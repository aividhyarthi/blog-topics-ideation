---
// Topic sub-navigation, shown on every blog page.
//
// Previously the only way to browse by topic was a client-side filter that
// existed solely on the index — from inside an article there was no way to
// reach related posts at all, which is what made the blog feel nav-less.
// These are real links to real pages, so they work from anywhere, survive a
// page refresh, can be shared, and are crawlable.
import { getCollection } from 'astro:content';
import { topicSlug } from '../lib/blog/topics';

interface Props { current?: string }
const { current } = Astro.props as Props;

const posts = await getCollection('blog');
const themes = [...new Set(posts.map((p) => p.data.theme))].sort();
---
<nav class="subnav" aria-label="Blog topics">
  <div class="subnav-inner">
    <a href="/blog" class:list={['tlink', !current && 'active']}>All posts</a>
    {themes.map((t) => (
      <a href={`/blog/topic/${topicSlug(t)}`} class:list={['tlink', current === t && 'active']}>{t}</a>
    ))}
  </div>
</nav>

<style>
  /* A row of nine pill-chips with counts wrapped onto two lines and read as
     clutter rather than navigation. Plain text links on one line, with the
     active item marked by an underline, look like the section nav this is. */
  .subnav { border-bottom: 1px solid #e5e7eb; background: #fff; }
  .subnav-inner {
    max-width: 1160px; margin: 0 auto; padding: 0 22px;
    display: flex; gap: 22px; align-items: stretch;
    overflow-x: auto; scrollbar-width: none;
  }
  .subnav-inner::-webkit-scrollbar { display: none; }
  .tlink {
    position: relative; white-space: nowrap; text-decoration: none;
    color: #6b7280; font-size: 14px; font-weight: 600;
    padding: 12px 0 13px; border-bottom: 2px solid transparent;
    transition: color .15s, border-color .15s;
  }
  .tlink:hover { color: #16181d; }
  .tlink.active { color: #16181d; border-bottom-color: #16181d; font-weight: 700; }
</style>
