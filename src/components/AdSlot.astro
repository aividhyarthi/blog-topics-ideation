---
// Google AdSense placement. Renders nothing at all if ADSENSE_CLIENT isn't
// set (e.g. local dev, or before the real AdSense ids are filled in) — see
// src/lib/saas/plans.ts for the env vars. Each page that uses this must
// load the AdSense loader script once in its own <head> (see AdSenseScript
// below); this component only renders the actual ad unit + the per-unit
// push call.
//
// Fixed size, not "auto"/full-width-responsive: a responsive unit can
// resize after it loads, shifting whatever sits below it. A fixed box is
// reserved by CSS before the ad script ever runs, so the page layout is
// identical whether the ad has loaded, is still loading, or (in dev,
// where ADSENSE_CLIENT is unset) never renders at all.
import { ADSENSE_CLIENT } from '../lib/saas/plans';

interface Props {
  slot: string;
  label?: string;
  width?: number;
  height?: number;
}
// 250x250 ("square") is one of Google's standard fixed ad sizes and the
// narrowest common one that still carries real demand. It fits inside the
// smallest layout this site supports (320px viewport minus the page's
// 20px side padding = 280px of content width) with room to spare, so the
// same literal box works on mobile and desktop without a breakpoint.
const { slot, label = 'Advertisement', width = 250, height = 250 } = Astro.props as Props;
const show = Boolean(ADSENSE_CLIENT && slot);
---
{show && (
  <div class="ad-slot" style={`width:${width}px;height:${height + 22}px;`}>
    <span class="ad-label">{label}</span>
    <ins
      class="adsbygoogle"
      style={`display:inline-block;width:${width}px;height:${height}px;`}
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}

<style>
  .ad-slot { margin: 20px auto; padding: 10px 0 0; border-top: 1px solid var(--line, #e5e7eb); max-width: 100%; }
  .ad-label { display: block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted, #6b7280); margin-bottom: 8px; }
</style>
