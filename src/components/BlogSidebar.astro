---
// Right-hand sidebar for both /blog and /blog/[slug] — a subscribe/signup
// CTA for the tool itself, an ad slot, a "Most Searched Topics" interlinking
// widget keyed off each post's target keyword, and a short "recent posts"
// list so a reader on one article has somewhere else to go. Both blog pages
// are prerendered static content, so this never depends on request-scoped
// data (login state etc.) — see the note in those pages.
import { BRAND, ADSENSE_SLOTS } from '../lib/saas/plans';
import AdSlot from './AdSlot.astro';

interface RecentPost { slug: string; title: string }
interface KeywordLink { slug: string; keyword: string; theme?: string }
interface Props { recentPosts?: RecentPost[]; keywordLinks?: KeywordLink[]; mixedCategories?: boolean }
const { recentPosts = [], keywordLinks = [], mixedCategories = false } = Astro.props as Props;
---
<aside class="blog-sidebar">
  <div class="cta-card">
    <div class="cta-title">Know where you rank, every day</div>
    <p class="cta-body">Track your app's keyword rankings on Google Play and the App Store, spot drops early, and see exactly what to fix. Free 7-day trial, no card required.</p>
    <a class="cta-btn" href="/signup">Start free trial →</a>
  </div>

  <AdSlot slot={ADSENSE_SLOTS.blog} label="Advertisement" />

  {keywordLinks.length > 0 && (
    <div class="kw-card">
      <div class="kw-title">Most Searched Topics:</div>
      <ul>
        {keywordLinks.map((k) => (
          <li>
            <a href={`/blog/${k.slug}`}>{k.keyword}</a>
            {mixedCategories && k.theme && <span class="kw-theme">{k.theme}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}

  {recentPosts.length > 0 && (
    <div class="recent-card">
      <div class="recent-title">More from the blog</div>
      <ul>
        {recentPosts.map((p) => <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>)}
      </ul>
    </div>
  )}
</aside>

<style>
  .blog-sidebar { display: flex; flex-direction: column; gap: 20px; }
  .cta-card { background: #111114; border-radius: 14px; padding: 22px; color: #fff; }
  .cta-title { font-size: 17px; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 8px; }
  .cta-body { font-size: 13.5px; line-height: 1.55; opacity: 0.92; margin: 0 0 16px; }
  .cta-btn { display: inline-block; background: #fff; color: #16181d; font-weight: 700; font-size: 13.5px; text-decoration: none; padding: 9px 15px; border-radius: 8px; }
  .cta-btn:hover { background: #e5e7eb; }
  .recent-card { border: 1px solid #e5e7eb; border-radius: 12px; padding: 18px; }
  .recent-title { font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #6b7280; margin-bottom: 10px; }
  .recent-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .recent-card a { color: #16181d; text-decoration: none; font-size: 13.5px; font-weight: 600; line-height: 1.4; }
  .recent-card a:hover { color: #111; text-decoration: underline; }

  .kw-card { border: 1px solid #e5e7eb; border-radius: 12px; padding: 18px; }
  .kw-title { font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #6b7280; margin-bottom: 10px; }
  .kw-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .kw-card li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; min-width: 0; }
  .kw-card a { color: #16181d; text-decoration: none; font-size: 13.5px; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
  .kw-card a:hover { text-decoration: underline; }
  .kw-theme { font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #9aa0ad; white-space: nowrap; }

  @media (max-width: 380px) {
    .kw-card a { font-size: 13px; }
  }
</style>
