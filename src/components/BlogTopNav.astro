---
// Shared top nav for the PRERENDERED blog pages.
//
// These pages are static (good for crawlability — see blog/index.astro), so
// they can't know at build time whether the visitor is signed in, and used to
// show every reader the logged-out "Start free trial" CTA — including the
// owner, mid-session. The markup below ships the logged-out state (correct for
// the overwhelming majority of blog traffic, and the right thing for a crawler
// to index), then upgrades it in place from /api/auth/me on load.
//
// Same black top-strip as the in-product pages (rank.astro/aso.astro/
// welcome.astro) and the marketing pages (landing.astro/about.astro via
// SiteHeader.astro) — one nav look across the whole site, not just wherever
// it was asked for first.
import { BRAND } from '../lib/saas/plans';
interface Props { active?: 'blog' | 'about' }
const { active } = Astro.props as Props;
---
<header class="top">
  <a class="logo" href="/"><span class="mark">AR</span>{BRAND}</a>
  <div class="navlinks" id="site-navlinks">
    <a class="plain" class:list={[active === 'blog' && 'active']} href="/blog">Blog</a>
    <a class="plain" class:list={[active === 'about' && 'active']} href="/about">About</a>
    <span class="mail" id="nav-mail" style="display:none;"></span>
    <a class="plain" id="nav-login" href="/login">Log in</a>
    <a class="btn" id="nav-cta" href="/signup">Start free trial</a>
    <a class="plain" id="nav-signout" href="#" style="display:none;">Sign out</a>
  </div>
</header>

<style>
  /* These live here, not in the host page: Astro scopes a page's <style> to
     that page's own markup, so leaving them behind when this nav moved into
     a component stripped it back to unstyled browser-default links. */
  :where(header.top) {
    background: #16181d;
    display: flex; align-items: center; justify-content: space-between;
    padding: 13px 22px; max-width: 1160px; margin: 0 auto; flex-wrap: wrap; gap: 10px;
  }
  .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 16px; letter-spacing: -0.02em; text-decoration: none; color: #fff; }
  .logo .mark { width: 24px; height: 24px; border-radius: 7px; background: #fff; color: #16181d; display: grid; place-items: center; font-size: 10px; font-weight: 800; letter-spacing: -0.03em; }
  .navlinks { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .navlinks a.plain { color: #9ca3af; text-decoration: none; font-size: 13.5px; font-weight: 600; }
  .navlinks a.plain:hover { color: #fff; }
  .navlinks a.plain.active { color: #fff; }
  .navlinks .mail { color: #6b7280; font-size: 12.5px; font-weight: 600; max-width: 32vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .navlinks a.btn { text-decoration: none; font-weight: 700; font-size: 13.5px; border-radius: 8px; padding: 8px 15px; background: #fff; color: #16181d; white-space: nowrap; }
  .navlinks a.btn:hover { background: #d1d5db; }
</style>

<script>
  // Progressive upgrade: a signed-in reader gets the same destinations the
  // in-product nav offers (Welcome, not the logged-out trial pitch), instead
  // of being asked to start a trial they're already past. Failure is silent
  // and simply leaves the logged-out nav.
  (async () => {
    try {
      const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
      if (!res.ok) return;
      const me = await res.json();
      if (!me.loggedIn) return;
      const login = document.getElementById('nav-login');
      const cta = document.getElementById('nav-cta');
      const mail = document.getElementById('nav-mail');
      const signout = document.getElementById('nav-signout');
      if (login) login.style.display = 'none';
      if (mail) { mail.textContent = me.email || ''; mail.style.display = ''; }
      if (cta) { cta.textContent = 'Dashboard'; cta.setAttribute('href', '/welcome'); }
      if (signout) {
        signout.style.display = '';
        signout.addEventListener('click', async (e) => {
          e.preventDefault();
          await fetch('/api/auth/logout', { method: 'POST' });
          location.href = '/';
        });
      }
    } catch { /* stay logged-out; nothing here is worth breaking the page for */ }
  })();
</script>
