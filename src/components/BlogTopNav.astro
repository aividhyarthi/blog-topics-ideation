---
// Shared top nav for the PRERENDERED blog pages.
//
// These pages are static (good for crawlability — see blog/index.astro), so
// they can't know at build time whether the visitor is signed in, and used to
// show every reader the logged-out "Start free trial" CTA — including the
// owner, mid-session. The markup below ships the logged-out state (correct for
// the overwhelming majority of blog traffic, and the right thing for a crawler
// to index), then upgrades it in place from /api/auth/me on load.
import { BRAND } from '../lib/saas/plans';
interface Props { active?: 'blog' | 'about' }
const { active } = Astro.props as Props;
---
<header class="top">
  <a class="logo" href="/"><span class="mark">▲</span>{BRAND}<span class="betatag">Beta 1.0</span></a>
  <div class="navlinks" id="site-navlinks">
    <a class="plain" class:list={[active === 'blog' && 'active']} href="/blog">Blog</a>
    <a class="plain" class:list={[active === 'about' && 'active']} href="/about">About</a>
    <a class="plain" id="nav-login" href="/login">Log in</a>
    <a class="btn" id="nav-cta" href="/signup">Start free trial</a>
  </div>
</header>

<style>
  /* These live here, not in the host page: Astro scopes a page's <style> to
     that page's own markup, so leaving them behind when this nav moved into
     a component stripped it back to unstyled browser-default links. */
  :where(header.top) {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 22px; max-width: 1160px; margin: 0 auto; flex-wrap: wrap; gap: 10px;
  }
  .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; text-decoration: none; color: #16181d; }
  .logo .betatag { font-size: 10px; font-weight: 800; color: #372aa8; background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25); padding: 2px 7px; border-radius: 999px; letter-spacing: 0.02em; }
  .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(120deg, #6366f1, #8b5cf6); color: #fff; display: grid; place-items: center; font-size: 14px; }
  .navlinks { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .navlinks a.plain { color: #6b7280; text-decoration: none; font-size: 14px; font-weight: 600; }
  .navlinks a.plain:hover { color: #16181d; }
  .navlinks a.plain.active { color: #16181d; }
  .navlinks a.btn { text-decoration: none; font-weight: 700; font-size: 14px; border-radius: 10px; padding: 10px 18px; background: #4338ca; color: #fff; white-space: nowrap; }
  .navlinks a.btn:hover { background: #372aa8; }
</style>

<script>
  // Progressive upgrade: a signed-in reader gets the same destinations the
  // in-product nav offers, instead of being asked to start a trial they are
  // already past. Failure is silent and simply leaves the logged-out nav.
  (async () => {
    try {
      const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
      if (!res.ok) return;
      const me = await res.json();
      if (!me.loggedIn) return;
      // Repurpose the existing elements rather than creating new ones:
      // Astro's scoped CSS is applied via a per-component attribute that a
      // freshly created node wouldn't carry, so an injected <a> would render
      // as an unstyled default link.
      const cta = document.getElementById('nav-cta');
      const login = document.getElementById('nav-login');
      if (login) {
        login.textContent = me.email || 'Account';
        login.setAttribute('href', '/account');
      }
      if (cta) {
        cta.textContent = 'Dashboard';
        cta.setAttribute('href', '/rank');
      }
    } catch { /* stay logged-out; nothing here is worth breaking the page for */ }
  })();
</script>
