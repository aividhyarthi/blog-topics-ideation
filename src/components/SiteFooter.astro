---
// Shared footer for marketing-facing pages (landing, about, blog) — replaces
// the single-line "© AppRankr · About" footer that was on every page. Only
// links to real, existing routes (no placeholder Terms/Privacy pages that
// would just 404).
import { BRAND, FOUNDER_NAME, FOUNDER_LINKEDIN, INITIATIVE_NAME } from '../lib/saas/plans';
---
<footer class="site-footer">
  <div class="sf-wrap sf-grid">
    <div class="sf-brand">
      <div class="sf-logo"><span class="mark">AR</span>{BRAND}</div>
      <p class="sf-blurb">Know where your app ranks, every keyword, every day.</p>
    </div>
    <div class="sf-col">
      <div class="sf-heading">Product</div>
      <a href="/#features">Features</a>
      <a href="/signup">Start free trial</a>
      <a href="/login">Log in</a>
    </div>
    <div class="sf-col">
      <div class="sf-heading">Company</div>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href="mailto:talktoapprankr@gmail.com">Contact</a>
    </div>
  </div>
  <div class="sf-wrap sf-bottom">
    © {new Date().getFullYear()} {BRAND} · An initiative by {INITIATIVE_NAME} · Built by <a href={FOUNDER_LINKEDIN} target="_blank" rel="noopener">{FOUNDER_NAME}</a>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid #e5e7eb; margin-top: 40px; padding-top: 40px; }
  .sf-wrap { max-width: 1080px; margin: 0 auto; padding: 0 22px; }
  .sf-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 32px; padding-bottom: 28px; }
  @media (max-width: 640px) { .sf-grid { grid-template-columns: 1fr; gap: 22px; } }
  .sf-logo { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 16px; letter-spacing: -0.02em; color: #16181d; }
  .sf-logo .mark { width: 24px; height: 24px; border-radius: 7px; background: #16181d; color: #fff; display: grid; place-items: center; font-size: 10px; font-weight: 800; letter-spacing: -0.03em; }
  .sf-blurb { font-size: 13px; color: #6b7280; margin: 10px 0 0; max-width: 30ch; line-height: 1.5; }
  .sf-heading { font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #9ca3af; margin-bottom: 12px; }
  .sf-col { display: flex; flex-direction: column; gap: 9px; }
  .sf-col a { color: #4b5160; text-decoration: none; font-size: 13.5px; font-weight: 500; }
  .sf-col a:hover { color: #16181d; text-decoration: underline; }
  .sf-bottom { border-top: 1px solid #e5e7eb; padding: 18px 0; text-align: center; color: #9ca3af; font-size: 12px; }
  .sf-bottom a { color: #9ca3af; text-decoration: underline; text-decoration-color: #d1d5db; }
  .sf-bottom a:hover { color: #4b5160; }
</style>
