---
// Google's site-ownership verification tags — AdSense's and Search
// Console's — belong in every page's <head> site-wide (separate from the
// ad-unit loader script in AdSenseScript.astro, which only needs to be on
// pages that actually show an <AdSlot />).
import { ADSENSE_CLIENT, GOOGLE_SITE_VERIFICATION } from '../lib/saas/plans';
---
{ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
