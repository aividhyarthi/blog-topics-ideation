---
// Shared marketing layout — professional nav, footer, and palette for the
// Pricing / Blog / News pages so the whole site reads as one product.
const { title = 'CiteRank', description = 'AEO / GEO intelligence platform.', schema } = Astro.props;

// We audit other people's structured data, so ours has to be right. Every page
// gets Organization + WebSite; pages pass their own `schema` for the specific
// type (Article, FAQPage, DefinedTermSet, …).
const origin = Astro.site?.origin || new URL(Astro.request.url).origin;
const canonical = new URL(Astro.url.pathname, origin).href;

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#org`,
      name: 'CiteRank',
      url: origin,
      description: 'AEO / GEO intelligence platform that shows what AI crawlers can and cannot read on your site.',
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#site`,
      url: origin,
      name: 'CiteRank',
      publisher: { '@id': `${origin}/#org` },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CiteRank" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --pink: #2563eb; --pink-dark: #1d4ed8; --accent-soft: #eaf1ff;
        --ink: #0f172a; --ink-2: #334155; --muted: #64748b; --faint: #94a3b8;
        --line: #e6ebf1; --line-2: #dbe3ec; --bg: #f6f8fb; --card: #fff;
        --ok: #12855a; --ok-bg: #e3f4ec; --warn: #b7791f; --warn-bg: #fbf1da;
        --bad: #d43a3a; --bad-bg: #fcebeb; --ink-900: #0b1220;
        --shadow: 0 1px 2px rgba(15,23,42,.04), 0 8px 24px -16px rgba(15,23,42,.16);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.6; -webkit-font-smoothing: antialiased; }
      a { color: var(--pink-dark); }
      .wrap { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
      svg { display: block; }
      .nav { position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,.85); backdrop-filter: saturate(180%) blur(12px); border-bottom: 1px solid var(--line); }
      .navinner { display: flex; align-items: center; gap: 14px; height: 60px; }
      .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 17px; letter-spacing: -.02em; color: var(--ink); text-decoration: none; }
      .brand .mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(140deg, #2563eb, #1d4ed8); display: grid; place-items: center; box-shadow: 0 4px 12px -4px rgba(29,78,216,.6); }
      .brand .mark svg { width: 15px; height: 15px; color: #fff; }
      .navmenu { margin-left: 28px; display: flex; gap: 22px; }
      .navmenu a { font-size: 13.5px; font-weight: 600; color: var(--ink-2); text-decoration: none; }
      .navmenu a:hover { color: var(--pink); }
      .navcta { margin-left: auto; display: flex; align-items: center; gap: 14px; }
      .nav-login { font-size: 13.5px; font-weight: 600; color: var(--ink-2); text-decoration: none; }
      .btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: var(--pink); color: #fff; border: none; border-radius: 10px; padding: 11px 20px; font-size: 14px; font-weight: 700; cursor: pointer; text-decoration: none; box-shadow: 0 6px 18px -8px rgba(37,99,235,.6); transition: .15s; }
      .btn-primary:hover { background: var(--pink-dark); transform: translateY(-1px); }
      .btn-primary.sm { padding: 8px 15px; font-size: 13px; }
      .btn-ghost { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--ink); border: 1px solid var(--line-2); border-radius: 10px; padding: 11px 20px; font-size: 14px; font-weight: 700; text-decoration: none; transition: .15s; }
      .btn-ghost:hover { border-color: var(--pink); color: var(--pink); }
      @media (max-width: 820px) { .navmenu { display: none; } }
      @media (max-width: 480px) { .nav-login { display: none; } }
      .pagehead { border-bottom: 1px solid var(--line); background: radial-gradient(800px 320px at 80% -10%, rgba(37,99,235,.10), transparent 60%); }
      .pagehead .wrap { padding: 54px 24px 44px; }
      .eyebrow { display: inline-block; font-size: 11.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--pink); background: var(--accent-soft); border: 1px solid #c7ddff; padding: 5px 12px; border-radius: 999px; margin-bottom: 16px; }
      .pagehead h1 { margin: 0 0 12px; font-size: 38px; font-weight: 800; letter-spacing: -.03em; line-height: 1.1; }
      .pagehead p { margin: 0; font-size: 17px; color: var(--ink-2); max-width: 66ch; }
      @media (max-width: 640px) { .pagehead h1 { font-size: 29px; } }
      main { padding: 44px 0 64px; }
      .site-footer { background: var(--ink-900); color: #cbd5e1; padding: 50px 0 26px; }
      .footcols { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 30px; }
      @media (max-width: 720px) { .footcols { grid-template-columns: 1fr 1fr; } }
      .footbrand .brand { color: #fff; margin-bottom: 12px; }
      .footbrand p { font-size: 13px; color: #94a3b8; line-height: 1.6; max-width: 34ch; margin: 0; }
      .footcol { display: flex; flex-direction: column; gap: 10px; }
      .footcol b { color: #fff; font-size: 13px; margin-bottom: 3px; }
      .footcol a { color: #cbd5e1; text-decoration: none; font-size: 13px; }
      .footcol a:hover { color: #fff; }
      .footbottom { margin-top: 36px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.1); font-size: 12px; color: #94a3b8; }
    </style>
  </head>
  <body>
    <div class="nav">
      <div class="wrap navinner">
        <a href="/" class="brand"><span class="mark"><svg viewBox="0 0 24 24" fill="none"><rect x="5" y="13" width="3.2" height="6" rx="1.2" fill="currentColor" opacity="0.55"/><rect x="10.4" y="9.5" width="3.2" height="9.5" rx="1.2" fill="currentColor" opacity="0.8"/><rect x="15.8" y="5.5" width="3.2" height="13.5" rx="1.2" fill="currentColor"/></svg></span>CiteRank</a>
        <nav class="navmenu">
          <a href="/#features">Features</a>
          <a href="/audit">Full Audit</a>
          <a href="/pricing">Pricing</a>
          <a href="/blog">Blog</a>
          <a href="/news">News</a>
          <a href="/glossary">Glossary</a>
        </nav>
        <div class="navcta" id="cr-navauth"></div>
      </div>
    </div>

    <slot />
    <script src="/js/citerank-auth.js" defer></script>

    <footer class="site-footer">
      <div class="wrap footcols">
        <div class="footbrand">
          <div class="brand"><span class="mark"><svg viewBox="0 0 24 24" fill="none"><rect x="5" y="13" width="3.2" height="6" rx="1.2" fill="currentColor" opacity="0.55"/><rect x="10.4" y="9.5" width="3.2" height="9.5" rx="1.2" fill="currentColor" opacity="0.8"/><rect x="15.8" y="5.5" width="3.2" height="13.5" rx="1.2" fill="currentColor"/></svg></span>CiteRank</div>
          <p>AEO / GEO intelligence for the age of AI search. By Rudra Kasturi Inc.</p>
        </div>
        <div class="footcol"><b>Product</b><a href="/">LLM Access Check</a><a href="/audit">Full AEO Audit</a><a href="/pricing">Pricing</a></div>
        <div class="footcol"><b>Resources</b><a href="/blog">Blog</a><a href="/news">News</a><a href="/glossary">Glossary</a></div>
        <div class="footcol"><b>Legal</b><a href="/terms">Terms of Service</a><a href="/privacy">Privacy Policy</a><a href="/refunds">Refunds &amp; Cancellation</a></div>
      </div>
      <div class="wrap footbottom">© 2026 CiteRank · By Rudra Kasturi Inc</div>
    </footer>
  </body>
</html>
