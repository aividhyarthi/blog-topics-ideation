---
// Public marketing layout — nav, footer and palette for the pages anyone can
// see (home, pricing, glossary, legal). Signed-in app pages use
// App.astro instead, which deliberately drops the marketing footer.
import '../styles/base.css';

const { title = 'AI Page Audit', description = 'See your site the way AI answer engines see it.', schema } = Astro.props;

// We audit other people's structured data, so ours has to be right. Every page
// gets Organization + WebSite; pages pass their own `schema` for the specific
// type (Article, FAQPage, DefinedTermSet, …).
const origin = Astro.site?.origin || new URL(Astro.request.url).origin;
const canonical = new URL(Astro.url.pathname, origin).href;

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#org`,
      name: 'AI Page Audit',
      url: origin,
      description: 'Shows what AI crawlers can and cannot read on your site, and what to fix.',
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#site`,
      url: origin,
      name: 'AI Page Audit',
      publisher: { '@id': `${origin}/#org` },
    },
  ],
};

const MARK = `<svg viewBox="0 0 24 24" fill="none"><rect x="5" y="13" width="3.2" height="6" rx="1.2" fill="currentColor" opacity="0.55"/><rect x="10.4" y="9.5" width="3.2" height="9.5" rx="1.2" fill="currentColor" opacity="0.8"/><rect x="15.8" y="5.5" width="3.2" height="13.5" rx="1.2" fill="currentColor"/></svg>`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AI Page Audit" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="nav nav-dark">
      <div class="wrap navinner">
        <a href="/" class="brand"><span class="mark" set:html={MARK} />AI Page Audit</a>
        <nav class="navmenu">
          <a href="/#features">Features</a>
          <a href="/pricing">Pricing</a>
          <a href="/checklist">Checklist</a>
          <a href="/glossary">Glossary</a>
        </nav>
        <div class="navcta" id="cr-navauth"></div>
      </div>
    </div>

    <slot />
    <script src="/js/citerank-auth.js" defer></script>

    <footer class="site-footer">
      <div class="wrap footcols">
        <div class="footbrand">
          <div class="brand"><span class="mark" set:html={MARK} />AI Page Audit</div>
          <p>See your site the way AI answer engines see it. By Rudra Kasturi Inc.</p>
        </div>
        <div class="footcol"><b>Product</b><a href="/check">LLM Access Check</a><a href="/audit">Full AEO Audit</a><a href="/pricing">Pricing</a></div>
        <div class="footcol"><b>Resources</b><a href="/checklist">The AEO checklist</a><a href="/glossary">AEO / GEO Glossary</a></div>
        <div class="footcol"><b>Legal</b><a href="/terms">Terms of Service</a><a href="/privacy">Privacy Policy</a><a href="/refunds">Refunds &amp; Cancellation</a></div>
      </div>
      <div class="wrap footbottom">© 2026 AI Page Audit · By Rudra Kasturi Inc</div>
    </footer>
  </body>
</html>
