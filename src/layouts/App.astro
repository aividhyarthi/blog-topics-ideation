---
// Signed-in app shell. The three tools are the main body of every app page,
// as a persistent tab bar — pick one and the other two stay visible with the
// active one marked, rather than being buried in a sidebar.
//
// Deliberately NOT the marketing layout: no feature grid, no four-column
// marketing footer. A logged-in workspace should look like a workspace.
import '../styles/base.css';

interface Props { title?: string; description?: string; tab: 'home' | 'check' | 'audit' | 'reports' }
const { title = 'AI Page Audit', description = 'Your AI visibility workspace.', tab } = Astro.props as Props;

const TABS = [
  { id: 'home', href: '/home', label: 'Home', hint: 'Welcome back, and what to do next' },
  { id: 'check', href: '/check', label: 'LLM Access Check', hint: 'What each AI crawler can read' },
  { id: 'audit', href: '/audit', label: 'Full AEO Audit', hint: 'Weighted score and ranked fixes' },
  { id: 'reports', href: '/dashboard', label: 'Reports', hint: 'Saved audits, usage and plan' },
] as const;

const MARK = `<svg viewBox="0 0 24 24"><text x="12" y="17" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="15" fill="currentColor">AI</text></svg>`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google tag (gtag.js) — product-usage analytics for signed-in pages.
         These pages carry noindex above, so this has no effect on search.
         is:inline keeps this literally inline instead of Astro bundling it
         into a hoisted module chunk. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZG9919Z4CC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZG9919Z4CC');
    </script>
  </head>
  <body class="appbody">
    <div class="nav">
      <div class="wrap navinner">
        <a href="/home" class="brand"><span class="mark" set:html={MARK} />AI Page Audit</a>
        <div class="navcta">
          <span class="usagepill" id="usagepill" hidden></span>
          <a href="/blog" class="applink">Blog</a>
        </div>
      </div>
    </div>

    <div class="appshell">
      <nav class="sidenav" role="tablist" aria-label="Sections">
        <div class="sidetabs">
          {TABS.map((t) => (
            <a
              href={t.href}
              class:list={['apptab', tab === t.id && 'on']}
              aria-current={tab === t.id ? 'page' : undefined}
            >
              <span class="t-label">{t.label}</span>
              <span class="t-hint">{t.hint}</span>
            </a>
          ))}
        </div>
        <!-- Account area: pinned to the bottom of the sidebar (margin-top:
             auto in a column flex container) rather than the top nav, so the
             nav bar itself stays uncluttered — plan/billing, the signed-in
             email and sign-out live with the rest of account-scoped nav. -->
        <div class="sidefoot">
          <a href="/pricing" class="sidefoot-link">Plan &amp; billing</a>
          <span id="cr-navauth"></span>
        </div>
      </nav>
      <div class="appmain">
        <slot />
      </div>
    </div>

    <script src="/js/citerank-auth.js" defer></script>

    <script>
      // Remaining-checks pill. Lives in the shell so it shows on all three
      // tabs; the tool pages used to each carry their own copy.
      fetch('/api/payments/status')
        .then((r) => r.json())
        .then((d) => {
          const el = document.getElementById('usagepill');
          if (!el || !d.signedIn) return;
          if (d.owner) {
            el.textContent = 'Pro · unlimited';
            el.className = 'usagepill pro';
          } else if (d.plan === 'pro') {
            const left = d.planLimit - d.planUsed;
            el.textContent = `Pro · ${d.planUsed}/${d.planLimit}`;
            el.className = 'usagepill' + (left <= Math.ceil(d.planLimit * 0.1) ? ' low' : ' pro');
          } else {
            const left = (d.freeCheckAvailable ? 1 : 0) + (d.credits || 0);
            el.textContent = `${left} check${left === 1 ? '' : 's'} left`;
            el.className = 'usagepill' + (left === 0 ? ' low' : '');
          }
          el.hidden = false;
        })
        .catch(() => {});
    </script>

    <footer class="app-footer">
      <div class="wrap app-footrow">
        <span>© 2026 AI Page Audit</span>
        <span class="app-footlinks">
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/refunds">Refunds</a>
          <a href="/">Home</a>
        </span>
      </div>
    </footer>

    <style is:global>
      /* Column flex so a short page (an empty Reports tab, say) still pins the
         footer to the bottom instead of leaving it floating mid-screen —
         .app-footer's margin-top:auto does the actual pushing. */
      .appbody { background: var(--bg); min-height: 100vh; display: flex; flex-direction: column; }

      .applink { font-size: 13.5px; font-weight: 600; color: var(--ink-2); text-decoration: none; }
      .applink:hover { color: var(--accent); }

      .usagepill {
        font-size: 11.5px; font-weight: 700; padding: 4px 11px; border-radius: 999px;
        background: var(--accent-soft); color: var(--accent-dark);
        border: 1px solid var(--accent-line); white-space: nowrap;
      }
      .usagepill.pro { background: var(--ok-bg); color: var(--ok); border-color: #cdebdd; }
      .usagepill.low { background: var(--warn-bg); color: var(--warn); border-color: #f0e2b8; }
      @media (max-width: 640px) { .usagepill, .applink { display: none; } }

      /* The tool switcher. Always shows all four; the active one is marked by
         weight, colour and a left accent bar rather than by hiding the
         others. Vertical rail on desktop (frees up horizontal width for the
         report itself, and stays visible while scrolling a long one) —
         collapses to the original horizontal scroller under 780px, where a
         fixed-width side rail would eat too much of a phone's screen. */
      .appshell { flex: 1 0 auto; display: flex; align-items: flex-start; width: 100%; }
      .sidenav {
        flex: none; width: 236px; display: flex; flex-direction: column;
        background: #fff; border-right: 1px solid var(--line);
        position: sticky; top: 60px; padding: 14px 10px;
        min-height: calc(100vh - 60px);
      }
      .sidetabs { display: flex; flex-direction: column; gap: 2px; }
      .appmain { flex: 1; min-width: 0; }

      .apptab {
        display: grid; gap: 1px; padding: 10px 13px;
        border-left: 2.5px solid transparent; border-radius: 0 9px 9px 0; text-decoration: none;
        color: var(--muted); transition: color .15s, border-color .15s, background .15s;
      }
      .apptab:hover { color: var(--ink); background: var(--accent-soft); }
      .apptab .t-label { font-size: 14px; font-weight: 700; letter-spacing: -.01em; }
      .apptab .t-hint { font-size: 11.5px; color: var(--faint); }
      .apptab.on { color: var(--accent); background: var(--accent-soft); border-left-color: var(--accent); }
      .apptab.on .t-hint { color: var(--accent); opacity: .75; }

      /* Account area, pinned to the bottom of the sidebar (see App.astro's
         comment above the markup). Stacked, not the horizontal row #cr-navauth
         uses in the top nav elsewhere — a lot narrower here than a full-width
         nav bar. */
      .sidefoot { margin-top: auto; padding: 14px 13px 4px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; }
      .sidefoot-link { font-size: 13px; font-weight: 700; color: var(--ink-2); text-decoration: none; }
      .sidefoot-link:hover { color: var(--accent); }
      .sidefoot #cr-navauth { flex-direction: column; align-items: flex-start; gap: 8px; }
      .sidefoot .cra-email { max-width: none; }
      .sidefoot .cra-btn { width: 100%; justify-content: center; }

      @media (max-width: 780px) {
        .appshell { flex-direction: column; }
        .sidenav {
          flex-direction: row; align-items: center; width: 100%; align-self: auto; position: sticky; top: 60px; z-index: 30;
          border-right: none; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none;
          padding: 0; min-height: 0;
        }
        .sidenav::-webkit-scrollbar { display: none; }
        /* flex-shrink: 0 on both — without it, .sidetabs (no explicit
           shrink) got squeezed by flexbox to fit next to .sidefoot's full
           natural width, but its own tab labels didn't actually shrink to
           match, so the last tab visually overflowed its compressed box
           and sat on top of "Plan & billing". Letting both keep their
           natural width means the row is wider than the phone screen, which
           is fine — that's what overflow-x: auto on .sidenav is for. */
        .sidetabs { flex-direction: row; gap: 4px; flex-shrink: 0; }
        .apptab { flex: none; padding: 13px 16px 12px; border-left: none; border-bottom: 2.5px solid transparent; border-radius: 0; }
        .apptab.on { background: transparent; border-left-color: transparent; border-bottom-color: var(--accent); }
        .apptab .t-hint { display: none; }
        /* No "bottom" in a horizontal strip — sits inline after the tabs instead. */
        /* Flows after the tabs in the same horizontal scroller, not pinned
           via margin-left:auto — that fights with overflow-x:auto and
           overlapped the last tab instead of scrolling into view after it. */
        .sidefoot { margin-top: 0; padding: 0 14px; border-top: none; border-left: 1px solid var(--line); flex-direction: row; align-items: center; flex: none; }
        .sidefoot-link { white-space: nowrap; }
        .sidefoot #cr-navauth { flex-direction: row; align-items: center; }
        .sidefoot .cra-email { max-width: 120px; }
        .sidefoot .cra-btn { width: auto; }
      }

      /* Slim, functional footer — the marketing one has no place in a
         signed-in workspace. */
      .app-footer { margin-top: auto; border-top: 1px solid var(--line); background: #fff; padding: 18px 0; }
      .app-footrow { display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 12.5px; color: var(--faint); flex-wrap: wrap; }
      .app-footlinks { display: flex; gap: 16px; }
      .app-footlinks a { color: var(--faint); text-decoration: none; }
      .app-footlinks a:hover { color: var(--accent); }
    </style>
  </body>
</html>
