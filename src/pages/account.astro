---
// Account & billing page (product mode, login required via middleware).
// Billing is manual UPI/WhatsApp, not a payment gateway — see plans.ts. The
// QR + UPI deep link are rendered server-side here (qrcode-generator), so
// there is no client-side payment JS at all.
import { BRAND, PLANS, planOf, checkAccess, CURRENCY, formatPrice, UPI_ID, UPI_PAYEE_NAME, WHATSAPP_NUMBER, ADSENSE_SLOTS } from '../lib/saas/plans';
import qrcode from 'qrcode-generator';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import AdSenseMeta from '../components/AdSenseMeta.astro';
import AdSenseScript from '../components/AdSenseScript.astro';
import AdSlot from '../components/AdSlot.astro';

const user = Astro.locals.user!;
const access = checkAccess(user.status, user.trialEndsAt);
const plan = planOf(user.plan);
const expired = Astro.url.searchParams.get('expired') === '1';
const statusLabel =
  user.status === 'active' ? `Active — ${plan.name} plan`
  : user.status === 'trialing' && access.allowed ? `Free trial — ${access.trialDaysLeft} day${access.trialDaysLeft === 1 ? '' : 's'} left`
  : user.status === 'past_due' ? 'Payment problem — please pay again to keep access'
  : 'No active subscription';

function upiUri(amount: number, note: string): string {
  const params = new URLSearchParams({ pa: UPI_ID, pn: UPI_PAYEE_NAME, am: String(amount), cu: 'INR', tn: note });
  return `upi://pay?${params.toString()}`;
}
function qrSvg(uri: string): string {
  const qr = qrcode(0, 'M');
  qr.addData(uri);
  qr.make();
  return qr.createSvgTag({ scalable: true });
}
function waLink(text: string): string {
  return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
}

const planPayment = Object.values(PLANS).map((p) => {
  const note = `${BRAND} ${p.name} plan`;
  return {
    plan: p,
    uri: upiUri(p.priceMonthly, note),
    qr: qrSvg(upiUri(p.priceMonthly, note)),
    wa: waLink(`Hi, I've paid ${CURRENCY}${formatPrice(p.priceMonthly)} for the ${p.name} plan on ${BRAND}. My account email is ${user.email} — please activate my account.`),
  };
});
const cancelWa = waLink(`Hi, I'd like to cancel my ${BRAND} ${plan.name} plan subscription. My account email is ${user.email}.`);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <AdSenseMeta />
    <AdSenseScript />
    <title>{BRAND} — Account</title>
    <style>
      :root { --pink: #16181d; --pink-dark: #000000; --ink: #16181d; --muted: #6b7280; --line: #e5e7eb; --bg: #f8f9fb; --ok: #0a8a5f; --bad: #c0392b; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.5; font-size: 14px; }
      header { background: #fff; color: var(--ink); border-bottom: 1px solid var(--line); padding: 14px 20px; }
      .wrap { max-width: 860px; margin: 0 auto; padding: 0 20px; }
      .topbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
      .logo { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; }
      .logo .betatag { font-size: 10px; font-weight: 700; color: var(--muted); background: var(--bg); border: 1px solid var(--line); padding: 2px 6px; border-radius: 4px; letter-spacing: 0.02em; }
      .logo .mark { width: 22px; height: 22px; border-radius: 6px; background: var(--pink); color: #fff; display: grid; place-items: center; font-size: 11px; }
      nav { display: flex; align-items: center; gap: 2px; flex-wrap: wrap; }
      nav a { color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 600; background: none; border: 1px solid transparent; padding: 6px 11px; border-radius: 7px; }
      nav a:hover { color: var(--ink); background: var(--bg); }
      .usermenu { position: relative; }
      .usertrigger { color: var(--muted); font-size: 13px; font-weight: 600; background: none; border: 1px solid var(--line); padding: 6px 11px; border-radius: 7px; cursor: pointer; font-family: inherit; max-width: 46vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .usertrigger:hover { border-color: #cbd0da; color: var(--ink); }
      .usertrigger .caret { opacity: 0.7; }
      .userdropdown { display: none; position: absolute; right: 0; top: calc(100% + 6px); background: #fff; border: 1px solid var(--line); border-radius: 9px; box-shadow: 0 8px 24px rgba(15,20,30,0.1); min-width: 190px; overflow: hidden; z-index: 50; }
      .userdropdown.open { display: block; }
      .userdropdown a { display: block; padding: 9px 13px; font-size: 13px; font-weight: 600; color: var(--ink); text-decoration: none; background: none; border: none; border-radius: 0; }
      .userdropdown a:hover { background: var(--bg); }
      .userdropdown a + a { border-top: 1px solid var(--line); }
      @media (max-width: 480px) { .usertrigger { max-width: 60vw; } }
      main { padding: 22px 0 60px; }
      .card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 18px; margin-bottom: 14px; }
      h2 { margin: 0 0 12px; font-size: 15px; }
      .kv { display: flex; gap: 10px; font-size: 14px; padding: 5px 0; }
      .kv .k { color: var(--muted); min-width: 120px; }
      .status { font-weight: 700; }
      .status.ok { color: var(--ok); }
      .status.bad { color: var(--bad); }
      .alert { padding: 12px 14px; border-radius: 8px; font-size: 13.5px; margin-bottom: 16px; }
      .alert.warn { background: #fff6e6; color: #8a5d00; border: 1px solid #f3e0b0; }
      .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      @media (max-width: 700px) { .plans { grid-template-columns: 1fr; } }
      .plan { border: 1px solid var(--line); border-radius: 9px; padding: 16px; }
      .plan.current { border-color: var(--pink); }
      .plan h3 { margin: 0 0 2px; font-size: 14px; }
      .plan .price { font-size: 22px; font-weight: 700; }
      .plan .price span { font-size: 13px; font-weight: 600; color: var(--muted); }
      .plan ul { list-style: none; padding: 0; margin: 8px 0 14px; font-size: 13px; color: var(--muted); }
      .plan li::before { content: '✓ '; color: var(--pink); font-weight: 700; }
      a.btn, button, summary.btn { display: inline-block; text-align: center; border: 1px solid transparent; border-radius: 7px; padding: 9px 16px; font-size: 13.5px; font-weight: 600; cursor: pointer; text-decoration: none; }
      .primary { background: var(--pink); color: #fff; border-color: var(--pink); }
      .primary:hover { background: var(--pink-dark); border-color: var(--pink-dark); }
      .ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }
      .ghost:hover { border-color: #cbd0da; background: var(--bg); }
      button:disabled { opacity: 0.5; cursor: not-allowed; }
      summary.btn { list-style: none; width: 100%; }
      summary.btn::-webkit-details-marker { display: none; }
      .paybox { margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--line); text-align: center; }
      .paybox .qr { width: 168px; height: 168px; margin: 0 auto 10px; }
      .paybox .qr svg { width: 100%; height: 100%; display: block; }
      .paybox .upiid { font-family: ui-monospace, monospace; font-size: 13px; background: var(--bg); padding: 6px 10px; border-radius: 8px; display: inline-block; margin-bottom: 10px; }
      .paybox .actions { display: flex; flex-direction: column; gap: 8px; }
      .paybox .note { font-size: 12px; color: var(--muted); margin-top: 10px; line-height: 1.5; }
      .wa { background: #25D366; color: #fff; }
      .wa:hover { background: #1ea952; }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap topbar">
        <a href="/" class="logo" style="text-decoration:none;color:inherit;"><span class="mark">▲</span>{BRAND}<span class="betatag">Beta 1.0</span></a>
        <nav>
          <a href="/rank">Rank Tracker</a>
          <a href="/aso">ASO Inspector</a>
          <div class="usermenu">
            <button type="button" class="usertrigger" id="usertrigger">{user.email} <span class="caret">▾</span></button>
            <div class="userdropdown" id="userdropdown">
              <a href="/about">About</a>
              <a href="#" id="logout">Log out</a>
            </div>
          </div>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        {expired && <div class="alert warn">Your free trial has ended. Pay via UPI below to keep your rank history and continue tracking — your data is saved and waiting. We'll activate your account shortly after you message us.</div>}

        <div class="card">
          <h2>Account</h2>
          <div class="kv"><span class="k">Name</span><span>{user.name || '—'}</span></div>
          <div class="kv"><span class="k">Email</span><span>{user.email}</span></div>
          <div class="kv"><span class="k">Status</span><span class={`status ${access.allowed || user.status === 'active' ? 'ok' : 'bad'}`}>{statusLabel}</span></div>
          {user.status === 'active' && (
            <div style="margin-top:10px;">
              <a class="btn ghost" href={cancelWa} target="_blank" rel="noopener">Cancel subscription (via WhatsApp)</a>
            </div>
          )}
        </div>

        <div class="card">
          <h2>{user.status === 'active' ? 'Change plan' : 'Choose your plan'}</h2>
          <p class="kv" style="padding-top:0;color:var(--muted);font-size:13.5px;">Pay by UPI — scan the QR, tap to pay in any UPI app, or message us on WhatsApp. No card, no netbanking, no payment gateway. We activate your account manually once the payment comes through.</p>
          <div class="plans">
            {planPayment.map(({ plan: p, qr, uri, wa }) => (
              <div class={`plan ${user.status === 'active' && user.plan === p.id ? 'current' : ''}`}>
                <h3>{p.name}</h3>
                <div class="price">{CURRENCY}{formatPrice(p.priceMonthly)}<span>/month</span></div>
                <ul>
                  <li>{p.maxApps} apps</li>
                  <li>{p.maxKeywordsPerApp} keywords per app</li>
                  <li>Both stores · daily checks · discovery · ASO Inspector</li>
                </ul>
                {user.status === 'active' && user.plan === p.id ? (
                  <button class="ghost" disabled>Current plan</button>
                ) : (
                  <details>
                    <summary class="btn primary">{user.status === 'active' ? `Switch to ${p.name}` : `Pay — ${CURRENCY}${formatPrice(p.priceMonthly)}/mo`}</summary>
                    <div class="paybox">
                      <div class="qr" set:html={qr} />
                      <div class="upiid">{UPI_ID}</div>
                      <div class="actions">
                        <a class="btn primary" href={uri}>📲 Pay in UPI app</a>
                        <a class="btn wa" href={wa} target="_blank" rel="noopener">💬 I've paid — message us on WhatsApp</a>
                      </div>
                      <p class="note">Scan the QR with any UPI app (GPay, PhonePe, Paytm...), or tap "Pay in UPI app" if you're on your phone. After paying, tap the WhatsApp button so we can activate your account — usually within a few hours.</p>
                    </div>
                  </details>
                )}
              </div>
            ))}
          </div>
        </div>
        <AdSlot slot={ADSENSE_SLOTS.footer} />
      </div>
    </main>
    <script>
      async function post(url, body) {
        const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Request failed.');
        return data;
      }
      document.getElementById('logout').addEventListener('click', async (e) => {
        e.preventDefault();
        await post('/api/auth/logout');
        location.href = '/';
      });
      const userTrigger = document.getElementById('usertrigger');
      const userDropdown = document.getElementById('userdropdown');
      if (userTrigger && userDropdown) {
        userTrigger.addEventListener('click', (e) => { e.stopPropagation(); userDropdown.classList.toggle('open'); });
        document.addEventListener('click', (e) => { if (!userDropdown.contains(e.target) && e.target !== userTrigger) userDropdown.classList.remove('open'); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') userDropdown.classList.remove('open'); });
      }
    </script>
  </body>
</html>
