---
// Static content (markdown, only changes on a new deploy) — prerendered so
// it's fast and reliably crawlable, independent of the Node server. Because
// this renders once at build time, request-scoped data like the logged-in
// user isn't available here (see rank.astro/aso.astro for pages that do
// need that). The nav ships its logged-out state and upgrades itself from
// /api/auth/me on load — see BlogTopNav — so a signed-in reader isn't shown
// a "Start free trial" CTA they're already past, without giving up the
// static rendering that makes these pages cheap and reliably crawlable.
export const prerender = true;
import { getCollection } from 'astro:content';
import { BRAND, SITE_URL, OG_IMAGE_VERSION } from '../../lib/saas/plans';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import AdSenseMeta from '../../components/AdSenseMeta.astro';
import AdSenseScript from '../../components/AdSenseScript.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BlogTopNav from '../../components/BlogTopNav.astro';
import BlogSubNav from '../../components/BlogSubNav.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <AdSenseMeta />
    <AdSenseScript />
    <title>{BRAND} Blog — ASO &amp; App Ranking Guides</title>
    <meta name="description" content={`Practical, no-fluff guides on App Store Optimization, keyword research, and app ranking on Google Play and the App Store — from the team behind ${BRAND}.`} />
    <link rel="canonical" href={`${SITE_URL}/blog`} />
    <meta name="robots" content="max-image-preview:large, max-video-preview:-1" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${BRAND} Blog — ASO & App Ranking Guides`} />
    <meta property="og:description" content={`Practical, no-fluff guides on App Store Optimization, keyword research, and app ranking on Google Play and the App Store.`} />
    <meta property="og:url" content={`${SITE_URL}/blog`} />
    {posts[0] && <meta property="og:image" content={`${SITE_URL}${posts[0].data.image}?${OG_IMAGE_VERSION}`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <style>
      :root { --pink: #16181d; --pink-dark: #000000; --ink: #16181d; --muted: #6b7280; --line: #e5e7eb; --bg: #f8f9fb; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #fff; color: var(--ink); line-height: 1.6; }
      .wrap { max-width: 1160px; margin: 0 auto; padding: 0 22px; }
      header.top { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; max-width: 1160px; margin: 0 auto; padding-left: 22px; padding-right: 22px; flex-wrap: wrap; gap: 10px; }
      .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
      .logo .betatag { font-size: 10px; font-weight: 800; color: var(--muted); background: #f3f4f6; border: 1px solid var(--line); padding: 2px 7px; border-radius: 999px; letter-spacing: 0.02em; }
      .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: #16181d; color: #fff; display: grid; place-items: center; font-size: 14px; }
      .navlinks { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
      .navlinks a.plain { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; }
      .navlinks a.plain:hover { color: var(--ink); }
      .navlinks a.plain.active { color: var(--ink); }
      a.btn { text-decoration: none; font-weight: 700; font-size: 14px; border-radius: 10px; padding: 10px 18px; background: var(--pink); color: #fff; white-space: nowrap; }
      a.btn:hover { background: var(--pink-dark); }
      main { padding: 34px 0 60px; }
      .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; align-items: start; }
      @media (max-width: 860px) { .layout { grid-template-columns: 1fr; gap: 30px; } }
      h1 { font-size: 30px; letter-spacing: -0.02em; margin: 0 0 8px; }
      .lede { color: var(--muted); font-size: 16px; margin: 0 0 28px; max-width: 60ch; }
      .themefilter { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 28px; }
      .themefilter button { border: 1px solid var(--line); background: #fff; color: var(--muted); font-size: 13px; font-weight: 600; padding: 7px 13px; border-radius: 999px; cursor: pointer; font-family: inherit; }
      .themefilter button:hover { border-color: #cbd0da; color: var(--ink); }
      .themefilter button.active { background: var(--ink); border-color: var(--ink); color: #fff; }
      .postlist { display: flex; flex-direction: column; gap: 12px; }
      .postcard {
        display: flex; align-items: flex-start; gap: 18px; text-decoration: none; color: inherit;
        padding: 20px 22px; border: 1px solid var(--line); border-radius: 14px; background: #fff;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
      }
      .postcard:hover { border-color: #cbd0da; box-shadow: 0 6px 20px rgba(20,20,40,0.07); transform: translateY(-1px); }
      .postcard .thumb { width: 160px; height: 90px; object-fit: cover; border-radius: 9px; border: 1px solid var(--line); flex-shrink: 0; }
      .postcard .body { min-width: 0; }
      @media (max-width: 560px) { .postcard { flex-direction: column; } .postcard .thumb { width: 100%; height: auto; aspect-ratio: 16 / 9; } }
      .posttheme { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #52525b; }
      .postcard h2 { font-size: 19px; margin: 7px 0 6px; letter-spacing: -0.01em; }
      .postcard p { color: var(--muted); font-size: 14.5px; margin: 0 0 10px; }
      .postmeta { font-size: 12.5px; color: var(--muted); }
      .sidebar-slot { position: sticky; top: 24px; }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 30px 0; border-top: 1px solid var(--line); margin-top: 30px; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <BlogTopNav active="blog" />
    <BlogSubNav />
    <main>
      <div class="wrap layout">
        <div>
          <h1>ASO &amp; App Ranking Guides</h1>
          <p class="lede">Practical, no-fluff writing on App Store Optimization, keyword research, and what actually moves your app's rank on Google Play and the App Store.</p>


          <div class="postlist" id="postlist">
            {posts.map((post) => (
              <a class="postcard" href={`/blog/${post.slug}`}>
                <img class="thumb" src={post.data.image} width="160" height="90" alt="" loading="lazy" />
                <div class="body">
                  <span class="posttheme">{post.data.theme}</span>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <span class="postmeta">{fmt(post.data.publishDate)} · {post.data.author}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="sidebar-slot">
          <BlogSidebar />
        </div>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
