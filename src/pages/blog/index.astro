---
// Static content (markdown, only changes on a new deploy) — prerendered so
// it's fast and reliably crawlable, independent of the Node server. Because
// this renders once at build time, request-scoped data like the logged-in
// user isn't available here (see rank.astro/aso.astro for pages that do
// need that) — the nav below always shows the logged-out CTAs, which is
// harmless: a logged-in visitor clicking "Log in" or "Start free trial"
// just gets redirected straight to /rank by those pages themselves.
export const prerender = true;
import { getCollection } from 'astro:content';
import { BRAND, ADSENSE_SLOTS } from '../../lib/saas/plans';
import AdSenseMeta from '../../components/AdSenseMeta.astro';
import AdSenseScript from '../../components/AdSenseScript.astro';
import AdSlot from '../../components/AdSlot.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const themes = [...new Set(posts.map((p) => p.data.theme))];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <AdSenseMeta />
    <AdSenseScript />
    <title>{BRAND} Blog — ASO &amp; App Ranking Guides</title>
    <meta name="description" content={`Practical, no-fluff guides on App Store Optimization, keyword research, and app ranking on Google Play and the App Store — from the team behind ${BRAND}.`} />
    <style>
      :root { --pink: #4338ca; --pink-dark: #372aa8; --ink: #16181d; --muted: #6b7280; --line: #e5e7eb; --bg: #f8f9fb; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #fff; color: var(--ink); line-height: 1.6; }
      .wrap { max-width: 860px; margin: 0 auto; padding: 0 22px; }
      header.top { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; max-width: 1080px; margin: 0 auto; padding-left: 22px; padding-right: 22px; flex-wrap: wrap; gap: 10px; }
      .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
      .logo .betatag { font-size: 10px; font-weight: 800; color: var(--pink-dark); background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25); padding: 2px 7px; border-radius: 999px; letter-spacing: 0.02em; }
      .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(120deg, #6366f1, #8b5cf6); color: #fff; display: grid; place-items: center; font-size: 14px; }
      .navlinks { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
      .navlinks a.plain { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; }
      .navlinks a.plain:hover { color: var(--ink); }
      .navlinks a.plain.active { color: var(--pink); }
      a.btn { text-decoration: none; font-weight: 700; font-size: 14px; border-radius: 10px; padding: 10px 18px; background: var(--pink); color: #fff; white-space: nowrap; }
      a.btn:hover { background: var(--pink-dark); }
      main { padding: 34px 0 60px; }
      h1 { font-size: 30px; letter-spacing: -0.02em; margin: 0 0 8px; }
      .lede { color: var(--muted); font-size: 16px; margin: 0 0 28px; max-width: 60ch; }
      .themefilter { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 28px; }
      .themefilter button { border: 1px solid var(--line); background: #fff; color: var(--muted); font-size: 13px; font-weight: 600; padding: 7px 13px; border-radius: 999px; cursor: pointer; font-family: inherit; }
      .themefilter button:hover { border-color: #cbd0da; color: var(--ink); }
      .themefilter button.active { background: var(--pink); border-color: var(--pink); color: #fff; }
      .postlist { display: flex; flex-direction: column; gap: 4px; }
      .postcard { display: block; text-decoration: none; color: inherit; padding: 20px 0; border-bottom: 1px solid var(--line); }
      .postcard:first-child { padding-top: 0; }
      .posttheme { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--pink-dark); }
      .postcard h2 { font-size: 20px; margin: 6px 0 6px; letter-spacing: -0.01em; }
      .postcard p { color: var(--muted); font-size: 14.5px; margin: 0 0 8px; }
      .postmeta { font-size: 12.5px; color: var(--muted); }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 30px 0; border-top: 1px solid var(--line); margin-top: 30px; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="logo" href="/"><span class="mark">▲</span>{BRAND}<span class="betatag">Beta 1.0</span></a>
      <div class="navlinks">
        <a class="plain active" href="/blog">Blog</a>
        <a class="plain" href="/about">About</a>
        <a class="btn" href="/signup">Start free trial</a>
      </div>
    </header>
    <main>
      <div class="wrap">
        <h1>ASO &amp; App Ranking Guides</h1>
        <p class="lede">Practical, no-fluff writing on App Store Optimization, keyword research, and what actually moves your app's rank on Google Play and the App Store.</p>

        <div class="themefilter" id="themefilter">
          <button class="active" data-theme="all">All</button>
          {themes.map((t) => <button data-theme={t}>{t}</button>)}
        </div>

        <div class="postlist" id="postlist">
          {posts.map((post) => (
            <a class="postcard" href={`/blog/${post.slug}`} data-theme={post.data.theme}>
              <span class="posttheme">{post.data.theme}</span>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="postmeta">{fmt(post.data.publishDate)} · {post.data.author}</span>
            </a>
          ))}
        </div>

        <AdSlot slot={ADSENSE_SLOTS.blog} />
      </div>
    </main>
    <footer>
      <div class="wrap">© {new Date().getFullYear()} {BRAND} · <a href="/">Home</a> · <a href="/about">About</a></div>
    </footer>
    <script>
      const buttons = document.querySelectorAll('#themefilter button');
      const cards = document.querySelectorAll('#postlist .postcard');
      buttons.forEach((btn) => btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const theme = btn.getAttribute('data-theme');
        cards.forEach((card) => {
          card.style.display = theme === 'all' || card.getAttribute('data-theme') === theme ? 'block' : 'none';
        });
      }));
    </script>
  </body>
</html>
