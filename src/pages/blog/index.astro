---
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const origin = Astro.site?.origin || new URL(Astro.request.url).origin;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'The AI Page Audit Blog',
  url: `${origin}/blog`,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${origin}/blog/${p.slug}`,
    datePublished: p.data.publishDate.toISOString(),
  })),
};
---
<Site
  schema={schema}
  title="AEO Blog — AI Page Audit"
  description="How to get cited by ChatGPT, Perplexity, Claude and Google AI Overviews. Practical AEO and GEO guides, not vague theory."
>
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow">The AEO blog</span>
      <h1>Answer Engine Optimization, explained plainly</h1>
      <p>How AI answer engines actually read, weigh and cite pages — and what to do about it. No vague theory, just what changes when you check it.</p>
    </div>
  </section>
  <main>
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="empty">No posts yet — check back soon.</p>
      ) : (
        <div class="postgrid">
          {posts.map((p) => (
            <a class="postcard" href={`/blog/${p.slug}`}>
              <div class="postmeta">
                <time datetime={p.data.publishDate.toISOString()}>
                  {p.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                {p.data.tags[0] && <span class="posttag">{p.data.tags[0]}</span>}
              </div>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <span class="t-go">Read →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>

  <style>
    .empty { color: var(--muted); font-size: 15px; }
    .postgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    @media (max-width: 720px) { .postgrid { grid-template-columns: 1fr; } }
    .postcard { display: block; border: 1px solid var(--line); border-radius: 16px; padding: 26px 24px; background: var(--card); text-decoration: none; transition: border-color .15s, transform .15s, box-shadow .15s; }
    .postcard:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow); }
    .postmeta { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
    .postmeta time { font-size: 12px; color: var(--faint); font-weight: 600; }
    .posttag { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; padding: 3px 9px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
    .postcard h2 { margin: 0 0 8px; font-size: 19px; font-weight: 800; letter-spacing: -.015em; color: var(--ink); line-height: 1.3; }
    .postcard p { margin: 0 0 14px; font-size: 14px; color: var(--muted); line-height: 1.6; }
    .t-go { font-size: 12.5px; font-weight: 700; color: var(--accent); }
  </style>
</Site>
