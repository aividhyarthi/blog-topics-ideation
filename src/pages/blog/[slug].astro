---
import Site from '../../layouts/Site.astro';
import { getCollection, getEntry } from 'astro:content';

const { slug } = Astro.params;
const entry = slug ? await getEntry('blog', slug) : undefined;
if (!entry || entry.data.draft) return Astro.redirect('/blog');
const { Content } = await entry.render();

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.slug !== entry.slug)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const origin = Astro.site?.origin || new URL(Astro.request.url).origin;
const url = `${origin}/blog/${entry.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      headline: entry.data.title,
      description: entry.data.description,
      datePublished: entry.data.publishDate.toISOString(),
      dateModified: (entry.data.updatedDate || entry.data.publishDate).toISOString(),
      author: { '@type': 'Person', name: entry.data.author },
      publisher: { '@id': `${origin}/#org` },
      mainEntityOfPage: url,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: origin },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${origin}/blog` },
        { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
      ],
    },
    ...(entry.data.faqs.length ? [{
      '@type': 'FAQPage',
      mainEntity: entry.data.faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }] : []),
  ],
};
---
<Site schema={schema} title={`${entry.data.title} — AI Page Audit`} description={entry.data.description}>
  <article class="post">
    <section class="pagehead posthead">
      <div class="wrap">
        <nav class="crumbs"><a href="/blog">Blog</a><span>/</span><span>{entry.data.tags[0] || 'AEO'}</span></nav>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.description}</p>
        <div class="bylinerow">
          <span>{entry.data.author}</span>
          <span class="dot">·</span>
          <time datetime={entry.data.publishDate.toISOString()}>
            {entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {entry.data.updatedDate && (
            <>
              <span class="dot">·</span>
              <span>Updated {entry.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </>
          )}
        </div>
      </div>
    </section>

    <main>
      <div class="wrap postlayout">
        <div class="prose">
          <Content />

          {entry.data.faqs.length > 0 && (
            <>
              <h2>FAQ</h2>
              {entry.data.faqs.map((f) => (
                <>
                  <h3>{f.q}</h3>
                  <p>{f.a}</p>
                </>
              ))}
            </>
          )}
        </div>

        <aside class="postside">
          <div class="ctacard">
            <b>See it on your own page</b>
            <p>Run a free AEO audit tool check and see exactly what ChatGPT, Perplexity, Claude and Google AI can read on your page.</p>
            <a class="btn-primary sm" href="/audit">Run a free audit →</a>
          </div>
          {related.length > 0 && (
            <div class="relcard">
              <b>More on AEO</b>
              {related.map((p) => <a href={`/blog/${p.slug}`}>{p.data.title}</a>)}
            </div>
          )}
        </aside>
      </div>
    </main>
  </article>

  <style>
    .posthead .wrap { padding: 40px 24px 34px; }
    .crumbs { font-size: 12.5px; color: var(--muted); margin-bottom: 14px; display: flex; gap: 8px; align-items: center; }
    .crumbs a { color: var(--muted); text-decoration: none; }
    .crumbs a:hover { color: var(--accent); }
    .bylinerow { margin-top: 16px; font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
    .bylinerow .dot { color: var(--faint); }

    .postlayout { display: grid; grid-template-columns: 1fr 280px; gap: 40px; align-items: start; }
    @media (max-width: 820px) { .postlayout { grid-template-columns: 1fr; } }

    .postside { display: grid; gap: 18px; position: sticky; top: 90px; }
    .ctacard { border: 1px solid var(--accent-line); background: var(--accent-soft); border-radius: 14px; padding: 20px; }
    .ctacard b { font-size: 14.5px; display: block; margin-bottom: 8px; }
    .ctacard p { font-size: 13px; color: var(--ink-2); line-height: 1.6; margin: 0 0 14px; }
    .relcard { border: 1px solid var(--line); background: #fff; border-radius: 14px; padding: 18px 20px; }
    .relcard b { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); display: block; margin-bottom: 10px; }
    .relcard a { display: block; padding: 9px 0; border-top: 1px solid var(--line); font-size: 13.5px; font-weight: 600; color: var(--ink); text-decoration: none; }
    .relcard a:first-of-type { border-top: none; }
    .relcard a:hover { color: var(--accent); }
  </style>

  <!-- Content rendered via <Content /> comes from a separate markdown
       collection entry, not this component's own template — Astro's scoped
       styles only stamp a data-astro-cid attribute onto elements written
       directly in a .astro file, so a normal scoped <style> block silently
       fails to match any of it (headings, tables, everything). Has to be
       global, deliberately scoped by the .prose class prefix instead. -->
  <style is:global>
    .prose { font-size: 16px; line-height: 1.75; color: var(--ink-2); max-width: 68ch; }
    .prose h2 { font-size: 26px; font-weight: 800; letter-spacing: -.02em; color: var(--ink); margin: 44px 0 16px; }
    .prose h3 { font-size: 19px; font-weight: 700; letter-spacing: -.01em; color: var(--ink); margin: 30px 0 12px; }
    .prose p { margin: 0 0 18px; }
    .prose ul, .prose ol { margin: 0 0 18px; padding-left: 22px; }
    .prose li { margin-bottom: 8px; }
    .prose strong { color: var(--ink); font-weight: 700; }
    .prose code { background: #f1f5f9; padding: 1px 6px; border-radius: 5px; font-size: 14px; }
    .prose pre { background: var(--ink-900); color: #e2e8f0; padding: 16px 18px; border-radius: 12px; overflow-x: auto; font-size: 13.5px; }
    .prose pre code { background: none; padding: 0; }
    .prose blockquote { margin: 0 0 18px; padding: 4px 20px; border-left: 3px solid var(--accent-line); color: var(--muted); font-style: italic; }
    .prose a { color: var(--accent-dark); text-decoration: underline; text-underline-offset: 2px; }
    .prose table { width: 100%; border-collapse: collapse; margin: 0 0 22px; font-size: 14.5px; }
    .prose th, .prose td { border: 1px solid var(--line); padding: 9px 13px; text-align: left; }
    .prose th { background: var(--accent-soft); font-weight: 700; color: var(--ink); }
    .prose tr:nth-child(even) td { background: #fafafa; }

    /* Quick-answer / key-takeaway highlight box — a raw HTML block dropped
       directly into the markdown source (Astro passes inline HTML through
       untouched). Gives the direct-answer-first structure this tool itself
       checks for a visible, scannable home on the page, not just prose. */
    .prose .callout { border: 1px solid var(--accent-line); background: var(--accent-soft); border-radius: 14px; padding: 18px 22px; margin: 0 0 26px; }
    .prose .callout p:last-child { margin-bottom: 0; }
    .prose .callout-label { display: block; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--accent); margin-bottom: 8px; }
    .prose .stat { font-weight: 800; color: var(--ink); }
  </style>
</Site>
