---
// Static content, prerendered — see the same note in blog/index.astro
// about why the nav below doesn't depend on Astro.locals.user here.
export const prerender = true;
import { getCollection } from 'astro:content';
import { BRAND, SITE_URL } from '../../lib/saas/plans';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import AdSenseMeta from '../../components/AdSenseMeta.astro';
import AdSenseScript from '../../components/AdSenseScript.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, allPosts: posts } }));
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const recentPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5)
  .map((p) => ({ slug: p.slug, title: p.data.title }));

const canonicalUrl = `${SITE_URL}/blog/${post.slug}`;
const faqs = post.data.faqs || [];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: post.data.publishDate.toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: BRAND },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
};

const faqJsonLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <AdSenseMeta />
    <AdSenseScript />
    <title>{post.data.title} — {BRAND} Blog</title>
    <meta name="description" content={post.data.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="article:published_time" content={post.data.publishDate.toISOString()} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={post.data.title} />
    <meta name="twitter:description" content={post.data.description} />
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    <style>
      :root { --pink: #4338ca; --pink-dark: #372aa8; --ink: #16181d; --muted: #6b7280; --line: #e5e7eb; --bg: #f8f9fb; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #fff; color: var(--ink); line-height: 1.7; }
      .wrap { max-width: 1160px; margin: 0 auto; padding: 0 22px; }
      header.top { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; max-width: 1160px; margin: 0 auto; padding-left: 22px; padding-right: 22px; flex-wrap: wrap; gap: 10px; }
      .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
      .logo .betatag { font-size: 10px; font-weight: 800; color: var(--pink-dark); background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25); padding: 2px 7px; border-radius: 999px; letter-spacing: 0.02em; }
      .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(120deg, #6366f1, #8b5cf6); color: #fff; display: grid; place-items: center; font-size: 14px; }
      .navlinks { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
      .navlinks a.plain { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; }
      .navlinks a.plain:hover { color: var(--ink); }
      a.btn { text-decoration: none; font-weight: 700; font-size: 14px; border-radius: 10px; padding: 10px 18px; background: var(--pink); color: #fff; white-space: nowrap; }
      a.btn:hover { background: var(--pink-dark); }
      main { padding: 34px 0 60px; }
      .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; align-items: start; }
      @media (max-width: 860px) { .layout { grid-template-columns: 1fr; gap: 30px; } }
      .backlink { display: inline-block; color: var(--muted); text-decoration: none; font-size: 13.5px; font-weight: 600; margin-bottom: 18px; }
      .backlink:hover { color: var(--ink); }
      .posttheme { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--pink-dark); }
      h1 { font-size: 30px; letter-spacing: -0.02em; margin: 8px 0 8px; line-height: 1.25; }
      .postmeta { font-size: 13px; color: var(--muted); margin-bottom: 30px; }
      article :global(h2) { font-size: 20px; letter-spacing: -0.01em; margin: 34px 0 12px; color: var(--ink); }
      article :global(p) { color: #2b2f38; font-size: 16px; margin: 0 0 16px; }
      article :global(strong) { color: var(--ink); }
      article :global(ul), article :global(ol) { color: #2b2f38; font-size: 16px; margin: 0 0 16px; padding-left: 22px; }
      article :global(li) { margin: 0 0 8px; }
      article :global(a) { color: var(--pink-dark); }
      article :global(table) { width: 100%; border-collapse: collapse; margin: 4px 0 22px; font-size: 14.5px; }
      article :global(th), article :global(td) { text-align: left; padding: 10px 14px 10px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
      article :global(thead th) { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); border-bottom: 2px solid var(--ink); }
      article :global(tbody tr:last-child td) { border-bottom: none; }
      article :global(blockquote) { margin: 0 0 20px; padding: 14px 18px; background: #f5f4ff; border-left: 4px solid var(--pink); border-radius: 0 8px 8px 0; }
      article :global(blockquote p) { margin: 0 0 8px; font-size: 15px; }
      article :global(blockquote p:last-child) { margin-bottom: 0; }
      .faq-block { margin-top: 38px; padding-top: 6px; border-top: 1px solid var(--line); }
      .faq-block h2 { font-size: 20px; letter-spacing: -0.01em; margin: 28px 0 14px; }
      .faq-item { margin: 0 0 18px; }
      .faq-q { font-weight: 700; font-size: 15.5px; margin-bottom: 6px; }
      .faq-a { color: #2b2f38; font-size: 15px; margin: 0; }
      .sidebar-slot { position: sticky; top: 24px; }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 30px 0; border-top: 1px solid var(--line); margin-top: 30px; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="logo" href="/"><span class="mark">▲</span>{BRAND}<span class="betatag">Beta 1.0</span></a>
      <div class="navlinks">
        <a class="plain" href="/blog">Blog</a>
        <a class="plain" href="/about">About</a>
        <a class="btn" href="/signup">Start free trial</a>
      </div>
    </header>
    <main>
      <div class="wrap layout">
        <div>
          <a class="backlink" href="/blog">← All articles</a>
          <span class="posttheme">{post.data.theme}</span>
          <h1>{post.data.title}</h1>
          <div class="postmeta">{fmt(post.data.publishDate)} · {post.data.author}</div>
          <article><Content /></article>

          {faqs.length > 0 && (
            <div class="faq-block">
              <h2>Frequently asked questions</h2>
              {faqs.map((f) => (
                <div class="faq-item">
                  <div class="faq-q">{f.question}</div>
                  <div class="faq-a">{f.answer}</div>
                </div>
              ))}
            </div>
          )}
        </div>

        <div class="sidebar-slot">
          <BlogSidebar recentPosts={recentPosts} />
        </div>
      </div>
    </main>
    <footer>
      <div class="wrap">© {new Date().getFullYear()} {BRAND} · <a href="/blog">Blog</a> · <a href="/">Home</a></div>
    </footer>
  </body>
</html>
