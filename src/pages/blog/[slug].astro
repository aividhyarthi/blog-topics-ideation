---
import Site from '../../layouts/Site.astro';
import { marked } from 'marked';
import { getPostBySlug, listPublishedPosts } from '../../lib/blogPosts';
import { injectCharts } from '../../lib/blogCharts';

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;
if (!post) return Astro.redirect('/blog');

// FAQ text and the source label/URL are concatenated as raw HTML below
// (set:html on .prose bypasses Astro's normal auto-escaping), so they're
// escaped explicitly here — defense in depth, since FAQ text for
// auto-generated posts comes from an unreviewed LLM call.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

let bodyHtml = injectCharts(await marked.parse(post.bodyMarkdown), post.charts);
if (post.faqs.length > 0) {
  bodyHtml += '<h2>FAQ</h2>' + post.faqs.map((f) => `<h3>${esc(f.q)}</h3><p>${esc(f.a)}</p>`).join('');
}
if (post.sourceUrl) {
  const label = esc(post.sourceLabel || post.sourceUrl);
  bodyHtml += `<p class="postsource">Source: <a href="${esc(post.sourceUrl)}" rel="noopener nofollow" target="_blank">${label}</a></p>`;
}

const allPosts = await listPublishedPosts();
const related = allPosts.filter((p) => p.slug !== post.slug).slice(0, 3);

const origin = Astro.site?.origin || new URL(Astro.request.url).origin;
const url = `${origin}/blog/${post.slug}`;
// A data: URI (the SVG cover auto-generated posts get — see blogCover.ts)
// can't be used as og:image: link-preview crawlers (WhatsApp, Twitter) fetch
// an absolute http(s) URL, not an inline data URI, and don't reliably
// render SVG for previews anyway. Fall back to the branded default PNG for
// those; only a real hosted image path becomes the share image.
const hasHostedImage = Boolean(post.image) && !post.image!.startsWith('data:');
const absoluteImage = hasHostedImage ? `${origin}${post.image}` : `${origin}/og-image.png`;

// Deliberately qualitative, not invented market-size statistics we can't
// verify or source: each of these describes documented crawler/schema
// behavior, not a number that needs a citation we don't actually have.
const LLM_STATS = [
  'GPTBot, ClaudeBot, PerplexityBot and OAI-SearchBot do not execute JavaScript, unlike Googlebot, which renders a page fully before indexing it.',
  'A generated AI answer can fully satisfy the reader\'s question, so a page can be cited by name without ever receiving a click.',
  'Structured data like FAQPage, Review and ClaimReview schema lets a model quote a fact directly instead of having to infer it from prose.',
];

const publishDate = new Date(post.publishDate);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      headline: post.title,
      description: post.description,
      image: absoluteImage,
      datePublished: publishDate.toISOString(),
      dateModified: publishDate.toISOString(),
      author: { '@type': 'Person', name: post.author },
      publisher: { '@id': `${origin}/#org` },
      mainEntityOfPage: url,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: origin },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${origin}/blog` },
        { '@type': 'ListItem', position: 3, name: post.title, item: url },
      ],
    },
    ...(post.faqs.length ? [{
      '@type': 'FAQPage',
      mainEntity: post.faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }] : []),
    ...(post.sourceUrl ? [{
      '@type': 'CreativeWork',
      '@id': `${url}#source`,
      name: post.sourceLabel || 'Source',
      url: post.sourceUrl,
    }] : []),
  ],
};
---
<Site schema={schema} title={`${post.title} | AI Page Audit`} description={post.description} ogImage={absoluteImage} ogType="article">
  <article class="post">
    <section class="pagehead posthead">
      <div class="wrap">
        <nav class="crumbs"><a href="/blog">Blog</a><span>/</span><span>{post.tags[0] || 'AEO'}</span></nav>
        <h1>{post.title}</h1>
        <p>{post.description}</p>
        <div class="bylinerow">
          <span>{post.author}</span>
          <span class="dot">·</span>
          <time datetime={publishDate.toISOString()}>
            {publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
    </section>

    {post.image && (
      <div class="wrap postcoverwrap">
        <img class="postcover" src={post.image} alt={post.title} width="1200" height="630" />
      </div>
    )}

    <main>
      <div class="wrap postlayout">
        <div class="prose" set:html={bodyHtml} />

        <aside class="postside">
          <div class="ctacard">
            <b>See it on your own page</b>
            <p>Run a free AEO audit tool check and see exactly what ChatGPT, Perplexity, Claude and Google AI can read on your page.</p>
            <a class="btn-primary sm" href="/audit">Run a free audit →</a>
          </div>
          <div class="statcard">
            <b>Why this matters</b>
            <ul>
              {LLM_STATS.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          {related.length > 0 && (
            <div class="relcard">
              <b>More on AEO</b>
              {related.map((p) => <a href={`/blog/${p.slug}`}>{p.title}</a>)}
            </div>
          )}
        </aside>
      </div>
    </main>
  </article>

  <style>
    .posthead .wrap { padding: 40px 24px 34px; }
    .crumbs { font-size: 12.5px; color: var(--muted); margin-bottom: 14px; display: flex; gap: 8px; align-items: center; }
    .crumbs a { color: var(--muted); text-decoration: none; }
    .crumbs a:hover { color: var(--accent); }
    .bylinerow { margin-top: 16px; font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
    .bylinerow .dot { color: var(--faint); }

    .postlayout { display: grid; grid-template-columns: 1fr 280px; gap: 40px; align-items: start; }
    @media (max-width: 820px) { .postlayout { grid-template-columns: 1fr; } }

    .postside { display: grid; gap: 18px; position: sticky; top: 90px; }
    .ctacard { border: 1px solid var(--accent-line); background: var(--accent-soft); border-radius: 14px; padding: 20px; }
    .ctacard b { font-size: 14.5px; display: block; margin-bottom: 8px; }
    .ctacard p { font-size: 13px; color: var(--ink-2); line-height: 1.6; margin: 0 0 14px; }
    .relcard { border: 1px solid var(--line); background: #fff; border-radius: 14px; padding: 18px 20px; }
    .relcard b { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); display: block; margin-bottom: 10px; }
    .relcard a { display: block; padding: 9px 0; border-top: 1px solid var(--line); font-size: 13.5px; font-weight: 600; color: var(--ink); text-decoration: none; }
    .relcard a:first-of-type { border-top: none; }
    .relcard a:hover { color: var(--accent); }
    .statcard { border: 1px solid var(--line); background: #fff; border-radius: 14px; padding: 18px 20px; }
    .statcard b { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); display: block; margin-bottom: 12px; }
    .statcard ul { margin: 0; padding-left: 18px; }
    .statcard li { font-size: 12.5px; color: var(--ink-2); line-height: 1.6; margin-bottom: 10px; }
    .statcard li:last-child { margin-bottom: 0; }

    .postcoverwrap { padding: 0 24px 34px; max-width: 900px; margin: 0 auto; }
    .postcover { width: 100%; height: auto; border-radius: 16px; display: block; }
    .postsource { font-size: 12.5px; color: var(--faint); margin-top: 24px; }
    .postsource a { color: var(--muted); }
  </style>

  <!-- bodyHtml comes from marked() rendering our own DB-stored markdown, not
       a .astro-template element, so scoped styles never attach to it —
       same reason this had to be is:global back when it came from Astro's
       content-collection <Content />. Scoped by the .prose class prefix. -->
  <style is:global>
    .prose { font-size: 16px; line-height: 1.75; color: var(--ink-2); max-width: 68ch; }
    .prose h2 { font-size: 26px; font-weight: 800; letter-spacing: -.02em; color: var(--ink); margin: 44px 0 16px; }
    .prose h3 { font-size: 19px; font-weight: 700; letter-spacing: -.01em; color: var(--ink); margin: 30px 0 12px; }
    .prose p { margin: 0 0 18px; }
    .prose ul, .prose ol { margin: 0 0 18px; padding-left: 22px; }
    .prose li { margin-bottom: 8px; }
    .prose strong { color: var(--ink); font-weight: 700; }
    .prose code { background: #f1f5f9; padding: 1px 6px; border-radius: 5px; font-size: 14px; }
    .prose pre { background: var(--ink-900); color: #e2e8f0; padding: 16px 18px; border-radius: 12px; overflow-x: auto; font-size: 13.5px; }
    .prose pre code { background: none; padding: 0; }
    .prose blockquote { margin: 0 0 18px; padding: 4px 20px; border-left: 3px solid var(--accent-line); color: var(--muted); font-style: italic; }
    .prose a { color: var(--accent-dark); text-decoration: underline; text-underline-offset: 2px; }
    .prose table { width: 100%; border-collapse: collapse; margin: 0 0 22px; font-size: 14.5px; }
    .prose th, .prose td { border: 1px solid var(--line); padding: 9px 13px; text-align: left; }
    .prose th { background: var(--accent-soft); font-weight: 700; color: var(--ink); }
    .prose tr:nth-child(even) td { background: #fafafa; }

    /* Quick-answer / key-takeaway highlight box — a raw HTML block dropped
       directly into the markdown source (marked passes inline HTML through
       untouched). Gives the direct-answer-first structure this tool itself
       checks for a visible, scannable home on the page, not just prose. */
    .prose .callout { border: 1px solid var(--accent-line); background: var(--accent-soft); border-radius: 14px; padding: 18px 22px; margin: 0 0 26px; }
    .prose .callout p:last-child { margin-bottom: 0; }
    .prose .callout-label { display: block; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--accent); margin-bottom: 8px; }
    .prose .stat { font-weight: 800; color: var(--ink); }

    /* Inline chart figures — see blogCharts.ts. */
    .prose .postchart { border: 1px solid var(--line); border-radius: 14px; background: #fafafa; padding: 20px 22px 16px; margin: 8px 0 28px; }
    .prose .postchart-title { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin-bottom: 14px; }
    .prose .postchart-svg { display: flex; justify-content: center; }
    .prose .postchart figcaption { margin-top: 12px; font-size: 12px; color: var(--faint); text-align: center; }
  </style>
</Site>
