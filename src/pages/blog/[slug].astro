---
// Static content, prerendered — see the same note in blog/index.astro
// about why the nav below doesn't depend on Astro.locals.user here.
export const prerender = true;
import { getCollection } from 'astro:content';
import { BRAND, ADSENSE_SLOTS } from '../../lib/saas/plans';
import AdSenseMeta from '../../components/AdSenseMeta.astro';
import AdSenseScript from '../../components/AdSenseScript.astro';
import AdSlot from '../../components/AdSlot.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <AdSenseMeta />
    <AdSenseScript />
    <title>{post.data.title} — {BRAND} Blog</title>
    <meta name="description" content={post.data.description} />
    <style>
      :root { --pink: #4338ca; --pink-dark: #372aa8; --ink: #16181d; --muted: #6b7280; --line: #e5e7eb; --bg: #f8f9fb; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #fff; color: var(--ink); line-height: 1.7; }
      .wrap { max-width: 680px; margin: 0 auto; padding: 0 22px; }
      header.top { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; max-width: 1080px; margin: 0 auto; padding-left: 22px; padding-right: 22px; flex-wrap: wrap; gap: 10px; }
      .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
      .logo .betatag { font-size: 10px; font-weight: 800; color: var(--pink-dark); background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25); padding: 2px 7px; border-radius: 999px; letter-spacing: 0.02em; }
      .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(120deg, #6366f1, #8b5cf6); color: #fff; display: grid; place-items: center; font-size: 14px; }
      .navlinks { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
      .navlinks a.plain { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; }
      .navlinks a.plain:hover { color: var(--ink); }
      a.btn { text-decoration: none; font-weight: 700; font-size: 14px; border-radius: 10px; padding: 10px 18px; background: var(--pink); color: #fff; white-space: nowrap; }
      a.btn:hover { background: var(--pink-dark); }
      main { padding: 34px 0 60px; }
      .backlink { display: inline-block; color: var(--muted); text-decoration: none; font-size: 13.5px; font-weight: 600; margin-bottom: 18px; }
      .backlink:hover { color: var(--ink); }
      .posttheme { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--pink-dark); }
      h1 { font-size: 30px; letter-spacing: -0.02em; margin: 8px 0 8px; line-height: 1.25; }
      .postmeta { font-size: 13px; color: var(--muted); margin-bottom: 30px; }
      article :global(h2) { font-size: 20px; letter-spacing: -0.01em; margin: 34px 0 12px; color: var(--ink); }
      article :global(p) { color: #2b2f38; font-size: 16px; margin: 0 0 16px; }
      article :global(strong) { color: var(--ink); }
      article :global(ul), article :global(ol) { color: #2b2f38; font-size: 16px; margin: 0 0 16px; padding-left: 22px; }
      article :global(li) { margin: 0 0 8px; }
      article :global(a) { color: var(--pink-dark); }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 30px 0; border-top: 1px solid var(--line); margin-top: 30px; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="logo" href="/"><span class="mark">▲</span>{BRAND}<span class="betatag">Beta 1.0</span></a>
      <div class="navlinks">
        <a class="plain" href="/blog">Blog</a>
        <a class="plain" href="/about">About</a>
        <a class="btn" href="/signup">Start free trial</a>
      </div>
    </header>
    <main>
      <div class="wrap">
        <a class="backlink" href="/blog">← All articles</a>
        <span class="posttheme">{post.data.theme}</span>
        <h1>{post.data.title}</h1>
        <div class="postmeta">{fmt(post.data.publishDate)} · {post.data.author}</div>
        <article><Content /></article>
        <AdSlot slot={ADSENSE_SLOTS.blog} />
      </div>
    </main>
    <footer>
      <div class="wrap">© {new Date().getFullYear()} {BRAND} · <a href="/blog">Blog</a> · <a href="/">Home</a></div>
    </footer>
  </body>
</html>
