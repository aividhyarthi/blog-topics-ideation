---
// AppRankr landing page — served at "/" in product mode (middleware rewrite).
import { BRAND, PLANS, TRIAL_DAYS, CURRENCY, formatPrice, SITE_URL } from '../lib/saas/plans';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import AdSenseMeta from '../components/AdSenseMeta.astro';
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
const user = Astro.locals.user;

const pageTitle = `${BRAND} — App Rank Tracker & ASO Tool for Google Play + App Store`;
const pageDescription = `${BRAND} is an ASO tool that tracks your app's keyword rank on Google Play and the App Store, finds every keyword you already rank for, and audits your store listing. ${TRIAL_DAYS}-day free trial, no card required.`;

const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: BRAND,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: pageDescription,
  offers: [PLANS.starter, PLANS.pro].map((p) => ({
    '@type': 'Offer',
    name: p.name,
    price: p.priceMonthly,
    priceCurrency: 'INR',
    description: p.blurb,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <AdSenseMeta />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={SITE_URL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={SITE_URL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} />
    <style>
      :root { --pink: #ff5a1f; --pink-dark: #e0480d; --ink: #16181d; --muted: #6b7280; --line: #e5e7eb; --bg: #f8f9fb; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #fff; color: var(--ink); line-height: 1.55; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 22px; }
      header.top { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; flex-wrap: wrap; gap: 10px; }
      .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; }
      .logo .betatag { font-size: 10px; font-weight: 800; color: var(--muted); background: #f3f4f6; border: 1px solid var(--line); padding: 2px 7px; border-radius: 999px; letter-spacing: 0.02em; }
      .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(120deg, #ff7a45, #ff5a1f); color: #fff; display: grid; place-items: center; font-size: 14px; }
      .navlinks { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
      a.btn { text-decoration: none; font-weight: 700; font-size: 14px; border-radius: 10px; padding: 10px 18px; white-space: nowrap; }
      @media (max-width: 420px) {
        .navlinks { gap: 6px; }
        .navlinks a.btn { padding: 9px 12px; font-size: 13px; }
      }
      a.btn.primary { background: var(--pink); color: #fff; }
      a.btn.primary:hover { background: var(--pink-dark); }
      a.btn.ghost { color: var(--ink); border: 1px solid var(--line); }
      a.btn.ghost:hover { border-color: var(--ink); color: var(--ink); }
      .hero { padding: 64px 0 30px; text-align: center; }
      .hero h1 { font-size: 42px; letter-spacing: -0.03em; margin: 0 auto 14px; max-width: 760px; line-height: 1.15; }
      .hero h1 em { font-style: normal; color: var(--ink); text-decoration: underline; text-decoration-color: var(--line); text-decoration-thickness: 3px; text-underline-offset: 7px; }
      .hero p { font-size: 17px; color: var(--muted); max-width: 640px; margin: 0 auto 26px; }
      .trialnote { font-size: 13px; color: var(--muted); margin-top: 10px; }
      .trustbar { padding: 8px 0 40px; text-align: center; }
      .trustbar .label { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 0 0 18px; }
      .trustbar .logos { display: flex; align-items: center; justify-content: center; gap: 40px; flex-wrap: wrap; }
      .trustbar .logos img { height: 30px; max-width: 130px; object-fit: contain; filter: grayscale(1); opacity: 0.55; transition: opacity 0.15s, filter 0.15s; }
      .trustbar .logos img:hover { filter: grayscale(0); opacity: 1; }
      @media (max-width: 560px) { .trustbar .logos { gap: 26px; } .trustbar .logos img { height: 24px; max-width: 100px; } }
      .band { background: var(--bg); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 46px 0; margin-top: 50px; }
      .feats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
      @media (max-width: 840px) { .feats { grid-template-columns: 1fr; } .hero h1 { font-size: 32px; } }
      .feat { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 20px; }
      .feat .ico { width: 42px; height: 42px; border-radius: 10px; background: #f3f4f6; color: var(--ink); display: grid; place-items: center; }
      .feat h3 { margin: 8px 0 6px; font-size: 16px; }
      .feat p { margin: 0; font-size: 13.5px; color: var(--muted); }
      .pricing { padding: 56px 0 30px; text-align: center; }
      .pricing h2 { font-size: 28px; letter-spacing: -0.02em; margin: 0 0 6px; }
      .pricing .sub { color: var(--muted); margin: 0 0 26px; }
      .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 330px)); gap: 16px; justify-content: center; }
      @media (max-width: 760px) { .cards { grid-template-columns: 1fr; } }
      .plan { border: 1px solid var(--line); border-radius: 16px; padding: 24px; text-align: left; }
      .plan.hot { border-color: var(--ink); box-shadow: 0 4px 24px rgba(0,0,0,0.08); position: relative; }
      .plan.hot .tag { position: absolute; top: -11px; right: 18px; background: var(--ink); color: #fff; font-size: 11px; font-weight: 800; padding: 3px 10px; border-radius: 999px; }
      .plan h3 { margin: 0; font-size: 17px; }
      .plan .price { font-size: 34px; font-weight: 800; margin: 8px 0 2px; }
      .plan .price span { font-size: 14px; font-weight: 600; color: var(--muted); }
      .plan .blurb { color: var(--muted); font-size: 13.5px; margin: 0 0 14px; }
      .plan ul { list-style: none; padding: 0; margin: 0 0 18px; font-size: 13.5px; }
      .plan li { padding: 4px 0; }
      .plan li::before { content: '✓  '; color: var(--ink); font-weight: 800; }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 36px 0 30px; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <div class="logo"><span class="mark">▲</span>{BRAND}<span class="betatag">Beta 1.0</span></div>
        <div class="navlinks">
          <a class="btn ghost" href="#pricing">Pricing</a>
          <a class="btn ghost" href="/blog">Blog</a>
          <a class="btn ghost" href="/about">About</a>
          {user
            ? <a class="btn primary" href="/rank">Open dashboard</a>
            : <><a class="btn ghost" href="/login">Log in</a><a class="btn primary" href="/signup">Start free trial</a></>}
        </div>
      </header>

      <section class="hero">
        <h1>Know exactly where your app ranks — <em>every keyword, every day</em></h1>
        <p>
          {BRAND} is an app rank tracker and ASO (App Store Optimization) tool in one: track your
          app's position in Google Play and App Store search for the keywords that matter, discover
          the keywords you already rank for, and audit your store listing — two tools, one subscription.
        </p>
        <a class="btn primary" href="/signup" style="font-size:16px;padding:13px 26px;">Start your {TRIAL_DAYS}-day free trial</a>
        <div class="trialnote">Full access for {TRIAL_DAYS} days · no card needed to start</div>
      </section>

      <section class="trustbar" id="trustbar">
        <p class="label">Trusted by teams at</p>
        <div class="logos">
          <img src="https://images.yourstory.com/cs/images/companies/logosC2031575978376942png" alt="CRED" loading="lazy" onerror="this.style.display='none'" />
          <img src="https://static.toiimg.com/thumb/msid-95254840,imgsize-87273,width-400,resizemode-4/95254840.jpg" alt="Times of India" loading="lazy" onerror="this.style.display='none'" />
          <img src="https://i0.wp.com/premom.in/wp-content/uploads/2026/03/premom-logo-1920x1080-1.png?resize=600%2C338&ssl=1" alt="PreMom India" loading="lazy" onerror="this.style.display='none'" />
          <img src="https://play-lh.googleusercontent.com/ApJ4Qv86goaDayg53TXS9X9L2PjS1uR4JUkJg4LxVgOeK6is-qXOAzTCE7VNCIP-2RVMwGc_6ZI28uCTEC8eQw" alt="Kuvera India" loading="lazy" onerror="this.style.display='none'" />
        </div>
      </section>
    </div>

    <div class="band">
      <div class="wrap">
        <div class="feats">
          <div class="feat"><div class="ico"><Icon name="trending" size={22} /></div><h3>Rank Tracker</h3>
            <p>Daily position, movement vs yesterday, best-ever rank and a trend for every keyword — plus Top 1/10/30/100 counts, a search visibility score, top-chart position, and one-click keyword discovery (finds every keyword you already rank for in the top 200).</p></div>
          <div class="feat"><div class="ico"><Icon name="search" size={22} /></div><h3>ASO Inspector</h3>
            <p>Paste a Google Play listing and get an ASO score, keyword coverage, competitor comparison, and AI-rewritten title/description copy — all from the live listing.</p></div>
          <div class="feat"><div class="ico"><Icon name="radar" size={22} /></div><h3>Competitor watch</h3>
            <p>Track rival apps on the same keywords in Rank Tracker, see who holds #1 for each term, and compare listings side by side in ASO Inspector.</p></div>
        </div>
      </div>
    </div>

    <div class="wrap">
      <section class="pricing" id="pricing">
        <h2>Simple pricing</h2>
        <p class="sub">Every plan starts with a {TRIAL_DAYS}-day free trial. Pay by UPI — scan, tap, or WhatsApp us. Cancel anytime.</p>
        <div class="cards">
          <div class="plan">
            <h3>{PLANS.starter.name}</h3>
            <div class="price">{CURRENCY}{formatPrice(PLANS.starter.priceMonthly)}<span>/month</span></div>
            <p class="blurb">{PLANS.starter.blurb}</p>
            <ul>
              <li>{PLANS.starter.maxApps} apps (yours or competitors')</li>
              <li>{PLANS.starter.maxKeywordsPerApp} keywords per app</li>
              <li>Google Play + Apple App Store</li>
              <li>Daily automatic rank checks</li>
              <li>Keyword discovery</li>
              <li>ASO Inspector (listing audit + AI rewrites)</li>
            </ul>
            <a class="btn primary" href="/signup" style="display:block;text-align:center;">Start free trial</a>
          </div>
          <div class="plan hot">
            <span class="tag">MOST POPULAR</span>
            <h3>{PLANS.pro.name}</h3>
            <div class="price">{CURRENCY}{formatPrice(PLANS.pro.priceMonthly)}<span>/month</span></div>
            <p class="blurb">{PLANS.pro.blurb}</p>
            <ul>
              <li>{PLANS.pro.maxApps} apps (yours or competitors')</li>
              <li>{PLANS.pro.maxKeywordsPerApp} keywords per app</li>
              <li>Google Play + Apple App Store</li>
              <li>Daily automatic rank checks</li>
              <li>Keyword discovery</li>
              <li>CSV export</li>
            </ul>
            <a class="btn primary" href="/signup" style="display:block;text-align:center;">Start free trial</a>
          </div>
        </div>
      </section>
    </div>

    <SiteFooter />
  </body>
</html>
