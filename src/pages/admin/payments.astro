---
import Site from '../../layouts/Site.astro';
---
<Site title="Payments — Admin — AI Page Audit" description="Review and approve UPI payment claims.">
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow">Admin</span>
      <h1>UPI payment claims</h1>
      <p>Approve a claim to activate 30 days of Pro on the matching AI Page Audit account (extends if already active).</p>
    </div>
  </section>
  <main>
    <div class="wrap">
      <div class="trialcard">
        <b>Grant a free trial</b>
        <p>Activate Pro on an existing account for a fixed number of days — no payment claim needed. Use this for a client's own team getting a trial of the whole tool. Extends from the current expiry if the account already has active Pro.</p>
        <div class="trialrow">
          <input type="email" id="trial-email" placeholder="person@client.com" />
          <input type="number" id="trial-days" value="7" min="1" style="width:80px" />
          <button class="btn-primary sm" id="trial-go">Grant trial</button>
        </div>
        <p class="trialnote" id="trial-note"></p>
      </div>
      <div class="dcard">
        <div class="dcard-head"><b>Blog auto-publish</b><span id="bloggen-status" class="muted"></span></div>
        <p class="dcard-lead">Sources a topic from Reddit r/AEO and official AI-provider news, drafts a post with Claude and publishes it immediately. Runs automatically 5x/day (2h apart); use this to fire one cycle right now.</p>
        <button class="btn-primary sm" id="bloggen-go">Generate now</button>
        <p class="trialnote" id="bloggen-note"></p>
        <div id="bloggen-runs" style="margin-top:14px"></div>
      </div>
      <div class="dcard">
        <div class="dcard-head"><b>Publish a post manually</b></div>
        <p class="dcard-lead">Paste in an already-written post (no Anthropic/OpenAI call, no cost) — for whenever a post is drafted directly instead of sourced by the pipeline above.</p>
        <div class="pubform">
          <input type="text" id="pub-title" placeholder="Title" />
          <input type="text" id="pub-desc" placeholder="Meta description (1-2 sentences)" />
          <input type="text" id="pub-tags" placeholder="Tags, comma-separated (e.g. AEO, Guide)" />
          <textarea id="pub-body" rows="14" placeholder="Full post body in Markdown. Start with:&#10;&lt;div class=&quot;callout&quot;&gt;&lt;span class=&quot;callout-label&quot;&gt;Quick answer&lt;/span&gt;&lt;p&gt;...&lt;/p&gt;&lt;/div&gt;&#10;&#10;Then ## headings, tables, etc."></textarea>
          <textarea id="pub-faqs" rows="4" placeholder='Optional: FAQs as JSON, e.g. [{"q":"...","a":"..."}]'></textarea>
          <button class="btn-primary sm" id="pub-go">Publish</button>
        </div>
        <p class="trialnote" id="pub-note"></p>
      </div>
      <div class="dcard">
        <div class="dcard-head"><b>Registered users</b><span id="users-count" class="muted"></span></div>
        <p class="dcard-lead">Everyone who has actually signed up — check here before granting a trial to make sure the account exists yet.</p>
        <div id="users-gate" class="gate-msg">Checking access…</div>
        <div id="users-list" style="display:none"></div>
      </div>
      <div id="gate" class="gate-msg">Checking access…</div>
      <div id="claims" style="display:none"></div>
    </div>
  </main>

  <script>
    const $ = (id) => document.getElementById(id);
    function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    const STCLS = { pending: 'st-pend', approved: 'st-ok', rejected: 'st-bad' };

    $('trial-go').addEventListener('click', async () => {
      const email = $('trial-email').value.trim();
      const days = Number($('trial-days').value) || 7;
      if (!email) { $('trial-note').textContent = 'Enter an email first.'; return; }
      $('trial-go').disabled = true;
      $('trial-note').textContent = 'Granting…';
      try {
        const res = await fetch('/api/admin/grant-trial', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, days }) });
        const d = await res.json();
        if (!res.ok) { $('trial-note').textContent = d.error || 'Failed.'; $('trial-go').disabled = false; return; }
        $('trial-note').textContent = `Done — ${email} has Pro until ${new Date(d.expiresAt).toLocaleString()}.`;
        $('trial-email').value = '';
        loadUsers();
      } catch { $('trial-note').textContent = 'Network error.'; }
      $('trial-go').disabled = false;
    });

    function renderRuns(list) {
      if (!list.length) { $('bloggen-runs').innerHTML = '<p class="empty">No runs yet.</p>'; return; }
      const STATUS_CLS = { published: 'st-ok', skipped: 'st-pend', error: 'st-bad' };
      $('bloggen-runs').innerHTML = list.map((r) => `
        <div class="runrow">
          <span class="st ${STATUS_CLS[r.status] || ''}">${esc(r.status)}</span>
          <span class="runrow-detail">${esc(r.detail || '')}</span>
          <span class="runrow-when">${new Date(r.createdAt).toLocaleString()}</span>
          ${r.postSlug ? `<a href="/blog/${esc(r.postSlug)}" target="_blank" class="runrow-link">View post →</a>` : ''}
        </div>`).join('');
    }
    async function loadRuns() {
      try {
        const res = await fetch('/api/admin/blog-gen-runs');
        const d = await res.json();
        if (!res.ok) return;
        renderRuns(d.runs || []);
      } catch {}
    }
    loadRuns();

    $('pub-go').addEventListener('click', async () => {
      const title = $('pub-title').value.trim();
      const description = $('pub-desc').value.trim();
      const bodyMarkdown = $('pub-body').value.trim();
      const tags = $('pub-tags').value.split(',').map((s) => s.trim()).filter(Boolean);
      let faqs = [];
      const faqsRaw = $('pub-faqs').value.trim();
      if (faqsRaw) {
        try { faqs = JSON.parse(faqsRaw); } catch { $('pub-note').textContent = 'FAQs field is not valid JSON — leave it blank or fix the JSON.'; return; }
      }
      if (!title || !description || !bodyMarkdown) { $('pub-note').textContent = 'Title, description and body are all required.'; return; }
      $('pub-go').disabled = true;
      $('pub-note').textContent = 'Publishing…';
      try {
        const res = await fetch('/api/admin/publish-post', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, description, bodyMarkdown, tags, faqs }),
        });
        const d = await res.json();
        if (!res.ok) { $('pub-note').textContent = d.error || 'Failed.'; }
        else {
          $('pub-note').innerHTML = `Published — <a href="${d.url}" target="_blank">${d.url} →</a>`;
          $('pub-title').value = ''; $('pub-desc').value = ''; $('pub-tags').value = ''; $('pub-body').value = ''; $('pub-faqs').value = '';
        }
      } catch { $('pub-note').textContent = 'Network error.'; }
      $('pub-go').disabled = false;
    });

    $('bloggen-go').addEventListener('click', async () => {
      $('bloggen-go').disabled = true;
      $('bloggen-note').textContent = 'Sourcing a topic and drafting the post — this can take up to a minute…';
      try {
        const res = await fetch('/api/admin/generate-blog-post', { method: 'POST' });
        const d = await res.json();
        $('bloggen-note').textContent = d.detail || (res.ok ? 'Done.' : 'Failed.');
        loadRuns();
      } catch { $('bloggen-note').textContent = 'Network error.'; }
      $('bloggen-go').disabled = false;
    });

    function renderUsers(list) {
      $('users-count').textContent = list.length ? `${list.length} signed up` : '';
      if (!list.length) { $('users-list').innerHTML = '<p class="empty">No one has signed up yet.</p>'; return; }
      $('users-list').innerHTML = `<div class="ctable">${list.map((u) => {
        const proActive = u.plan === 'pro' && u.planExpiresAt && new Date(u.planExpiresAt) > new Date();
        const status = proActive ? `Pro until ${new Date(u.planExpiresAt).toLocaleDateString()}` : u.freeCheckUsed ? `Free · ${u.credits} credit(s)` : 'Free · trial check unused';
        return `<div class="crow" data-email="${esc(u.email)}">
          <div class="crow-main">
            <div class="crow-top"><b>${esc(u.email)}</b><span class="kind">${status}</span></div>
            <div class="crow-sub">Signed up ${new Date(u.createdAt).toLocaleDateString()}</div>
          </div>
          <div class="crow-actions"><button class="btn-ghost sm" data-act="trial7">Grant 7-day trial</button></div>
        </div>`;
      }).join('')}</div>`;
      document.querySelectorAll('#users-list button[data-act="trial7"]').forEach((btn) => btn.addEventListener('click', () => quickTrial(btn)));
    }
    async function quickTrial(btn) {
      const row = btn.closest('.crow');
      const email = row.dataset.email;
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Granting…';
      try {
        const res = await fetch('/api/admin/grant-trial', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, days: 7 }) });
        const d = await res.json();
        if (!res.ok) { alert(d.error || 'Failed.'); btn.textContent = original; btn.disabled = false; return; }
        loadUsers();
      } catch { alert('Network error.'); btn.textContent = original; btn.disabled = false; }
    }
    async function loadUsers() {
      try {
        const res = await fetch('/api/admin/users');
        const d = await res.json();
        if (!res.ok) { $('users-gate').textContent = d.error || 'Not authorized.'; return; }
        $('users-gate').style.display = 'none'; $('users-list').style.display = 'block';
        renderUsers(d.users || []);
      } catch { $('users-gate').textContent = 'Could not load users.'; }
    }
    loadUsers();

    function renderClaims(list) {
      if (!list.length) { $('claims').innerHTML = '<p class="empty">No payment claims yet.</p>'; return; }
      $('claims').innerHTML = `<div class="ctable">${list.map((c) => `
        <div class="crow" data-id="${c.id}">
          <div class="crow-main">
            <div class="crow-top"><b>${esc(c.email)}</b><span class="kind">${c.kind === 'credits' ? `${c.credits || 1} check pack` : 'Monthly Pro'}</span><span class="st ${STCLS[c.status] || ''}">${esc(c.status)}</span></div>
            <div class="crow-sub">UTR: <code>${esc(c.utr)}</code>${c.amount ? ` · ${esc(c.amount)}` : ''} · ${new Date(c.createdAt).toLocaleString()}</div>
            ${c.note ? `<div class="crow-note">${esc(c.note)}</div>` : ''}
          </div>
          ${c.status === 'pending' ? `<div class="crow-actions"><button class="btn-primary sm" data-act="approve">Approve</button><button class="btn-ghost sm" data-act="reject">Reject</button></div>` : ''}
        </div>`).join('')}</div>`;
      document.querySelectorAll('.crow button').forEach((btn) => btn.addEventListener('click', () => act(btn)));
    }
    async function act(btn) {
      const row = btn.closest('.crow');
      const id = row.dataset.id, action = btn.dataset.act;
      row.querySelectorAll('button').forEach((b) => (b.disabled = true));
      try {
        const res = await fetch('/api/admin/payments', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, action }) });
        const d = await res.json();
        if (!res.ok) { alert(d.error || 'Failed.'); row.querySelectorAll('button').forEach((b) => (b.disabled = false)); return; }
        load();
      } catch { alert('Network error.'); row.querySelectorAll('button').forEach((b) => (b.disabled = false)); }
    }
    async function load() {
      try {
        const res = await fetch('/api/admin/payments');
        const d = await res.json();
        if (!res.ok) { $('gate').textContent = d.error || 'Not authorized.'; return; }
        $('gate').style.display = 'none'; $('claims').style.display = 'block';
        renderClaims(d.claims || []);
      } catch { $('gate').textContent = 'Could not load claims.'; }
    }
    load();
  </script>

  <style>
    .dcard { border: 1px solid var(--line); border-radius: 14px; background: #fff; padding: 18px 20px; box-shadow: var(--shadow); margin-bottom: 22px; }
    .dcard-head { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
    .dcard-head b { font-size: 14.5px; }
    .dcard-lead { margin: 0 0 14px; font-size: 12.5px; color: var(--muted); }
    .muted { font-size: 12px; color: var(--muted); font-weight: 600; }
    .trialcard { border: 1px solid var(--line); border-radius: 14px; background: #fff; padding: 18px 20px; box-shadow: var(--shadow); margin-bottom: 22px; }
    .trialcard b { font-size: 14.5px; }
    .trialcard p { margin: 6px 0 14px; font-size: 12.5px; color: var(--muted); max-width: 62ch; }
    .trialrow { display: flex; gap: 10px; flex-wrap: wrap; }
    .trialrow input { border: 1px solid var(--line-2); border-radius: 9px; padding: 9px 12px; font-size: 13.5px; font-family: inherit; }
    .trialrow input[type="email"] { flex: 1; min-width: 220px; }
    .trialnote { margin: 10px 0 0; font-size: 12.5px; color: var(--ink-2); }
    .gate-msg { font-size: 14px; color: var(--muted); padding: 24px 0; }
    .empty { color: var(--muted); font-size: 14px; }
    .ctable { display: grid; gap: 10px; }
    .crow { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; border: 1px solid var(--line); border-radius: 14px; background: #fff; padding: 16px 18px; box-shadow: var(--shadow); flex-wrap: wrap; }
    .crow-top { display: flex; align-items: center; gap: 10px; }
    .crow-top b { font-size: 14.5px; }
    .st { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; padding: 3px 9px; border-radius: 999px; }
    .st-pend { background: var(--warn-bg); color: var(--warn); }
    .st-ok { background: var(--ok-bg); color: var(--ok); }
    .st-bad { background: var(--bad-bg); color: var(--bad); }
    .kind { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; padding: 3px 9px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
    .crow-sub { font-size: 12.5px; color: var(--muted); margin-top: 5px; }
    .crow-sub code { background: #f1f5f9; padding: 1px 6px; border-radius: 5px; }
    .crow-note { font-size: 12.5px; color: var(--ink-2); margin-top: 6px; font-style: italic; }
    .crow-actions { display: flex; gap: 8px; flex-shrink: 0; }
    .btn-primary.sm, .btn-ghost.sm { padding: 7px 13px; font-size: 12.5px; }
    .runrow { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 9px 0; border-top: 1px solid var(--line); font-size: 12.5px; }
    .runrow:first-child { border-top: none; }
    .runrow-detail { color: var(--ink-2); flex: 1; min-width: 160px; }
    .runrow-when { color: var(--faint); white-space: nowrap; }
    .runrow-link { color: var(--accent); font-weight: 700; text-decoration: none; white-space: nowrap; }
    .pubform { display: grid; gap: 10px; }
    .pubform input, .pubform textarea { border: 1px solid var(--line-2); border-radius: 9px; padding: 9px 12px; font-size: 13.5px; font-family: inherit; width: 100%; box-sizing: border-box; }
    .pubform textarea { resize: vertical; font-family: ui-monospace, monospace; font-size: 12.5px; line-height: 1.5; }
  </style>
</Site>
