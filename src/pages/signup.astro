---
import { BRAND, TRIAL_DAYS } from '../lib/saas/plans';
import AdSenseMeta from '../components/AdSenseMeta.astro';
if (Astro.locals.user) return Astro.redirect('/rank');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <AdSenseMeta />
    <title>{BRAND} — Create your account</title>
    <style>
      :root { --pink: #4338ca; --pink-dark: #372aa8; --ink: #16181d; --muted: #6b7280; --line: #e5e7eb; --bg: #f8f9fb; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); min-height: 100vh; display: grid; place-items: center; }
      .card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 30px; width: min(400px, 92vw); box-shadow: 0 4px 24px rgba(20,20,40,0.06); }
      .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 18px; margin-bottom: 6px; }
      .logo .betatag { font-size: 10px; font-weight: 800; color: var(--pink-dark); background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25); padding: 2px 7px; border-radius: 999px; letter-spacing: 0.02em; }
      .logo .mark { width: 26px; height: 26px; border-radius: 7px; background: linear-gradient(120deg, #6366f1, #8b5cf6); color: #fff; display: grid; place-items: center; font-size: 13px; }
      h1 { font-size: 20px; margin: 0 0 4px; letter-spacing: -0.01em; }
      p.sub { margin: 0 0 18px; color: var(--muted); font-size: 13.5px; }
      label { display: block; font-size: 12.5px; font-weight: 700; color: var(--muted); margin: 12px 0 4px; }
      input { width: 100%; border: 1px solid var(--line); border-radius: 9px; padding: 11px 12px; font-size: 14px; outline: none; }
      input:focus { border-color: var(--pink); box-shadow: 0 0 0 3px rgba(99,102,241,0.12); }
      button { width: 100%; margin-top: 18px; background: var(--pink); color: #fff; border: none; border-radius: 10px; padding: 12px; font-size: 15px; font-weight: 700; cursor: pointer; }
      button:hover { background: var(--pink-dark); }
      button:disabled { opacity: 0.6; }
      .err { display: none; margin-top: 12px; padding: 10px 12px; border-radius: 9px; font-size: 13px; background: #fdecec; color: #b3261e; border: 1px solid #f6c9c6; }
      .alt { text-align: center; font-size: 13px; color: var(--muted); margin-top: 16px; }
      .alt a { color: var(--pink-dark); font-weight: 700; text-decoration: none; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="logo"><span class="mark">▲</span>{BRAND}<span class="betatag">Beta 1.0</span></div>
      <h1>Create your account</h1>
      <p class="sub">Full access for {TRIAL_DAYS} days — no card needed to start.</p>
      <label for="name">Your name</label>
      <input id="name" type="text" autocomplete="name" placeholder="Rudra" />
      <label for="email">Email</label>
      <input id="email" type="email" autocomplete="email" placeholder="you@company.com" />
      <label for="password">Password</label>
      <input id="password" type="password" autocomplete="new-password" placeholder="At least 8 characters" />
      <button id="go">Start my free trial</button>
      <div class="err" id="err"></div>
      <div class="alt">Already have an account? <a href="/login">Log in</a></div>
    </div>
    <script>
      const $ = (id) => document.getElementById(id);
      async function submit() {
        $('err').style.display = 'none';
        const btn = $('go'); btn.disabled = true; btn.textContent = 'Creating account…';
        try {
          const res = await fetch('/api/auth/signup', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: $('name').value, email: $('email').value, password: $('password').value }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Signup failed.');
          location.href = data.redirect || '/rank';
        } catch (e) {
          $('err').textContent = e.message; $('err').style.display = 'block';
          btn.disabled = false; btn.textContent = 'Start my free trial';
        }
      }
      $('go').addEventListener('click', submit);
      document.addEventListener('keydown', (e) => { if (e.key === 'Enter') submit(); });
    </script>
  </body>
</html>
