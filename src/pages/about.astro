---
import { BRAND } from '../lib/saas/plans';
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{BRAND} — About</title>
    <meta name="description" content={`${BRAND} is built by Rudra Kasturi to bring affordable app store keyword rank tracking to indie developers and small studios.`} />
    <style>
      :root { --pink: #6366f1; --pink-dark: #4f46e5; --ink: #1d1f2b; --muted: #6b6f80; --line: #e7e8ef; --bg: #f6f6fa; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #fff; color: var(--ink); line-height: 1.6; }
      .wrap { max-width: 720px; margin: 0 auto; padding: 0 22px; }
      header.top { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; max-width: 1080px; margin: 0 auto; }
      .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
      .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(120deg, #6366f1, #8b5cf6); color: #fff; display: grid; place-items: center; font-size: 14px; }
      a.btn { text-decoration: none; font-weight: 700; font-size: 14px; border-radius: 10px; padding: 10px 18px; background: var(--pink); color: #fff; }
      a.btn:hover { background: var(--pink-dark); }
      main { padding: 40px 0 60px; }
      h1 { font-size: 32px; letter-spacing: -0.02em; margin: 0 0 20px; }
      p { color: var(--muted); font-size: 16px; margin: 0 0 18px; }
      p b { color: var(--ink); }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 30px 0; border-top: 1px solid var(--line); margin-top: 30px; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="logo" href="/"><span class="mark">▲</span>{BRAND}</a>
      <a class="btn" href={user ? '/rank' : '/signup'}>{user ? 'Open dashboard' : 'Start free trial'}</a>
    </header>
    <main>
      <div class="wrap">
        <h1>About {BRAND}</h1>
        <p>
          {BRAND} is built and run by <b>Rudra Kasturi</b>. It started from a simple frustration:
          professional app store rank tracking and ASO auditing tools are priced for large marketing
          teams, out of reach for indie developers and small studios who need the same data to grow
          their apps.
        </p>
        <p>
          {BRAND} brings the two things that matter most — <b>knowing exactly where your app ranks
          for the keywords that drive installs</b>, and <b>knowing whether your store listing is
          working for or against you</b> — into one focused, affordable tool, without the enterprise
          price tag.
        </p>
        <p>
          Questions, feedback, or a feature you'd like to see? Reach out any time — {BRAND} is
          actively built based on what real app owners need.
        </p>
      </div>
    </main>
    <footer>
      <div class="wrap">© {new Date().getFullYear()} {BRAND} · Built by Rudra Kasturi · <a href="/">Home</a></div>
    </footer>
  </body>
</html>
