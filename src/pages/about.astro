---
import { BRAND } from '../lib/saas/plans';
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{BRAND} — About</title>
    <meta name="description" content={`${BRAND} makes App Store Optimization measurable and accessible — simple, actionable keyword ranking intelligence for every app business.`} />
    <style>
      :root { --pink: #4338ca; --pink-dark: #372aa8; --ink: #16181d; --muted: #6b7280; --line: #e5e7eb; --bg: #f8f9fb; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #fff; color: var(--ink); line-height: 1.65; }
      .wrap { max-width: 640px; margin: 0 auto; padding: 0 22px; }
      header.top { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; max-width: 1080px; margin: 0 auto; padding-left: 22px; padding-right: 22px; flex-wrap: wrap; gap: 10px; }
      .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
      .logo .betatag { font-size: 10px; font-weight: 800; color: var(--pink-dark); background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25); padding: 2px 7px; border-radius: 999px; letter-spacing: 0.02em; }
      .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(120deg, #6366f1, #8b5cf6); color: #fff; display: grid; place-items: center; font-size: 14px; }
      .navlinks { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
      .navlinks a.plain { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; }
      .navlinks a.plain:hover { color: var(--ink); }
      a.btn { text-decoration: none; font-weight: 700; font-size: 14px; border-radius: 10px; padding: 10px 18px; background: var(--pink); color: #fff; white-space: nowrap; }
      a.btn:hover { background: var(--pink-dark); }
      main { padding: 44px 0 60px; }
      h1 { font-size: 28px; letter-spacing: -0.02em; margin: 0 0 16px; }
      h2 { font-size: 19px; letter-spacing: -0.01em; margin: 30px 0 12px; color: var(--ink); }
      p { color: var(--muted); font-size: 16px; margin: 0 0 16px; }
      p b { color: var(--ink); }
      ul { color: var(--muted); font-size: 16px; margin: 0 0 16px; padding-left: 22px; }
      li { margin: 0 0 6px; }
      .contact { margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 15px; }
      .contact a { color: var(--pink-dark); font-weight: 700; text-decoration: none; }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 30px 0; border-top: 1px solid var(--line); margin-top: 30px; }
      footer a { color: var(--muted); }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="logo" href="/"><span class="mark">▲</span>{BRAND}<span class="betatag">Beta 1.0</span></a>
      <div class="navlinks">
        <a class="plain" href="/about">About</a>
        <a class="btn" href={user ? '/rank' : '/signup'}>{user ? 'Open dashboard' : 'Start free trial'}</a>
      </div>
    </header>
    <main>
      <div class="wrap">
        <h1>About {BRAND}</h1>
        <p>
          Like many ASO professionals, product marketers, founders, and growth teams, we relied on
          expensive global ASO platforms to track app keyword rankings. They were packed with
          features, but when it came to answering the one question that mattered most — "Where does
          my app rank for my most important keywords?" — the experience was often limited, slow, or
          unnecessarily complicated.
        </p>
        <p>We wanted something simpler.</p>
        <p>
          A platform that lets you monitor keyword rankings across app stores, understand how your
          app is performing, compare your visibility against competitors, and spot ranking changes
          before they impact downloads.
        </p>
        <p>So we built {BRAND}.</p>
        <p>{BRAND} is designed for people who make decisions based on app visibility.</p>
        <p>
          Whether you're an ASO specialist optimizing hundreds of keywords, a startup founder
          tracking your growth, a CMO measuring campaign impact, or a CEO who simply wants to know
          whether the app is becoming easier to discover, {BRAND} gives you the data that matters
          without overwhelming you.
        </p>
        <p>Our goal is straightforward.</p>
        <p>Help businesses answer questions like:</p>
        <ul>
          <li>Which keywords are we ranking for?</li>
          <li>Which rankings are improving or dropping?</li>
          <li>How do we compare with competitors?</li>
          <li>Which keywords should we focus on next?</li>
          <li>Are our ASO efforts actually working?</li>
        </ul>
        <p>
          We believe ASO shouldn't require expensive enterprise software or hours of manual
          tracking. Good decisions come from clear, reliable data.
        </p>
        <p>Interestingly, {BRAND} itself is proof of what's possible today.</p>
        <p>
          The platform was built almost entirely using AI. Without a traditional software
          engineering background, we used modern AI coding tools to design, build, test, and launch
          {BRAND}. It's a reflection of how AI is changing product development and making it
          possible for founders to build solutions around real problems instead of waiting for
          large engineering teams.
        </p>
        <p>This is only the beginning.</p>
        <p>
          We're continuously improving {BRAND} with new insights, smarter analytics, competitor
          intelligence, historical trends, and AI powered recommendations to help app teams grow
          faster.
        </p>
        <p>If app discovery matters to your business, {BRAND} is built for you.</p>

        <h2>Our Mission</h2>
        <p>
          To make App Store Optimization measurable, transparent, and accessible for every app
          business, from indie developers to global enterprises, through simple, actionable ranking
          intelligence instead of overwhelming dashboards.
        </p>

        <div class="contact">
          Talk to us — <a href="mailto:talktoapprankr@gmail.com">talktoapprankr@gmail.com</a>
        </div>
      </div>
    </main>
    <footer>
      <div class="wrap">© {new Date().getFullYear()} {BRAND} · <a href="/">Home</a></div>
    </footer>
  </body>
</html>
