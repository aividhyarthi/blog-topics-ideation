---
// ASO Inspector — Google Play (Android) App Store Optimization.
// Scores a Play Store listing on owner-editable fields, extracts keywords,
// compares competitors, and proposes AI-rewritten title/short/long copy.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>CiteRank — ASO Inspector for Google Play</title>
    <meta name="description" content="Audit any Google Play (Android) app's store listing: ASO score, keyword analysis, competitor comparison and AI-rewritten title, short and long descriptions." />
    <!-- is:global so styles also apply to the results DOM injected at runtime. -->
    <style is:global>
      :root {
        --pink: #6366f1; --pink-dark: #4f46e5; --ink: #1d1f2b; --muted: #6b6f80;
        --line: #e7e8ef; --bg: #f4f5fb; --card: #ffffff;
        --ok: #15a06a; --ok-bg: #e7f6ef; --warn: #c98a00; --warn-bg: #fdf3dd;
        --bad: #d63a3a; --bad-bg: #fdecec; --na: #9aa0ad; --indigo: #5b46c9;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.5; }
      header { background: linear-gradient(125deg, #6366f1 0%, #8b5cf6 60%, #a78bfa 100%); color: #fff; padding: 30px 20px 34px; }
      .wrap { max-width: 1060px; margin: 0 auto; padding: 0 20px; }
      header h1 { margin: 0 0 8px; font-size: 27px; font-weight: 800; letter-spacing: -0.02em; }
      header p { margin: 0; opacity: 0.96; font-size: 15px; max-width: 760px; }
      .brandbar { display: flex; align-items: center; gap: 9px; margin-bottom: 14px; flex-wrap: wrap; }
      .brandbar .logo { width: 26px; height: 26px; border-radius: 8px; background: rgba(255,255,255,0.22); border: 1px solid rgba(255,255,255,0.4); display: grid; place-items: center; font-size: 13px; }
      .brandbar .wordmark { font-size: 19px; font-weight: 800; letter-spacing: -0.02em; }
      .brandbar .by { font-size: 11.5px; font-weight: 600; opacity: 0.9; }
      .brandbar .aipill { margin-left: auto; font-size: 11.5px; font-weight: 700; padding: 4px 11px; border-radius: 999px; background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.4); }
      nav.top { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; }
      nav.top a { color: #fff; text-decoration: none; font-size: 13px; font-weight: 600; background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.3); padding: 7px 13px; border-radius: 9px; }
      nav.top a.active { background: #fff; color: var(--pink-dark); }
      main { padding: 26px 0 64px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 18px; box-shadow: 0 2px 8px rgba(20,20,40,0.05); }
      label.fld { display: block; font-size: 12.5px; color: var(--muted); font-weight: 600; margin: 12px 0 5px; }
      input[type=text], input[type=url], textarea, select { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: 13.5px; color: var(--ink); background: #fcfcfe; outline: none; font-family: inherit; }
      textarea { min-height: 70px; resize: vertical; font-size: 13px; }
      input:focus, textarea:focus, select:focus { border-color: var(--pink); box-shadow: 0 0 0 3px rgba(99,102,241,0.12); }
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .three { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 12px; }
      @media (max-width: 720px) { .two, .three { grid-template-columns: 1fr; } }
      .row { display: flex; align-items: center; gap: 14px; margin-top: 16px; flex-wrap: wrap; }
      button.primary { background: var(--pink); color: #fff; border: none; border-radius: 11px; padding: 13px 24px; font-size: 15px; font-weight: 700; cursor: pointer; box-shadow: 0 2px 10px rgba(99,102,241,0.35); }
      button.primary:hover { background: var(--pink-dark); }
      button.primary:disabled { opacity: 0.6; cursor: not-allowed; box-shadow: none; }
      .spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.5); border-top-color: #fff; border-radius: 50%; display: inline-block; vertical-align: -3px; margin-right: 8px; animation: spin 0.7s linear infinite; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .alert { margin-top: 16px; padding: 12px 14px; border-radius: 10px; font-size: 13.5px; display: none; }
      .alert.err { background: var(--bad-bg); color: #b3261e; border: 1px solid #f6c9c6; }
      .alert.info { background: var(--warn-bg); color: #8a5d00; border: 1px solid #f3e0b0; }
      .hint { font-size: 11.5px; color: var(--muted); margin-top: 5px; }
      .adv { margin-top: 10px; }
      .adv > summary { cursor: pointer; font-size: 12.5px; color: var(--pink-dark); font-weight: 700; list-style: none; }
      .adv > summary::-webkit-details-marker { display: none; }
      #results { margin-top: 24px; display: none; }

      /* app header */
      .apphead { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
      .apphead img.icon { width: 64px; height: 64px; border-radius: 15px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(20,20,40,0.12); }
      .apphead .ameta .atitle { font-size: 19px; font-weight: 800; letter-spacing: -0.01em; }
      .apphead .ameta .adev { font-size: 12.5px; color: var(--muted); }
      .apphead .astats { display: flex; gap: 18px; margin-left: auto; flex-wrap: wrap; }
      .apphead .astat { text-align: center; }
      .apphead .astat b { display: block; font-size: 17px; font-weight: 800; }
      .apphead .astat span { font-size: 11px; color: var(--muted); font-weight: 600; }

      .hero { display: flex; gap: 26px; align-items: center; flex-wrap: wrap; }
      .donut { --val: 0; --ring: var(--ok); width: 150px; height: 150px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--ring) calc(var(--val) * 1%), #e9ebf3 0); flex-shrink: 0; }
      .donut .inner { width: 116px; height: 116px; border-radius: 50%; background: #fff; display: grid; place-items: center; text-align: center; box-shadow: 0 1px 4px rgba(20,20,40,0.06); }
      .donut .num { font-size: 40px; font-weight: 800; line-height: 1; }
      .donut .grd { font-size: 13px; color: var(--muted); font-weight: 700; margin-top: 3px; }
      .verdict { flex: 1; min-width: 260px; }
      .verdict .vtitle { font-size: 22px; font-weight: 800; margin: 0 0 8px; letter-spacing: -0.01em; }
      .chips { display: flex; gap: 7px; flex-wrap: wrap; }
      .chip { font-size: 11.5px; font-weight: 700; padding: 3px 10px; border-radius: 999px; background: #eef0f7; color: #4a5060; }
      .chip.band-High { background: var(--ok-bg); color: var(--ok); }
      .chip.band-Medium { background: var(--warn-bg); color: var(--warn); }
      .chip.band-Low { background: var(--bad-bg); color: var(--bad); }
      .note-bad { color: var(--bad); font-size: 12.5px; margin-top: 8px; }
      .note-warn { color: var(--warn); font-size: 12.5px; margin-top: 8px; }

      .summary { margin-top: 16px; display: flex; gap: 12px; background: linear-gradient(120deg, #f3f1ff, #eef4ff); border: 1px solid #e2def8; border-radius: 13px; padding: 13px 15px; }
      .summary .sicon { font-size: 18px; line-height: 1.4; }
      .summary .sbody b { display: block; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--indigo); margin-bottom: 2px; }
      .summary .sbody p { margin: 0; font-size: 13.5px; color: #2c3142; }

      .resbar { display: flex; justify-content: flex-end; gap: 8px; margin: 16px 0 -8px; }
      .ghostbtn { background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 9px; padding: 7px 13px; font-size: 12.5px; font-weight: 700; cursor: pointer; }
      .ghostbtn:hover { border-color: var(--pink); color: var(--pink); }

      .sectitle { font-size: 15px; font-weight: 800; margin: 26px 0 12px; display: flex; align-items: center; gap: 8px; }
      .sectitle .sub { font-weight: 500; color: var(--muted); font-size: 12.5px; }

      .gauges { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
      @media (max-width: 760px) { .gauges { grid-template-columns: 1fr 1fr; } }
      @media (max-width: 460px) { .gauges { grid-template-columns: 1fr; } }
      .gauge { border: 1px solid var(--line); border-radius: 13px; padding: 13px 14px; background: #fff; border-left: 4px solid var(--g); }
      .gauge .gtop { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
      .gauge .gname { font-size: 12.5px; font-weight: 700; line-height: 1.25; }
      .gauge .gpts { font-size: 22px; font-weight: 800; color: var(--g); white-space: nowrap; }
      .gauge .gpts small { font-size: 12px; color: var(--muted); font-weight: 700; }
      .gauge .gpurpose { font-size: 10.5px; color: var(--muted); margin-top: 2px; }
      .gbar { height: 7px; border-radius: 999px; background: #edeef4; overflow: hidden; margin-top: 9px; }
      .gbar > i { display: block; height: 100%; border-radius: 999px; background: var(--g); }

      /* tables */
      table { width: 100%; border-collapse: collapse; font-size: 13px; background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
      th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); }
      th { background: #f6f7fb; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
      tr:last-child td { border-bottom: none; }
      td.num, th.num { text-align: center; }
      .kmark { font-weight: 800; }
      .kmark.y { color: var(--ok); } .kmark.n { color: var(--na); }
      .tablewrap { overflow-x: auto; }
      .me-row td { background: #f3f1ff; font-weight: 600; }
      .gapcount { font-weight: 800; background: #e9e6fb; color: var(--indigo); padding: 2px 9px; border-radius: 7px; }
      .gap-row td { background: #f6f4ff; }
      /* keyword sub-tabs */
      .ktabs { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
      .ktab { padding: 8px 14px; border-radius: 9px; border: 1px solid var(--line); background: #fff; cursor: pointer; font-size: 13px; font-weight: 700; color: var(--muted); }
      .ktab.active { border-color: var(--pink); color: var(--pink); background: #f0f1fe; }
      .scorepill { font-weight: 800; padding: 2px 8px; border-radius: 7px; }

      /* AI improvement cards */
      .impgrid { display: grid; gap: 12px; }
      .impcard { border: 1px solid var(--line); border-left: 4px solid var(--indigo); border-radius: 12px; padding: 13px 15px; background: #fff; }
      .impcard .ilabel { font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--indigo); display: flex; justify-content: space-between; align-items: center; gap: 8px; }
      .impcard .ilabel .clen { font-size: 11px; font-weight: 700; color: var(--muted); }
      .impcard .ilabel .clen.over { color: var(--bad); }
      .impcard .itext { margin-top: 7px; font-size: 13.5px; white-space: pre-wrap; }
      .impcard .icopy { margin-top: 8px; }
      .kwtargets { display: grid; gap: 7px; }
      .kwrow { display: flex; gap: 10px; align-items: flex-start; border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; background: #fff; font-size: 13px; }
      .kwrow .kmk { width: 20px; height: 20px; border-radius: 6px; display: grid; place-items: center; font-size: 12px; font-weight: 800; flex-shrink: 0; }
      .kwrow .kmk.yes { background: var(--ok-bg); color: var(--ok); }
      .kwrow .kmk.no { background: var(--warn-bg); color: var(--warn); }
      .kwrow .kterm { font-weight: 700; }
      .kwrow .krat { color: var(--muted); font-size: 12px; }

      /* focus-keyword verdict */
      .fvcard { padding: 16px 18px; }
      .fvhead { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
      .fvkw { font-size: 17px; font-weight: 800; letter-spacing: -0.01em; }
      .fvrate { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; padding: 3px 10px; border-radius: 999px; }
      .fvrate.strong { background: var(--ok-bg); color: var(--ok); }
      .fvrate.moderate { background: var(--warn-bg); color: var(--warn); }
      .fvrate.weak { background: var(--bad-bg); color: var(--bad); }
      .fvrow { display: flex; gap: 11px; align-items: flex-start; padding: 9px 0; border-top: 1px solid var(--line); font-size: 13.5px; }
      .fvrow:first-of-type { border-top: none; }
      .fvrow b { font-weight: 700; }
      .fvic { width: 22px; height: 22px; border-radius: 7px; display: grid; place-items: center; font-size: 13px; font-weight: 800; flex-shrink: 0; }
      .fvic.ok { background: var(--ok-bg); color: var(--ok); }
      .fvic.bad { background: var(--bad-bg); color: var(--bad); }
      .fvic.alt { background: #e9e6fb; color: var(--indigo); }

      /* market signals */
      .market { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
      @media (max-width: 620px) { .market { grid-template-columns: 1fr 1fr; } }
      .mcell { border: 1px solid var(--line); border-radius: 11px; padding: 11px 13px; background: #fbfbfe; border-left: 4px solid var(--mc); }
      .mcell .mlabel { font-size: 11px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
      .mcell .mval { font-size: 14px; font-weight: 700; margin-top: 2px; }

      /* fixes */
      .fixlist { display: grid; gap: 9px; }
      .fixrow { display: flex; gap: 12px; align-items: flex-start; border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; background: #fff; border-left: 4px solid var(--fc); }
      .fixrow .fnum { font-weight: 800; color: var(--fc); font-size: 14px; min-width: 18px; }
      .fixrow .ftext { font-size: 13px; flex: 1; }
      .fixrow .ftext b { display: block; margin-bottom: 2px; font-size: 13.5px; }
      .fixrow .fmeta { display: flex; flex-direction: column; align-items: flex-end; gap: 5px; flex-shrink: 0; }
      .gain { font-size: 12px; font-weight: 800; color: var(--ok); white-space: nowrap; }
      .ftag { font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; padding: 2px 8px; border-radius: 999px; }
      .ftag.high { background: #e9e6fb; color: var(--indigo); }
      .ftag.quick { background: var(--ok-bg); color: var(--ok); }

      /* full breakdown */
      .pillar { border: 1px solid var(--line); border-radius: 13px; overflow: hidden; background: #fff; margin-bottom: 10px; border-left: 4px solid var(--p); }
      .pillar > summary { list-style: none; cursor: pointer; padding: 14px 16px; display: flex; align-items: center; gap: 14px; }
      .pillar > summary::-webkit-details-marker { display: none; }
      .pillar .caret { color: var(--muted); font-size: 12px; transition: transform 0.15s; }
      .pillar[open] .caret { transform: rotate(90deg); }
      .pname { font-weight: 700; font-size: 14.5px; flex: 1; }
      .pbar { height: 8px; border-radius: 999px; background: #edeef4; width: 130px; overflow: hidden; }
      .pbar > i { display: block; height: 100%; border-radius: 999px; background: var(--p); }
      @media (max-width: 720px) { .pbar { width: 60px; } }
      .pscore { font-weight: 800; font-size: 18px; min-width: 40px; text-align: right; color: var(--p); }
      .signals { padding: 2px 16px 12px; }
      .signal { display: flex; gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); align-items: flex-start; }
      .schip { width: 22px; height: 22px; border-radius: 7px; display: grid; place-items: center; font-size: 13px; font-weight: 800; flex-shrink: 0; margin-top: 1px; }
      .schip.pass { background: var(--ok-bg); color: var(--ok); } .schip.warn { background: var(--warn-bg); color: var(--warn); }
      .schip.fail { background: var(--bad-bg); color: var(--bad); } .schip.na { background: #eef0f5; color: var(--na); }
      .sbody { flex: 1; min-width: 0; }
      .sname { font-weight: 600; font-size: 13.5px; }
      .sdetail { font-size: 12.5px; color: var(--muted); margin-top: 2px; }
      .sfix { font-size: 12.5px; color: #5c4a14; margin-top: 6px; background: var(--warn-bg); border-left: 3px solid var(--warn); padding: 6px 10px; border-radius: 0 7px 7px 0; }
      .sscore { font-weight: 800; font-size: 13px; padding: 3px 9px; border-radius: 8px; min-width: 42px; text-align: center; flex-shrink: 0; }

      .caveat { margin-top: 20px; font-size: 12px; color: var(--muted); background: #eef0f7; border-radius: 12px; padding: 12px 14px; }
      .caveat b { color: var(--ink); }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 26px; }
      .toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 10px 18px; border-radius: 10px; font-size: 13.5px; opacity: 0; transition: opacity 0.2s; pointer-events: none; }
      .toast.show { opacity: 1; }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <div class="brandbar">
          <span class="logo">◆</span>
          <span class="wordmark">CiteRank</span>
          <span class="by">By Rudra Kasturi Inc</span>
          <span class="aipill">✨ AI-powered</span>
        </div>
        <h1>ASO Inspector — Google Play</h1>
        <p>Paste a Google Play (Android) app and get its App Store Optimization score, keyword analysis, competitor comparison, and AI-rewritten title, short and long descriptions — all from the live listing.</p>
        <nav class="top">
          <a href="/">✍️ Topic Engine</a>
          <a href="/audit">🔎 AEO Auditor</a>
          <a href="/aso" class="active">📱 ASO Inspector</a>
          <a href="/wbr">📊 WBR Builder</a>
          <a href="/snapshot">🎯 Snapshot</a>
          <a href="/measure">📡 Live AEO</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <div class="card">
          <label class="fld" for="url">Google Play app URL or package id</label>
          <input id="url" type="text" placeholder="https://play.google.com/store/apps/details?id=com.company.app  —or—  com.company.app" />
          <div class="hint">Paste the Play Store link or just the package id (e.g. <code>com.whatsapp</code>).</div>

          <div class="two" style="margin-top:4px">
            <div>
              <label class="fld" for="focus">Focus keyword <span style="font-weight:400">(optional)</span></label>
              <input id="focus" type="text" placeholder="e.g. photo editor — leave blank to let AI pick" />
            </div>
            <div>
              <label class="fld" for="competitors">Competitor apps <span style="font-weight:400">(optional)</span></label>
              <input id="competitors" type="text" placeholder="package ids or URLs, comma-separated — blank = auto-discover" />
            </div>
          </div>

          <details class="adv">
            <summary>Advanced — store country &amp; language</summary>
            <div class="two" style="margin-top:8px">
              <div>
                <label class="fld" for="country">Store country</label>
                <input id="country" type="text" value="us" placeholder="us" />
              </div>
              <div>
                <label class="fld" for="lang">Listing language</label>
                <input id="lang" type="text" value="en" placeholder="en" />
              </div>
            </div>
          </details>

          <div class="row">
            <button class="primary" id="go">Inspect ASO</button>
          </div>

          <div class="alert err" id="err"></div>
          <div class="alert info" id="info"></div>
        </div>

        <section id="results"></section>
      </div>
    </main>

    <footer><b>CiteRank · ASO Inspector</b> · By Rudra Kasturi Inc · live Google Play data · the score grades owner-editable listing fields; ratings &amp; installs are shown as market context</footer>
    <div class="toast" id="toast"></div>

    <script>
      const $ = (id) => document.getElementById(id);
      // Escapes both element-text and attribute contexts (quotes included) so AI
      // rewrites containing " or ' can't break out of data-copy="…"/src="…" etc.
      function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
      function showErr(msg) { const e = $('err'); e.textContent = msg; e.style.display = 'block'; }
      function hideAlerts() { $('err').style.display = 'none'; $('info').style.display = 'none'; }
      function showToast(msg) { const t = $('toast'); t.textContent = msg; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 1900); }
      async function copy(text) { try { await navigator.clipboard.writeText(text); showToast('Copied to clipboard'); } catch { showToast('Copy failed — select manually'); } }

      function hexFor(s) { if (s == null) return '#9aa0ad'; if (s >= 75) return '#15a06a'; if (s >= 45) return '#c98a00'; return '#d63a3a'; }
      function statusOf(s) { if (s == null) return 'na'; if (s >= 75) return 'pass'; if (s >= 45) return 'warn'; return 'fail'; }
      function tintFor(s) { const st = statusOf(s); return st === 'pass' ? 'background:var(--ok-bg);color:var(--ok)' : st === 'warn' ? 'background:var(--warn-bg);color:var(--warn)' : st === 'fail' ? 'background:var(--bad-bg);color:var(--bad)' : 'background:#eef0f5;color:var(--na)'; }
      const ICON = { pass: '✓', warn: '!', fail: '✕', na: '–' };
      const TONE = { good: 'var(--ok)', mid: 'var(--warn)', bad: 'var(--bad)', na: 'var(--na)' };
      function verdictFor(s) {
        if (s >= 80) return { t: 'Strong listing — well optimized', c: '#15a06a' };
        if (s >= 65) return { t: 'Good, with room to improve', c: '#15a06a' };
        if (s >= 50) return { t: 'Moderate — leaving ranking on the table', c: '#c98a00' };
        if (s >= 35) return { t: 'Weak — listing needs real work', c: '#d63a3a' };
        return { t: 'Poor — major ASO gaps', c: '#d63a3a' };
      }
      function fmtNum(n) { if (n == null) return '—'; if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M'; if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k'; return String(n); }

      function render(data) {
        const r = data.report, app = data.app || {}, ai = data.ai || {}, m = data.meta || {}, comps = data.competitors || [];
        const root = $('results');
        const v = verdictFor(r.overall);

        const appHead = `
          <div class="card">
            <div class="apphead">
              ${app.icon ? `<img class="icon" src="${esc(app.icon)}" alt="" />` : ''}
              <div class="ameta">
                <div class="atitle">${esc(app.title || m.appId)}</div>
                <div class="adev">${esc(app.developer || '')} · ${esc(app.genre || '')} · <a href="${esc(app.url)}" target="_blank" rel="noopener" style="color:var(--pink-dark)">${esc(m.appId)}</a></div>
              </div>
              <div class="astats">
                <div class="astat"><b>${app.score != null ? app.score.toFixed(2) + '★' : '—'}</b><span>${fmtNum(app.ratings)} ratings</span></div>
                <div class="astat"><b>${esc(app.installs || '—')}</b><span>installs</span></div>
              </div>
            </div>
            <div class="hero">
              <div class="donut" style="--val:${r.overall};--ring:${v.c}">
                <div class="inner"><div class="num" style="color:${v.c}">${r.overall}</div><div class="grd">Grade ${esc(r.grade)}</div></div>
              </div>
              <div class="verdict">
                <div class="vtitle" style="color:${v.c}">${v.t}</div>
                <div class="chips">
                  <span class="chip band-${r.band}">${r.band} optimization</span>
                  ${r.focusKeyword ? `<span class="chip">focus: ${esc(r.focusKeyword)}</span>` : ''}
                  ${app.version ? `<span class="chip">v${esc(app.version)}</span>` : ''}
                </div>
                ${m.aiError ? `<div class="note-warn">⚠ ${esc(m.aiError)}</div>` : ''}
              </div>
            </div>
            ${ai.summary ? `<div class="summary"><span class="sicon">🤖</span><div class="sbody"><b>AI verdict</b><p>${esc(ai.summary)}</p></div></div>` : ''}
          </div>`;

        const gauges = r.pillars.map((p) => {
          const col = hexFor(p.score);
          return `<div class="gauge" style="--g:${col}">
            <div class="gtop"><div><div class="gname">${esc(p.label)}</div><div class="gpurpose">${esc(p.purpose)}</div></div><div class="gpts">${p.points}<small>/${p.weight}</small></div></div>
            <div class="gbar"><i style="width:${p.score}%"></i></div></div>`;
        }).join('');

        // AI improvements
        const imp = ai.improvements || {};
        const impCard = (label, text, limit) => {
          if (!text) return '';
          const over = text.length > limit;
          return `<div class="impcard"><div class="ilabel"><span>${label}</span><span class="clen ${over ? 'over' : ''}">${text.length}${limit ? '/' + limit : ''} chars</span></div>
            <div class="itext">${esc(text)}</div>
            <button class="ghostbtn icopy" data-copy="${esc(text)}">📋 Copy</button></div>`;
        };
        const improvements = (imp.title || imp.shortDescription || imp.longDescription) ? `
          <div class="sectitle">✨ AI-rewritten listing copy <span class="sub">— optimized for ranking + conversion, within Play's limits</span></div>
          <div class="impgrid">
            ${impCard('Title', imp.title, 30)}
            ${impCard('Short description', imp.shortDescription, 80)}
            ${impCard('Long description (opening)', imp.longDescription, 4000)}
          </div>` : '';

        // AI keyword targets
        const kt = ai.keywordTargets || [];
        const kwTargets = kt.length ? `
          <div class="sectitle">🎯 Keyword opportunities <span class="sub">— ranked by Claude for this app's audience</span></div>
          <div class="kwtargets">${kt.map((k) => `<div class="kwrow"><span class="kmk ${k.covered ? 'yes' : 'no'}">${k.covered ? '✓' : '+'}</span><div><span class="kterm">${esc(k.term)}</span> <span class="krat">— ${esc(k.rationale)}</span></div></div>`).join('')}</div>` : '';

        // ---- Keywords section: tabbed (Yours · You vs competitors · Gap) ----
        const kw = r.keywords || [];
        const gap = data.gap || [];
        const matrix = data.matrix || { columns: [], rows: [] };
        const shortName = (s) => { s = String(s || ''); return s.length > 16 ? esc(s.slice(0, 15)) + '…' : esc(s); };
        const yn = (b, extra) => `<td class="num kmark ${b ? 'y' : 'n'}" ${extra || ''}>${b ? '✓' : '·'}</td>`;

        // Pane 1 — your current listing keywords
        const yoursPane = kw.length ? `
          <div class="tablewrap"><table>
            <thead><tr><th>Keyword</th><th class="num">Count</th><th class="num">Title</th><th class="num">Short</th><th class="num">Long</th></tr></thead>
            <tbody>${kw.map((k) => `<tr><td>${esc(k.term)}</td><td class="num">${k.count}</td>
              ${yn(k.inTitle)}${yn(k.inShort)}${yn(k.inLong)}</tr>`).join('')}</tbody>
          </table></div>` : '<div class="hint" style="padding:8px">No keywords extracted.</div>';

        // Pane 2 — you vs competitors matrix (✓ = the app's listing uses the term)
        const vsPane = matrix.rows.length ? `
          <div class="hint" style="margin-bottom:8px">✓ = the app's listing uses the term. <span style="color:var(--indigo);font-weight:700">Indigo rows</span> = a gap (rivals use it, you don't).</div>
          <div class="tablewrap"><table>
            <thead><tr><th>Keyword</th><th class="num">You</th>${matrix.columns.map((c) => `<th class="num" title="${esc(c)}">${shortName(c)}</th>`).join('')}</tr></thead>
            <tbody>${matrix.rows.map((row) => `<tr${row.gap ? ' class="gap-row"' : ''}>
              <td>${row.gap ? '<span style="color:var(--indigo);font-weight:700">' + esc(row.term) + '</span>' : esc(row.term)}</td>
              ${yn(row.yours)}${row.competitors.map((b) => yn(b)).join('')}</tr>`).join('')}</tbody>
          </table></div>` : '<div class="hint" style="padding:8px">Add competitors to see the comparison.</div>';

        // Pane 3 — the gap (relevant terms rivals use that you don't)
        const gapPane = gap.length ? `
          ${ai.gapInsight ? `<div class="summary" style="margin:0 0 12px"><span class="sicon">🕳️</span><div class="sbody"><b>The gap</b><p>${esc(ai.gapInsight)}</p></div></div>` : ''}
          <div class="tablewrap"><table>
            <thead><tr><th>Missing keyword</th><th class="num">Rivals</th><th class="num">In title</th><th class="num">In short</th><th>Examples</th></tr></thead>
            <tbody>${gap.map((g) => `<tr><td><b>${esc(g.term)}</b></td>
              <td class="num"><span class="gapcount">${g.competitors}</span></td>
              <td class="num kmark ${g.inTitle ? 'y' : 'n'}">${g.inTitle || '·'}</td>
              <td class="num kmark ${g.inShort ? 'y' : 'n'}">${g.inShort || '·'}</td>
              <td style="color:var(--muted);font-size:12px">${esc((g.apps || []).slice(0, 2).join(', '))}</td></tr>`).join('')}</tbody>
          </table></div>` : '<div class="hint" style="padding:8px">No clear gap — your listing already covers the competitor keywords. 🎉</div>';

        const hasComps = (comps || []).length > 0;
        const keywordsSection = kw.length ? `
          <div class="sectitle">🔑 Keywords <span class="sub">— yours, vs competitors, and the gap</span></div>
          <div class="ktabs">
            <button class="ktab active" data-ktab="yours">Your keywords</button>
            ${hasComps ? '<button class="ktab" data-ktab="vs">You vs competitors</button>' : ''}
            ${hasComps ? '<button class="ktab" data-ktab="gap">Gap</button>' : ''}
          </div>
          <div class="kpane" data-kpane="yours">${yoursPane}</div>
          ${hasComps ? `<div class="kpane" data-kpane="vs" style="display:none">${vsPane}</div>` : ''}
          ${hasComps ? `<div class="kpane" data-kpane="gap" style="display:none">${gapPane}</div>` : ''}` : '';

        // focus-keyword verdict (will it work / what won't / best alternative)
        const focusKw = data.focusKeyword || r.focusKeyword || '';
        const fv = ai.focusVerdict || {};
        const focusVerdict = (fv.willWork || fv.wontWork || fv.bestAlternative) ? `
          <div class="sectitle">🧭 Verdict on your keyword ${focusKw ? `<span class="sub">— “${esc(focusKw)}”</span>` : ''}</div>
          <div class="card fvcard">
            <div class="fvhead">
              <span class="fvkw">${esc(fv.keyword || focusKw)}</span>
              ${fv.rating ? `<span class="fvrate ${esc(fv.rating)}">${esc(fv.rating)} fit</span>` : ''}
            </div>
            ${fv.willWork ? `<div class="fvrow"><span class="fvic ok">✓</span><div><b>Can it work?</b> ${esc(fv.willWork)}</div></div>` : ''}
            ${fv.wontWork ? `<div class="fvrow"><span class="fvic bad">✕</span><div><b>What's working against it</b> ${esc(fv.wontWork)}</div></div>` : ''}
            ${fv.bestAlternative ? `<div class="fvrow"><span class="fvic alt">→</span><div><b>Better bet: “${esc(fv.bestAlternative)}”</b> ${esc(fv.alternativeWhy || '')} <button class="ghostbtn" data-refocus="${esc(fv.bestAlternative)}" style="margin-left:6px">↻ Re-run with this</button></div></div>` : ''}
          </div>` : '';

        // keyword head-to-head: who covers the focus keyword where (you vs rivals)
        const fkCells = (cov) => {
          const c = cov || { inTitle: false, inShort: false, inLong: false, longCount: 0 };
          return `<td class="num kmark ${c.inTitle ? 'y' : 'n'}">${c.inTitle ? '✓' : '·'}</td>
            <td class="num kmark ${c.inShort ? 'y' : 'n'}">${c.inShort ? '✓' : '·'}</td>
            <td class="num kmark ${c.inLong ? 'y' : 'n'}">${c.longCount ? c.longCount + '×' : '·'}</td>`;
        };
        const h2hMe = `<tr class="me-row"><td>${esc(app.title || m.appId)} <span style="color:var(--pink-dark)">(you)</span></td>
          ${fkCells(app.focus)}<td class="num">${app.score != null ? app.score.toFixed(2) + '★' : '—'}</td><td class="num">${esc(app.installs || '—')}</td></tr>`;
        const h2hComp = comps.map((c) => `<tr><td><a href="${esc(c.url)}" target="_blank" rel="noopener" style="color:var(--ink)">${esc(c.title)}</a></td>
          ${fkCells(c.focus)}<td class="num">${c.score != null ? c.score.toFixed(2) + '★' : '—'}</td><td class="num">${esc(c.installs || '—')}</td></tr>`).join('');
        const headToHead = (comps.length && focusKw) ? `
          <div class="sectitle">🥊 Keyword head-to-head <span class="sub">— who covers “${esc(focusKw)}”, and where</span></div>
          <div class="tablewrap"><table>
            <thead><tr><th>App</th><th class="num">Title</th><th class="num">Short</th><th class="num">Long</th><th class="num">Rating</th><th class="num">Installs</th></tr></thead>
            <tbody>${h2hMe}${h2hComp}</tbody>
          </table></div>
          ${ai.competitorTakeaway ? `<div class="summary" style="margin-top:12px"><span class="sicon">🥊</span><div class="sbody"><b>Why they out-rank you on this keyword</b><p>${esc(ai.competitorTakeaway)}</p></div></div>` : ''}` : '';

        // why the install leader ranks ahead
        const lv = ai.leaderVerdict || {};
        const leaderName = (lv.app || (data.leader && data.leader.title) || '').trim();
        const leaderCard = (lv.why || lv.copyThis) ? `
          <div class="sectitle">👑 Why ${leaderName ? `“${esc(leaderName)}”` : 'the leader'} ranks ahead <span class="sub">— the category install leader</span></div>
          <div class="card fvcard">
            ${data.leader ? `<div class="fvhead"><span class="fvkw">${esc(data.leader.title)}</span>${data.leader.score != null ? `<span class="chip">${data.leader.score.toFixed(2)}★</span>` : ''}${data.leader.installs ? `<span class="chip">${esc(data.leader.installs)} installs</span>` : ''}</div>` : ''}
            ${lv.why ? `<div class="fvrow"><span class="fvic alt">★</span><div><b>Why they're #1</b> ${esc(lv.why)}</div></div>` : ''}
            ${lv.copyThis ? `<div class="fvrow"><span class="fvic ok">✓</span><div><b>Copy this now</b> ${esc(lv.copyThis)}</div></div>` : ''}
          </div>` : '';

        // competitor comparison (overall ASO — primary row + competitors)
        const meRow = `<tr class="me-row"><td>${esc(app.title || m.appId)} <span style="color:var(--pink-dark)">(this app)</span></td>
          <td class="num"><span class="scorepill" style="${tintFor(r.overall)}">${r.overall}</span></td>
          <td class="num">${app.score != null ? app.score.toFixed(2) + '★' : '—'}</td><td class="num">${esc(app.installs || '—')}</td>
          <td class="num">${(app.title || '').length}</td><td class="num">${(app.screenshots || []).length}</td></tr>`;
        const compRows = comps.map((c) => `<tr><td><a href="${esc(c.url)}" target="_blank" rel="noopener" style="color:var(--ink)">${esc(c.title)}</a></td>
          <td class="num"><span class="scorepill" style="${tintFor(c.overall)}">${c.overall}</span></td>
          <td class="num">${c.score != null ? c.score.toFixed(2) + '★' : '—'}</td><td class="num">${esc(c.installs || '—')}</td>
          <td class="num">${c.titleLen}</td><td class="num">${c.screenshots}</td></tr>`).join('');
        const compTable = comps.length ? `
          <div class="sectitle">⚔️ Competitor comparison <span class="sub">— overall ASO score applied to each rival listing</span></div>
          <div class="tablewrap"><table>
            <thead><tr><th>App</th><th class="num">ASO</th><th class="num">Rating</th><th class="num">Installs</th><th class="num">Title len</th><th class="num">Shots</th></tr></thead>
            <tbody>${meRow}${compRows}</tbody>
          </table></div>` : '';

        // market signals
        const market = (r.marketSignals || []).map((s) => `<div class="mcell" style="--mc:${TONE[s.tone] || 'var(--na)'}"><div class="mlabel">${esc(s.label)}</div><div class="mval">${esc(s.detail)}</div></div>`).join('');

        // top fixes
        const TAGLBL = { high: 'High impact', quick: 'Quick win' };
        const fixes = (r.topFixes || []).map((fx, i) => {
          const col = fx.severity === 'fail' ? '#d63a3a' : '#c98a00';
          const gain = fx.gain >= 0.5 ? `<span class="gain">+${fx.gain} pts</span>` : '';
          return `<div class="fixrow" style="--fc:${col}"><span class="fnum">${i + 1}</span><div class="ftext"><b>${esc(fx.label)}</b>${esc(fx.fix)}</div><div class="fmeta">${gain}<span class="ftag ${fx.tag}">${TAGLBL[fx.tag] || fx.tag}</span></div></div>`;
        }).join('');

        // full breakdown
        const breakdown = r.pillars.map((p) => {
          const col = hexFor(p.score);
          const sigs = p.signals.map((s) => {
            const st = s.score == null ? 'na' : statusOf(s.score);
            return `<div class="signal"><span class="schip ${st}">${ICON[st]}</span><div class="sbody"><div class="sname">${esc(s.label)}</div><div class="sdetail">${esc(s.detail)}</div>${s.fix ? `<div class="sfix">💡 ${esc(s.fix)}</div>` : ''}</div><span class="sscore" style="${tintFor(s.score)}">${s.score == null ? 'n/a' : s.score}</span></div>`;
          }).join('');
          const open = p.score < 70 ? ' open' : '';
          return `<details class="pillar" style="--p:${col}"${open}><summary><span class="caret">▶</span><span class="pname">${esc(p.label)}</span><span class="pbar"><i style="width:${p.score}%"></i></span><span class="pscore">${p.score}</span></summary><div class="signals">${sigs}</div></details>`;
        }).join('');

        const compErr = (m.competitorErrors || []).length ? `<div class="note-warn">⚠ Some competitors couldn't be read: ${esc((m.competitorErrors || []).join('; '))}</div>` : '';

        root.innerHTML = `
          ${appHead}
          <div class="sectitle">📊 ASO pillar scores <span class="sub">— points out of each pillar's weight (100 total)</span></div>
          <div class="gauges">${gauges}</div>
          ${focusVerdict}
          ${improvements}
          ${kwTargets}
          ${keywordsSection}
          ${headToHead}
          ${leaderCard}
          ${compTable}
          ${compErr}
          <div class="sectitle">📈 Market signals <span class="sub">— outcomes, shown as context (NOT in the score)</span></div>
          <div class="market">${market}</div>
          ${fixes ? `<div class="sectitle">🔧 Top fixes, ranked by impact</div><div class="fixlist">${fixes}</div>` : ''}
          <div class="sectitle">🔬 Full breakdown</div>
          ${breakdown}
          <div class="caveat"><b>How to read this:</b> the <b>score</b> grades only listing fields you can edit in Play Console (title, descriptions, keywords, visuals, freshness). <b>Market signals</b> — rating, installs, age — are outcomes shown for context, not scored. The <b>keyword verdict</b> and <b>head-to-head</b> assess the keyword you entered (or, if blank, the strongest one we extracted): coverage in the table is measured from the live listings; the “will it work / better bet / why they out-rank you” narrative is Claude's judgement. Verify search volume in a dedicated ASO tool before committing.</div>`;

        root.querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', () => copy(b.getAttribute('data-copy'))));
        root.querySelectorAll('[data-refocus]').forEach((b) => b.addEventListener('click', () => { $('focus').value = b.getAttribute('data-refocus'); run(); }));
        root.querySelectorAll('.ktab').forEach((t) => t.addEventListener('click', () => {
          const name = t.getAttribute('data-ktab');
          root.querySelectorAll('.ktab').forEach((x) => x.classList.toggle('active', x === t));
          root.querySelectorAll('.kpane').forEach((p) => { p.style.display = p.getAttribute('data-kpane') === name ? 'block' : 'none'; });
        }));
        root.style.display = 'block';
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      async function run() {
        hideAlerts();
        const payload = {
          url: $('url').value.trim(),
          focusKeyword: $('focus').value.trim(),
          competitors: $('competitors').value.trim(),
          country: $('country').value.trim() || 'us',
          lang: $('lang').value.trim() || 'en',
        };
        if (!payload.url) { showErr('Paste a Google Play app URL or package id.'); return; }

        const btn = $('go');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>Inspecting…';
        $('info').textContent = 'Fetching the live listing, scoring it, and generating keyword + copy suggestions. This can take 15–40 seconds.';
        $('info').style.display = 'block';

        try {
          const res = await fetch('/api/aso', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const data = await res.json();
          if (!res.ok) showErr(data.error || 'Something went wrong. Please try again.');
          else render(data);
        } catch (e) {
          showErr('Network error: ' + (e && e.message ? e.message : e));
        } finally {
          $('info').style.display = 'none';
          btn.disabled = false;
          btn.textContent = 'Inspect ASO';
        }
      }
      $('go').addEventListener('click', run);
      $('url').addEventListener('keydown', (e) => { if (e.key === 'Enter') run(); });
    </script>
  </body>
</html>
