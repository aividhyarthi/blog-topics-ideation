---
// LLM Access Check — fetches a URL as Googlebot, GPTBot, ClaudeBot,
// PerplexityBot, OAI-SearchBot and Bingbot, then reports what each one
// actually received. Previously lived at "/"; the homepage is now a public
// marketing page, so the tool has its own route inside the signed-in app.
import App from '../layouts/App.astro';
import { getUser } from '../lib/auth';
import { dbEnabled } from '../lib/db';

const user = await getUser(Astro as any);
const locked = !user;
const accountsDown = !dbEnabled;
---
<App tab="check" title="LLM Access Check — AI Page Audit" description="See exactly what each AI crawler can and cannot read on any page.">
  <section class="toolhead">
    <div class="wrap">
      <h1>LLM Access Check</h1>
      <p>Enter a URL and see exactly what Googlebot, ChatGPT, Perplexity, Claude and Copilot each receive — element by element.</p>
    </div>
  </section>

    <main>
      <div class="wrap">
        {locked ? (
          <div class="gatecard">
            <div class="gate-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div>
            {accountsDown ? (
              <>
                <h2>Accounts are temporarily unavailable</h2>
                <p>We can't reach the account service right now, so sign-in is paused. Please try again in a few minutes.</p>
                <p class="ownernote">Own this site? <a href="/setup">Open setup</a> to see what's missing.</p>
              </>
            ) : (
              <>
                <h2>Sign in to run a check</h2>
                <p>Create a free account and your first check is on us. After that, buy checks as you need them or go unlimited with Pro.</p>
                <div class="gate-actions">
                  <button class="btn-primary" id="gate-signup">Get started free</button>
                  <button class="btn-ghost" id="gate-login">Log in</button>
                </div>
              </>
            )}
          </div>
        ) : (
          <div class="card">
            <label class="fld" for="url">Page URL</label>
            <div class="inrow">
              <input id="url" type="url" placeholder="https://example.com/your-page" />
              <button class="primary" id="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>Check access</button>
            </div>
            <div class="pastelink">Can’t fetch it (login-walled or blocked)? <a id="pastetoggle">Paste the HTML instead</a></div>
            <div id="pastewrap"><textarea id="html" placeholder="Paste the page's HTML source here…"></textarea></div>
            <div class="alert err" id="err"></div>
            <div class="alert info" id="info"></div>
          </div>
        )}

        <section id="out"></section>
      </div>
    </main>

  {locked && (
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const wait = setInterval(() => {
          if (!window.CRAuth) return;
          clearInterval(wait);
          const su = document.getElementById('gate-signup'), li = document.getElementById('gate-login');
          if (su) su.addEventListener('click', () => window.CRAuth.openAuth('signup'));
          if (li) li.addEventListener('click', () => window.CRAuth.openAuth('login'));
        }, 50);
      });
    </script>
  )}

  <script>

      const $ = (id) => document.getElementById(id);
      const IC = {
        check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4.5 4.5L19 7"/></svg>',
        x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"/></svg>',
        alert: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5"/><path d="M12 16.5h.01"/></svg>',
        info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 11v5"/><path d="M12 8h.01"/></svg>',
        eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>',
        caret: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>',
        desktop: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>',
        mobile: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg>',
        bot: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="11" rx="2.5"/><path d="M12 8V4M9 4h6"/><circle cx="9" cy="13" r="1"/><circle cx="15" cy="13" r="1"/><path d="M2 13v2M22 13v2"/></svg>',
        copy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>',
        download: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>',
        clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
      };
      const CHIP = { read: 'read', partial: 'partial', missed: 'missed', warn: 'warn', info: 'info' };
      const CHIP_IC = { read: IC.check, partial: IC.alert, missed: IC.x, warn: IC.alert, info: IC.info };
      const TAG_TXT = { read: 'can access', partial: 'partial', missed: 'cannot access', warn: 'caution', info: 'info' };
      const ACCESS_ST = { ok: 'pass', partial: 'warn', blocked: 'fail' };
      const BOT_IC = { allowed: IC.check, default: IC.check, partial: IC.alert, blocked: IC.x };

      function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
      function showErr(m) { const e = $('err'); e.innerHTML = IC.alert + '<span>' + esc(m) + '</span>'; e.style.display = 'flex'; }
      function hideAlerts() { $('err').style.display = 'none'; $('info').style.display = 'none'; }

      let pasteMode = false;
      $('pastetoggle').addEventListener('click', () => {
        pasteMode = !pasteMode;
        $('pastewrap').style.display = pasteMode ? 'block' : 'none';
        $('pastetoggle').textContent = pasteMode ? 'use a URL instead' : 'Paste the HTML instead';
      });

      function renderTag(r) {
        return r.type === 'html'
          ? `<span class="rendertag html">${IC.check} <b>Server HTML</b>${r.framework ? ' · ' + esc(r.framework) : ''} · ${r.words} words</span>`
          : `<span class="rendertag js">${IC.x} <b>JavaScript-rendered</b>${r.framework ? ' · ' + esc(r.framework) : ''} · ${r.words} words in HTML</span>`;
      }
      function groupHtml(groups) {
        return groups.map((g) => {
          const c = { read: 0, warn: 0, missed: 0 };
          g.items.forEach((i) => { if (i.status === 'read' || i.status === 'info') c.read++; else if (i.status === 'missed') c.missed++; else c.warn++; });
          const pills = `<span class="gpills">${c.read ? `<span class="gpill read">${c.read}</span>` : ''}${c.warn ? `<span class="gpill warn">${c.warn}</span>` : ''}${c.missed ? `<span class="gpill missed">${c.missed}</span>` : ''}</span>`;
          const open = c.missed || c.warn ? ' open' : '';
          const items = g.items.map((i) => `<div class="git"><span class="gchip ${CHIP[i.status]}">${CHIP_IC[i.status]}</span><div><div class="gname">${esc(i.label)} <span class="gtag ${CHIP[i.status]}">${TAG_TXT[i.status]}</span></div><div class="gdetail">${esc(i.detail)}</div></div></div>`).join('');
          return `<details class="grp"${open}><summary><span class="caret">${IC.caret}</span>${esc(g.title)}${pills}<span class="gcount">${g.items.length}</span></summary><div class="gitems">${items}</div></details>`;
        }).join('');
      }
      function tabPanel(view, isPasted) {
        const rows = (view.access || []).map((a) => {
          const cls = a.status === 'ok' ? 'ok' : 'blocked';
          return `<div class="arow ${cls}"><span class="aic">${a.status === 'ok' ? IC.check : IC.x}</span><div><div class="awho">${esc(a.who)} <span class="akind">${esc(a.kind)}</span></div><div class="anote">${esc(a.note)}</div></div></div>`;
        }).join('');
        const lazy = view.render && view.render.lazy ? `<div class="banner warn">${IC.alert}<div><b>Delayed / lazy content detected:</b> ${esc(view.render.lazyDetail)}. A crawler that doesn’t scroll or wait may never load it.</div></div>` : '';
        return `
          ${isPasted ? '' : `<div class="sectitle">Access &amp; rendering</div><div class="accessrows">${rows}</div>`}
          <div style="margin-top:12px" class="rendertags">${renderTag(view.render)}</div>
          ${lazy}
          <div class="sectitle">What can be read — navigation to footer</div>
          ${groupHtml(view.groups)}`;
      }

      function contentBlock(c) {
        if (!c || !c.hasAny) return '';
        const rows = [];
        if (c.name) rows.push(`<div class="cname">${esc(c.name)}</div>`);
        const meta = [];
        if (c.brand) meta.push(`<span class="cpill">${esc(c.brand)}</span>`);
        if (c.price) meta.push(`<span class="cpill price">${esc(c.price)}</span>`);
        if (c.availability) meta.push(`<span class="cpill">${esc(c.availability)}</span>`);
        if (c.rating && c.rating.value) meta.push(`<span class="cpill rating">★ ${esc(c.rating.value)}${c.rating.ratings ? ` · ${Number(c.rating.ratings).toLocaleString()} ratings` : ''}${c.rating.reviews ? ` · ${Number(c.rating.reviews).toLocaleString()} reviews` : ''}</span>`);
        if (meta.length) rows.push(`<div class="cmeta">${meta.join('')}</div>`);
        if (c.description) rows.push(`<div class="cdesc">${esc(c.description)}</div>`);
        let html = `<div class="cprod">${rows.join('')}</div>`;
        if (c.keywords && c.keywords.length) html += `<div class="csub">Topics / keywords the page targets</div><div class="ckeys">${c.keywords.map((k) => `<span class="ckey">${esc(k)}</span>`).join('')}</div>`;
        if (c.attributes && c.attributes.length) html += `<div class="csub">Attributes / specs</div><div class="cattrs">${c.attributes.map((a) => `<div class="cattr"><span class="ck">${esc(a.name)}</span><span class="cv">${esc(a.value)}</span></div>`).join('')}</div>`;
        if (c.sections && c.sections.length) html += `<div class="csub">Content sections</div>` + c.sections.map((s) => `<div class="csec"><div class="csech">${esc(s.heading)} <span class="cwords">${s.words} words</span></div><div class="csect">${esc(s.text)}</div></div>`).join('');
        if (c.faqs && c.faqs.length) html += `<div class="csub">FAQs (${c.faqs.length})</div>` + c.faqs.map((f) => `<div class="cfaq"><div class="cfq">${esc(f.q)}</div><div class="cfa">${esc(f.a)}</div></div>`).join('');
        if (c.reviews && c.reviews.length) html += `<div class="csub">Review snippets (${c.reviews.length} in the HTML)</div>` + c.reviews.map((r) => `<div class="crev">“${esc(r)}”</div>`).join('');
        return `<div class="sectitle" style="margin-top:22px">Content extracted from this page <span style="font-weight:500;color:var(--muted)">— the actual data an LLM pulls</span></div><div class="content-card">${html}</div>`;
      }

      function renderResult(d) {
        const out = $('out'), isPasted = d.mode === 'pasted';
        const v = d.overall;
        let html = `
          <div class="viscard ${v.level}">
            <div class="verdicthead">
              <span class="vbadge ${v.level}">${v.level === 'yes' ? IC.check : v.level === 'no' ? IC.x : IC.alert} ${esc(v.label)}</span>
              <span class="rendertags">${d.desktop ? `<span class="rendertag ${d.desktop.render.type}">${IC.desktop} ${d.desktop.render.type === 'html' ? 'Desktop: HTML' : 'Desktop: JS'}</span>` : ''}${!isPasted && d.mobile ? `<span class="rendertag ${d.mobile.render.type}">${IC.mobile} ${d.mobile.render.type === 'html' ? 'Mobile: HTML' : 'Mobile: JS'}</span>` : ''}</span>
            </div>
            <div class="vreason">${esc(v.reason)}</div>
            ${d.host ? `<div class="vhost">${esc(d.url || d.host)}${d.pageTypeLabel ? ` · detected as <b>${esc(d.pageTypeLabel)}</b>` : ''}</div>` : (d.pageTypeLabel ? `<div class="vhost">Detected as <b>${esc(d.pageTypeLabel)}</b></div>` : '')}
            ${d.fetchNote ? `<div class="banner bad">${IC.alert}<div>${esc(d.fetchNote)}</div></div>` : ''}
            ${!isPasted && d.parity && !d.parity.same ? `<div class="banner warn">${IC.alert}<div><b>Mobile ≠ Desktop.</b> ${esc(d.parity.note)}</div></div>` : ''}
          </div>
          <div class="resbar"><button class="ghostbtn" id="copyall">${IC.copy} Copy all</button><button class="ghostbtn" id="pdfbtn">${IC.download} Download PDF</button></div>`;

        html += contentBlock(d.content);

        // Content gaps — the missing bits competitors / ChatGPT exploit.
        if (d.gaps && d.gaps.length) {
          html += `<div class="sectitle" style="margin-top:22px">Content gaps <span style="font-weight:500;color:var(--muted)">— what's missing (competitors &amp; AI exploit these)</span></div><div class="gaps-card">${d.gaps.map((g) => `<div class="gap2">${IC.x}<div><b>${esc(g.label)}</b><span>${esc(g.detail)}</span></div></div>`).join('')}</div>`;
        }

        // Tabs: Desktop | Mobile (fetched now) + one tab per AI bot (run on-demand).
        const botTabs = d.botTabs || [];
        const tabBtns = [
          `<button class="tab active" data-tab="desktop">${IC.desktop} Desktop</button>`,
          `<button class="tab" data-tab="mobile">${IC.mobile} Mobile</button>`,
          ...botTabs.map((b) => `<button class="tab" data-tab="bot-${b.id}">${IC.bot} ${esc(b.label)}</button>`),
        ].join('');
        const botPanels = botTabs.map((b) => `
          <div class="tabpanel" id="tab-bot-${b.id}">
            <div class="botrun">
              <div class="botrun-h">${esc(b.label)} <span class="botrun-sub">${esc(b.sub)}</span></div>
              <div class="botrun-p">We fetch the page <b>live as ${esc(b.sub)}</b> and show exactly what this crawler can read. Runs are spaced out (1-min cooldown) so we never burst the site and trigger a false block.</div>
              ${isPasted
                ? `<div class="pasted-note" style="margin:8px 0 0">${IC.info} Live crawler checks need a URL — paste mode can't run bots.</div>`
                : `<button class="primary botgo" data-bot="${b.id}" data-label="${esc(b.label)}">${IC.bot} Run ${esc(b.label)}</button>`}
            </div>
            <div id="botout-${b.id}"></div>
          </div>`).join('');

        html += `
          <div class="sectitle" style="margin-top:22px">Fetch as each agent <span style="font-weight:500;color:var(--muted)">— Desktop &amp; Mobile now; each AI bot on demand</span></div>
          <div class="tabs tabs-wrap">${tabBtns}</div>
          ${isPasted ? `<div class="pasted-note">${IC.info} Pasted HTML is a single snapshot. Enter a live <b>URL</b> to compare Desktop vs Mobile and to run each AI crawler.</div>` : ''}
          <div class="tabpanel active" id="tab-desktop">${tabPanel(d.desktop, isPasted)}</div>
          <div class="tabpanel" id="tab-mobile">${tabPanel(d.mobile, isPasted)}</div>
          ${botPanels}`;

        // shared: who sees what + LLM crawler + robots bots
        const viewers = (d.viewers || []).map((vw) => {
          const st = ACCESS_ST[vw.access];
          return `<div class="viewer ${st}"><div class="vw-top"><span class="vw-who">${esc(vw.who)}</span><span class="vw-js ${vw.rendersJs ? 'yes' : 'no'}">${vw.rendersJs ? 'runs JS' : 'no JS'}</span></div><div class="vw-access ${st}">${vw.access === 'ok' ? IC.check : vw.access === 'partial' ? IC.alert : IC.x} ${vw.access === 'ok' ? 'Can read it' : vw.access === 'partial' ? 'Partial' : 'Blocked'}</div><div class="vw-sees">${esc(vw.sees)}</div></div>`;
        }).join('');
        html += `<div class="sectitle">Who sees what</div><div class="viewers">${viewers}</div>`;

        if (d.bots && d.bots.length) {
          html += `<div class="sectitle">Are the AI crawlers allowed? (robots.txt)</div><div class="bots">${d.bots.map((b) => `<div class="botrow"><span class="botname">${esc(b.label)}</span><span class="botbadge ${b.status}">${BOT_IC[b.status]} ${b.status === 'blocked' ? 'Blocked' : b.status === 'partial' ? 'Partial' : 'Allowed'}</span></div>`).join('')}</div>`;
        }

        html += `<div class="note">Googlebot runs JavaScript, so it sees your full page. The AI answer crawlers (ChatGPT, Claude, Perplexity) do <b>not</b> run JavaScript — they read only the raw HTML, so anything injected by JS is invisible to them. Want scores, fixes and a real-engine citation check? <a href="/audit">Run the full AEO audit →</a></div>`;

        out.innerHTML = html;
        out.querySelectorAll('.tab').forEach((t) => t.addEventListener('click', () => {
          out.querySelectorAll('.tab').forEach((x) => x.classList.remove('active'));
          out.querySelectorAll('.tabpanel').forEach((x) => x.classList.remove('active'));
          t.classList.add('active');
          $('tab-' + t.dataset.tab).classList.add('active');
        }));
        out.querySelectorAll('.botgo').forEach((btn) => btn.addEventListener('click', () => runBot(d.url, btn.dataset.bot, btn.dataset.label, btn)));
        const pdfBtn = $('pdfbtn'); if (pdfBtn) pdfBtn.addEventListener('click', () => window.print());
        const copyBtn = $('copyall'); if (copyBtn) copyBtn.addEventListener('click', () => copyAll(d));
        out.style.display = 'block';
        out.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function showToast(msg) { let t = $('toast'); if (!t) { t = document.createElement('div'); t.id = 'toast'; t.className = 'toast'; document.body.appendChild(t); } t.textContent = msg; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 1900); }
      async function copyAll(d) {
        const c = d.content || {}, L = [];
        L.push(`# LLM Access Check — ${d.url || 'Pasted HTML'}`);
        if (d.pageTypeLabel) L.push(`Page type: ${d.pageTypeLabel}`);
        L.push(`Verdict: ${d.overall.label} — ${d.overall.reason}`);
        L.push('');
        if (c.name) L.push(`## ${c.name}`);
        const meta = [c.brand, c.price, c.availability, c.rating && c.rating.value ? `★ ${c.rating.value}${c.rating.ratings ? ` · ${c.rating.ratings} ratings` : ''}${c.rating.reviews ? ` · ${c.rating.reviews} reviews` : ''}` : ''].filter(Boolean);
        if (meta.length) L.push(meta.join(' · '));
        if (c.description) { L.push(''); L.push(c.description); }
        if (c.keywords && c.keywords.length) { L.push(''); L.push(`Keywords: ${c.keywords.join(', ')}`); }
        if (c.attributes && c.attributes.length) { L.push(''); L.push('### Attributes'); c.attributes.forEach((a) => L.push(`- ${a.name}: ${a.value}`)); }
        if (c.sections && c.sections.length) { c.sections.forEach((s) => { L.push(''); L.push(`### ${s.heading} (${s.words} words)`); L.push(s.text); }); }
        if (c.faqs && c.faqs.length) { L.push(''); L.push('### FAQs'); c.faqs.forEach((f) => { L.push(`**${f.q}**`); L.push(f.a); }); }
        if (c.reviews && c.reviews.length) { L.push(''); L.push('### Review snippets'); c.reviews.forEach((r) => L.push(`- "${r}"`)); }
        if (d.gaps && d.gaps.length) { L.push(''); L.push('### Content gaps'); d.gaps.forEach((g) => L.push(`- ${g.label}: ${g.detail}`)); }
        L.push(''); L.push('Generated by AI Page Audit · LLM Access Check');
        try { await navigator.clipboard.writeText(L.join('\n')); showToast('Copied all content to clipboard'); }
        catch { showToast('Copy failed — select & copy manually'); }
      }

      // ---- on-demand per-bot runs with a shared cooldown ----
      const COOLDOWN_MS = 60000;
      let cooldownUntil = 0, cdInt = null;
      function refreshCooldown() {
        const remain = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
        document.querySelectorAll('.botgo').forEach((b) => {
          if (b.dataset.running) return;
          const ran = (document.getElementById('botout-' + b.dataset.bot) || {}).childElementCount > 0;
          if (remain > 0) { b.disabled = true; b.innerHTML = IC.clock + ' Run available in ' + remain + 's'; }
          else { b.disabled = false; b.innerHTML = IC.bot + ' ' + (ran ? 'Re-run ' : 'Run ') + b.dataset.label; }
        });
        if (remain <= 0 && cdInt) { clearInterval(cdInt); cdInt = null; }
      }
      function startCooldown() { cooldownUntil = Date.now() + COOLDOWN_MS; if (!cdInt) cdInt = setInterval(refreshCooldown, 1000); refreshCooldown(); }
      function renderBot(r) {
        const SCLS = { ok: 'allowed', blocked: 'blocked', noresponse: 'blocked', partial: 'partial' };
        const STXT = { ok: 'Can read', blocked: 'Blocked', noresponse: 'No response', partial: 'Partial' };
        const cls = SCLS[r.status] || 'partial';
        const ic = r.status === 'ok' ? IC.check : r.status === 'partial' ? IC.alert : IC.x;
        let h = `<div class="airow ${cls}" style="margin-top:14px"><div class="aitop"><span class="ainame">${esc(r.label)}</span><span class="aibadge ${cls}">${ic} ${STXT[r.status] || r.status}${r.status === 'ok' && r.words ? ` · ${r.words}w` : ''}</span></div><div class="ainote">${esc(r.note)}</div></div>`;
        if (r.render) h += `<div style="margin-top:12px" class="rendertags">${renderTag(r.render)}</div>`;
        if (r.groups) h += `<div class="sectitle">What this crawler can read</div>${groupHtml(r.groups)}`;
        return h;
      }
      async function runBot(url, bot, label, btn) {
        if (Date.now() < cooldownUntil || !url) return;
        btn.dataset.running = '1'; btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>Running ' + label + '…';
        const out = document.getElementById('botout-' + bot);
        try {
          const res = await fetch('/api/access-bot', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ url, bot }) });
          const r = await res.json();
          out.innerHTML = res.ok ? renderBot(r) : `<div class="banner bad" style="margin-top:12px">${IC.alert}<div>${esc(r.error || 'Failed to run this crawler.')}</div></div>`;
        } catch (e) { out.innerHTML = `<div class="banner bad" style="margin-top:12px">${IC.alert}<div>Network error running this crawler.</div></div>`; }
        finally { delete btn.dataset.running; startCooldown(); }
      }

      async function run() {
        hideAlerts();
        const payload = {};
        if (pasteMode) { const html = $('html').value.trim(); if (!html) { showErr('Paste the page HTML to check.'); return; } payload.html = html; }
        else { const url = $('url').value.trim(); if (!url) { showErr('Enter a page URL to check.'); return; } payload.url = url; }
        const btn = $('go');
        btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>Checking…';
        $('info').innerHTML = IC.eye + '<span>Fetching as Googlebot (desktop &amp; mobile), real devices and GPTBot, then auditing the HTML… ~10–20s.</span>';
        $('info').style.display = 'flex';
        try {
          const res = await fetch('/api/access', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const d = await res.json();
          if (!res.ok) {
            // Session expired / never signed in — prompt to sign in and retry.
            if (d.requireAuth && window.CRAuth) { $('info').style.display = 'none'; window.CRAuth.requireAuth(run); return; }
            showErr(d.error || 'Something went wrong.');
          } else renderResult(d);
        } catch (e) { showErr('Network error: ' + (e && e.message ? e.message : e)); }
        finally { $('info').style.display = 'none'; btn.disabled = false; btn.innerHTML = IC.eye + 'Check access'; }
      }
      // An account is required to run a check — gate the button through CRAuth.
      function goClicked() { if (window.CRAuth) window.CRAuth.requireAuth(run); else run(); }
      $('go').addEventListener('click', goClicked);
      $('url').addEventListener('keydown', (e) => { if (e.key === 'Enter') goClicked(); });
    
  </script>

