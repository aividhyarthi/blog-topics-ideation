---
import Site from '../layouts/Site.astro';

// Real AEO/GEO industry news — editorial summaries of publicly reported
// developments, not a product changelog. Kept factual and conservative
// (no invented stats or quotes); each links the development back to what it
// means for site owners.
const items = [
  {
    date: 'Ongoing',
    tag: 'Search',
    title: 'Google AI Overviews keeps expanding — and keeps changing who gets cited',
    body: 'Google has continued rolling AI Overviews out to more countries and more query types since its 2024 debut, generating an AI-written summary above traditional results for a large share of searches. Because Overviews synthesizes and cites a handful of sources rather than listing ten links, which pages get pulled in has become its own optimization problem — separate from, and sometimes at odds with, classic ranking position. Sites that are technically well-structured (clear schema, direct answers, FAQ blocks) are more often the ones AI Overviews quotes.',
  },
  {
    date: 'Ongoing',
    tag: 'Crawlers',
    title: 'The AI crawler roster keeps growing — and so does the JavaScript blind spot',
    body: 'OpenAI (GPTBot, OAI-SearchBot), Anthropic (ClaudeBot) and Perplexity (PerplexityBot) all now operate distinct crawlers with published robots.txt tokens, alongside Google\'s long-standing Googlebot and the newer Google-Extended opt-out token for AI training/grounding. A detail that trips up most sites: none of the answer-engine crawlers execute JavaScript the way Googlebot does. A page that ranks perfectly well on Google can be an empty shell to every one of the AI crawlers if its content loads client-side — a gap CiteRank\'s LLM Access Check is built specifically to surface.',
  },
  {
    date: 'Ongoing',
    tag: 'Research',
    title: 'The academic case for GEO: Princeton\'s study on what gets cited by generative engines',
    body: 'Researchers at Princeton, Georgia Tech, Allen Institute for AI and IIT Delhi published "GEO: Generative Engine Optimization," one of the first empirical studies measuring what content changes actually increase citation by AI answer engines. Their findings pointed to concrete, testable levers: adding statistics and data points, citing authoritative sources, and including direct quotations meaningfully increased how often a source was cited in generated answers — giving the AEO/GEO field its first real evidence base instead of just intuition.',
  },
  {
    date: 'Ongoing',
    tag: 'Publishers',
    title: 'Perplexity\'s publisher program signals a shift toward compensating cited sources',
    body: 'Perplexity launched a publisher partner program that shares advertising revenue with outlets whose content gets cited in its answers — an early sign that answer engines are starting to formalize a relationship with the sites they depend on for source material, rather than treating citation purely as a byproduct of crawling. It reinforces a wider trend: being citable is becoming a distinct commercial asset for publishers, separate from, and now sometimes fought over alongside, search referral traffic.',
  },
  {
    date: 'Ongoing',
    tag: 'Infrastructure',
    title: 'Cloudflare\'s AI-crawler defaults put publisher permission back in the spotlight',
    body: 'Cloudflare, which sits in front of a large share of the web, has pushed policies that let (and in some configurations default to) blocking AI crawlers unless a site owner explicitly allows them, and has floated pay-per-crawl style marketplace ideas for AI companies to compensate sites for access. Whatever the eventual business model, the practical effect for site owners is the same: crawler access is no longer a given, and checking whether your CDN/WAF is silently blocking GPTBot, ClaudeBot or PerplexityBot — even when your robots.txt allows them — is now a routine technical audit, not an edge case.',
  },
  {
    date: 'Ongoing',
    tag: 'ChatGPT',
    title: 'ChatGPT Search made live, cited answers a mainstream ChatGPT feature',
    body: 'OpenAI\'s ChatGPT Search (and the OAI-SearchBot crawler that powers it) brought real-time, cited web answers directly into ChatGPT\'s main interface rather than a separate product — putting it in the same category as Perplexity and Google\'s AI-first surfaces. For site owners, it means the OpenAI crawler that matters for training (GPTBot) and the one that matters for being cited in live answers (OAI-SearchBot) are genuinely different bots with different robots.txt tokens, and a site can allow one while blocking the other without realizing it.',
  },
];
---
<Site title="AEO / GEO News — CiteRank" description="What's happening in Answer Engine Optimization: AI crawlers, Google AI Overviews, research and industry moves.">
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow">News</span>
      <h1>What's happening in AI search</h1>
      <p>Developments in Answer Engine Optimization — crawlers, research and industry moves — explained plainly.</p>
    </div>
  </section>
  <main>
    <div class="wrap news">
      {items.map((it) => (
        <div class="newsitem">
          <div class="ni-side"><span class={`ni-tag ${it.tag.toLowerCase()}`}>{it.tag}</span><span class="ni-date">{it.date}</span></div>
          <div class="ni-body"><h3>{it.title}</h3><p>{it.body}</p></div>
        </div>
      ))}
    </div>
    <div class="wrap news-cta">
      <p>Want to know where your own site stands on any of this? <a href="/">Run a free LLM Access Check</a> to see exactly which AI crawlers can read your pages.</p>
    </div>
  </main>
  <style>
    .news { max-width: 820px; }
    .newsitem { display: grid; grid-template-columns: 130px 1fr; gap: 20px; padding: 24px 0; border-top: 1px solid var(--line); }
    .newsitem:first-child { border-top: none; }
    @media (max-width: 560px) { .newsitem { grid-template-columns: 1fr; gap: 8px; } }
    .ni-side { display: flex; flex-direction: column; gap: 7px; }
    .ni-tag { display: inline-block; width: fit-content; font-size: 10.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; background: var(--accent-soft); color: var(--pink); }
    .ni-date { font-size: 12.5px; color: var(--faint); font-weight: 600; }
    .ni-body h3 { margin: 0 0 8px; font-size: 18px; font-weight: 700; letter-spacing: -.01em; line-height: 1.35; }
    .ni-body p { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.7; }
    .news-cta { max-width: 820px; margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--line); }
    .news-cta p { font-size: 14px; color: var(--ink-2); }
  </style>
</Site>
