---
import Site from '../layouts/Site.astro';
const items = [
  { date: 'Jul 2026', tag: 'New', title: 'A tab for every AI crawler', body: 'Run your page live as ChatGPT, ChatGPT Search, Perplexity, Claude, Copilot and Google AI — each in its own tab, on demand, with smart pacing so results stay accurate.' },
  { date: 'Jul 2026', tag: 'New', title: 'Content extraction like ChatGPT', body: 'CiteRank now pulls the real data from your page — name, rating, reviews, ingredients, specs, FAQs — and flags what’s declared vs actually in the HTML.' },
  { date: 'Jul 2026', tag: 'Improved', title: 'Category-aware product audits', body: 'A beauty product is now checked for shade, size and ingredients; electronics for specs and warranty; automotive for engine and mileage — and any other product reads its own declared attributes automatically.' },
  { date: 'Jun 2026', tag: 'New', title: 'Desktop vs Mobile crawler view', body: 'See how the site serves Googlebot desktop vs smartphone, with a content-parity warning when mobile is served less — the version Google actually ranks.' },
  { date: 'Jun 2026', tag: 'New', title: 'Content gaps &amp; PDF export', body: 'Every report now lists the missing pieces competitors exploit, and exports to PDF or copies as Markdown in one click.' },
  { date: 'Jun 2026', tag: 'Launch', title: 'CiteRank AEO/GEO platform is live', body: 'The LLM Access Check and full AEO audit are now available — the toolkit for ranking in AI search.' },
];
---
<Site title="News &amp; Updates — CiteRank" description="Product updates and news from CiteRank, the AEO/GEO platform.">
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow">News &amp; Updates</span>
      <h1>What’s new at CiteRank</h1>
      <p>Product updates, new features and notes from the frontier of AI search optimization.</p>
    </div>
  </section>
  <main>
    <div class="wrap news">
      {items.map((it) => (
        <div class="newsitem">
          <div class="ni-side"><span class={`ni-tag ${it.tag.toLowerCase()}`}>{it.tag}</span><span class="ni-date">{it.date}</span></div>
          <div class="ni-body"><h3 set:html={it.title}></h3><p set:html={it.body}></p></div>
        </div>
      ))}
    </div>
  </main>
  <style>
    .news { max-width: 820px; }
    .newsitem { display: grid; grid-template-columns: 130px 1fr; gap: 20px; padding: 22px 0; border-top: 1px solid var(--line); }
    .newsitem:first-child { border-top: none; }
    @media (max-width: 560px) { .newsitem { grid-template-columns: 1fr; gap: 8px; } }
    .ni-side { display: flex; flex-direction: column; gap: 7px; }
    .ni-tag { display: inline-block; width: fit-content; font-size: 10.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; }
    .ni-tag.new { background: var(--ok-bg); color: var(--ok); }
    .ni-tag.improved { background: var(--accent-soft); color: var(--pink); }
    .ni-tag.launch { background: var(--warn-bg); color: var(--warn); }
    .ni-date { font-size: 12.5px; color: var(--faint); font-weight: 600; }
    .ni-body h3 { margin: 0 0 6px; font-size: 17px; font-weight: 700; letter-spacing: -.01em; }
    .ni-body p { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.6; }
  </style>
</Site>
