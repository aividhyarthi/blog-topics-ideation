---
// Super-admin panel — the owner's day-to-day console for the "scan & pay,
// then I enable the login" billing flow. See every signup, activate a plan
// the moment a UPI payment lands, extend trials, cancel, check whether the
// nightly rank check actually ran, and trigger a full check on demand.
// Gated on ADMIN_EMAILS; everyone else 404s (see /api/admin for the same
// gate on the data).
import { BRAND, isAdminEmail } from '../lib/saas/plans';

const user = Astro.locals.user;
if (!Astro.locals.productMode || !user || !isAdminEmail(user.email)) {
  return new Response('Not found.', { status: 404 });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>{BRAND} — Admin</title>
    <style>
      :root { --pink: #16181d; --pink-dark: #000000; --ink: #16181d; --muted: #6b7280; --line: #e5e7eb; --bg: #f8f9fb; --ok: #0a8a5f; --bad: #c0392b; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.5; }
      .wrap { max-width: 1100px; margin: 0 auto; padding: 0 22px 60px; }
      header.top { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; flex-wrap: wrap; gap: 10px; }
      .logo { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; color: var(--ink); text-decoration: none; }
      .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: #16181d; color: #fff; display: grid; place-items: center; font-size: 14px; }
      .logo .admintag { font-size: 10px; font-weight: 800; color: var(--muted); background: #f3f4f6; border: 1px solid var(--line); padding: 2px 7px; border-radius: 999px; }
      .navlinks a { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; margin-left: 14px; }
      .navlinks a:hover { color: var(--ink); }
      h1 { font-size: 24px; letter-spacing: -0.02em; margin: 18px 0 4px; }
      .sub { color: var(--muted); font-size: 14px; margin: 0 0 24px; }
      .card { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 20px 22px; margin-bottom: 18px; }
      .card h2 { font-size: 15px; margin: 0 0 12px; letter-spacing: -0.01em; }
      table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
      th { text-align: left; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); padding: 8px 10px 8px 0; border-bottom: 2px solid var(--ink); }
      td { padding: 10px 10px 10px 0; border-bottom: 1px solid var(--line); vertical-align: middle; }
      tr:last-child td { border-bottom: none; }
      .status-pill { display: inline-block; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; }
      .status-active { background: #e6f5ef; color: var(--ok); }
      .status-trialing { background: #f3f4f6; color: var(--muted); }
      .status-canceled, .status-past_due { background: #fdecec; color: var(--bad); }
      button { border: 1px solid var(--line); background: #fff; color: var(--ink); font-size: 12.5px; font-weight: 600; padding: 6px 11px; border-radius: 8px; cursor: pointer; font-family: inherit; margin: 2px 4px 2px 0; }
      button:hover { border-color: var(--ink); }
      button:disabled { opacity: 0.5; cursor: default; }
      button.primary { background: var(--pink); border-color: var(--pink); color: #fff; }
      button.primary:hover { background: var(--pink-dark); }
      button.danger:hover { border-color: var(--bad); color: var(--bad); }
      .runline { font-size: 13.5px; margin: 4px 0; }
      .runline b { font-weight: 700; }
      .ok { color: var(--ok); } .bad { color: var(--bad); }
      pre { background: #f7f7f8; border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; font-size: 12px; overflow-x: auto; max-height: 300px; margin: 10px 0 0; }
      .toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; font-size: 13.5px; font-weight: 600; padding: 11px 18px; border-radius: 10px; display: none; max-width: 90vw; }
      .muted { color: var(--muted); }
      @media (max-width: 760px) { .tablewrap { overflow-x: auto; } table { min-width: 760px; } }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <a class="logo" href="/rank"><span class="mark">▲</span>{BRAND}<span class="admintag">ADMIN</span></a>
        <nav class="navlinks">
          <a href="/rank">Rank Tracker</a>
          <a href="/aso">ASO Inspector</a>
          <a href="/account">Account</a>
        </nav>
      </header>

      <h1>Admin</h1>
      <p class="sub">Activate users after a payment, manage trials, and check that the daily rank check is actually running.</p>

      <div class="card">
        <h2>Daily automatic check</h2>
        <div id="runstatus"><span class="muted">Loading…</span></div>
        <div style="margin-top:12px;">
          <button class="primary" id="runnow">Run full check now</button>
          <span class="muted" style="font-size:12.5px;">Checks every active user's apps + coverage lists immediately — use this if the data looks stale.</span>
        </div>
        <pre id="runlog" style="display:none;"></pre>
      </div>

      <div class="card">
        <h2>Users</h2>
        <div class="tablewrap">
          <table>
            <thead><tr><th>Email</th><th>Name</th><th>Status</th><th>Plan</th><th>Trial ends</th><th>Apps</th><th>Signed up</th><th>Actions</th></tr></thead>
            <tbody id="userrows"><tr><td colspan="8" class="muted">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="toast" id="toast"></div>

    <script>
      const $ = (id) => document.getElementById(id);
      let state = null;

      function toast(msg) {
        const t = $('toast'); t.textContent = msg; t.style.display = 'block';
        clearTimeout(t._h); t._h = setTimeout(() => { t.style.display = 'none'; }, 4000);
      }

      async function api(body) {
        const res = await fetch('/api/admin', body
          ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }
          : undefined);
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
        return data;
      }

      const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
      const fmtDate = (iso) => iso ? new Date(iso).toLocaleString() : '–';

      function render() {
        const run = state.lastRun;
        const sched = state.scheduler;
        let html = '';
        if (!run) {
          html += `<div class="runline bad"><b>No automatic check has ever run on this deployment.</b> If this stays true after the next scheduled time below, the deployed code is out of date — check that Railway is deploying the latest push.</div>`;
        } else if (!run.finishedAt) {
          html += `<div class="runline"><b>Check in progress</b> — started ${fmtDate(run.startedAt)} (${esc(run.trigger)}).</div>`;
        } else {
          const cls = run.error ? 'bad' : 'ok';
          html += `<div class="runline"><b class="${cls}">Last check:</b> ${fmtDate(run.startedAt)} → ${fmtDate(run.finishedAt)} · ${run.checkedApps} app(s), ${run.checkedCoverage} coverage list(s) · trigger: ${esc(run.trigger)}${run.error ? ` · <span class="bad">${esc(run.error)}</span>` : ''}</div>`;
        }
        html += `<div class="runline muted">Next automatic check: ${fmtDate(sched.nextRunAt)} (daily at ${esc(sched.checkTimeUtc)} UTC${sched.checkTimeUtc === '06:30' ? ' = 12:00 noon IST' : ''})</div>`;
        $('runstatus').innerHTML = html;

        if (run && run.lines && run.lines.length) {
          $('runlog').style.display = 'block';
          $('runlog').textContent = run.lines.join('\n');
        }

        $('userrows').innerHTML = state.users.map((u) => `
          <tr>
            <td><b>${esc(u.email)}</b></td>
            <td>${esc(u.name || '–')}</td>
            <td><span class="status-pill status-${esc(u.status)}">${esc(u.status)}</span></td>
            <td>${esc(u.plan)}</td>
            <td>${u.trialEndsAt ? new Date(u.trialEndsAt).toLocaleDateString() : '–'}</td>
            <td>${u.apps}</td>
            <td>${new Date(u.createdAt).toLocaleDateString()}</td>
            <td>
              <button data-act="set-plan" data-id="${esc(u.id)}" data-plan="starter">Activate Starter</button>
              <button data-act="set-plan" data-id="${esc(u.id)}" data-plan="pro">Activate Pro</button>
              <button data-act="extend-trial" data-id="${esc(u.id)}">+7d trial</button>
              <button class="danger" data-act="cancel" data-id="${esc(u.id)}">Cancel</button>
            </td>
          </tr>`).join('') || '<tr><td colspan="8" class="muted">No signups yet.</td></tr>';
      }

      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('button[data-act]');
        if (!btn) return;
        const act = btn.getAttribute('data-act');
        const userId = btn.getAttribute('data-id');
        btn.disabled = true;
        try {
          if (act === 'set-plan') {
            const plan = btn.getAttribute('data-plan');
            const ref = prompt('Optional: payment reference (UPI txn id) — leave blank to skip.') || '';
            state = await api({ action: 'set-plan', userId, plan, paymentRef: ref.trim() });
            toast(`Activated on ${plan}.`);
          } else if (act === 'cancel') {
            if (!confirm('Cancel this user\'s access? They keep their data but lose dashboard access until re-activated.')) { btn.disabled = false; return; }
            state = await api({ action: 'cancel', userId });
            toast('Canceled.');
          } else if (act === 'extend-trial') {
            state = await api({ action: 'extend-trial', userId, days: 7 });
            toast('Trial extended by 7 days.');
          }
          render();
        } catch (err) { toast(err.message); }
        btn.disabled = false;
      });

      $('runnow').addEventListener('click', async () => {
        $('runnow').disabled = true;
        try {
          const data = await api({ action: 'run-check' });
          state = data; render();
          toast(data.note || 'Check started.');
        } catch (err) { toast(err.message); }
        setTimeout(() => { $('runnow').disabled = false; }, 3000);
      });

      (async () => {
        try { state = await api(); render(); }
        catch (err) { toast(err.message); }
      })();
    </script>
  </body>
</html>
