---
// Public marketing homepage. Deliberately NOT gated — the tool itself lives at
// /check behind login, but a locked front door made the product look broken to
// anyone arriving cold.
import Site from '../layouts/Site.astro';

const origin = new URL(Astro.request.url).origin;
const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AI Page Audit',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: origin,
  description:
    'Fetches your pages as Googlebot, GPTBot, ClaudeBot, PerplexityBot and OAI-SearchBot, then reports exactly what each crawler can and cannot read.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'INR',
    description: 'First check free, then one-time credit packs or a monthly Pro plan.',
  },
};

// An illustrative result, clearly labelled as one on the page. The shape is the
// common real-world failure: Google renders the JavaScript and sees everything,
// the answer engines fetch raw HTML and see a shell, and one is blocked outright
// at the CDN.
const crawlers = [
  { name: 'Googlebot', note: 'renders JavaScript', pct: 100 },
  { name: 'Bingbot', note: 'renders JavaScript', pct: 96 },
  { name: 'OAI-SearchBot', note: 'raw HTML only', pct: 22 },
  { name: 'GPTBot', note: 'raw HTML only', pct: 22 },
  { name: 'ClaudeBot', note: 'raw HTML only', pct: 19 },
  { name: 'PerplexityBot', note: 'blocked at the CDN', pct: 0 },
];



const features = [
  { icon: '🔎', h: 'LLM Access Check', p: 'Fetch any URL as Googlebot, ChatGPT, Perplexity, Claude, Copilot and Google AI — and see exactly what each crawler can and can’t read, from navigation to footer.' },
  { icon: '🧩', h: 'Per-crawler tabs', p: 'A dedicated tab for every AI bot, run on demand with smart pacing so you get clean results without tripping the site’s rate-limiter.' },
  { icon: '📄', h: 'Content extraction', p: 'Pulls the real data an LLM reads — title, rating, reviews, ingredients, specs, FAQs — and flags what’s declared vs actually in the HTML.' },
  { icon: '🛒', h: 'Page-type aware', p: 'Detects article, product or listing — and the vertical (beauty, electronics, fashion, automotive) — then runs the right checks for that page.' },
  { icon: '⚡', h: 'JavaScript & render analysis', p: 'Spots content injected by JavaScript, lazy-loaded media, tabs and “read more” that AI crawlers never see — the #1 hidden reason pages don’t get cited.' },
  { icon: '🚧', h: 'Content-gap finder', p: 'Surfaces the missing pieces — no FAQ, no schema, thin sections, blocked crawlers — that competitors and AI answers exploit.' },
  { icon: '📊', h: 'Full AEO audit', p: 'A weighted, category-specific score across six pillars with ranked, page-specific fixes and per-engine citation likelihood.' },
  { icon: '📁', h: 'Reports & history', p: 'Save every audit to your account, export to PDF or copy as Markdown, and track how your AI visibility changes over time.' },
];

const tone = (p: number) => (p >= 80 ? 'ok' : p >= 40 ? 'warn' : 'bad');
const verdict = (p: number) => (p >= 80 ? 'Reads the page' : p >= 40 ? 'Partial' : p === 0 ? 'No access' : 'Near-empty');
---
<Site
  schema={homeSchema}
  title="AI Page Audit — see your site the way AI answer engines see it"
  description="Fetch any page as Googlebot, ChatGPT, Perplexity and Claude, and see exactly what each AI crawler can and cannot read. First check free."
>
  <!-- ── hero ───────────────────────────────────────────────── -->
  <section class="hero">
    <div class="wrap herogrid">
      <div class="herocopy">
        <span class="eyebrow">AI visibility for the new front page of search</span>
        <h1>See your site the way <em>AI answer engines</em> see it</h1>
        <p>
          Google renders your JavaScript. ChatGPT, Perplexity and Claude don’t —
          they read raw HTML. A page can rank beautifully and still be invisible
          to every AI answer at the same time. We show you which, and why.
        </p>
        <div class="herocta">
          <button class="btn-primary lg" id="cta-signup">Sign up free</button>
          <button class="btn-ghost lg" id="cta-login">Log in</button>
        </div>
        <p class="herofine">Your first check is free · No card required</p>
      </div>

      <!-- Product-output preview. One measure (share of page content the
           crawler actually received) across six named crawlers. -->
      <figure class="chartcard">
        <figcaption>
          <b>What each crawler can read</b>
          <span>Example result · share of page content received</span>
        </figcaption>
        <div class="bars">
          {crawlers.map((c) => (
            <div class="barrow">
              <div class="b-head">
                <span class="b-name">{c.name}</span>
                <span class="b-note">{c.note}</span>
              </div>
              <div class="b-track">
                <div class={`b-fill ${tone(c.pct)}`} style={`width:${Math.max(c.pct, 1.5)}%`}></div>
              </div>
              <div class="b-val">
                <b>{c.pct}%</b>
                <span class={`b-tag ${tone(c.pct)}`}>{verdict(c.pct)}</span>
              </div>
            </div>
          ))}
        </div>
      </figure>
    </div>
  </section>

  <!-- ── how it works (our product, not someone else's research) ── -->
  <section class="how">
    <div class="wrap">
      <div class="sec-eyebrow">How it works</div>
      <h2 class="sec-h2">Three steps, about twenty seconds</h2>
      <p class="sec-sub">No install, no tag to add to your site, no waiting for a crawl. Paste a URL and read the answer.</p>
      <div class="steps">
        <div class="step">
          <span class="st-n">1</span>
          <h3>Paste any URL</h3>
          <p>Your page, a client's page, or a competitor's. Nothing to install and no access to their site required — we fetch it the same way the crawlers do.</p>
        </div>
        <div class="step">
          <span class="st-n">2</span>
          <h3>We fetch it as each crawler</h3>
          <p>Googlebot, GPTBot, OAI-SearchBot, ClaudeBot, PerplexityBot and Bingbot — each with its real user-agent, paced so we never trip the site's rate limiter.</p>
        </div>
        <div class="step">
          <span class="st-n">3</span>
          <h3>You get the gap, and the fix</h3>
          <p>Element by element: what each crawler received, what it missed, and a ranked list of what to change first. Export it as a PDF and hand it to a client.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── features ───────────────────────────────────────────── -->
  <section class="features" id="features">
    <div class="wrap">
      <div class="sec-eyebrow">Everything in one platform</div>
      <h2 class="sec-h2">The complete AEO / GEO toolkit</h2>
      <p class="sec-sub">
        Traditional SEO tools tell you how Google sees your site. AI Page Audit
        tells you how AI answer engines see it — the new front page of search.
      </p>
      <div class="fgrid">
        {features.map((f) => (
          <div class="fcard">
            <div class="f-ico" aria-hidden="true">{f.icon}</div>
            <h3>{f.h}</h3>
            <p>{f.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── closing CTA ────────────────────────────────────────── -->
  <section class="endcta">
    <div class="wrap">
      <h2>Find out what AI can actually read on your site</h2>
      <p>One check takes about 20 seconds. The first one is on us.</p>
      <div class="herocta center">
        <button class="btn-primary lg" id="cta-signup2">Sign up free</button>
        <a href="/pricing" class="btn-ghost lg">See pricing</a>
      </div>
    </div>
  </section>

  <script>
    // The auth widget loads separately; wait for it rather than assuming order.
    const open = (mode) => {
      const go = setInterval(() => {
        if (!window.CRAuth) return;
        clearInterval(go);
        window.CRAuth.openAuth(mode);
      }, 40);
    };
    for (const id of ['cta-signup', 'cta-signup2']) {
      const el = document.getElementById(id);
      if (el) el.addEventListener('click', () => open('signup'));
    }
    const li = document.getElementById('cta-login');
    if (li) li.addEventListener('click', () => open('login'));
  </script>

  <style>
    /* ---- hero ---- */
    .hero {
      border-bottom: 1px solid var(--line);
      background:
        radial-gradient(900px 400px at 12% -20%, rgba(8, 145, 178, .13), transparent 62%),
        radial-gradient(700px 340px at 92% 0%, rgba(2, 132, 199, .10), transparent 60%);
    }
    .herogrid {
      display: grid; grid-template-columns: 1.05fr .95fr; gap: 54px;
      align-items: center; padding: 66px 24px 70px;
    }
    .herocopy h1 { margin: 0 0 16px; font-size: 46px; line-height: 1.06; letter-spacing: -.035em; font-weight: 800; }
    .herocopy h1 em { font-style: normal; color: var(--accent); }
    .herocopy > p { margin: 0 0 26px; font-size: 17px; line-height: 1.65; color: var(--ink-2); max-width: 52ch; }
    .herocta { display: flex; gap: 12px; flex-wrap: wrap; }
    .herocta.center { justify-content: center; }
    .btn-primary.lg, .btn-ghost.lg { padding: 14px 26px; font-size: 15px; border-radius: 11px; }
    .herofine { margin: 16px 0 0; font-size: 13px; color: var(--faint); }

    /* ---- shared chart card ---- */
    .chartcard {
      margin: 0; background: var(--card); border: 1px solid var(--line);
      border-radius: 16px; padding: 22px 24px 20px; box-shadow: var(--shadow-lg);
    }
    .chartcard figcaption { display: grid; gap: 3px; margin-bottom: 20px; }
    .chartcard figcaption b { font-size: 15px; font-weight: 800; letter-spacing: -.015em; }
    .chartcard figcaption span { font-size: 12.5px; color: var(--faint); }

    .bars { display: grid; gap: 15px; }
    .barrow { display: grid; grid-template-columns: 1fr; gap: 6px; }
    .b-head { display: flex; align-items: baseline; gap: 8px; }
    .b-name { font-size: 13.5px; font-weight: 700; color: var(--ink); }
    .b-note { font-size: 11.5px; color: var(--faint); }
    /* Recessive track; the fill carries the signal. */
    .b-track { height: 9px; border-radius: 999px; background: #eef1f6; overflow: hidden; }
    .b-fill { height: 100%; border-radius: 999px; min-width: 3px; }
    .b-fill.ok { background: var(--ok); }
    .b-fill.warn { background: var(--warn); }
    .b-fill.bad { background: var(--bad); }
    .b-fill.solo { background: var(--accent); }
    .b-val { display: flex; align-items: center; gap: 9px; }
    .b-val b { font-size: 13px; font-variant-numeric: tabular-nums; color: var(--ink); }
    /* State is named in words, never colour alone. */
    .b-tag { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
    .b-tag.ok { background: var(--ok-bg); color: var(--ok); }
    .b-tag.warn { background: var(--warn-bg); color: var(--warn); }
    .b-tag.bad { background: var(--bad-bg); color: var(--bad); }

    /* ---- how it works ---- */
    .how { background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 66px 0 72px; }
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .step { position: relative; border: 1px solid var(--line); border-radius: 14px; padding: 26px 22px 22px; }
    .st-n {
      position: absolute; top: -15px; left: 22px;
      width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center;
      background: var(--accent); color: #fff; font-size: 14px; font-weight: 800;
      font-variant-numeric: tabular-nums;
    }
    .step h3 { margin: 8px 0 8px; font-size: 16.5px; font-weight: 800; letter-spacing: -.02em; }
    .step p { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.65; }

    /* ---- features ---- */
    .features { border-top: 1px solid var(--line); background: #fff; padding: 66px 0 74px; }
    .sec-eyebrow { text-align: center; font-size: 11.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
    .sec-h2 { text-align: center; font-size: 31px; font-weight: 800; letter-spacing: -.03em; margin: 0 0 12px; }
    .sec-sub { text-align: center; font-size: 16px; color: var(--muted); max-width: 62ch; margin: 0 auto 42px; line-height: 1.6; }
    .fgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .fcard { border: 1px solid var(--line); border-radius: 14px; padding: 22px 20px; background: var(--card); transition: border-color .15s, transform .15s, box-shadow .15s; }
    .fcard:hover { border-color: var(--accent-line); transform: translateY(-2px); box-shadow: var(--shadow); }
    .f-ico { font-size: 21px; margin-bottom: 12px; }
    .fcard h3 { margin: 0 0 7px; font-size: 15px; font-weight: 800; letter-spacing: -.015em; }
    .fcard p { margin: 0; font-size: 13.5px; color: var(--muted); line-height: 1.62; }

    /* ---- closing CTA ---- */
    .endcta { padding: 66px 0 78px; text-align: center; border-top: 1px solid var(--line); background: var(--accent-soft); }
    .endcta h2 { margin: 0 0 10px; font-size: 29px; font-weight: 800; letter-spacing: -.03em; }
    .endcta p { margin: 0 0 24px; font-size: 16px; color: var(--ink-2); }

    /* ---- responsive ---- */
    @media (max-width: 980px) {
      .herogrid { grid-template-columns: 1fr; gap: 38px; }
      .steps { grid-template-columns: 1fr; gap: 26px; }
      .herocopy h1 { font-size: 38px; }
      .fgrid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .herogrid { padding: 44px 24px 50px; }
      .herocopy h1 { font-size: 31px; }
      .fgrid { grid-template-columns: 1fr; }
      .sec-h2, .endcta h2 { font-size: 24px; }
      .chartcard { padding: 18px 16px 16px; }
    }
  </style>
</Site>
