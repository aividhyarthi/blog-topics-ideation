---
import App from '../layouts/App.astro';
import { getUser } from '../lib/auth';
import { dbEnabled } from '../lib/db';
import { usageStatus } from '../lib/billing';
import { listAudits } from '../lib/audits';

const user = await getUser(Astro as any);
if (!dbEnabled || !user) return Astro.redirect('/');

const usage = await usageStatus(user.id).catch(() => null);
const audits = await listAudits(user.id, 10).catch(() => []);
const isOwner = usage?.owner === true;
const isPro = usage?.plan === 'pro';
const planUsed = usage?.planUsed ?? 0;
const planLimit = usage?.planLimit ?? 0;
const pct = isPro && planLimit ? Math.min(100, Math.round((planUsed / planLimit) * 100)) : 0;
const credits = usage?.credits ?? 0;
const freeCheckAvailable = usage?.freeCheckAvailable ?? false;
const expiresAt = usage?.expiresAt ? new Date(usage.expiresAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) : null;

function hexFor(s: number | null) { if (s == null) return '#94a3b8'; if (s >= 75) return '#12855a'; if (s >= 45) return '#b7791f'; return '#d43a3a'; }
---
<App tab="reports" title="Reports — AI Page Audit" description="Your saved audits, usage and plan.">
  <section class="toolhead">
    <div class="wrap">
      <h1>Reports</h1>
      <p>Your saved audits, checks remaining and plan.</p>
    </div>
  </section>
  <main>
    <div class="wrap dash-grid">
      <div class="dash-main">
        <div class="dcard planrow">
          <div>
            <div class={`plan-badge${isPro ? ' pro' : ''}`}>{isOwner ? 'Pro · Owner' : isPro ? 'Pro' : 'Free'}</div>
            <div class="plan-sub">{isOwner ? 'Unlimited checks · never expires' : isPro ? `500 checks/month · renews ${expiresAt}` : 'Pay per URL, or subscribe for volume'}</div>
          </div>
          {!isPro && <a href="/pricing" class="btn-primary">See plans</a>}
        </div>

        {isOwner ? (
          <div class="dcard">
            <div class="usage-top"><b>Usage this month</b><span>{planUsed} {planUsed === 1 ? 'check' : 'checks'} · unlimited</span></div>
            <div class="plan-sub">This account has full access — checks are recorded but never limited or charged.</div>
          </div>
        ) : isPro ? (
          <div class="dcard">
            <div class="usage-top"><b>Usage this month</b><span>{planUsed} / {planLimit} checks</span></div>
            <div class="usage-bar"><i style={`width:${pct}%; background:${pct >= 90 ? '#d43a3a' : pct >= 70 ? '#b7791f' : '#18181b'}`}></i></div>
            {pct >= 80 && <div class="usage-warn">You’re close to your monthly limit — it resets on your renewal date.</div>}
          </div>
        ) : (
          <div class="dcard">
            <div class="usage-top"><b>Checks available</b></div>
            <div class="balance-row">
              <div class="bal-item"><span class="bal-n">{freeCheckAvailable ? 1 : 0}</span><span class="bal-l">Free trial check</span></div>
              <div class="bal-item"><span class="bal-n">{credits}</span><span class="bal-l">Purchased credits</span></div>
            </div>
            {!freeCheckAvailable && credits === 0 && <div class="usage-warn">You’re out of checks. <a href="/pricing">Buy a check pack or subscribe</a> to continue.</div>}
          </div>
        )}

        <div class="dcard">
          <div class="dcard-head"><b>Recent audits</b><a href="/audit">Run a new audit →</a></div>
          {audits.length === 0 ? (
            <p class="empty">No saved audits yet. <a href="/audit">Run your first audit</a> or run a <a href="/check">crawler access check</a>.</p>
          ) : (
            <div class="alist">
              {audits.map((a) => (
                <a class="arow" href={`/audit?view=${a.id}`} title="View this saved report — no new check, nothing charged">
                  <span class="ascore" style={`color:${hexFor(a.overall)}`}>{a.overall == null ? '–' : a.overall}</span>
                  <div class="abody">
                    <div class="ahost">{a.host || a.url || 'Pasted content'}</div>
                    <div class="ameta">{a.pageType || ''}{a.grade ? ` · ${a.grade}` : ''}{a.createdAt ? ` · ${new Date(a.createdAt).toLocaleDateString()}` : ''}</div>
                  </div>
                  <span class="arow-go">View →</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="dash-side">
        <div class="dcard side-acc">
          <div class="side-head">Account</div>
          <div class="side-email">{user.email}</div>
          <button class="btn-ghost sm" id="dash-signout">Sign out</button>
        </div>
        <div class="dcard">
          <div class="side-head">Plan</div>
          <a href="/pricing" class="side-link">Billing &amp; plan</a>
        </div>
      </div>
    </div>
  </main>

  <script>
    const btn = document.getElementById('dash-signout');
    if (btn) btn.addEventListener('click', async () => {
      try { await fetch('/api/auth/logout', { method: 'POST' }); } catch {}
      location.href = '/';
    });
  </script>

  <style>
    .toolhead { border-bottom: 1px solid var(--line); background: #fff; }
    .toolhead .wrap { padding: 26px 24px 22px; }
    .toolhead h1 { margin: 0 0 5px; font-size: 24px; font-weight: 800; letter-spacing: -.025em; }
    .toolhead p { margin: 0; font-size: 14.5px; color: var(--muted); }
    main { padding: 28px 0 56px; }
    .dash-grid { display: grid; grid-template-columns: 1fr 280px; gap: 22px; align-items: start; }
    @media (max-width: 820px) { .dash-grid { grid-template-columns: 1fr; } }
    .dash-main { display: grid; gap: 18px; }
    .dcard { border: 1px solid var(--line); border-radius: 16px; background: #fff; padding: 20px 22px; box-shadow: var(--shadow); }
    .planrow { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .plan-badge { display: inline-block; font-size: 13px; font-weight: 800; padding: 5px 14px; border-radius: 999px; background: #f1f5f9; color: var(--ink-2); }
    .plan-badge.pro { background: var(--ok-bg); color: var(--ok); }
    .plan-sub { font-size: 12.5px; color: var(--muted); margin-top: 6px; }
    .usage-top { display: flex; justify-content: space-between; align-items: baseline; font-size: 14px; margin-bottom: 10px; }
    .usage-top span { color: var(--muted); font-weight: 600; font-size: 13px; }
    .usage-bar { height: 9px; border-radius: 999px; background: #edeef4; overflow: hidden; }
    .usage-bar > i { display: block; height: 100%; border-radius: 999px; }
    .usage-warn { margin-top: 12px; font-size: 12.5px; color: var(--warn); background: var(--warn-bg); border: 1px solid #f0e2b8; border-radius: 9px; padding: 9px 11px; }
    .balance-row { display: flex; gap: 24px; margin-top: 10px; }
    .bal-item { display: flex; flex-direction: column; }
    .bal-n { font-size: 28px; font-weight: 800; color: var(--accent); letter-spacing: -.02em; }
    .bal-l { font-size: 12px; color: var(--muted); font-weight: 600; margin-top: 2px; }
    .dcard-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .dcard-head a { font-size: 13px; font-weight: 700; }
    .empty { font-size: 13.5px; color: var(--muted); margin: 0; }
    .alist { display: grid; gap: 8px; }
    .arow { display: flex; gap: 12px; align-items: center; border: 1px solid var(--line); border-radius: 11px; padding: 11px 13px; text-decoration: none; color: inherit; transition: border-color .15s, background .15s; }
    .arow:hover { border-color: var(--accent); background: #fafafa; }
    .arow:hover .arow-go { color: var(--accent); text-decoration: underline; }
    .ascore { font-weight: 800; font-size: 16px; min-width: 34px; text-align: center; }
    .ahost { font-size: 13.5px; font-weight: 600; color: var(--ink); }
    .ameta { font-size: 12px; color: var(--muted); margin-top: 1px; }
    .arow-go { font-size: 12px; font-weight: 700; color: var(--muted); white-space: nowrap; }
    .dash-side { display: grid; gap: 18px; }
    .side-head { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin-bottom: 12px; }
    .side-link { display: block; font-size: 13.5px; font-weight: 600; padding: 9px 0; border-top: 1px solid var(--line); }
    .side-link:first-of-type { border-top: none; }
    .side-email { font-size: 13px; color: var(--ink-2); margin-bottom: 12px; word-break: break-all; }
    .btn-ghost.sm { padding: 7px 13px; font-size: 12.5px; }
  </style>
</App>
