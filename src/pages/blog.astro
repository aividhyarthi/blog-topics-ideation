---
import Site from '../layouts/Site.astro';
const posts = [
  { slug: '/blog/what-is-aeo', tag: 'Fundamentals', title: 'What is AEO? Answer Engine Optimization explained', excerpt: 'Search is moving from ten blue links to a single AI answer. AEO is how you make sure that answer cites you. Here’s the complete primer.', date: 'Jul 2026', read: '6 min' },
  { slug: '/blog/geo-vs-seo', tag: 'Strategy', title: 'GEO vs SEO: what actually changes for your content', excerpt: 'Generative Engine Optimization isn’t a rebrand of SEO. It rewards different signals — extractability, entities, and citations. Here’s the diff.', date: 'Jul 2026', read: '7 min' },
  { slug: '/blog/js-rendering-blind-spot', tag: 'Technical', title: 'Why AI crawlers can’t read your JavaScript site', excerpt: 'Googlebot renders JavaScript. GPTBot, ClaudeBot and PerplexityBot don’t. If your content is JS-injected, LLMs see an empty shell — here’s how to fix it.', date: 'Jun 2026', read: '5 min' },
  { slug: '/blog/hidden-reviews-problem', tag: 'E-commerce', title: 'The hidden reviews problem killing your product pages in AI', excerpt: '“1,200 reviews” on the page, but only 3 in the HTML. AI answer engines see 3. Here’s why, and how to expose your reviews to crawlers.', date: 'Jun 2026', read: '6 min' },
];
---
<Site title="Blog — CiteRank" description="AEO/GEO playbooks, guides and research on ranking in AI search.">
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow">Blog</span>
      <h1>The AEO / GEO playbook</h1>
      <p>Guides, research and practical playbooks on getting cited by ChatGPT, Perplexity, Google AI Overviews and the rest of AI search.</p>
    </div>
  </section>
  <main>
    <div class="wrap">
      <div class="bloggrid">
        {posts.map((p) => (
          <a class="postcard" href={p.slug}>
            <div class="pc-tag">{p.tag}</div>
            <h3>{p.title}</h3>
            <p>{p.excerpt}</p>
            <div class="pc-meta">{p.date} · {p.read} read</div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <style>
    .bloggrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    @media (max-width: 720px) { .bloggrid { grid-template-columns: 1fr; } }
    .postcard { display: block; border: 1px solid var(--line); border-radius: 16px; background: #fff; padding: 24px; text-decoration: none; color: inherit; transition: box-shadow .18s, transform .18s, border-color .18s; }
    .postcard:hover { box-shadow: var(--shadow); transform: translateY(-2px); border-color: var(--line-2); }
    .pc-tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--pink); background: var(--accent-soft); border: 1px solid #c7ddff; padding: 3px 10px; border-radius: 999px; margin-bottom: 12px; }
    .postcard h3 { margin: 0 0 8px; font-size: 19px; font-weight: 700; letter-spacing: -.02em; line-height: 1.3; }
    .postcard p { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.6; }
    .pc-meta { margin-top: 14px; font-size: 12.5px; color: var(--faint); font-weight: 600; }
  </style>
</Site>
