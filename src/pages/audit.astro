.fixlist { display: grid; gap: 10px; }
.fixrow { display: flex; gap: 13px; align-items: flex-start; border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; background: #fff; border-left: 3px solid var(--fc); box-shadow: var(--shadow); }
.fixrow .fnum { font-weight: 800; color: var(--fc); font-size: 14px; min-width: 18px; }
.fixrow .ftext { font-size: 13px; flex: 1; line-height: 1.55; }
.fixrow .ftext b { display: block; margin-bottom: 3px; font-size: 13.5px; }
.pillar { border: 1px solid var(--line); border-radius: 15px; overflow: hidden; background: #fff; margin-bottom: 11px; box-shadow: var(--shadow); }
.pillar > summary { list-style: none; cursor: pointer; padding: 15px 17px; display: flex; align-items: center; gap: 14px; }
.pillar > summary::-webkit-details-marker { display: none; }
.pillar .caret { color: var(--faint); transition: transform .15s; display: grid; place-items: center; }
.pillar .caret svg { width: 13px; height: 13px; }
.pillar[open] .caret { transform: rotate(90deg); }
.pillar .pdot { width: 8px; height: 8px; border-radius: 50%; background: var(--p); flex-shrink: 0; }
.pname { font-weight: 700; font-size: 14.5px; flex: 1; }
.pillar .pissues { font-size: 11px; font-weight: 700; color: var(--bad); background: var(--bad-bg); padding: 3px 10px; border-radius: 999px; }
.pillar .pclean { font-size: 11px; font-weight: 700; color: var(--ok); background: var(--ok-bg); padding: 3px 10px; border-radius: 999px; }
.pbar { height: 7px; border-radius: 999px; background: #edeef4; width: 130px; overflow: hidden; }
.pbar > i { display: block; height: 100%; border-radius: 999px; background: var(--p); }
@media (max-width: 720px) { .pbar { width: 56px; } }
.pscore { font-weight: 800; font-size: 18px; min-width: 40px; text-align: right; color: var(--p); letter-spacing: -.02em; }
.signals { padding: 2px 17px 14px; }
.signal { display: flex; gap: 13px; padding: 13px 0; border-top: 1px solid var(--line); align-items: flex-start; }
.schip { width: 22px; height: 22px; border-radius: 7px; display: grid; place-items: center; flex-shrink: 0; margin-top: 1px; }
.schip svg { width: 12px; height: 12px; }
.schip.pass { background: var(--ok-bg); color: var(--ok); }
.schip.warn { background: var(--warn-bg); color: var(--warn); }
.schip.fail { background: var(--bad-bg); color: var(--bad); }
.schip.na { background: #eef0f5; color: var(--na); }
.sbody { flex: 1; min-width: 0; }
.sname { font-weight: 600; font-size: 13.5px; }
.sname .tag { font-size: 9px; font-weight: 700; color: var(--indigo); background: var(--accent-soft); border-radius: 5px; padding: 2px 6px; margin-left: 8px; vertical-align: 1px; letter-spacing: .04em; }
.sdetail { font-size: 12.5px; color: var(--muted); margin-top: 3px; line-height: 1.5; }
.sfix { font-size: 12.5px; color: #6b5410; margin-top: 7px; background: var(--warn-bg); border-left: 3px solid var(--warn); padding: 7px 11px; border-radius: 0 8px 8px 0; line-height: 1.5; }
.sscore { font-weight: 700; font-size: 13px; padding: 3px 9px; border-radius: 8px; min-width: 42px; text-align: center; flex-shrink: 0; }
.caveat { margin-top: 24px; font-size: 12px; color: var(--muted); background: #f1f1f6; border-radius: 14px; padding: 14px 16px; line-height: 1.6; }
.caveat b { color: var(--ink-2); }
footer b { color: var(--ink-2); }
::selection { background: #ddd9fb; }
/* PDF / print */
      .printhead { display: none; }
@media print {
        @page { margin: 14mm; }
        body { background: #fff !important; }
        body * { visibility: hidden; }
        #results, #results * { visibility: visible; }
        #results { position: absolute; left: 0; top: 0; width: 100%; margin: 0; }
        .nav, .hero, footer, .toast, .resbar, .suggest a { display: none !important; }
        .printhead { display: block !important; margin-bottom: 14px; border-bottom: 2px solid var(--accent); padding-bottom: 8px; }
        .printhead .pt-brand { font-size: 18px; font-weight: 800; color: var(--accent-dark); letter-spacing: -.02em; }
        .printhead .pt-sub { font-size: 11px; color: var(--muted); }
        .card, .gauge, .engcard, .pillar, .prow, .domain, .actrow, .evsec { box-shadow: none !important; border: 1px solid var(--line) !important; break-inside: avoid; }
        .pillar .signals { display: block !important; }
        .gauges { break-inside: avoid; }
        a[href]:after { content: ""; }

        /* The verdict and the fix list are the whole point of the printed
           report, so they get page one to themselves and the evidence starts
           after the break. Collapsed sections still have to print in full — a
           PDF that silently omits content is worse than a long one. */
        .evidence { break-before: page; }
        .evsec > summary .caret, .moreacts > summary { display: none !important; }
        .verdict .vtitle { font-size: 26px; }
        .verdict .vline { font-size: 14px; }
        .actioncard { break-inside: avoid; }

        /* Inline chips sit directly after a bold label in the flow, so without an
           explicit margin the PDF renders them welded on ("…in markupEVERY PAGE",
           "Headline answer clarityAI"). Print drops the flex gaps that hide this
           on screen, so state the spacing outright. */
        .cltop b, .sname { margin-right: 8px; }
        .clgroup, .sname .tag, .eltag, .vw-js { margin-left: 6px !important; }
      }
  </style>
</App>
