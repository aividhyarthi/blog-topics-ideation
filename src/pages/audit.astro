---
// AEO Auditor — scores an article/page for LLM answer-engine citability.
const brand = 'Nykaa';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AEO Auditor — {brand}</title>
    <meta name="description" content="Score any article or blog for Answer Engine Optimization — how likely it is to be cited by ChatGPT, Perplexity, Gemini and Google AI Overviews." />
    <style>
      :root {
        --pink: #fc2779; --pink-dark: #d81b66; --ink: #1d1f2b; --muted: #6b6f80;
        --line: #e7e8ef; --bg: #f6f6fa; --card: #ffffff;
        --ok: #15a06a; --warn: #c98a00; --bad: #d63a3a; --na: #9aa0ad;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.5; }
      header { background: linear-gradient(120deg, #fc2779 0%, #ff6aa2 100%); color: #fff; padding: 28px 20px 32px; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      header h1 { margin: 0 0 6px; font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
      header p { margin: 0; opacity: 0.95; font-size: 15px; max-width: 760px; }
      .badge { display: inline-block; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.35); padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; margin-bottom: 12px; }
      nav.top { margin-top: 14px; display: flex; gap: 10px; }
      nav.top a { color: #fff; text-decoration: none; font-size: 13px; font-weight: 600; background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.3); padding: 6px 12px; border-radius: 8px; }
      nav.top a.active { background: #fff; color: var(--pink-dark); }
      main { padding: 26px 0 60px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 18px; box-shadow: 0 1px 2px rgba(20,20,40,0.04); }
      .tabs { display: flex; gap: 8px; margin-bottom: 14px; }
      .tab { padding: 8px 14px; border-radius: 9px; border: 1px solid var(--line); background: #fff; cursor: pointer; font-size: 13.5px; font-weight: 600; color: var(--muted); }
      .tab.active { border-color: var(--pink); color: var(--pink); background: #fff5f9; }
      label.fld { display: block; font-size: 12.5px; color: var(--muted); font-weight: 600; margin: 12px 0 5px; }
      input[type=text], input[type=url], textarea { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: 13.5px; color: var(--ink); background: #fcfcfe; outline: none; font-family: inherit; }
      textarea { min-height: 220px; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
      input:focus, textarea:focus { border-color: var(--pink); box-shadow: 0 0 0 3px rgba(252,39,121,0.12); }
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      @media (max-width: 720px) { .two { grid-template-columns: 1fr; } }
      .row { display: flex; align-items: center; gap: 14px; margin-top: 16px; flex-wrap: wrap; }
      button.primary { background: var(--pink); color: #fff; border: none; border-radius: 10px; padding: 12px 22px; font-size: 15px; font-weight: 700; cursor: pointer; }
      button.primary:hover { background: var(--pink-dark); }
      button.primary:disabled { opacity: 0.6; cursor: not-allowed; }
      .spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.5); border-top-color: #fff; border-radius: 50%; display: inline-block; vertical-align: -3px; margin-right: 8px; animation: spin 0.7s linear infinite; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .alert { margin-top: 16px; padding: 12px 14px; border-radius: 10px; font-size: 13.5px; display: none; }
      .alert.err { background: #fdecec; color: #b3261e; border: 1px solid #f6c9c6; }
      .alert.info { background: #fff6e6; color: #8a5d00; border: 1px solid #f3e0b0; }
      #results { margin-top: 24px; display: none; }
      .scorecard { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; }
      .donut { --val: 0; width: 132px; height: 132px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--ring) calc(var(--val) * 1%), #eceef4 0); flex-shrink: 0; }
      .donut .inner { width: 104px; height: 104px; border-radius: 50%; background: #fff; display: grid; place-items: center; text-align: center; }
      .donut .num { font-size: 34px; font-weight: 800; line-height: 1; }
      .donut .grd { font-size: 13px; color: var(--muted); font-weight: 700; }
      .scoremeta h2 { margin: 0 0 4px; font-size: 20px; }
      .scoremeta p { margin: 0; color: var(--muted); font-size: 13.5px; }
      .pillars { margin-top: 22px; display: grid; gap: 10px; }
      .pillar { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #fff; }
      .pillar > summary { list-style: none; cursor: pointer; padding: 13px 16px; display: flex; align-items: center; gap: 14px; }
      .pillar > summary::-webkit-details-marker { display: none; }
      .pname { font-weight: 700; font-size: 14.5px; flex: 1; }
      .pweight { font-size: 11.5px; color: var(--muted); background: #f3f3f8; padding: 2px 8px; border-radius: 999px; }
      .pscore { font-weight: 800; font-size: 16px; min-width: 42px; text-align: right; }
      .bar { height: 7px; border-radius: 999px; background: #eceef4; width: 160px; overflow: hidden; }
      .bar > i { display: block; height: 100%; border-radius: 999px; }
      @media (max-width: 720px) { .bar { width: 90px; } .pweight { display: none; } }
      .signals { padding: 4px 16px 14px; }
      .signal { display: flex; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line); }
      .dot { width: 9px; height: 9px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }
      .sname { font-weight: 600; font-size: 13.5px; }
      .sname .tag { font-size: 10.5px; font-weight: 700; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; padding: 0 5px; margin-left: 7px; vertical-align: 1px; }
      .sdetail { font-size: 12.5px; color: var(--muted); margin-top: 2px; }
      .sfix { font-size: 12.5px; color: var(--ink); margin-top: 4px; background: #fff6e6; border-left: 3px solid var(--warn); padding: 5px 9px; border-radius: 0 6px 6px 0; }
      .sright { margin-left: auto; font-weight: 800; font-size: 14px; min-width: 38px; text-align: right; }
      .fixes { margin-top: 22px; }
      .fixes h3 { font-size: 16px; margin: 0 0 10px; }
      .fixlist { display: grid; gap: 8px; }
      .fixrow { display: flex; gap: 10px; align-items: flex-start; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; background: #fff; }
      .fixrow .sev { font-size: 10.5px; font-weight: 800; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; flex-shrink: 0; margin-top: 1px; }
      .sev.fail { background: #fdecec; color: var(--bad); }
      .sev.warn { background: #fff3d6; color: var(--warn); }
      .fixrow .ftext { font-size: 13px; }
      .fixrow .ftext b { display: block; margin-bottom: 1px; }
      .caveat { margin-top: 18px; font-size: 12px; color: var(--muted); background: #f3f3f8; border-radius: 10px; padding: 11px 13px; }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 24px; }
      .pill { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11.5px; font-weight: 600; background: #f0eefc; color: #5b46c9; }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <span class="badge">AEO Auditor · {brand}</span>
        <h1>Is your article AEO-friendly?</h1>
        <p>Score any blog or page for <b>Answer Engine Optimization</b> — how likely it is to be cited when people ask ChatGPT, Perplexity, Gemini or Google AI Overviews. Audit a live URL or paste the article.</p>
        <nav class="top">
          <a href="/">Topic Engine</a>
          <a href="/audit" class="active">AEO Auditor</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <div class="card">
          <div class="tabs">
            <div class="tab active" id="tab-url" data-mode="url">🔗 Audit a URL</div>
            <div class="tab" id="tab-paste" data-mode="paste">📝 Paste article</div>
          </div>

          <div id="pane-url">
            <label class="fld" for="url">Page URL</label>
            <input id="url" type="url" placeholder="https://www.nykaa.com/beauty-blog/best-sunscreen-for-oily-skin" />
          </div>
          <div id="pane-paste" style="display:none">
            <label class="fld" for="html">Article HTML or plain text</label>
            <textarea id="html" placeholder="Paste the full article HTML (best — keeps headings, schema, links) or plain text…"></textarea>
          </div>

          <div class="two">
            <div>
              <label class="fld" for="brand">Brand / site <span style="font-weight:400">(helps the off-page estimate)</span></label>
              <input id="brand" type="text" value="Nykaa" />
            </div>
            <div>
              <label class="fld" for="topic">Topic <span style="font-weight:400">(optional)</span></label>
              <input id="topic" type="text" placeholder="e.g. sunscreen for oily skin" />
            </div>
          </div>
          <label class="fld" for="target">Target question this page should be the cited answer to <span style="font-weight:400">(optional)</span></label>
          <input id="target" type="text" placeholder="e.g. which sunscreen is best for acne-prone oily skin?" />

          <div class="row">
            <button class="primary" id="go">Audit AEO score</button>
          </div>

          <div class="alert err" id="err"></div>
          <div class="alert info" id="info"></div>
        </div>

        <section id="results"></section>
      </div>
    </main>

    <footer>Built for {brand} content strategy · AEO citability audit · weights are evidence-based, not a guarantee</footer>

    <script>
      const $ = (id) => document.getElementById(id);
      let mode = 'url';

      function setMode(m) {
        mode = m;
        $('tab-url').classList.toggle('active', m === 'url');
        $('tab-paste').classList.toggle('active', m === 'paste');
        $('pane-url').style.display = m === 'url' ? 'block' : 'none';
        $('pane-paste').style.display = m === 'paste' ? 'block' : 'none';
      }
      $('tab-url').addEventListener('click', () => setMode('url'));
      $('tab-paste').addEventListener('click', () => setMode('paste'));

      function esc(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function showErr(msg) { const e = $('err'); e.textContent = msg; e.style.display = 'block'; }
      function hideAlerts() { $('err').style.display = 'none'; $('info').style.display = 'none'; }

      function colorFor(score) {
        if (score == null) return 'var(--na)';
        if (score >= 75) return 'var(--ok)';
        if (score >= 45) return 'var(--warn)';
        return 'var(--bad)';
      }
      function ringColor(score) {
        if (score >= 75) return '#15a06a';
        if (score >= 45) return '#c98a00';
        return '#d63a3a';
      }

      function render(data) {
        const r = data.report;
        const m = data.meta || {};
        const root = $('results');

        const pillarsHtml = r.pillars.map((p) => {
          const sigs = p.signals.map((s) => {
            const col = colorFor(s.score);
            const scoreTxt = s.score == null ? 'n/a' : s.score;
            const tag = s.source === 'ai' ? '<span class="tag">AI</span>' : '';
            return `
              <div class="signal">
                <span class="dot" style="background:${col}"></span>
                <div style="flex:1">
                  <div class="sname">${esc(s.label)}${tag}</div>
                  <div class="sdetail">${esc(s.detail)}</div>
                  ${s.fix ? `<div class="sfix">${esc(s.fix)}</div>` : ''}
                </div>
                <div class="sright" style="color:${col}">${scoreTxt}</div>
              </div>`;
          }).join('');
          const open = p.score < 70 ? ' open' : '';
          return `
            <details class="pillar"${open}>
              <summary>
                <span class="pname">${esc(p.label)}</span>
                <span class="pweight">${Math.round(p.weight * 100)}% weight</span>
                <span class="bar"><i style="width:${p.score}%;background:${ringColor(p.score)}"></i></span>
                <span class="pscore" style="color:${ringColor(p.score)}">${p.score}</span>
              </summary>
              <div class="signals">${sigs}</div>
            </details>`;
        }).join('');

        const fixesHtml = (r.topFixes || []).map((fx) => `
          <div class="fixrow">
            <span class="sev ${fx.severity}">${fx.severity}</span>
            <div class="ftext"><b>${esc(fx.label)}</b>${esc(fx.fix)}</div>
          </div>`).join('');

        const intent = m.detectedIntent ? `<span class="pill">${esc(m.detectedIntent)}</span>` : '';

        root.innerHTML = `
          <div class="card">
            <div class="scorecard">
              <div class="donut" style="--val:${r.overall};--ring:${ringColor(r.overall)}">
                <div class="inner">
                  <div class="num" style="color:${ringColor(r.overall)}">${r.overall}</div>
                  <div class="grd">Grade ${esc(r.grade)}</div>
                </div>
              </div>
              <div class="scoremeta">
                <h2>AEO citability score: ${r.overall}/100</h2>
                <p>${esc(m.mode === 'url' ? (m.url || 'URL') : 'Pasted article')} · ${m.wordCount} words ${intent ? '· detected intent: ' + intent : ''}</p>
                ${m.fetchNote ? `<p style="color:var(--warn);margin-top:6px">${esc(m.fetchNote)}</p>` : ''}
                ${m.aiError ? `<p style="color:var(--bad);margin-top:6px">AI-judged signals unavailable (${esc(m.aiError)}) — those default to 50.</p>` : ''}
              </div>
            </div>

            <div class="pillars">${pillarsHtml}</div>

            ${fixesHtml ? `<div class="fixes"><h3>🔧 Top fixes, ranked by impact</h3><div class="fixlist">${fixesHtml}</div></div>` : ''}

            <div class="caveat">
              <b>How to read this:</b> the score predicts <i>page-level citability</i> from on-page signals + an AI estimate of off-page brand authority. Off-page signals (marked <b>AI</b>) are Claude's estimate from training data, not a live measurement of brand mentions or backlinks — verify with a tool like Ahrefs/Semrush. Citation behaviour also varies a lot between engines (ChatGPT favours Wikipedia, Perplexity favours Reddit), so treat this as one composite signal, not a guarantee.
            </div>
          </div>`;

        root.style.display = 'block';
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      async function run() {
        hideAlerts();
        const payload = {
          brand: $('brand').value.trim(),
          topic: $('topic').value.trim(),
          target: $('target').value.trim(),
        };
        if (mode === 'url') {
          payload.url = $('url').value.trim();
          if (!payload.url) { showErr('Enter a page URL to audit.'); return; }
        } else {
          payload.html = $('html').value.trim();
          if (!payload.html) { showErr('Paste the article HTML or text to audit.'); return; }
        }

        const btn = $('go');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>Auditing…';
        $('info').textContent = mode === 'url' ? 'Fetching the page and scoring it. This can take 10–25 seconds.' : 'Scoring the article. This can take 10–25 seconds.';
        $('info').style.display = 'block';

        try {
          const res = await fetch('/api/aeo-audit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) showErr(data.error || 'Something went wrong. Please try again.');
          else render(data);
        } catch (e) {
          showErr('Network error: ' + (e && e.message ? e.message : e));
        } finally {
          hideAlerts();
          btn.disabled = false;
          btn.textContent = 'Audit AEO score';
        }
      }
      $('go').addEventListener('click', run);
    </script>
  </body>
</html>
