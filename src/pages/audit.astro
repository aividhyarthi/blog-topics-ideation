/* ---- Accordions with a literal +/− marker (used for checklist groups and,
   via .pplus, for the score-breakdown pillars) rather than a rotating caret. ---- */
.acc { border: 1px solid var(--line); border-radius: 14px; background: #fff; margin-bottom: 10px; overflow: hidden; box-shadow: var(--shadow); }
.acc > summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 12px; padding: 14px 16px; }
.acc > summary::-webkit-details-marker { display: none; }
.acc > summary:hover { background: #fafafc; }
.acc-title { flex: 1; min-width: 0; }
.acc-title b { font-size: 13.5px; font-weight: 700; }
.acc-title span { display: block; font-size: 11.5px; color: var(--faint); margin-top: 1px; }
.acc-bar { width: 60px; height: 6px; border-radius: 999px; background: #edeef4; overflow: hidden; flex-shrink: 0; }
.acc-bar > i { display: block; height: 100%; border-radius: 999px; }
.acc-badge { font-size: 11.5px; font-weight: 700; padding: 3px 9px; border-radius: 999px; flex-shrink: 0; }
.acc-badge.ok { background: var(--ok-bg); color: var(--ok); }
.acc-badge.warn { background: var(--warn-bg); color: var(--warn); }
.acc-body { padding: 4px 16px 14px; border-top: 1px solid var(--line); }
.pplus, .acc-plus { width: 22px; height: 22px; border-radius: 7px; background: #eef0f5; color: var(--ink-2); display: grid; place-items: center; flex-shrink: 0; font-size: 15px; font-weight: 800; line-height: 1; }
.pplus::before, .acc-plus::before { content: '+'; }
details[open] > summary .pplus, details[open] > summary .acc-plus { background: var(--accent-soft); color: var(--accent-dark); }
details[open] > summary .pplus::before, details[open] > summary .acc-plus::before { content: '−'; }

/* ---- Radar (shape of the score) + score-history trend, Overview tab ---- */
.radarwrap { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
.radarwrap svg { flex-shrink: 0; }
.radar-legend { display: flex; flex-direction: column; gap: 8px; font-size: 12px; flex: 1; min-width: 170px; }
.rl-row { display: flex; align-items: center; gap: 8px; }
.rl-row.dim { opacity: .55; }
.rl-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
.rl-row { cursor: help; }
.rl-row .name { flex: 1; color: var(--ink-2); font-weight: 600; border-bottom: 1px dotted var(--faint); }
.rl-row .val { font-weight: 800; font-variant-numeric: tabular-nums; }
.trend-empty { display: flex; align-items: center; gap: 12px; padding: 6px 2px; color: var(--muted); font-size: 12.5px; line-height: 1.5; }
.trend-empty svg { width: 30px; height: 30px; flex-shrink: 0; opacity: .5; }
.trendrow { display: flex; align-items: center; gap: 16px; }
.trend-delta { font-size: 22px; font-weight: 800; }
.trend-delta small { font-size: 11.5px; font-weight: 700; color: var(--muted); display: block; margin-top: 1px; }
.trend-pts { display: flex; gap: 14px; margin-top: 10px; font-size: 11px; color: var(--faint); font-weight: 600; flex-wrap: wrap; }
.trend-pts b { color: var(--ink-2); font-size: 12px; }

/* ---- Compact per-engine bars, Overview tab (full cards live in Engines tab) ---- */
.minieng-list { display: flex; flex-direction: column; }
.mineng { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
.mineng + .mineng { border-top: 1px solid var(--line); }
.me-name { width: 92px; font-size: 12.5px; font-weight: 700; flex-shrink: 0; }
.me-track { flex: 1; height: 7px; border-radius: 99px; background: #edeef4; overflow: hidden; }
.me-fill { display: block; height: 100%; border-radius: 99px; }
.me-val { width: 34px; text-align: right; font-size: 12.5px; font-weight: 800; font-variant-numeric: tabular-nums; flex-shrink: 0; }

/* ---- Checklist "Detected as" card, Checklist tab ---- */
.cld-cols { display: flex; gap: 26px; flex-wrap: wrap; font-size: 13px; }
.cld-cols > div { display: flex; flex-direction: column; gap: 4px; }

/* A pillar we could not measure is greyed out and reads "not checked" — it is
   never shown as a zero, which would look like a failure we never tested for. */
.gauge.unmeasured { opacity: .6; cursor: default; }
.gpts.na { font-size: 22px; font-weight: 800; color: var(--na); }
.gmore.na { color: var(--muted); font-style: italic; }
.pna { font-size: 11.5px; font-weight: 600; color: var(--na); }
.gate { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 999px; margin-bottom: 11px; letter-spacing: .01em; }
.gate svg { width: 13px; height: 13px; }
.gate.block { background: var(--bad-bg); color: var(--bad); }
.gate.warn { background: var(--warn-bg); color: var(--warn); }
.gate.strong { background: var(--ok-bg); color: var(--ok); }
.gate.optimized { background: var(--accent-soft); color: var(--indigo); }
.verdict .vsub { color: var(--muted); font-size: 13px; margin: 0 0 12px; word-break: break-word; }
.verdict .vsub b { color: var(--ink-2); font-weight: 600; }
.chips { display: flex; gap: 7px; flex-wrap: wrap; }
.chip { font-size: 11.5px; font-weight: 600; padding: 4px 11px; border-radius: 999px; background: #f1f1f6; color: var(--ink-2); border: 1px solid var(--line); }
.chip.intent { background: var(--accent-soft); color: var(--indigo); border-color: #c7ddff; }
.chip.band-High { background: var(--ok-bg); color: var(--ok); border-color: #cdebdd; }
.chip.band-Medium { background: var(--warn-bg); color: var(--warn); border-color: #f0e2b8; }
.chip.band-Low { background: var(--bad-bg); color: var(--bad); border-color: #f4cfcf; }
.note-warn { display: flex; gap: 7px; align-items: flex-start; color: var(--warn); font-size: 12.5px; margin-top: 11px; }
.note-bad { display: flex; gap: 7px; align-items: flex-start; color: var(--bad); font-size: 12.5px; margin-top: 11px; }
.note-warn svg, .note-bad svg { width: 14px; height: 14px; flex-shrink: 0; margin-top: 2px; }
.suggest { margin-top: 12px; font-size: 12.5px; background: #f1f1f6; border-radius: 10px; padding: 9px 12px; color: var(--ink-2); }
.suggest a { color: var(--accent-dark); font-weight: 600; cursor: pointer; }
/* AI executive summary */
      .summary { margin-top: 20px; display: flex; gap: 13px; background: linear-gradient(120deg, #f4f3ff, #f0f4ff); border: 1px solid #e6e3fb; border-radius: 14px; padding: 15px 17px; }
.summary .sicon { width: 30px; height: 30px; border-radius: 9px; background: #fff; border: 1px solid #e6e3fb; display: grid; place-items: center; flex-shrink: 0; }
.summary .sicon svg { width: 16px; height: 16px; color: var(--indigo); }
.summary .sbody b { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--indigo); margin-bottom: 3px; font-weight: 700; }
.summary .sbody p { margin: 0; font-size: 13.5px; color: var(--ink-2); line-height: 1.55; }
.resbar { display: flex; justify-content: flex-end; gap: 9px; margin: 18px 0 -6px; }
.ghostbtn { display: inline-flex; align-items: center; gap: 7px; background: #fff; color: var(--ink-2); border: 1px solid var(--line-2); border-radius: 10px; padding: 8px 14px; font-size: 12.5px; font-weight: 600; cursor: pointer; font-family: inherit; transition: .15s; }
.ghostbtn svg { width: 14px; height: 14px; }
.ghostbtn:hover { border-color: var(--accent); color: var(--accent); }
.covbar { height: 9px; border-radius: 999px; background: #edeef4; overflow: hidden; margin: 6px 0 14px; }
.covbar > i { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--indigo), #8b85f5); }
.fixrow .fmeta { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; flex-shrink: 0; }
.gain { font-size: 12px; font-weight: 700; color: var(--ok); white-space: nowrap; }
.ftag { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; padding: 2px 8px; border-radius: 999px; }
.ftag.high { background: var(--accent-soft); color: var(--indigo); }
.ftag.quick { background: var(--ok-bg); color: var(--ok); }
.ftag.offpage { background: #f1f1f6; color: var(--muted); }
.toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 11px 20px; border-radius: 11px; font-size: 13.5px; font-weight: 500; opacity: 0; transition: opacity .2s; pointer-events: none; box-shadow: 0 12px 32px -12px rgba(0,0,0,.5); }
.toast.show { opacity: 1; }
/* ---- section header (eyebrow style, no emoji) ---- */
      .sectitle { display: flex; align-items: center; gap: 10px; margin: 34px 0 14px; }
.sectitle .sicn { width: 30px; height: 30px; border-radius: 9px; background: #fff; border: 1px solid var(--line); display: grid; place-items: center; flex-shrink: 0; color: var(--ink-2); box-shadow: var(--shadow); }
.sectitle .sicn svg { width: 15px; height: 15px; }
.sectitle .stx { display: flex; flex-direction: column; }
.sectitle .stx b { font-size: 14.5px; font-weight: 700; letter-spacing: -.01em; }
.sectitle .stx span { font-size: 12px; color: var(--muted); font-weight: 500; margin-top: 1px; }
/* ---- Client (agency) checklist banner ---- */
      .clientbanner { display: flex; gap: 12px; align-items: flex-start; background: #eef2ff; border: 1px solid #c7d2fe; border-radius: 14px; padding: 14px 16px; margin-bottom: 4px; font-size: 13px; color: #3730a3; line-height: 1.55; }
.clientbanner svg { width: 20px; height: 20px; flex-shrink: 0; color: #4338ca; margin-top: 1px; }
.clientbanner b { color: #312e81; }
/* ---- AI crawlability ---- */
      .crawlbanner { display: flex; gap: 12px; align-items: flex-start; background: var(--bad-bg); border: 1px solid #f4cfcf; border-radius: 14px; padding: 14px 16px; margin-bottom: 4px; font-size: 13px; color: #8f2020; line-height: 1.55; }
.crawlbanner svg { width: 20px; height: 20px; flex-shrink: 0; color: var(--bad); margin-top: 1px; }
.crawlbanner b { color: var(--bad); }
.crawlcards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 620px) { .crawlcards { grid-template-columns: 1fr; } }
.crawlcard { border: 1px solid var(--line); border-radius: 14px; padding: 14px 15px; background: #fff; box-shadow: var(--shadow); border-left: 3px solid var(--line-2); }
.crawlcard.pass { border-left-color: var(--ok); }
.crawlcard.warn { border-left-color: var(--warn); }
.crawlcard.fail { border-left-color: var(--bad); }
.cc-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.cc-name { font-size: 13.5px; font-weight: 700; }
.cbadge { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
.cbadge svg { width: 11px; height: 11px; }
.cbadge.pass { background: var(--ok-bg); color: var(--ok); }
.cbadge.warn { background: var(--warn-bg); color: var(--warn); }
.cbadge.fail { background: var(--bad-bg); color: var(--bad); }
.cc-detail { font-size: 12px; color: var(--muted); margin-top: 7px; line-height: 1.5; }
.cc-fix { font-size: 12.5px; color: #6b5410; margin-top: 8px; background: var(--warn-bg); border-left: 3px solid var(--warn); padding: 7px 11px; border-radius: 0 8px 8px 0; line-height: 1.5; }
/* ---- Our AEO checklist ---- */
.cldetect { border: 1px solid var(--line); border-radius: 14px; background: #fff; padding: 14px 16px; margin-bottom: 14px; display: grid; gap: 8px; }
.cld-row { display: flex; align-items: center; gap: 9px; font-size: 13.5px; flex-wrap: wrap; }
.cld-label { color: var(--muted); min-width: 72px; }
.clconf { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 2px 8px; border-radius: 999px; }
.clconf.high { background: var(--ok-bg); color: var(--ok); }
.clconf.medium { background: var(--warn-bg); color: var(--warn); }
.clconf.low { background: #f1f5f9; color: var(--muted); }
.cld-evidence { font-size: 12px; color: var(--faint); padding-top: 4px; border-top: 1px solid var(--line); }
.cld-note { font-size: 12px; color: var(--faint); }
.clscore { font-size: 13.5px; color: var(--ink-2); margin-bottom: 14px; }
.clscore span { font-weight: 800; font-size: 18px; color: var(--ink); }
.clscore small { font-size: 12px; font-weight: 700; }
.cllist { display: grid; gap: 10px; }
.clrow { display: flex; gap: 12px; border: 1px solid var(--line); border-radius: 12px; padding: 13px 14px; background: #fff; border-left: 3px solid var(--line-2); }
.clrow.pass { border-left-color: var(--ok); }
.clrow.warn { border-left-color: var(--warn); }
.clrow.fail { border-left-color: var(--bad); }
.clbadge { flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; margin-top: 1px; }
.clbadge svg { width: 12px; height: 12px; }
.clbadge.pass { background: var(--ok-bg); color: var(--ok); }
.clbadge.warn { background: var(--warn-bg); color: var(--warn); }
.clbadge.fail { background: var(--bad-bg); color: var(--bad); }
.clbadge.na { background: #f1f5f9; color: var(--faint); }
.clbody { flex: 1; min-width: 0; }
.cltop { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.cltop b { font-size: 13.5px; }
.clgroup { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: var(--faint); background: #f1f5f9; padding: 2px 7px; border-radius: 999px; }
.cldetail { font-size: 12.5px; color: var(--muted); margin-top: 4px; line-height: 1.5; }
.clwhy { font-size: 12px; color: var(--ink-2); margin-top: 6px; padding-left: 10px; border-left: 2px solid var(--line-2); line-height: 1.5; }
.clwhy b { display: block; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: var(--faint); margin-bottom: 2px; }
.clfix { font-size: 12.5px; color: #6b5410; margin-top: 8px; background: var(--warn-bg); border-left: 3px solid var(--warn); padding: 7px 11px; border-radius: 0 8px 8px 0; line-height: 1.5; }
.clfoot { font-size: 12px; color: var(--faint); margin-top: 12px; }

/* ---- Content / Indexability / Keywords tabs: one plain sentence, then issues
   ranked worst-first, with the fix as the loudest thing on each card and
   "why it matters" shrunk to a footnote instead of a competing block. ---- */
.repcnt.bad { background: var(--bad-bg); color: var(--bad); }
.reptab.active .repcnt.bad { background: var(--bad-bg); color: var(--bad); }
.topicintro { margin-bottom: 14px; }
.topicintro p { margin: 0; font-size: 14.5px; color: var(--ink-2); line-height: 1.6; }
.issuelist { display: grid; gap: 10px; }
.issuecard { display: flex; gap: 12px; border: 1px solid var(--line); border-radius: 12px; padding: 15px 16px; background: #fff; border-left: 4px solid var(--line-2); box-shadow: var(--shadow); }
.issuecard.fail { border-left-color: var(--bad); }
.issuecard.warn { border-left-color: var(--warn); }
.issuebody { flex: 1; min-width: 0; }
.issuelabel { display: block; font-size: 14.5px; font-weight: 700; letter-spacing: -.005em; }
.issuedetail { margin: 4px 0 0; font-size: 13px; color: var(--muted); line-height: 1.5; }
.issuefix { margin: 10px 0 0; font-size: 13.5px; color: #0f172a; background: var(--ok-bg); border-radius: 9px; padding: 9px 12px; line-height: 1.5; }
.issuefix b { color: var(--ok); }
.issuewhy { margin: 8px 0 0; font-size: 11.5px; color: var(--faint); line-height: 1.5; }
.allgood { display: flex; align-items: center; gap: 10px; padding: 16px 18px; border-radius: 12px; background: var(--ok-bg); color: var(--ok); font-size: 14px; font-weight: 600; }
.allgood svg { width: 18px; height: 18px; flex-shrink: 0; }
.passfold { margin-top: 12px; border: 1px dashed var(--line-2); border-radius: 10px; padding: 2px 14px; }
.passfold > summary { cursor: pointer; list-style: none; padding: 10px 0; font-size: 12.5px; font-weight: 600; color: var(--muted); display: flex; align-items: center; gap: 7px; }
.passfold > summary::-webkit-details-marker { display: none; }
.passfold > summary svg { width: 13px; height: 13px; color: var(--ok); }
.passlist { padding: 2px 0 12px; display: grid; gap: 6px; }
.passrow { font-size: 12px; color: var(--muted); line-height: 1.5; }
.seeallwrap { margin-top: 12px; }
.seeallwrap > summary { cursor: pointer; list-style: none; font-size: 13px; font-weight: 600; color: var(--accent-dark); }
.seeallwrap > summary::-webkit-details-marker { display: none; }
.seeallwrap > summary:hover { text-decoration: underline; }
/* ---- Can LLMs access this page? (visibility) ---- */
      .devtoggle { display: inline-flex; gap: 4px; background: #f1f1f6; border-radius: 10px; padding: 4px; margin-bottom: 14px; }
.devbtn { border: none; background: transparent; padding: 7px 14px; border-radius: 7px; font-size: 12.5px; font-weight: 700; color: var(--muted); cursor: pointer; }
.devbtn.active { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(0,0,0,.08); }
.paritybanner { display: flex; gap: 11px; align-items: flex-start; background: var(--warn-bg); border: 1px solid #f0dfa8; border-radius: 12px; padding: 12px 14px; margin-bottom: 14px; font-size: 12.5px; color: #8a6a10; line-height: 1.55; }
.paritybanner svg { width: 18px; height: 18px; flex-shrink: 0; color: var(--warn); margin-top: 1px; }
.botrow { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
.botrow select { width: auto; flex: 1; min-width: 220px; }
#botresult:empty { display: none; }
.bottabs { display: flex; gap: 8px; flex-wrap: wrap; }
.bottab { border: 1px solid var(--line-2); background: #fff; padding: 8px 13px; border-radius: 10px; font-size: 12.5px; font-weight: 700; color: var(--ink-2); cursor: pointer; line-height: 1.4; }
.bottab small { display: block; font-size: 10.5px; font-weight: 500; color: var(--faint); }
.bottab.active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-dark); }
      .viscard { border: 1px solid var(--line); border-radius: 16px; padding: 18px; background: #fff; box-shadow: var(--shadow); border-top: 3px solid var(--line-2); }
.viscard.vis-yes { border-top-color: var(--ok); }
.viscard.vis-partial { border-top-color: var(--warn); }
.viscard.vis-no { border-top-color: var(--bad); }
.vis-verdicthead { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.vis-badge { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 800; letter-spacing: -.01em; padding: 6px 13px; border-radius: 999px; }
.vis-badge svg { width: 15px; height: 15px; }
.vis-badge.yes { background: var(--ok-bg); color: var(--ok); }
.vis-badge.partial { background: var(--warn-bg); color: var(--warn); }
.vis-badge.no { background: var(--bad-bg); color: var(--bad); }
.vis-fw { font-size: 11px; font-weight: 700; color: var(--muted); background: #f1f1f6; border: 1px solid var(--line); padding: 3px 9px; border-radius: 999px; }
.vis-reason { font-size: 13px; color: var(--ink-2); line-height: 1.6; margin: 11px 0 16px; }
.viewers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
@media (max-width: 680px) { .viewers { grid-template-columns: 1fr; } }
.viewer { border: 1px solid var(--line); border-radius: 13px; padding: 13px 14px; background: #fbfbfe; border-left: 3px solid var(--line-2); }
.viewer.pass { border-left-color: var(--ok); }
.viewer.warn { border-left-color: var(--warn); }
.viewer.fail { border-left-color: var(--bad); }
.vw-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 7px; }
.vw-who { font-size: 12.5px; font-weight: 700; line-height: 1.3; }
.vw-js { font-size: 9.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; white-space: nowrap; }
.vw-js.yes { background: #dbe8ff; color: var(--indigo); }
.vw-js.no { background: #eef0f5; color: var(--muted); }
.vw-access { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 800; margin-bottom: 6px; }
.vw-access svg { width: 13px; height: 13px; }
.vw-access.pass { color: var(--ok); }
.vw-access.warn { color: var(--warn); }
.vw-access.fail { color: var(--bad); }
.vw-sees { font-size: 11.5px; color: var(--muted); line-height: 1.5; }
.vis-elhead { font-size: 12.5px; font-weight: 700; margin: 18px 0 10px; letter-spacing: -.01em; }
.ellist { display: grid; gap: 7px; }
.elrow { display: flex; gap: 11px; align-items: flex-start; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; background: #fff; }
.elchip { width: 20px; height: 20px; border-radius: 6px; display: grid; place-items: center; flex-shrink: 0; margin-top: 1px; }
.elchip svg { width: 11px; height: 11px; }
.elchip.pass { background: var(--ok-bg); color: var(--ok); }
.elchip.warn { background: var(--warn-bg); color: var(--warn); }
.elchip.fail { background: var(--bad-bg); color: var(--bad); }
.elbody { flex: 1; min-width: 0; }
.elname { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.eltag { font-size: 9px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: 2px 7px; border-radius: 5px; }
.eltag.read { background: var(--ok-bg); color: var(--ok); }
.eltag.partial { background: var(--warn-bg); color: var(--warn); }
.eltag.missed { background: var(--bad-bg); color: var(--bad); }
.eldetail { font-size: 12px; color: var(--muted); margin-top: 2px; line-height: 1.5; }
/* ---- Verify in real engines ---- */
