              </div>
            </div>
            <label class="fld" for="target">Target question this page should be the cited answer to <span class="opt">(optional)</span></label>
            <input id="target" type="text" placeholder="e.g. why did Virat Kohli retire?" />
            <label class="fld" for="competitors">Competitors to track <span class="opt">(optional — domains, comma-separated; used in “Verify in real engines”)</span></label>
            <input id="competitors" type="text" placeholder="e.g. sephora.com, sugarcosmetics.com" />

            <div class="row">
              <button class="primary" id="go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>Run AEO audit</button>
              <span class="hint">Takes 15–30 seconds.</span>
            </div>

            <div class="alert err" id="err"></div>
            <div class="alert info" id="info"></div>
          </div>
        )}

        <section id="results"></section>
      </div>
    </main>

    <footer><b>CiteRank</b> · By Rudra Kasturi Inc · category-weighted &amp; evidence-based (Princeton GEO, Ahrefs studies) · predicts citability, not a guarantee</footer>
    <div class="toast" id="toast"></div>

    <script>
      const $ = (id) => document.getElementById(id);
      let mode = 'url';
      let SVC = null; // server capability (set by checkHealth): { judge, verify, ... }
      const CAT_LABEL = { general: 'General', entertainment: 'Entertainment', health: 'Health', news: 'Breaking News', lifestyle: 'Lifestyle', commerce: 'Beauty / Commerce' };

      // Inline SVG icon set (stroke-based, replaces emoji for a cleaner look).
      const IC = {
        engine: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="14" height="14" rx="2.5"/><rect x="9" y="9" width="6" height="6" rx="1.2"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/></svg>',
        bot: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="11" rx="2.5"/><path d="M12 8V4M9 4h6"/><circle cx="9" cy="13" r="1"/><circle cx="15" cy="13" r="1"/><path d="M2 13v2M22 13v2"/></svg>',
        eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>',
        bars: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="7" rx="1"/><rect x="12" y="6" width="3" height="11" rx="1"/><rect x="17" y="13" width="3" height="4" rx="1"/></svg>',
        chat: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/></svg>',
        wrench: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14.6 6.3a3.7 3.7 0 0 0-4.9 4.7l-6 6a1.7 1.7 0 0 0 0 2.4l.9.9a1.7 1.7 0 0 0 2.4 0l6-6a3.7 3.7 0 0 0 4.7-4.9l-2.5 2.5-2.1-.6-.6-2.1z"/></svg>',
        globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18"/></svg>',
        layers: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/></svg>',
        sparkle: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z"/></svg>',
        download: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>',
        copy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>',
        check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4.5 4.5L19 7"/></svg>',
        alert: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5"/><path d="M12 16.5h.01"/></svg>',
        x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"/></svg>',
        dash: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 12h12"/></svg>',
        caret: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>',
        arrow: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>',
        shieldX: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/><path d="m10 10 4 4m0-4-4 4"/></svg>',
        shieldA: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/><path d="M12 9v3m0 3h.01"/></svg>',
        shieldOk: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/><path d="m9 11.5 2 2 4-4"/></svg>',
        trophy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3M9 19h6M10 15v4M14 15v4"/></svg>',
      };
      const STATUS_IC = { pass: IC.check, warn: IC.alert, fail: IC.x, na: IC.dash };
      const GATE_IC = { block: IC.shieldX, warn: IC.shieldA, strong: IC.shieldOk, optimized: IC.trophy };

      function setMode(m) {
        mode = m;
        $('tab-url').classList.toggle('active', m === 'url');
        $('tab-paste').classList.toggle('active', m === 'paste');
        $('pane-url').style.display = m === 'url' ? 'block' : 'none';
        $('pane-paste').style.display = m === 'paste' ? 'block' : 'none';
      }
      $('tab-url').addEventListener('click', () => setMode('url'));
      $('tab-paste').addEventListener('click', () => setMode('paste'));

      function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
      function showErr(msg) { const e = $('err'); e.innerHTML = IC.alert + '<span>' + esc(msg) + '</span>'; e.style.display = 'flex'; }
      function hideAlerts() { $('err').style.display = 'none'; $('info').style.display = 'none'; }

      function hexFor(s) { if (s == null) return '#9aa0ad'; if (s >= 75) return '#15915f'; if (s >= 45) return '#b07900'; return '#d23c3c'; }
      function statusOf(s) { if (s == null) return 'na'; if (s >= 75) return 'pass'; if (s >= 45) return 'warn'; return 'fail'; }
      function tintFor(s) { const st = statusOf(s); return st === 'pass' ? 'background:var(--ok-bg);color:var(--ok)' : st === 'warn' ? 'background:var(--warn-bg);color:var(--warn)' : st === 'fail' ? 'background:var(--bad-bg);color:var(--bad)' : 'background:#eef0f5;color:var(--na)'; }
      function sec(icon, title, sub) { return `<div class="sectitle"><span class="sicn">${icon}</span><div class="stx"><b>${title}</b>${sub ? `<span>${sub}</span>` : ''}</div></div>`; }

      function render(data) {
        const r = data.report, m = data.meta || {}, root = $('results');
        const vc = hexFor(r.overall);

        const chips = [
          m.pageTypeLabel ? `<span class="chip intent">${esc(m.pageTypeLabel)}${m.pageTypeAuto ? ' (auto)' : ''}</span>` : '',
          `<span class="chip band-${r.citationBand}">${r.citationBand} citation likelihood</span>`,
          r.benchmark ? `<span class="chip">${esc(r.benchmark)}</span>` : '',
          `<span class="chip">${m.wordCount} words</span>`,
          m.detectedIntent ? `<span class="chip intent">${esc(m.detectedIntent)}</span>` : '',
          m.brand ? `<span class="chip">brand: ${esc(m.brand)}</span>` : (m.host ? `<span class="chip">site: ${esc(m.host)}</span>` : ''),
        ].filter(Boolean).join('');

        let suggest = '';
        if (m.suggestedCategory && m.suggestedCategory !== m.category) {
          suggest = `<div class="suggest">This reads more like <b>${esc(CAT_LABEL[m.suggestedCategory] || m.suggestedCategory)}</b> than ${esc(m.categoryLabel)}. <a id="recat" data-cat="${esc(m.suggestedCategory)}">Re-audit as ${esc(CAT_LABEL[m.suggestedCategory] || m.suggestedCategory)} →</a></div>`;
        }

        const bandLine = r.citationBand === 'High' ? 'Likely to be cited by AI'
          : r.citationBand === 'Medium' ? 'Some chance of being cited — needs work'
          : 'Unlikely to be cited as it stands';
        const hero = `
          <div class="card">
            <div class="hero-res">
              <div class="donut" style="--val:${r.overall};--ring:${vc}">
                <div class="inner"><div class="num" style="color:${vc}">${r.overall}<span class="pct">%</span></div><div class="grd">AEO · ${esc(r.grade)}</div></div>
              </div>
              <div class="verdict">
                <span class="gate ${r.gate.level}">${GATE_IC[r.gate.level] || IC.shieldA} ${esc(r.gate.label)}</span>
                <div class="vtitle" style="color:${vc}">${bandLine}</div>
                <div class="vsub">${esc(m.mode === 'url' ? (m.url || 'Audited URL') : 'Pasted content')}${m.pageTypeLabel ? ` · ${esc(m.pageTypeLabel)}` : ''} · weighted for <b>${esc(m.categoryLabel)}</b></div>
                <div class="chips">${chips}</div>
                ${suggest}
                ${m.fetchNote ? `<div class="note-warn">${IC.alert}<span>${esc(m.fetchNote)}</span></div>` : ''}
                ${m.aiError ? `<div class="note-bad">${IC.alert}<span>AI-judged signals unavailable — they default to 50. Add a funded API key to the service. (${esc(m.aiError)})</span></div>` : ''}
              </div>
            </div>
            ${r.summary ? `<div class="summary"><span class="sicon">${IC.sparkle}</span><div class="sbody"><b>What this means</b><p>${esc(r.summary)}</p></div></div>` : ''}
          </div>`;

        // ---- AI crawlability (robots.txt + llms.txt) ----
        function crawlBadge(s) {
          if (s.id === 'llms_txt') return s.score >= 100 ? ['Found', 'pass'] : ['Not found', 'warn'];
          if (s.score >= 100) return ['Allowed', 'pass'];
          if (s.score === 0) return ['Blocked', 'fail'];
          if (s.score >= 70) return ['Default-allow', 'pass'];
          return ['Partly blocked', 'warn'];
        }
        const crawl = r.crawlability || [];
        const crawlPanel = crawl.length ? sec(IC.bot, 'AI crawlability', 'can answer-engine bots actually reach this page? (site-wide — not in the score)') + `
          <div class="crawlcards">${crawl.map((s) => {
            const [lbl, st] = crawlBadge(s);
            return `<div class="crawlcard ${st}"><div class="cc-top"><span class="cc-name">${esc(s.label)}</span><span class="cbadge ${st}">${st === 'pass' ? IC.check : st === 'fail' ? IC.x : IC.alert}${lbl}</span></div><div class="cc-detail">${esc(s.detail)}</div>${s.fix ? `<div class="cc-fix">${esc(s.fix)}</div>` : ''}</div>`;
          }).join('')}</div>` : '';
        const crawlBanner = r.crawlBlocked ? `<div class="crawlbanner">${IC.shieldX}<div><b>An answer-engine crawler is blocked.</b> No matter how good this page is, the affected engines can't read it — so they can't cite it. Fix the robots.txt rules flagged in “AI crawlability” below first.</div></div>` : '';

        // ---- Can LLMs access this page? (User vs Googlebot vs LLM) ----
        const vis = r.visibility;
        const ACCESS_IC = { ok: IC.check, partial: IC.alert, blocked: IC.x };
        const ACCESS_ST = { ok: 'pass', partial: 'warn', blocked: 'fail' };
        const EL_IC = { read: IC.check, partial: IC.alert, missed: IC.x };
        const visibilityPanel = (vis && vis.applicable) ? sec(IC.eye, 'Can LLMs access this page?', 'what a human, Googlebot and the LLM crawlers each actually see') + `
          <div class="viscard vis-${vis.verdict.level}">
            <div class="vis-verdicthead">
              <span class="vis-badge ${vis.verdict.level}">${vis.verdict.level === 'yes' ? IC.check : vis.verdict.level === 'no' ? IC.x : IC.alert} ${esc(vis.verdict.label)}</span>
              ${vis.framework ? `<span class="vis-fw">${esc(vis.framework)} detected</span>` : ''}
            </div>
            <div class="vis-reason">${esc(vis.verdict.reason)}</div>
            <div class="viewers">${vis.viewers.map((v) => {
              const st = ACCESS_ST[v.access];
              return `<div class="viewer ${st}"><div class="vw-top"><span class="vw-who">${esc(v.who)}</span><span class="vw-js ${v.rendersJs ? 'yes' : 'no'}">${v.rendersJs ? 'runs JS' : 'no JS'}</span></div><div class="vw-access ${st}">${ACCESS_IC[v.access]} ${v.access === 'ok' ? 'Can read it' : v.access === 'partial' ? 'Partial' : 'Blocked'}</div><div class="vw-sees">${esc(v.sees)}</div></div>`;
            }).join('')}</div>
            ${vis.elements && vis.elements.length ? `<div class="vis-elhead">Element-by-element — what LLMs get from the raw HTML</div><div class="ellist">${vis.elements.map((e) => `<div class="elrow ${e.status}"><span class="elchip ${e.status === 'read' ? 'pass' : e.status === 'partial' ? 'warn' : 'fail'}">${EL_IC[e.status]}</span><div class="elbody"><div class="elname">${esc(e.label)} <span class="eltag ${e.status}">${e.status === 'read' ? 'LLMs read this' : e.status === 'partial' ? 'partly read' : 'LLMs miss this'}</span></div><div class="eldetail">${esc(e.detail)}</div></div></div>`).join('')}</div>` : ''}
          </div>` : '';

        const engineMeta = [['chatgpt', 'ChatGPT', '#10a37f'], ['gemini', 'Gemini', '#4285f4'], ['perplexity', 'Perplexity', '#20808d'], ['aiOverviews', 'AI Overviews', '#a855f7']];
        const enginesPanel = r.engines ? sec(IC.engine, 'Likelihood by engine', 'estimated chance each engine cites this page') + `
          <div class="engcards">${engineMeta.map(([k, label, brand]) => {
            const s = typeof r.engines[k] === 'number' ? r.engines[k] : 0; const col = hexFor(s);
            return `<div class="engcard" style="--e:${brand}"><div class="en"><span class="swatch"></span>${label}</div><div class="es" style="color:${col}">${s}<small>%</small></div><div class="ebar"><i style="width:${s}%;background:${col}"></i></div></div>`;
          }).join('')}</div>` : '';

        // ---- Verify in real engines (predict -> measure) ----
        const aiPrompts = (r.promptCoverage || []).map((p) => p.q).filter(Boolean);
        const verifyPrompts = aiPrompts.length ? aiPrompts : (m.fallbackPrompts || []);
        const usingFallback = aiPrompts.length === 0 && verifyPrompts.length > 0;
        const verifyConfigured = SVC ? SVC.verify : true; // assume ok until health says otherwise
        const canVerify = m.mode === 'url' && verifyPrompts.length > 0;
        let verifyBody;
        if (m.mode !== 'url') {
          verifyBody = `<div class="note-warn">${IC.alert}<span>Verification needs a live domain. Audit a URL (not pasted HTML) to use this.</span></div>`;
        } else if (!verifyPrompts.length) {
          verifyBody = `<div class="note-warn">${IC.alert}<span>No prompts to verify. Add a <b>Topic</b> or a <b>Target question</b> in the form and re-run — CiteRank will use those to query the engines.</span></div>`;
        } else if (!verifyConfigured) {
          verifyBody = `<div class="note-warn">${IC.alert}<span><b>Live verification isn’t available right now.</b> We’re working on turning this back on — check back soon.</span></div>`;
        } else {
          verifyBody = `<button class="primary vfy-btn" id="verifybtn">${IC.bot} Verify against live engines</button><span class="hint">Queries ${verifyPrompts.length} prompt${verifyPrompts.length > 1 ? 's' : ''} · up to ~60s.</span>`;
        }
        const verifyPanel = sec(IC.shieldOk, 'Verify in real engines', 'run these prompts through live ChatGPT &amp; Perplexity and see who actually gets cited') + `
          <div class="verifybox">
            <div class="vfy-intro"><b>The scores above are a prediction.</b> This runs ${verifyPrompts.length || 'the'} of the page's likely prompts through real answer engines and checks whether <b>${esc(m.host || 'your domain')}</b> is actually cited — ground truth, not an estimate.${usingFallback ? ` <span class="vfy-fallback">Using prompts derived from your page (the AI judge is off).</span>` : ''}</div>
            ${verifyBody}
            <div id="verifyout"></div>
          </div>`;

        const gauges = r.pillars.map((p) => {
          const col = hexFor(p.score);
          const counts = p.signals.reduce((a, s) => { const st = s.score == null ? 'na' : statusOf(s.score); a[st] = (a[st] || 0) + 1; return a; }, {});
          const issues = (counts.warn || 0) + (counts.fail || 0);
          return `
            <div class="gauge" style="--g:${col}" data-pill="${p.id}" role="button" tabindex="0" title="Click to see the issues in ${esc(p.label)}">
              <div class="gtop">
                <div><div class="gname">${esc(p.label)}</div><div class="gpurpose">${esc(p.purpose)}</div></div>
                <div class="gpts">${p.points}<small>/${p.weight}</small></div>
              </div>
              <div class="gbar"><i style="width:${p.score}%"></i></div>
              <div class="gcounts">
                ${counts.pass ? `<span class="cok">✓ ${counts.pass}</span>` : ''}
                ${counts.warn ? `<span class="cwarn">! ${counts.warn}</span>` : ''}
                ${counts.fail ? `<span class="cbad">✕ ${counts.fail}</span>` : ''}
              </div>
              <div class="gmore">${issues ? `See ${issues} issue${issues > 1 ? 's' : ''}` : 'All good — view details'} ${IC.arrow}</div>
            </div>`;
        }).join('');

        const dc = (r.domainContext || []).map((s) => `
          <div class="drow">
            <span class="dscore" style="${tintFor(s.score)}">${s.score == null ? 'n/a' : s.score}</span>
            <div class="dbody"><div class="dname">${esc(s.label)}</div><div class="ddetail">${esc(s.detail)}</div></div>
          </div>`).join('');
        const domainPanel = dc ? sec(IC.globe, 'Domain context', 'off-page — NOT counted in the score (an editor can\'t change it per article)') + `
          <div class="domain"><div class="dnote">AI estimate from training data, not a live measurement. Verify with Ahrefs / Semrush.</div>${dc}</div>` : '';

        const pc = (r.promptCoverage || []);
        const covered = pc.filter((p) => p.covered).length;
        const covPct = pc.length ? Math.round((covered / pc.length) * 100) : 0;
        const promptPanel = pc.length ? sec(IC.chat, 'Prompt coverage', `answers ${covered} of ${pc.length} likely AI questions (${covPct}%)`) + `
          <div class="covbar"><i style="width:${covPct}%"></i></div>
          <div class="prompts">${pc.map((p) => `<div class="prow"><span class="pmark ${p.covered ? 'yes' : 'no'}">${p.covered ? IC.check : IC.x}</span><div>${esc(p.q)}</div></div>`).join('')}</div>` : '';

        const TAGLBL = { high: 'High impact', quick: 'Quick win', offpage: 'Off-page' };
        const fixesHtml = (r.topFixes || []).map((fx, i) => {
          const col = fx.severity === 'fail' ? '#d23c3c' : '#b07900';
          const gain = fx.gain >= 0.5 ? `<span class="gain">+${fx.gain} pts</span>` : '';
          return `<div class="fixrow" style="--fc:${col}"><span class="fnum">${i + 1}</span><div class="ftext"><b>${esc(fx.label)}</b>${esc(fx.fix)}</div><div class="fmeta">${gain}<span class="ftag ${fx.tag}">${TAGLBL[fx.tag] || fx.tag}</span></div></div>`;
        }).join('');

        const statusRank = { fail: 0, warn: 1, na: 2, pass: 3 };
        const breakdown = r.pillars.map((p) => {
          const col = hexFor(p.score);
          const ordered = [...p.signals].sort((a, b) => {
            const sa = a.score == null ? 'na' : statusOf(a.score);
            const sb = b.score == null ? 'na' : statusOf(b.score);
            return statusRank[sa] - statusRank[sb];
          });
          const issues = p.signals.filter((s) => s.score != null && statusOf(s.score) !== 'pass').length;
          const sigs = ordered.map((s) => {
            const st = s.score == null ? 'na' : statusOf(s.score);
            const tag = s.source === 'ai' ? '<span class="tag">AI</span>' : '';
            return `<div class="signal"><span class="schip ${st}">${STATUS_IC[st]}</span><div class="sbody"><div class="sname">${esc(s.label)}${tag}</div><div class="sdetail">${esc(s.detail)}</div>${s.fix ? `<div class="sfix">${esc(s.fix)}</div>` : ''}</div><span class="sscore" style="${tintFor(s.score)}">${s.score == null ? 'n/a' : s.score}</span></div>`;
          }).join('');
          const open = p.score < 70 ? ' open' : '';
          const issueLbl = issues ? `<span class="pissues">${issues} issue${issues > 1 ? 's' : ''} to fix</span>` : '<span class="pclean">no issues</span>';
          return `<details class="pillar" id="pill-${p.id}" style="--p:${col}"${open}><summary><span class="caret">${IC.caret}</span><span class="pdot"></span><span class="pname">${esc(p.label)}</span>${issueLbl}<span class="pbar"><i style="width:${p.score}%"></i></span><span class="pscore">${p.score}</span></summary><div class="signals">${sigs}</div></details>`;
        }).join('');

        root.innerHTML = `
          <div class="printhead">
            <div class="pt-brand">CiteRank — AEO Audit</div>
            <div class="pt-sub">${esc(m.mode === 'url' ? (m.url || 'Audited page') : 'Pasted content')}${m.pageTypeLabel ? ` · ${esc(m.pageTypeLabel)}` : ''} · ${esc(new Date().toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }))}</div>
          </div>
          ${hero}
          ${crawlBanner}
          <div class="resbar">${m.savedId ? `<span class="savednote" style="margin-right:auto">${IC.check} Saved to your history</span>` : (ACCOUNTS && !USER ? `<span class="savednote" style="margin-right:auto;color:var(--muted)"><a id="savesignin" style="color:var(--pink-dark);font-weight:700;cursor:pointer">Sign in</a> to save this audit to your history</span>` : '')}<button class="ghostbtn" id="pdfbtn">${IC.download} Download PDF</button><button class="ghostbtn" id="copyreport">${IC.copy} Copy report</button></div>
          ${visibilityPanel}
          ${enginesPanel}
          ${verifyPanel}
          ${crawlPanel}
          ${sec(IC.bars, 'Pillar scores', 'points shown out of each pillar\'s category weight')}
          <div class="gauges">${gauges}</div>
          ${promptPanel}
          ${fixesHtml ? sec(IC.wrench, 'Top fixes, ranked by impact', '') + `<div class="fixlist">${fixesHtml}</div>` : ''}
          ${domainPanel}
          ${sec(IC.layers, 'Full breakdown', '')}
          ${breakdown}
          <div class="caveat"><b>How to read this:</b> the score grades only what an editor can change before publishing. Off-page brand authority is the strongest real driver of citation but is shown separately as <b>domain context</b> because it's the same for every article on your site. Signals marked <b>AI</b> are the model's judgement / estimate. Citation behaviour varies between engines (ChatGPT favours Wikipedia, Perplexity favours Reddit), so treat this as one composite signal, not a guarantee.</div>`;

        const recat = $('recat');
        if (recat) recat.addEventListener('click', () => { $('category').value = recat.dataset.cat; run(); });
        const copyBtn = $('copyreport');
        if (copyBtn) copyBtn.addEventListener('click', () => copyReport(r, m));
        const pdfBtn = $('pdfbtn');
        if (pdfBtn) pdfBtn.addEventListener('click', () => window.print());
        const ssi = $('savesignin');
        if (ssi) ssi.addEventListener('click', () => openAuth('login'));

        const verifyBtn = $('verifybtn');
        if (verifyBtn) verifyBtn.addEventListener('click', () => runVerify(r, m, verifyPrompts, verifyBtn));

        root.querySelectorAll('.gauge[data-pill]').forEach((g) => {
          const openPill = () => {
            const d = document.getElementById('pill-' + g.dataset.pill);
            if (d) { d.open = true; d.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
          };
          g.addEventListener('click', openPill);
          g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPill(); } });
        });

        root.style.display = 'block';
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // ---- Verify in real engines ----
      async function runVerify(r, m, prompts, btn) {
        const out = $('verifyout');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>Querying live engines…';
        out.innerHTML = '<div class="vfy-loading">Running ' + prompts.length + ' prompt' + (prompts.length > 1 ? 's' : '') + ' through real answer engines. This can take up to a minute…</div>';
        try {
          const competitors = ($('competitors').value || '').split(/[,\s]+/).map((s) => s.trim()).filter(Boolean);
          const res = await fetch('/api/aeo-verify', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompts, url: m.url, host: m.host, brand: m.brand, competitors }),
          });
          const data = await res.json();
          if (!res.ok) { out.innerHTML = '<div class="note-bad">' + IC.alert + '<span>' + esc(data.error || 'Verification failed.') + '</span></div>'; }
          else renderVerify(data.result, out);
        } catch (e) {
          out.innerHTML = '<div class="note-bad">' + IC.alert + '<span>Network error: ' + esc(e && e.message ? e.message : e) + '</span></div>';
        } finally {
          btn.disabled = false;
          btn.innerHTML = IC.bot + ' Re-run verification';
        }
      }

      function renderVerify(v, out) {
        if (!v || !v.ran) {
          out.innerHTML = '<div class="note-warn">' + IC.alert + '<span>' + esc((v && v.note) || 'Verification could not run.') + '</span></div>';
          return;
        }
        const rateCol = hexFor(v.citationRate);
        // Group probes by prompt for a per-question view.
        const byPrompt = {};
        (v.probes || []).forEach((p) => { (byPrompt[p.q] = byPrompt[p.q] || []).push(p); });
        const promptRows = Object.keys(byPrompt).map((q) => {
          const chips = byPrompt[q].map((p) => {
            const cls = p.error ? 'na' : p.cited ? 'pass' : 'fail';
            const txt = p.error ? 'error' : p.cited ? 'Cited' : 'Not cited';
            const ico = p.error ? IC.dash : p.cited ? IC.check : IC.x;
            const srcN = !p.error ? ` · ${p.sources.length} src` : '';
            return `<span class="vchip ${cls}" title="${esc(p.engine)}${p.error ? ': ' + esc(p.error) : ''}">${ico}${esc(p.engine)}: ${txt}${srcN}</span>`;
          }).join('');
          return `<div class="vrow"><div class="vq">${esc(q)}</div><div class="vchips">${chips}</div></div>`;
        }).join('');

        const maxSov = Math.max(1, ...(v.shareOfVoice || []).map((s) => s.count));
        const sov = (v.shareOfVoice || []).map((s) => {
          const cls = s.isYou ? 'you' : s.isCompetitor ? 'rival' : '';
          const tag = s.isYou ? '<span class="youtag">YOU</span>' : s.isCompetitor ? '<span class="rivaltag">RIVAL</span>' : '';
          const w = Math.round((s.count / maxSov) * 100);
          return `<div class="sovrow ${cls}"><div class="sovdom">${esc(s.domain)}${tag}</div><div class="sovbar"><i style="width:${Math.max(w, s.count ? 6 : 0)}%"></i></div><div class="sovn">${s.count}</div></div>`;
        }).join('');

        const KIND_TINT = { Community: '#5b54e6', Encyclopedia: '#15915f', Video: '#d23c3c', Marketplace: '#b07900', Authority: '#20808d', Publisher: '#3c3f4a' };
        const gaps = (v.sourceGaps || []).map((g) => {
          const col = KIND_TINT[g.kind] || '#3c3f4a';
          return `<div class="gaprow"><div class="gaptop"><span class="gapdom">${esc(g.domain)}</span><span class="gapkind" style="background:${col}1a;color:${col}">${esc(g.kind)} · cited ${g.count}×</span></div><div class="gapaction">${esc(g.action)}</div></div>`;
        }).join('');

        out.innerHTML = `
          ${v.note ? `<div class="note-warn">${IC.alert}<span>${esc(v.note)}</span></div>` : ''}
          <div class="vfy-stats">
            <div class="vstat" style="--vc:${rateCol}"><div class="vnum" style="color:${rateCol}">${v.citationRate}<small>%</small></div><div class="vlbl">Citation rate<span>${esc(v.yourDomain)} cited in live answers</span></div></div>
            <div class="vstat"><div class="vnum">${v.promptCitationRate}<small>%</small></div><div class="vlbl">Prompt coverage<span>prompts where you were cited at least once</span></div></div>
            <div class="vstat"><div class="vnum">${v.brandMentionRate}<small>%</small></div><div class="vlbl">Brand mention<span>answers that named ${esc(v.brand || 'the brand')}</span></div></div>
          </div>
          <div class="vfy-engines">Measured live via ${v.engines.map((e) => `<span class="chip">${esc(e)}</span>`).join(' ')}</div>
          <div class="vsub2">Per-prompt results</div>
          <div class="vrows">${promptRows}</div>
          ${sov ? `<div class="vsub2">Share of voice — who got cited across these prompts${v.competitors && v.competitors.length ? ' (your pinned rivals are always shown)' : ''}</div><div class="sovlist">${sov}</div>` : ''}
          ${gaps ? `<div class="vsub2">Source gap — your off-page to-do list</div><div class="gaphint">These third-party sites get cited for your prompts and you don't. Earning a presence on them is the highest-leverage off-page work for AI citation.</div><div class="gaplist">${gaps}</div>` : ''}
          <div class="caveat">This is a real-time sample of ${v.promptCount} prompt(s) on a single run — answer engines are non-deterministic, so treat it as a directional read, not a fixed ranking. Re-run for a fresh sample.</div>`;
        out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function showToast(msg) { const t = $('toast'); t.textContent = msg; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 1900); }
      async function copyReport(r, m) {
        const L = [];
        L.push('CiteRank — AEO audit · By Rudra Kasturi Inc');
        L.push(m.mode === 'url' ? (m.url || '') : 'Pasted article');
        L.push(`Category: ${m.categoryLabel}`);
        L.push(`Score: ${r.overall}/100 (Grade ${r.grade}) — ${r.citationBand} citation likelihood — ${r.gate.label}`);
        if (r.benchmark) L.push(r.benchmark);
        if (r.engines) { L.push(''); L.push(`Likelihood by engine: ChatGPT ${r.engines.chatgpt}% · Gemini ${r.engines.gemini}% · Perplexity ${r.engines.perplexity}% · AI Overviews ${r.engines.aiOverviews}%`); }
        if (r.crawlability && r.crawlability.length) {
          L.push(''); L.push('AI crawlability:');
          r.crawlability.forEach((s) => L.push(`  - ${s.label}: ${s.detail}`));
          if (r.crawlBlocked) L.push('  ⚠ A primary answer-engine crawler is BLOCKED — fix robots.txt first.');
        }
        L.push('');
        L.push(`AI verdict: ${r.summary}`);
        L.push('');
        L.push('Pillar scores:');
        r.pillars.forEach((p) => L.push(`  - ${p.label}: ${p.points}/${p.weight}`));
        if (r.promptCoverage && r.promptCoverage.length) {
          const cov = r.promptCoverage.filter((p) => p.covered).length;
          L.push(''); L.push(`Prompt coverage: ${cov}/${r.promptCoverage.length}`);
          r.promptCoverage.forEach((p) => L.push(`  [${p.covered ? 'x' : ' '}] ${p.q}`));
        }
        if (r.topFixes && r.topFixes.length) {
          L.push(''); L.push('Top fixes (ranked by impact):');
          r.topFixes.forEach((f, i) => L.push(`  ${i + 1}. ${f.label}${f.gain >= 0.5 ? ` (+${f.gain} pts)` : ''} — ${f.fix}`));
        }
        L.push(''); L.push('Generated by CiteRank · By Rudra Kasturi Inc');
        try { await navigator.clipboard.writeText(L.join('\n')); showToast('Report copied to clipboard'); }
        catch { showToast('Copy failed — select & copy manually'); }
      }

      async function run() {
        hideAlerts();
        const payload = { brand: $('brand').value.trim(), topic: $('topic').value.trim(), target: $('target').value.trim(), category: $('category').value, pageType: $('pagetype').value };
        if (mode === 'url') { payload.url = $('url').value.trim(); if (!payload.url) { showErr('Enter a page URL to audit.'); return; } }
        else { payload.html = $('html').value.trim(); if (!payload.html) { showErr('Paste the article HTML or text to audit.'); return; } }

        const btn = $('go');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>Auditing…';
        $('info').innerHTML = IC.sparkle + '<span>' + (mode === 'url' ? 'Fetching the page and scoring it. This can take 15–30 seconds.' : 'Scoring the content. This can take 15–30 seconds.') + '</span>';
        $('info').style.display = 'flex';

        try {
          const res = await fetch('/api/aeo-audit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          const data = await res.json();
          if (!res.ok) {
            if (data.requireAuth) { $('info').style.display = 'none'; pendingAction = run; openAuth('signup'); return; }
            showErr(data.error || 'Something went wrong. Please try again.');
          } else render(data);
        } catch (e) {
          showErr('Network error: ' + (e && e.message ? e.message : e));
        } finally {
          $('info').style.display = 'none';
          btn.disabled = false;
          btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>Run AEO audit';
        }
      }
      // An account is required to run an audit — gate the button up front.
      function goClicked() { if (!ACCOUNTS || USER) run(); else { pendingAction = run; openAuth('signup'); } }
      $('go').addEventListener('click', goClicked);

      // ---- service capability probe (silent) — feeds SVC for internal gating
      // (e.g. whether to show the "Verify in real engines" button). No banner is
      // shown to customers here; that's an ops concern, not theirs to fix.
      async function checkHealth() {
        try { SVC = await (await fetch('/api/aeo-health')).json(); } catch { SVC = null; }
      }
      checkHealth();

      // ---- accounts + saved-audit history ----
      let USER = null, ACCOUNTS = false, pendingAction = null;
      async function refreshAuth() {
        try { const d = await (await fetch('/api/auth/me')).json(); ACCOUNTS = !!d.accountsEnabled; USER = d.user; }
        catch { ACCOUNTS = false; USER = null; }
        renderAcct();
      }
      function renderAcct() {
        const el = $('acct'); if (!el) return;
        if (!ACCOUNTS) { el.innerHTML = ''; return; }
        if (USER) {
          el.innerHTML = `<span class="acct-usage" id="acctusage"></span><span class="acct-email">${esc(USER.email)}</span><a class="acct-btn" href="/dashboard">Dashboard</a><button class="acct-btn" id="myaudits">My audits</button><button class="acct-btn" id="signout">Sign out</button>`;
          $('myaudits').onclick = showAudits; $('signout').onclick = signOut;
          fetch('/api/payments/status').then((r) => r.json()).then((d) => {
            const u = $('acctusage');
            if (!u || !d.signedIn) return;
            if (d.plan === 'pro') {
              const low = (d.planLimit - d.planUsed) <= Math.ceil(d.planLimit * 0.1);
              u.innerHTML = `<a href="/pricing" class="usage-pill pro${low ? ' low' : ''}">Pro · ${d.planUsed}/${d.planLimit}</a>`;
            } else {
              const left = (d.freeCheckAvailable ? 1 : 0) + (d.credits || 0);
              u.innerHTML = `<a href="/pricing" class="usage-pill${left === 0 ? ' low' : ''}">Free · ${left} check${left === 1 ? '' : 's'} left</a>`;
            }
          }).catch(() => {});
        } else {
          el.innerHTML = `<button class="acct-btn solid" id="signin">Sign in</button>`;
          $('signin').onclick = () => openAuth('login');
        }
      }
      function openModal(html) { $('modal-body').innerHTML = html; $('modal').style.display = 'flex'; }
      function closeModal() { $('modal').style.display = 'none'; }
      $('modalx').onclick = closeModal;
      $('modal').addEventListener('click', (e) => { if (e.target === $('modal')) closeModal(); });

      function openAuth(mode) {
        const isLogin = mode === 'login';
        openModal(`
          <h3>${isLogin ? 'Welcome back' : 'Create your free account'}</h3>
          <p class="msub">${pendingAction ? 'An account is required to run a check — it takes 10 seconds.' : (isLogin ? 'Sign in to see your saved audits and history.' : 'Save every audit and build a history you can track over time.')}</p>
          <label class="fld" for="au-email">Email</label>
          <input id="au-email" type="email" placeholder="you@company.com" autocomplete="email" />
          <label class="fld" for="au-pw">Password</label>
          <input id="au-pw" type="password" placeholder="${isLogin ? 'Your password' : 'At least 8 characters'}" autocomplete="${isLogin ? 'current-password' : 'new-password'}" />
          <div class="modal-err" id="au-err"></div>
          <button class="primary" id="au-go">${isLogin ? 'Sign in' : 'Create account'}</button>
          <div class="modal-switch">${isLogin ? 'New here? <a id="au-switch">Create an account</a>' : 'Have an account? <a id="au-switch">Sign in</a>'}</div>
        `);
        $('au-go').onclick = () => submitAuth(mode);
        $('au-switch').onclick = () => openAuth(isLogin ? 'signup' : 'login');
        $('au-pw').addEventListener('keydown', (e) => { if (e.key === 'Enter') submitAuth(mode); });
        $('au-email').focus();
      }
      async function submitAuth(mode) {
        const email = $('au-email').value.trim(), pw = $('au-pw').value;
        const err = $('au-err'); err.style.display = 'none';
        const btn = $('au-go'); btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>Please wait…';
        const reset = () => { btn.disabled = false; btn.textContent = mode === 'login' ? 'Sign in' : 'Create account'; };
        try {
          const res = await fetch('/api/auth/' + (mode === 'login' ? 'login' : 'signup'), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password: pw }) });
          const d = await res.json();
          if (!res.ok) { err.textContent = d.error || 'Something went wrong.'; err.style.display = 'block'; reset(); return; }
          // Reload: the audit form itself is server-rendered only for signed-in
          // visitors, so a full reload is what reveals it (simpler + more robust
          // than trying to keep client state in sync with the SSR gate).
          btn.innerHTML = 'Success — loading…';
          location.reload();
        } catch { err.textContent = 'Network error. Try again.'; err.style.display = 'block'; reset(); }
      }
      async function signOut() { try { await fetch('/api/auth/logout', { method: 'POST' }); } catch {} await refreshAuth(); showToast('Signed out'); }

      async function showAudits() {
        openModal('<h3>Your audits</h3><p class="msub">Click any audit to reload it.</p><div class="hist-list" id="hist"><div class="hist-empty">Loading…</div></div>');
        try {
          const d = await (await fetch('/api/audits')).json();
          const list = d.audits || [], box = $('hist');
          if (!list.length) { box.innerHTML = '<div class="hist-empty">No saved audits yet. Run an audit while signed in and it will appear here.</div>'; return; }
          box.innerHTML = list.map((a) => {
            const col = hexFor(a.overall);
            const when = a.createdAt ? new Date(a.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) : '';
            return `<button class="hist-item" data-id="${a.id}"><span class="hist-score" style="color:${col}">${a.overall == null ? '–' : a.overall}</span><span class="hist-main"><span class="hist-host">${esc(a.host || a.url || 'Pasted content')}</span><span class="hist-meta">${esc(a.pageType || '')}${a.grade ? ' · ' + esc(a.grade) : ''}${when ? ' · ' + when : ''}</span></span></button>`;
          }).join('');
          box.querySelectorAll('.hist-item').forEach((b) => { b.onclick = () => loadAudit(b.dataset.id); });
        } catch { $('hist').innerHTML = '<div class="hist-empty">Could not load your audits.</div>'; }
      }
      async function loadAudit(id) {
        try { const d = await (await fetch('/api/audits/' + id)).json(); if (d.report) { closeModal(); render({ report: d.report, meta: d.meta }); } }
        catch {}
      }
      refreshAuth().then(() => {
        // Arrived via the marketing site's "Log in" link (/audit?signin=1) —
        // open the sign-in modal automatically instead of dumping them on the page.
        if (new URLSearchParams(location.search).get('signin') && !USER) {
          openAuth('login');
          history.replaceState(null, '', location.pathname);
        }
      });
    </script>
  </body>
</html>
