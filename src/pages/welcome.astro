      <div class="section-label">7-day snapshot</div>
      <div class="tiles">
        <div class="tile">
          <div class="tile-lbl">Search visibility</div>
          <div class="tile-num-row">
            <span class="tile-num">{visNow != null ? visNow.toFixed(1) : '–'}</span>
            {visDelta == null
              ? <span class="delta na">–</span>
              : visDelta > 0 ? <span class="delta up">▲ {visDelta}</span>
              : visDelta < 0 ? <span class="delta down">▼ {Math.abs(visDelta)}</span>
              : <span class="delta na">＝ 0</span>}
          </div>
          {visSpark && <svg class="spark" width="100%" height="28" viewBox="0 0 120 28" preserveAspectRatio="none"><polyline points={visSpark} fill="none" stroke={visDelta != null && visDelta < 0 ? 'var(--bad)' : 'var(--ok)'} stroke-width="2" /></svg>}
          <div class="tile-sub">{visNow != null ? `Since ${rangeLabel.split(' – ')[0]}` : 'No checks yet — hit Check now on the dashboard'}</div>
        </div>
        <div class="tile">
          <div class="tile-lbl">Category rank</div>
          <div class="tile-num-row">
            <span class="tile-num">{rankNow != null ? `#${rankNow}` : '–'}</span>
            {rankDelta == null
              ? <span class="delta na">–</span>
              : rankDelta > 0 ? <span class="delta up">▲ {rankDelta}</span>
              : rankDelta < 0 ? <span class="delta down">▼ {Math.abs(rankDelta)}</span>
              : <span class="delta na">＝ 0</span>}
          </div>
          {rankSpark && <svg class="spark" width="100%" height="28" viewBox="0 0 120 28" preserveAspectRatio="none"><polyline points={rankSpark} fill="none" stroke={rankDelta != null && rankDelta < 0 ? 'var(--bad)' : 'var(--ok)'} stroke-width="2" /></svg>}
          <div class="tile-sub">{chart.chart ? (rankThen != null ? `${chart.chart}, from #${rankThen}` : chart.chart) : 'Not currently in a top chart'}</div>
        </div>
        <div class="tile">
          <div class="tile-lbl">1&ndash;2★ review share</div>
          <div class="tile-num-row">
            <span class="tile-num">{ratingNow?.negativeShare != null ? `${ratingNow.negativeShare}%` : '–'}</span>
            {negShareDelta == null
              ? <span class="delta na">–</span>
              : negShareDelta < 0 ? <span class="delta up">▼ {Math.abs(negShareDelta)}</span>
              : negShareDelta > 0 ? <span class="delta down">▲ {negShareDelta}</span>
              : <span class="delta na">＝ 0</span>}
          </div>
          {negShareSpark && <svg class="spark" width="100%" height="28" viewBox="0 0 120 28" preserveAspectRatio="none"><polyline points={negShareSpark} fill="none" stroke={negShareDelta != null && negShareDelta > 0 ? 'var(--bad)' : 'var(--ok)'} stroke-width="2" /></svg>}
          <div class="tile-sub">{ratingNow ? `${ratingNow.total} reviews in the sample` : 'No rating data yet'}</div>
        </div>
        <div class="tile">
          <div class="tile-lbl">Reviews sampled</div>
          <div class="tile-num-row">
            <span class="tile-num">{ratingNow?.total ?? '–'}</span>
            {reviewCountDelta == null
              ? <span class="delta na">–</span>
              : reviewCountDelta > 0 ? <span class="delta up">▲ {reviewCountDelta}</span>
              : reviewCountDelta < 0 ? <span class="delta down">▼ {Math.abs(reviewCountDelta)}</span>
              : <span class="delta na">＝ 0</span>}
          </div>
          {reviewSpark && <svg class="spark" width="100%" height="28" viewBox="0 0 120 28" preserveAspectRatio="none"><polyline points={reviewSpark} fill="none" stroke="var(--ok)" stroke-width="2" /></svg>}
          <div class="tile-sub">{ratingThen ? `vs ${ratingThen.total} a week ago` : 'No rating history yet'}</div>
        </div>
      </div>

      <div class="dyk-head">
        <div class="section-label">Did you know?</div>
        <p class="hint">Picked from what actually moved this week &middot; scroll for more →</p>
      </div>
      <div class="carousel">
        {dykCards.map((c) => (
          <a class="dyk-card" href={c.href}>
            <span class={`dyk-tag tag-${c.tone}`}>{c.tag}</span>
            <p class="dyk-q">Did you know?</p>
            <p class="dyk-title">{c.title}</p>
            <p class="dyk-desc">{c.desc}</p>
            <span class="dyk-cta">Read the post →</span>
          </a>
        ))}
      </div>

      <div class="cta-row">
        <div class="cta-copy">
          <p class="k">Ready to dig into the details?</p>
          <p class="v">Full charts, keyword-by-keyword rankings, and every app you track.</p>
        </div>
        <a class="cta-btn" href="/rank">Go to my dashboard →</a>
      </div>
    </div>

    <script define:vars={{ name: userName }}>
      // Picks the greeting band from the VISITOR's own clock, not the
      // server's — a login at 11pm IST shouldn't get a UTC "good morning".
      var BANDS = {
        morning: { icon: '☀️', title: `Good morning, ${name}.`, sub: `Coffee's brewing — so is your 7-day analysis. Here's how it went while you were asleep.` },
        afternoon: { icon: '🌤️', title: `Good afternoon, ${name}.`, sub: `Quick check between meetings? Here's what's moved since this morning.` },
        evening: { icon: '🌆', title: `Good evening, ${name}.`, sub: `Wrapping up the day? Here's your scorecard before you log off.` },
        night: { icon: '🌙', title: `Whatsup ${name}? Late-night brewing?`, sub: `What made you check in at this hour? Either way, here's what happened while most people were asleep.` },
      };
      function bandForHour(h) {
        if (h >= 5 && h < 12) return 'morning';
        if (h >= 12 && h < 17) return 'afternoon';
        if (h >= 17 && h < 21) return 'evening';
        return 'night';
      }
      function applyBand(id) {
        var b = BANDS[id];
        document.getElementById('hero-icon').textContent = b.icon;
        document.getElementById('hero-title').textContent = b.title;
        document.getElementById('hero-sub').textContent = b.sub;
        document.getElementById('hero').classList.toggle('band-night', id === 'night');
        document.querySelectorAll('.hero-char svg').forEach(function (el) {
          el.classList.toggle('active', el.getAttribute('data-char') === id);
        });
      }
      applyBand(bandForHour(new Date().getHours()));

      const logoutBtn = document.getElementById('logout');
      if (logoutBtn) logoutBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        await fetch('/api/auth/logout', { method: 'POST' });
        location.href = '/';
      });
      const userTrigger = document.getElementById('usertrigger');
      const userDropdown = document.getElementById('userdropdown');
      if (userTrigger && userDropdown) {
        userTrigger.addEventListener('click', (e) => { e.stopPropagation(); userDropdown.classList.toggle('open'); });
        document.addEventListener('click', (e) => { if (!userDropdown.contains(e.target) && e.target !== userTrigger) userDropdown.classList.remove('open'); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') userDropdown.classList.remove('open'); });
      }
    </script>
  </body>
</html>
