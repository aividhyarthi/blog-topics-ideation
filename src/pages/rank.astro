              <a href="/aso">ASO Inspector</a>
              <a href="/rank" class="active">Rank Tracker</a>
            </nav>
          </>
        )}
      </div>
    </header>

    {/* Guests are riding on the owner's subscription — never nag a client to
        buy a plan for a dashboard someone else is already paying for. */}
    {product && !guest && access?.trialDaysLeft && (
      <div class="no-print" style="background:var(--warn-tint);border-bottom:1px solid rgba(242,169,59,0.3);color:var(--warn);font-size:13.5px;padding:9px 20px;text-align:center;">
        ⏳ <b>{access.trialDaysLeft} day{access.trialDaysLeft === 1 ? '' : 's'}</b> left in your free trial —
        <a href="/account" style="color:var(--warn);font-weight:700;">choose a plan</a> to keep your rank history running.
      </div>
    )}

    <main>
      <div class="wrap">
        <div class="alert err no-print" id="err"></div>
        <div class="alert info no-print" id="info"></div>
        <div class="alert info no-print" id="ro-banner" style="display:none;"></div>

        <div class="toolbar no-print">
          <span class="lastcheck" id="lastcheck"></span>
          <div class="row">
            <select id="ws-switch" style="display:none;" title="Switch between your own apps and apps shared with you">
              <option value="own">My apps</option>
              <option value="shared">Shared with me</option>
            </select>
            <button class="ghost" id="csv-btn">Export CSV</button>
            <button class="primary" id="checkall-btn">Check all rankings now</button>
          </div>
        </div>

        <div class="shell">
          <div class="sidebar no-print" id="sidebar" style="display:none;">
            <div class="side-card">
              <div class="side-label">Your apps</div>
              <div class="side-apps" id="side-apps"></div>
              <button class="ghost side-add" id="toggle-add-app">＋ Track an app</button>
            </div>
          </div>
          <div class="main-col">
            <div class="toptabs no-print" id="snav"></div>
            <div id="apps"></div>
          </div>
        </div>
      </div>
    </main>

    <footer>{product ? <><b>{BRAND}</b> · App keyword rank tracking · An initiative by {INITIATIVE_NAME}</> : <><b>CiteRank</b> · By Rudra Kasturi Inc · App keyword rank tracking</>}</footer>
    <div class="toast" id="toast"></div>
    <div class="viztip" id="viztip"></div>
    <div class="kwmodal-backdrop no-print" id="kwmodal-backdrop">
      <div class="kwmodal" id="kwmodal"></div>
    </div>
    <div class="kwmodal-backdrop no-print" id="addapp-modal-backdrop">
      <div class="kwmodal" id="addapp-modal" style="max-width:560px;">
        <div class="kwmodal-head">
          <h3 style="margin:0;font-size:16px;">Track an app</h3>
          <button class="kwmodal-close" data-act="close-addapp-modal" aria-label="Close">×</button>
        </div>
        <p class="hint">
          Paste a <b>Google Play URL / package id</b> (e.g. <code>com.whatsapp</code>) or an
          <b>App Store URL / id</b> (e.g. <code>https://apps.apple.com/in/app/…/id310633997</code>).
          Add the same app twice with different countries to track multiple markets.
        </p>
        <div class="addrow">
          <input type="text" id="add-app" placeholder="Play/App Store URL, package id, or id123456789" />
          <input type="text" id="add-country" placeholder="Country (us)" maxlength="2" />
          <input type="text" id="add-lang" placeholder="Lang (en)" maxlength="2" />
        </div>
        <div class="row" style="margin:8px 0;">
          <label class="hint" style="margin:0;" for="add-likeapp">This app is a competitor for:</label>
          <select id="add-likeapp"><option value="">— none, this is my own app —</option></select>
        </div>
        <textarea id="add-keywords" placeholder="Keywords to track — one per line or comma-separated, e.g.
photo editor
collage maker
ai photo enhancer"></textarea>
        <p class="hint" id="add-likeapp-hint" style="display:none;"></p>
        <div class="row" style="margin-top:10px;">
          <button class="primary" id="add-btn">Add app</button>
          <span class="hint" style="margin:0;">{limitsText} No keywords yet? Add the app, then hit <b>Discover keywords</b>.</span>
        </div>
      </div>
    </div>

    <script define:vars={{ BRAND_NAME: product ? BRAND : 'CiteRank' }}>
      const $ = (id) => document.getElementById(id);
      let state = { apps: [], lastCheckedAt: null, snapshotDays: [] };
      let selectedAppKey = null;
      const sortState = {};
      const covSortState = {};
      const compareSortState = {};
      const snapSortState = {};
      // Which section of the app-shell is showing: one job per screen, like
      // the international ASO tools — switched from the left sidebar.
      const SECTIONS = [
        { id: 'overview', label: 'Overview' },
        { id: 'insights', label: 'Insights' },
        { id: 'snapshot', label: 'Report Card' },
        { id: 'keywords', label: 'Daily Keywords' },
        { id: 'coverage', label: 'All Keywords' },
        { id: 'compare', label: 'Compare' },
        { id: 'trends', label: 'Trends' },
        { id: 'settings', label: 'Settings' },
      ];
      // Which competitor apps (their keys) are selected in Compare, per app.
      const compareState = {};
      let currentSection = 'overview';
      // "Export PDF" prints every section stacked, not just the open one.
      let printAll = false;
      // Which category sub-tab is active within the coverage view, per app.
      const catTabState = {};

      // Hardcoded category rules (not user-editable) — grouping a long
      // coverage list by topic instead of one flat list. "Brand + Comp" is
      // always the app's own name (+ any competitor titles already cached
      // from an ASO Inspector run); the rest are simple word-match rules
      // aimed at the finance vertical this was built for first. A pattern
      // that doesn't match anything just never produces a tab, so this
      // doesn't do anything odd for apps outside that vertical — they just
      // end up with a "Brand + Comp" tab (if applicable) and "General".
      // Check-window presets. Ranges are IST hours, end-exclusive. Kept wider
      // than 4-hour blocks because a big keyword list under an hourly request
      // cap needs enough hours to finish: see capPlanHint below.
      const WINDOW_CHOICES = [
        [0, 6], [0, 8], [4, 8], [6, 12], [7, 12], [8, 12],
        [12, 18], [12, 20], [16, 20], [18, 24], [20, 24], [0, 24],
      ];
      const hourLabel = (h) =>
        h === 0 || h === 24 ? '12am' : h === 12 ? '12pm' : h < 12 ? `${h}am` : `${h - 12}pm`;

      /**
       * The whole point of the cap is to spread a big list out WITHOUT losing
       * any of it, and that only works if the window is long enough to get
       * through the list at that rate. Rather than let the owner discover the
       * shortfall a day later as unchecked keywords, do the arithmetic here:
       * hours needed = ceil(unique keywords / cap).
       */
      const windowHours = (w) => !w ? 24 : (w.startHour === w.endHour ? 24 : ((w.endHour - w.startHour + 24) % 24 || 24));
      const sameWindow = (a, b) =>
        (!a.checkWindow && !b.checkWindow) ||
        (!!a.checkWindow && !!b.checkWindow &&
          a.checkWindow.startHour === b.checkWindow.startHour && a.checkWindow.endHour === b.checkWindow.endHour);

      function capPlanHint(app) {
        const cap = app.hourlyRequestCap;
        if (!cap || !app.checkWindow) return '';
        const hours = windowHours(app.checkWindow);
        const unique = new Set([...(app.keywords || []), ...(app.coverageKeywords || [])].map((k) => k.toLowerCase())).size;
        if (!unique) return '';

        // The search cache lives for ONE run, so two apps only share searches
        // if they're checked in the same tick. A competitor scheduled in its
        // primary's window rides that primary's results for free; scheduled
        // elsewhere it re-searches the whole list itself and pays full price.
        const primary = app.competitorOf ? state.apps.find((a) => a.key === app.competitorOf) : null;
        if (primary && sameWindow(app, primary)) {
          return `<p class="hint" style="margin:8px 0 0;color:var(--ok);font-weight:600;">
            Shares <b>${esc(primary.title)}</b>'s window, so its searches are served from the same run's cache — costs close to nothing against this cap.</p>`;
        }
        if (primary && !sameWindow(app, primary)) {
          return `<p class="hint" style="margin:8px 0 0;color:var(--warn);font-weight:600;">
            ⚠︎ Checked in a different window from <b>${esc(primary.title)}</b>, so it can't reuse that run's cached searches and re-searches all ${unique} keywords itself.
            Put it in the same window to make it near-free.</p>`;
        }

        const needed = Math.ceil(unique / cap);
        const ok = needed <= hours;
        return `<p class="hint" style="margin:8px 0 0;color:${ok ? 'var(--ok)' : 'var(--bad)'};font-weight:600;">
          ${unique} keywords at ${cap}/hour needs <b>${needed} hour${needed === 1 ? '' : 's'}</b>; this window is <b>${hours}</b>.
          ${ok ? 'The full list completes every day.' : `Short by ${needed - hours} hour${needed - hours === 1 ? '' : 's'} — widen the window or raise the cap to ${Math.ceil(unique / hours)}/hour, or the list will take more than a day to cycle.`}
        </p>`;
      }

      // Keyword grouping is DERIVED FROM THE KEYWORDS, not from a fixed list
      // of categories. The previous version hardcoded a finance taxonomy
      // (SIP / Mutual Funds / ELSS / NPS...), which had two bad consequences:
      // a finance term it simply hadn't been told about ("liquid funds") fell
      // into "General" despite being a major keyword, and every app outside
      // finance — an ovulation tracker, a news app — had its ENTIRE list
      // dumped into "General", making the tabs useless. Grouping now comes
      // from the phrases that actually recur in this app's own list, so it
      // adapts to any vertical and can't miss a term it never heard of.
      const GROUP_STOPWORDS = new Set([
        'app', 'apps', 'best', 'top', 'free', 'online', 'india', 'indian', 'new', 'my',
        'for', 'and', 'the', 'with', 'in', 'on', 'to', 'of', 'a', 'an', 'or', 'how',
        'download', 'login', 'near', 'me', 'today', 'live', 'latest', 'good', 'better',
      ]);
      const MAX_KEYWORD_GROUPS = 12;

      /**
       * Crude singulariser. Without it "liquid funds" and "liquid fund
       * returns" land in different groups, and a "funds" group appears
       * alongside "mutual fund" / "liquid fund" competing for the same
       * keywords. Correctness matters less than applying the SAME rule when
       * building groups and when matching against them — 'nps' and 'elss'
       * are left alone by the length/'ss' guards.
       */
      const singular = (w) => (w.length > 3 && w.endsWith('s') && !w.endsWith('ss')) ? w.slice(0, -1) : w;

      /** Tokens of a keyword, minus stopwords and this app's brand words. */
      function groupTokens(keyword, brandTokens) {
        const brand = new Set(brandTokens.map(singular));
        return keyword.toLowerCase().split(/[^a-z0-9]+/)
          .map(singular)
          .filter((w) => w.length > 2 && !GROUP_STOPWORDS.has(w) && !brand.has(w));
      }

      /**
       * Builds the group list for one app from its own keywords. Two-word
       * phrases are preferred over single words so groups read as real topics
       * ("liquid fund", "mutual fund") instead of collapsing everything that
       * contains "fund" into one bucket.
       */
      function buildKeywordGroups(keywords, brandTokens) {
        const uni = new Map(), bi = new Map();
        for (const kw of keywords) {
          const toks = groupTokens(kw, brandTokens);
          for (const t of new Set(toks)) uni.set(t, (uni.get(t) || 0) + 1);
          for (let i = 0; i < toks.length - 1; i++) {
            const phrase = `${toks[i]} ${toks[i + 1]}`;
            bi.set(phrase, (bi.get(phrase) || 0) + 1);
          }
        }
        // Thresholds scale with the list: a fixed "appears 4+ times" bar that
        // suits a 600-keyword universe leaves most of a 40-keyword one in
        // "Other", and a bar that suits 40 would produce dozens of noise
        // groups at 600. Floors keep a pair of keywords from becoming a group.
        const n = keywords.length;
        const minUni = Math.max(3, Math.ceil(n / 50));
        const minBi = Math.max(2, Math.ceil(n / 80));
        const cands = [
          ...[...bi].filter(([, c]) => c >= minBi).map(([p, c]) => ({ label: p, n: c, words: p.split(' '), bigram: true })),
          ...[...uni].filter(([, c]) => c >= minUni).map(([w, c]) => ({ label: w, n: c, words: [w], bigram: false })),
        ];
        // Bigrams first (more specific), then by how much of the list they cover.
        cands.sort((a, b) => (b.bigram ? 1 : 0) - (a.bigram ? 1 : 0) || b.n - a.n);
        // Keep BOTH the bigram and the unigram it contains. Dropping "sip"
        // because "sip calculator" exists sent every other sip keyword to
        // "Other"; since bigrams are matched first, the specific group takes
        // what it should and the unigram catches the remainder.
        return cands.slice(0, MAX_KEYWORD_GROUPS);
      }

      /** Which group a keyword belongs to, given the groups built above. */
      function groupOfKeyword(keyword, groups, brandTokens) {
        const toks = groupTokens(keyword, brandTokens);
        const set = new Set(toks);
        const joined = ` ${toks.join(' ')} `;
        for (const g of groups) {
          if (g.bigram ? joined.includes(` ${g.label} `) : set.has(g.label)) return g.label;
        }
        return 'Other';
      }
      function wordMatch(text, pattern) {
        const esc = pattern.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return new RegExp(`\\b${esc}\\b`, 'i').test(text);
      }
      // App Store titles are almost always "BrandName: keyword-stuffed
      // tagline" (e.g. "Groww: Mutual Fund, SIP, Stocks") — that tagline
      // exists specifically to rank for generic terms, so treating every
      // word in a title as a "brand" signal (the original bug here)
      // mis-tags nearly every generic keyword as Brand + Comp. Only the
      // part before the first separator is a real brand signal, and even
      // that is filtered against a generic-word list as a second guard.
      const GENERIC_TITLE_WORDS = new Set([
        'app', 'apps', 'application', 'free', 'best', 'online', 'india', 'new',
        'investment', 'invest', 'investing', 'fund', 'funds', 'mutual', 'sip',
        'money', 'finance', 'financial', 'save', 'saving', 'savings', 'tax',
        'tracker', 'manager', 'management', 'wallet', 'pay', 'payment', 'bank',
        'banking', 'loan', 'loans', 'insurance', 'stock', 'stocks', 'trading',
        'trade', 'gold', 'plan', 'plans', 'calculator', 'and', 'the', 'for',
      ]);
      function brandTokensFromTitle(title) {
        if (!title) return [];
        const brandPart = title.split(/[:\-–|,]/)[0];
        return brandPart.toLowerCase().split(/\s+/).filter((w) => w.length > 2 && !GENERIC_TITLE_WORDS.has(w));
      }
      /**
       * Brand tokens for this app and its known competitors.
       *
       * A hand-maintained stop-list can't keep up here: competitor titles are
       * keyword-stuffed ("Credit Card Bill Payment App"), so their words leak
       * in as "brand" and tag ordinary category keywords — "credit card"
       * landing in Brand + Comp. Rather than keep guessing words, drop any
       * candidate that shows up across a chunk of the owner's OWN keyword
       * list: a real brand name appears in a handful of branded searches, a
       * category word appears everywhere. Self-correcting, and it works the
       * same for a news or health app as for a fintech one.
       */
      function brandTokensFor(app) {
        const compTitles = ((app.asoCache && app.asoCache.data && app.asoCache.data.competitors) || []).map((c) => c.title || '');
        const candidates = [...new Set([...brandTokensFromTitle(app.title), ...compTitles.flatMap(brandTokensFromTitle)])];
        const keys = [...new Set([...(app.keywords || []), ...(app.coverageKeywords || [])].map((k) => k.toLowerCase()))];
        if (keys.length < 10) return candidates; // too few to judge frequency
        const share = (tok) => keys.filter((k) => wordMatch(k, tok)).length / keys.length;
        return candidates.filter((t) => share(t) <= 0.15);
      }

      /**
       * Groups for one app, cached per render pass — buildKeywordGroups walks
       * the whole list, and the table asks for a group per row.
       */
      const GROUP_CACHE = {};
      function groupsFor(app) {
        const brand = brandTokensFor(app);
        // Deduped: a keyword present in BOTH the daily and coverage lists
        // otherwise counts twice and can push a one-off phrase over the
        // threshold, producing a group with a single member.
        const keys = [...new Set([...(app.keywords || []), ...(app.coverageKeywords || [])].map((k) => k.toLowerCase()))];
        const sig = `${app.key}|${keys.length}|${brand.join(',')}`;
        if (GROUP_CACHE[app.key] && GROUP_CACHE[app.key].sig === sig) return GROUP_CACHE[app.key];
        const entry = { sig, brand, groups: buildKeywordGroups(keys, brand) };
        GROUP_CACHE[app.key] = entry;
        return entry;
      }

      function categorizeKeyword(keyword, app) {
        const { brand, groups } = groupsFor(app);
        // Brand and competitor names stay their own group — they behave
        // differently from topic keywords and are read separately.
        if (brand.some((t) => wordMatch(keyword.toLowerCase(), t))) return 'Brand + Comp';
        return groupOfKeyword(keyword, groups, brand);
      }
      const MAX_COVERAGE = 2000;
      function sortVal(t, col) {
        if (col === 'pos') return t.position;
        if (col === 'best') return t.best;
        if (col === 'delta') return t.delta;
        if (col === 'volume') return t.volume;
        if (col === 'difficulty') return t.difficulty ? t.difficulty.score : null;
        return null;
      }

      // Difficulty pill (Easy/Medium/Hard from top-3 churn — computed
      // server-side, see keywordDifficulties in track.ts). null = not
      // enough history yet for an honest score.
      function diffCell(d) {
        if (!d) return '<span class="un" title="Needs ~5 days of check history for this keyword before a churn-based score is honest.">–</span>';
        const cls = d.label === 'Hard' ? 'hard' : d.label === 'Medium' ? 'med' : 'easy';
        return `<span class="diffpill ${cls}" title="${d.score}/100 — based on how much the top-3 apps for this keyword changed over the last ${d.days} checked day(s). Stable incumbents = hard to break in; churn = winnable.">${d.label}</span>`;
      }
      // key -> { status: 'loading'|'done'|'error', data?, error? } — best-effort
      // ASO Inspector summary fetched automatically once an app has keywords.
      const ASO_CACHE = {};

      const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const escAttr = (s) => esc(s).replace(/"/g, '&quot;');

      function showToast(msg) {
        const t = $('toast'); t.textContent = msg; t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2000);
      }
      function showErr(msg) { const e = $('err'); e.textContent = msg; e.style.display = msg ? 'block' : 'none'; }
      function showInfo(msg) { const e = $('info'); e.textContent = msg; e.style.display = msg ? 'block' : 'none'; }

      // A paste bigger than the daily-tracked cap used to just silently lose
      // everything past the cap with no indication anything was dropped.
      function truncationMsg(t) {
        return `Saved ${t.saved} of ${t.total} keywords here — this list is checked daily and capped at ${t.saved} for your plan. Paste the rest into the "All keywords" list below instead (up to ${MAX_COVERAGE}, checked automatically by the nightly check) to still monitor them.`;
      }

      // Sparkline of positions (lower = better, so the y-axis is inverted).
      function spark(history) {
        const pts = history.map((p, i) => ({ p, i })).filter((x) => x.p != null);
        if (pts.length < 2) return '<span class="who">—</span>';
        const w = 110, h = 26, pad = 3;
        const min = Math.min(...pts.map((x) => x.p));
        const max = Math.max(...pts.map((x) => x.p));
        const span = Math.max(1, max - min);
        const x = (i) => pad + (i / Math.max(1, history.length - 1)) * (w - 2 * pad);
        const y = (p) => pad + ((p - min) / span) * (h - 2 * pad); // top = best rank
        const d = pts.map((pt, j) => `${j ? 'L' : 'M'}${x(pt.i).toFixed(1)},${y(pt.p).toFixed(1)}`).join(' ');
        const last = pts[pts.length - 1];
        return `<svg class="spark" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">
          <path d="${d}" fill="none" stroke="var(--ink)" stroke-width="1.8" stroke-linecap="round"/>
          <circle cx="${x(last.i).toFixed(1)}" cy="${y(last.p).toFixed(1)}" r="2.6" fill="var(--ink)"/>
        </svg>`;
      }

      // --- overview charts (App Radar-style) ---------------------------------
      // Ordered rank buckets share one indigo ramp (darkest = best); "Unranked"
      // is neutral gray because it means absence, not a rank. Ramp validated
      // for lightness monotony + surface contrast.
      const BUCKET_COLORS = ['#2c2a75', '#4038c4', '#5655e6', '#7472f0', '#9091f5', '#a9aaf8', '#cbccd6'];
      const BUCKET_LABELS = () => [...(state.buckets || ['Top 1', 'Top 2–3', 'Top 4–10', 'Top 11–30', 'Top 31–100', 'Top 101–200']), 'Unranked'];
      const TIPS = {}; let tipSeq = 0;
      const fmtDay = (dk) => { const d = new Date(dk + 'T00:00:00Z'); return d.getUTCDate() + ' ' + d.toLocaleString('en', { month: 'short', timeZone: 'UTC' }); };

      function tipId(html) { const id = 't' + (++tipSeq); TIPS[id] = html; return id; }

      function tileHtml(label, val, prev, decimals) {
        let d = '<span class="d flat">–</span>';
        if (val != null && prev != null) {
          const diff = Math.round((val - prev) * 10) / 10;
          if (diff > 0) d = `<span class="d up">▲ ${diff}</span>`;
          else if (diff < 0) d = `<span class="d down">▼ ${-diff}</span>`;
          else d = '<span class="d flat">＝</span>';
        }
        const shown = val == null ? '–' : (decimals ? val.toFixed(1) : val);
        return `<div class="tile"><div class="lbl">${esc(label)}</div><div class="val">${shown} ${d}</div></div>`;
      }

      // Stacked bars: one bar per checked day, best bucket at the bottom,
      // 2px surface gaps between segments/bars, rounded cap on the top segment.
      // Keywords the store never gave us an answer for that day (errored, or
      // the run ran out of time before reaching them). NOT a ranking outcome.
      const notCheckedOn = (d) => (d.failed || 0) + (d.unchecked || 0);

      function stackChart(days) {
        const W = 560, H = 170, padL = 26, padB = 18, padT = 6;
        const plotW = W - padL - 6, plotH = H - padT - padB;
        // Scale to the whole LIST, not just the part that got checked. With
        // the axis topping out at the checked count, a day where half the
        // keywords never got searched drew a half-height bar — visually
        // identical to every keyword crashing out of the rankings overnight.
        // The unchecked remainder is drawn as its own hatched segment below,
        // so a partial day reads as "not measured yet", which is what it is.
        const maxY = Math.max(1, ...days.map((d) => d.tracked + notCheckedOn(d)));
        const anyUnchecked = days.some((d) => notCheckedOn(d) > 0);
        const n = days.length;
        const slot = plotW / n, bw = Math.min(46, Math.max(8, slot * 0.62));
        let out = '';
        // recessive grid: baseline + one midline + top
        const gy = (v) => padT + plotH - (v / maxY) * plotH;
        for (const v of [maxY, Math.round(maxY / 2)]) {
          if (v > 0) out += `<line x1="${padL}" y1="${gy(v)}" x2="${W - 4}" y2="${gy(v)}" stroke="var(--line)" stroke-width="1"/>
            <text x="${padL - 5}" y="${gy(v) + 3.5}" text-anchor="end" font-size="9.5" fill="var(--muted)">${v}</text>`;
        }
        out += `<line x1="${padL}" y1="${padT + plotH}" x2="${W - 4}" y2="${padT + plotH}" stroke="var(--line)" stroke-width="1"/>`;
        const labelEvery = Math.ceil(n / 8);
        days.forEach((d, i) => {
          const x = padL + slot * i + (slot - bw) / 2;
          let y = padT + plotH;
          let segs = '';
          let topSegY = null, topBi = null;
          d.buckets.forEach((v, bi) => {
            if (!v) return;
            const h = (v / maxY) * plotH;
            y -= h;
            segs += `<rect x="${x.toFixed(1)}" y="${(y + 1).toFixed(1)}" width="${bw.toFixed(1)}" height="${Math.max(1, h - 2).toFixed(1)}" fill="${BUCKET_COLORS[bi]}"/>`;
            topSegY = y; topBi = bi;
          });
          // Unchecked sits on top, hatched, so it never reads as a rank bucket.
          const nc = notCheckedOn(d);
          if (nc) {
            const h = (nc / maxY) * plotH;
            y -= h;
            segs += `<rect x="${x.toFixed(1)}" y="${(y + 1).toFixed(1)}" width="${bw.toFixed(1)}" height="${Math.max(1, h - 2).toFixed(1)}" fill="url(#ncHatch)" stroke="#c3c8d4" stroke-width="0.8"/>`;
            topSegY = null; // hatched block is its own cap, no rounded overlay
          }
          // rounded cap on the top of the stack
          if (topSegY != null) segs += `<rect x="${x.toFixed(1)}" y="${(topSegY + 1).toFixed(1)}" width="${bw.toFixed(1)}" height="6" rx="3" fill="${BUCKET_COLORS[topBi]}"/>`;
          const rows = d.buckets.map((v, bi) => v ? `<div class="tt-r"><span><span class="sw" style="background:${BUCKET_COLORS[bi]};display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:4px;"></span>${esc(BUCKET_LABELS()[bi])}</span><b>${v}</b></div>` : '').join('');
          const ncRow = nc ? `<div class="tt-r"><span>Not checked</span><b>${nc}</b></div>` : '';
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(d.dateKey))} · ${d.tracked} of ${d.tracked + nc} checked</div>${rows}${ncRow}<div class="tt-r"><span>Visibility</span><b>${d.visibility.toFixed(1)}</b></div>`);
          out += segs;
          out += `<rect class="hcol" data-tip="${tid}" x="${(padL + slot * i).toFixed(1)}" y="${padT}" width="${slot.toFixed(1)}" height="${plotH + padB}" fill="transparent"/>`;
          if (i % labelEvery === 0) out += `<text x="${(x + bw / 2).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="var(--muted)">${esc(fmtDay(d.dateKey))}</text>`;
        });
        const defs = anyUnchecked
          ? `<defs><pattern id="ncHatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
               <rect width="6" height="6" fill="#f1f3f7"/><line x1="0" y1="0" x2="0" y2="6" stroke="#c8cdd9" stroke-width="2.5"/>
             </pattern></defs>` : '';
        return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${defs}${out}</svg>`;
      }

      /** Bucket legend, plus a "not checked" key when any day has one. */
      function bucketLegend(days) {
        const base = BUCKET_LABELS().map((l, i) =>
          `<span class="li"><span class="sw" style="background:${BUCKET_COLORS[i]}"></span>${esc(l)}</span>`).join('');
        const anyUnchecked = (days || []).some((d) => notCheckedOn(d) > 0);
        return base + (anyUnchecked
          ? `<span class="li"><span class="sw" style="background:repeating-linear-gradient(45deg,#f1f3f7 0 2px,#c8cdd9 2px 4px);border:1px solid #c3c8d4;"></span>Not checked</span>`
          : '');
      }

      // Visibility score: the headline chart (see overviewHtml) — accent
      // line with a soft area fill under it and an emphasized last point,
      // so the one number the dashboard leads with also gets the one chart
      // that visually stands apart from every other (neutral-colored) trend.
      let vizGradSeq = 0;
      function visChart(days, annotations) {
        const W = 400, H = 190, padL = 30, padB = 18, padT = 8;
        const plotW = W - padL - 8, plotH = H - padT - padB;
        const vals = days.map((d) => d.visibility);
        const maxY = Math.max(10, Math.ceil(Math.max(...vals) / 10) * 10);
        const x = (i) => padL + (days.length === 1 ? plotW / 2 : (i / (days.length - 1)) * plotW);
        const y = (v) => padT + plotH - (v / maxY) * plotH;
        const gradId = `visFill${++vizGradSeq}`;
        let out = `<defs><linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.3"/>
          <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
        </linearGradient></defs>`;
        for (const v of [maxY, maxY / 2]) {
          out += `<line x1="${padL}" y1="${y(v)}" x2="${W - 6}" y2="${y(v)}" stroke="var(--line)" stroke-width="1"/>
            <text x="${padL - 5}" y="${y(v) + 3.5}" text-anchor="end" font-size="9.5" fill="var(--muted)">${v}</text>`;
        }
        out += `<line x1="${padL}" y1="${padT + plotH}" x2="${W - 6}" y2="${padT + plotH}" stroke="var(--line)" stroke-width="1"/>`;
        const d = vals.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
        const areaD = `${d} L${x(vals.length - 1).toFixed(1)},${(padT + plotH).toFixed(1)} L${x(0).toFixed(1)},${(padT + plotH).toFixed(1)} Z`;
        out += `<path d="${areaD}" fill="url(#${gradId})" stroke="none"/>`;
        out += `<path d="${d}" fill="none" stroke="var(--accent)" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>`;
        const labelEvery = Math.ceil(days.length / 6);
        days.forEach((day, i) => {
          const isLast = i === days.length - 1;
          out += `<circle cx="${x(i).toFixed(1)}" cy="${y(vals[i]).toFixed(1)}" r="${isLast ? 4.5 : 2.6}" fill="var(--accent)" stroke="var(--card)" stroke-width="2"/>`;
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(day.dateKey))}</div><div class="tt-r"><span>Visibility score</span><b>${vals[i].toFixed(1)}</b></div>`);
          const cw = days.length === 1 ? plotW : plotW / (days.length - 1);
          out += `<rect class="hcol" data-tip="${tid}" x="${(x(i) - cw / 2).toFixed(1)}" y="${padT}" width="${cw.toFixed(1)}" height="${plotH + padB}" fill="transparent"/>`;
          if (i % labelEvery === 0) out += `<text x="${x(i).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="var(--muted)">${esc(fmtDay(day.dateKey))}</text>`;
        });
        (annotations || []).forEach((a) => {
          const idx = days.findIndex((d) => d.dateKey === a.date);
          if (idx === -1) return;
          const ax = x(idx);
          const color = a.type === 'paid' ? 'var(--blue)' : 'var(--ink)';
          out += `<line x1="${ax.toFixed(1)}" y1="${padT}" x2="${ax.toFixed(1)}" y2="${(padT + plotH).toFixed(1)}" stroke="${color}" stroke-width="1.5" stroke-dasharray="3,2"/>`;
          out += `<circle cx="${ax.toFixed(1)}" cy="${(padT - 2).toFixed(1)}" r="3.5" fill="${color}" stroke="var(--card)" stroke-width="1"/>`;
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(a.date))} · ${esc(ANN_TYPE_LABEL[a.type] || a.type)}</div><div class="tt-r"><span>${esc(a.label)}</span></div>`);
          out += `<rect class="hcol" data-tip="${tid}" x="${(ax - 4).toFixed(1)}" y="${(padT - 8).toFixed(1)}" width="8" height="${(plotH + padB + 8).toFixed(1)}" fill="transparent"/>`;
        });
        return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${out}</svg>`;
      }

      // Category (top-chart) position trend — top = best rank, same
      // low-is-good inversion as the per-keyword sparkline.
      function chartPositionTrend(dateKeys, history, label = 'Category rank', emptyMsg = 'No category chart data yet.') {
        const known = history.filter((v) => v != null);
        if (!known.length) return `<p class="hint">${esc(emptyMsg)}</p>`;
        const W = 400, H = 170, padL = 34, padB = 18, padT = 8;
        const plotW = W - padL - 8, plotH = H - padT - padB;
        const minV = Math.min(...known), maxV = Math.max(...known);
        const span = Math.max(1, maxV - minV);
        const x = (i) => padL + (history.length === 1 ? plotW / 2 : (i / (history.length - 1)) * plotW);
        const y = (v) => padT + ((v - minV) / span) * plotH;
        let out = '';
        [minV, maxV].forEach((v) => {
          out += `<line x1="${padL}" y1="${y(v).toFixed(1)}" x2="${W - 6}" y2="${y(v).toFixed(1)}" stroke="var(--line)" stroke-width="1"/>
            <text x="${padL - 5}" y="${(y(v) + 3.5).toFixed(1)}" text-anchor="end" font-size="9.5" fill="var(--muted)">#${v}</text>`;
        });
        let d = '', started = false;
        history.forEach((v, i) => {
          if (v == null) { started = false; return; }
          d += `${started ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)} `;
          started = true;
        });
        out += `<path d="${d}" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
        const labelEvery = Math.ceil(history.length / 6);
        history.forEach((v, i) => {
          if (v == null) return;
          out += `<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="3" fill="var(--ink)" stroke="var(--card)" stroke-width="2"/>`;
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(dateKeys[i]))}</div><div class="tt-r"><span>${esc(label)}</span><b>#${v}</b></div>`);
          const cw = history.length === 1 ? plotW : plotW / (history.length - 1);
          out += `<rect class="hcol" data-tip="${tid}" x="${(x(i) - cw / 2).toFixed(1)}" y="${padT}" width="${cw.toFixed(1)}" height="${plotH + padB}" fill="transparent"/>`;
          if (i % labelEvery === 0) out += `<text x="${x(i).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="var(--muted)">${esc(fmtDay(dateKeys[i]))}</text>`;
        });
        return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${out}</svg>`;
      }

      // 1-2★ share trend — one cheap (no-AI) point per nightly check, shows
      // the ranking-impact risk building over time even between full ASO audits.
      function ratingTrendChart(history) {
        const pts = (history || []).map((h) => ({ dateKey: h.dateKey, v: h.tone === 'na' ? null : h.negativeShare, windowDays: h.windowDays }));
        const known = pts.filter((p) => p.v != null);
        if (!known.length) return '<p class="hint">Not enough rating history yet — check back after a few nightly checks.</p>';
        const W = 400, H = 170, padL = 30, padB = 18, padT = 8;
        const plotW = W - padL - 8, plotH = H - padT - padB;
        const maxY = Math.max(20, Math.ceil(Math.max(...known.map((p) => p.v)) / 10) * 10);
        const x = (i) => padL + (pts.length === 1 ? plotW / 2 : (i / (pts.length - 1)) * plotW);
        const y = (v) => padT + plotH - (v / maxY) * plotH;
        let out = '';
        for (const v of [maxY, maxY / 2]) {
          out += `<line x1="${padL}" y1="${y(v).toFixed(1)}" x2="${W - 6}" y2="${y(v).toFixed(1)}" stroke="var(--line)" stroke-width="1"/>
            <text x="${padL - 5}" y="${(y(v) + 3.5).toFixed(1)}" text-anchor="end" font-size="9.5" fill="var(--muted)">${v}%</text>`;
        }
        out += `<line x1="${padL}" y1="${(padT + plotH).toFixed(1)}" x2="${W - 6}" y2="${(padT + plotH).toFixed(1)}" stroke="var(--line)" stroke-width="1"/>`;
        let d = '', started = false;
        pts.forEach((p, i) => {
          if (p.v == null) { started = false; return; }
          d += `${started ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.v).toFixed(1)} `;
          started = true;
        });
        out += `<path d="${d}" fill="none" stroke="var(--bad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
        const labelEvery = Math.ceil(pts.length / 6);
        pts.forEach((p, i) => {
          if (p.v == null) return;
          out += `<circle cx="${x(i).toFixed(1)}" cy="${y(p.v).toFixed(1)}" r="3" fill="var(--bad)" stroke="var(--card)" stroke-width="2"/>`;
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(p.dateKey))}</div><div class="tt-r"><span>1-2★ share${p.windowDays ? ` (last ${p.windowDays}d)` : ''}</span><b>${p.v}%</b></div>`);
          const cw = pts.length === 1 ? plotW : plotW / (pts.length - 1);
          out += `<rect class="hcol" data-tip="${tid}" x="${(x(i) - cw / 2).toFixed(1)}" y="${padT}" width="${cw.toFixed(1)}" height="${plotH + padB}" fill="transparent"/>`;
          if (i % labelEvery === 0) out += `<text x="${x(i).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="var(--muted)">${esc(fmtDay(p.dateKey))}</text>`;
        });
        return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${out}</svg>`;
      }

      // How big is the tracked keyword list on each day it was actually
      // checked — answers "is my keyword universe growing over time" with
      // real historical sizes (see universeSizeSeries server-side), not
      // today's count re-applied to every past day.
      function universeSizeChart(points, color = 'var(--ink)') {
        const pts = points || [];
        if (pts.length < 2) return '<p class="hint">Not enough history yet to show a trend — check back after a few more days of checks.</p>';
        const W = 400, H = 170, padL = 34, padB = 18, padT = 8;
        const plotW = W - padL - 8, plotH = H - padT - padB;
        const counts = pts.map((p) => p.count);
        const maxY = Math.max(4, Math.ceil(Math.max(...counts) * 1.1));
        const x = (i) => padL + (pts.length === 1 ? plotW / 2 : (i / (pts.length - 1)) * plotW);
        const y = (v) => padT + plotH - (v / maxY) * plotH;
        let out = '';
        for (const v of [maxY, Math.round(maxY / 2)]) {
          out += `<line x1="${padL}" y1="${y(v).toFixed(1)}" x2="${W - 6}" y2="${y(v).toFixed(1)}" stroke="var(--line)" stroke-width="1"/>
            <text x="${padL - 5}" y="${(y(v) + 3.5).toFixed(1)}" text-anchor="end" font-size="9.5" fill="var(--muted)">${v}</text>`;
        }
        out += `<line x1="${padL}" y1="${(padT + plotH).toFixed(1)}" x2="${W - 6}" y2="${(padT + plotH).toFixed(1)}" stroke="var(--line)" stroke-width="1"/>`;
        const d = pts.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.count).toFixed(1)}`).join(' ');
        out += `<path d="${d}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
        const labelEvery = Math.ceil(pts.length / 6);
        pts.forEach((p, i) => {
          out += `<circle cx="${x(i).toFixed(1)}" cy="${y(p.count).toFixed(1)}" r="3" fill="${color}" stroke="var(--card)" stroke-width="2"/>`;
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(p.dateKey))}</div><div class="tt-r"><span>Keywords tracked</span><b>${p.count}</b></div>`);
          const cw = pts.length === 1 ? plotW : plotW / (pts.length - 1);
          out += `<rect class="hcol" data-tip="${tid}" x="${(x(i) - cw / 2).toFixed(1)}" y="${padT}" width="${cw.toFixed(1)}" height="${plotH + padB}" fill="transparent"/>`;
          if (i % labelEvery === 0) out += `<text x="${x(i).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="var(--muted)">${esc(fmtDay(p.dateKey))}</text>`;
        });
        const first = counts[0], last = counts[counts.length - 1];
        const change = last - first;
        const changeLabel = change > 0 ? `<span class="delta up">▲ +${change} since ${esc(fmtDay(pts[0].dateKey))}</span>`
          : change < 0 ? `<span class="delta down">▼ ${change} since ${esc(fmtDay(pts[0].dateKey))}</span>`
          : `<span class="delta flat">＝ unchanged since ${esc(fmtDay(pts[0].dateKey))}</span>`;
        return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${out}</svg><div class="hint" style="margin-top:6px;">${last} tracked today ${changeLabel}</div>`;
      }

      // --- keyword discovery panel -------------------------------------------
      const DISCOVER = {}; // key -> discovery result, shown until tracked/dismissed

      function discoverHtml(app) {
        const d = DISCOVER[app.key];
        if (!d) return '';
        const items = d.discovery.discovered;
        const ranking = items.filter((k) => k.position != null);
        const opportunities = items.filter((k) => k.position == null);
        const srcPill = { listing: 'from listing', autocomplete: 'autocomplete', ai: 'AI idea', competitor: 'from competitor' };
        const volPill = (v) => v == null ? '' : `<span class="pill vol" title="Estimated search popularity, 0–100 scale">📊 ${v}</span>`;
        const row = (k) => `
          <label class="disc-row">
            <input type="checkbox" data-role="disc-kw" value="${escAttr(k.keyword)}" ${k.position != null && k.position <= 100 ? 'checked' : ''} />
            <span class="kw">${esc(k.keyword)}</span>
            <b>${k.position != null ? '#' + k.position : '<span class="un">not yet ranking</span>'}</b>
            ${volPill(k.volume)}
            <span class="pill cc">${srcPill[k.source] || esc(k.source)}</span>
          </label>`;
        const errNote = d.discovery.errors && d.discovery.errors.length
          ? `<p class="hint" style="margin:8px 0 0;">⚠︎ ${esc(d.discovery.errors[0])}${d.discovery.errors.length > 1 ? ` (+${d.discovery.errors.length - 1} more)` : ''}</p>` : '';
        return `<div class="discover" data-role="discover">
          <h4>Keyword universe: ${items.length} relevant keywords scanned — ${ranking.length} already ranking, ${opportunities.length} opportunities not yet ranking</h4>
          <p class="hint" style="margin:0 0 10px;">Tick any to start tracking them daily — you don't need to already rank for a keyword to track it. Your plan caps how many you can track at once, not how many you can see here. 📊 shows an estimated search popularity score (0–100) for the top ${Math.min(25, items.length)} — may be blank for some keywords.</p>
          ${ranking.length ? `<p class="hint" style="margin:0 0 4px;font-weight:700;color:var(--ink);">✅ Already ranking (${ranking.length})</p><div class="disc-list">${ranking.map(row).join('')}</div>` : ''}
          ${opportunities.length ? `<p class="hint" style="margin:12px 0 4px;font-weight:700;color:var(--ink);">💡 Opportunities — relevant, not yet ranking (${opportunities.length})</p><div class="disc-list">${opportunities.map(row).join('')}</div>` : ''}
          ${items.length ? '' : '<p class="hint">No new keyword ideas found beyond the ones already tracked.</p>'}
          <div class="row" style="margin-top:10px;">
            ${items.length ? '<button class="primary" data-act="track-selected" style="padding:9px 16px;font-size:13.5px;">Track selected keywords</button>' : ''}
            <button class="ghost" data-act="dismiss-discover">Dismiss</button>
          </div>
          ${errNote}
        </div>`;
      }

      // --- ASO Inspector integration -----------------------------------------
      // ASO Inspector is Play-only. Fires in the background after keywords are
      // saved so a recommendation is waiting without slowing down the save.
      function asoLinkParams(app, focusList) {
        const p = new URLSearchParams({ app: app.url || app.appId, country: app.country || 'us', lang: app.lang || 'en', key: app.key });
        if (focusList.length) p.set('focus', focusList.join(', '));
        return p.toString();
      }

      // Loads whatever was cached server-side (see api/aso.ts + api/rank.ts's
      // statePayload) — no network call, so viewing/reloading the dashboard
      // never silently re-triggers a (paid, Anthropic-backed) ASO audit.
      function loadAsoFromCache(app) {
        if (app.store !== 'play') return;
        if (app.asoCache) ASO_CACHE[app.key] = { status: 'done', data: app.asoCache.data, focusList: app.asoCache.focusList, checkedAt: app.asoCache.checkedAt };
      }

      // The REAL check — hits /api/aso (and its Anthropic call). Only call
      // this from an actual change (new app, edited keywords) or an explicit
      // "Re-check ASO" click, never automatically on page load/reload.
      async function checkAsoFor(app) {
        if (app.store !== 'play' || !app.keywords || !app.keywords.length) return;
        ASO_CACHE[app.key] = { status: 'loading' };
        // Guard against re-rendering off a stale `state` that doesn't have
        // this app yet — a caller right after add-app fires this before the
        // fresh API response has replaced `state`, and an unconditional
        // render() here would rebuild the sidebar from the OLD app list,
        // which resets selectedAppKey back to the first app (see render()'s
        // "selectedAppKey not in state.apps" fallback) and silently un-selects
        // the app that was just added.
        const inState = () => state.apps.some((a) => a.key === app.key);
        if (app.key === selectedAppKey && inState()) render();
        const focusList = app.keywords.slice(0, 3);
        try {
          const res = await fetch('/api/aso', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: app.url || app.appId, focusKeyword: focusList.join(', '), country: app.country, lang: app.lang, key: app.key }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'ASO check failed.');
          ASO_CACHE[app.key] = { status: 'done', data, focusList, checkedAt: data.checkedAt };
        } catch (e) {
          ASO_CACHE[app.key] = { status: 'error', error: e && e.message ? e.message : String(e) };
        }
        if (app.key === selectedAppKey && inState()) render();
      }

      function asoSummaryHtml(app) {
        if (app.store !== 'play') return '';
        const cached = ASO_CACHE[app.key];
        if (!cached) {
          return `<div class="asobox na">No ASO check yet for this app. <button class="ghost small" data-act="recheck-aso">Run ASO check</button></div>`;
        }
        if (cached.status === 'loading') {
          return `<div class="asobox"><span class="spinner" style="border-color:rgba(0,0,0,0.15);border-top-color:var(--accent);"></span>Getting ASO recommendations for your tracked keywords…</div>`;
        }
        if (cached.status === 'error') {
          return `<div class="asobox err">⚠︎ Couldn't fetch ASO recommendations: ${esc(cached.error)}</div>`;
        }
        const r = cached.data.report, ai = cached.data.ai || {};
        const link = `/aso?${asoLinkParams(app, cached.focusList)}`;
        const rb = r.ratingBreakdown;
        const ratingPill = (rb && (rb.tone === 'bad' || rb.tone === 'mid'))
          ? `<div class="asorating ${rb.tone}">⚠️ ${rb.negativeShare}% of ratings in the last ${rb.windowDays} days are 1-2★ — likely hurting your ranking, not just conversions</div>`
          : '';
        const lastChecked = cached.checkedAt ? new Date(cached.checkedAt).toLocaleString() : null;
        return `<div class="asobox">
          <div class="asorow">
            <span class="asoscore" style="color:${r.overall >= 80 ? 'var(--ok)' : r.overall >= 60 ? 'var(--warn)' : 'var(--bad)'}">${r.overall}<small>/100</small></span>
            <div class="asotext">
              <b>ASO score for "${esc(cached.focusList[0] || '')}"${cached.focusList.length > 1 ? ` +${cached.focusList.length - 1} more` : ''}</b>
              <p>${esc(ai.summary || 'Deterministic listing score computed — open the full report for keyword-by-keyword recommendations.')}</p>
            </div>
          </div>
          ${ratingPill}
          <div class="asometa">
            ${lastChecked ? `<span>Last checked ${esc(lastChecked)}</span>` : ''}
            <button class="ghost small" data-act="recheck-aso">Re-check ASO</button>
          </div>
          <a class="ghost-link" href="${escAttr(link)}" target="_blank" rel="noopener" data-aso-key="${escAttr(app.key)}">Open full ASO Inspector report →</a>
        </div>`;
      }

      // Small inline-SVG icons, matching Icon.astro's stroke style — these
      // cards are built client-side from template strings, so the Astro
      // <Icon> component itself isn't usable here; same currentColor/
      // stroke-width convention, hand-copied for the three card headers.
      const SVG_COMMON = 'width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
      const ICO_TREND = `<svg ${SVG_COMMON}><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="14 7 21 7 21 14"></polyline></svg>`;
      const ICO_RADAR = `<svg ${SVG_COMMON}><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"></circle><path d="M12 3v3M21 12h-3"></path></svg>`;
      const ICO_STAR = `<svg ${SVG_COMMON}><polygon points="12 2.5 15 9 22 10 17 15 18.2 21.5 12 18.3 5.8 21.5 7 15 2 10 9 9"></polygon></svg>`;
      const wnCardHead = (ico, label) => `<div class="wn-card-head"><span class="wn-card-ico">${ico}</span><h4>${label}</h4></div>`;

      // "What changed since your last check" — the questions an app owner
      // actually asks first, ahead of the aggregate tiles/charts below:
      // which keywords moved, which competitor is gaining, is the rating
      // trend healthy. Everything here reuses data already collected by the
      // regular daily check — no extra fetches, no extra cost. Each card
      // links straight into the tab with the full detail (Compare, Trends)
      // rather than trying to cram that detail onto Overview itself.
      /**
       * Keywords the app already ranks well for in the FULL coverage list but
       * that aren't in the daily-tracked list.
       *
       * This gap is how a term you rank #1 for goes unnoticed: the coverage
       * list is a wide net checked in batches, while the daily list is the
       * small set that gets a position every single day, feeds the movers
       * card, the visibility score and the rank-drop alerts. A keyword can sit
       * in coverage ranking #1 for weeks and never appear on the daily
       * dashboard, because nothing ever suggested promoting it. Surfacing the
       * best of them turns "we forgot to add it" into one click.
       */
      function promotableHtml(app) {
        const daily = new Set((app.keywords || []).map((k) => k.toLowerCase()));
        const candidates = (app.coverageTrends || [])
          .filter((t) => t.position != null && t.position <= 20 && !daily.has(t.keyword.toLowerCase()))
          .sort((a, b) => a.position - b.position)
          .slice(0, 8);
        if (!candidates.length) return '';
        const head = wnCardHead(ICO_RADAR, 'Ranking well, but not tracked daily');
        const rows = candidates.map((t) => `
          <label class="promo-row">
            <input type="checkbox" data-role="promo-kw" value="${escAttr(t.keyword)}" checked />
            <span class="kw">${esc(t.keyword)}</span>
            <b class="pos">#${t.position}</b>
          </label>`).join('');
        return `<div class="wn-card">${head}
          <p class="hint" style="margin:0 0 9px;">These are in your full keyword list and already ranking, but they're not in the daily set, so they get no daily position, no movement tracking and no drop alerts.</p>
          ${rows}
          <div class="row no-print" style="margin-top:10px;">
            <button class="primary" data-act="promote-kw" style="padding:8px 14px;font-size:13px;">Track selected daily</button>
          </div>
        </div>`;
      }

      function moversHtml(app) {
        const trends = app.trends || [];
        const withDelta = trends.filter((t) => t.delta != null && t.delta !== 0);
        const gainers = withDelta.filter((t) => t.delta > 0).sort((a, b) => b.delta - a.delta).slice(0, 3);
        const losers = withDelta.filter((t) => t.delta < 0).sort((a, b) => a.delta - b.delta).slice(0, 3);
        const newlyRanked = trends.filter((t) => t.position != null && t.prevPosition == null).slice(0, 3);
        const droppedOut = trends.filter((t) => t.position == null && t.prevPosition != null).slice(0, 3);
        const head = wnCardHead(ICO_TREND, 'Rank movers since last check');
        const moves = [...gainers, ...losers, ...newlyRanked, ...droppedOut];
        if (!moves.length) return `<div class="wn-card">${head}<p class="wn-empty">No keyword moved position since the last check — check back after the next one.</p></div>`;
        const rows = [...gainers, ...newlyRanked, ...losers, ...droppedOut].slice(0, 5).map((t) =>
          `<div class="wn-row"><button class="kwlink wn-kw" data-kwhistory="${escAttr(t.keyword)}" data-list="daily">${esc(t.keyword)}</button>${deltaCell(t)}</div>`).join('');
        return `<div class="wn-card">${head}${rows}</div>`;
      }

      function competitorPulseHtml(app) {
        const comps = state.apps.filter((a) => a.competitorOf === app.key);
        const head = wnCardHead(ICO_RADAR, 'Competitor pulse');
        if (!comps.length) return '';
        const kws = (app.keywords || []).length ? app.keywords : (app.coverageKeywords || []).slice(0, 60);
        if (!kws.length) return '';
        const mine = trendMap(app);
        const lines = comps.map((c) => {
          const theirs = trendMap(c);
          let curWin = 0, curTotal = 0, prevWin = 0, prevTotal = 0;
          for (const kw of kws) {
            const m = mine[kw], t = theirs[kw];
            const myPos = m && !m.error ? m.position : null;
            const theirPos = t && !t.error ? t.position : null;
            if (myPos != null || theirPos != null) {
              curTotal++;
              if (theirPos != null && (myPos == null || theirPos < myPos)) curWin++;
            }
            const myPrev = m ? m.prevPosition : null;
            const theirPrev = t ? t.prevPosition : null;
            if (myPrev != null || theirPrev != null) {
              prevTotal++;
              if (theirPrev != null && (myPrev == null || theirPrev < myPrev)) prevWin++;
            }
          }
          // Icon + a short name instead of the full store title — same fix
          // as the Compare table's compLabel, since a long title ("Buddy
          // Loan - Personal Loan App") otherwise wraps across 2-3 lines and
          // makes this card read as a wall of text next to its terser
          // siblings (Rank movers, Rating health).
          const icon = c.icon ? `<img src="${escAttr(c.icon)}" alt="" class="cticon" />` : '';
          const shortTitle = c.title.length > 24 ? c.title.slice(0, 23) + '…' : c.title;
          const nameHtml = `<span class="wn-line-title cthead" title="${escAttr(c.title)}">${icon}<b>${esc(shortTitle)}</b></span>`;
          if (!curTotal) return `<button class="wn-linkline" data-goto-compare="${escAttr(c.key)}"><span class="wn-line-main">${nameHtml}<span class="wn-empty">No shared keyword data checked yet</span></span><span class="wn-viewcta">Compare →</span></button>`;
          // "Beats you on N/M" every time, regardless of the actual number,
          // read as a wall of bad news even on keywords the app is winning —
          // three competitor rows saying the same downbeat sentence back to
          // back is exactly what looked broken. Frame it by who's actually
          // ahead instead of always centering the competitor's win count.
          const yourWin = curTotal - curWin;
          const diff = prevTotal ? curWin - prevWin : null;
          const trendTxt = diff == null || diff === 0 ? 'no change vs last check'
            : diff > 0 ? `<span class="delta down">▲${diff}</span> vs last check` : `<span class="delta up">▼${-diff}</span> vs last check`;
          const shareTxt = curWin > yourWin
            ? `<span class="delta down">${curWin}/${curTotal}</span> ahead of you`
            : curWin === yourWin
              ? `<span class="delta flat">${curWin}/${curTotal}</span> — dead even`
              : `<span class="delta up">${yourWin}/${curTotal}</span> ahead of them`;
          return `<button class="wn-linkline" data-goto-compare="${escAttr(c.key)}"><span class="wn-line-main">${nameHtml}<span class="wn-empty">${shareTxt} · ${trendTxt}</span></span><span class="wn-viewcta">Compare →</span></button>`;
        }).join('');
        return `<div class="wn-card">${head}${lines}</div>`;
      }

      function ratingPulseHtml(app) {
        const rh = app.ratingHistory || [];
        const head = wnCardHead(ICO_STAR, 'Rating health');
        if (!rh.length) return `<div class="wn-card">${head}<p class="wn-empty">${app.store === 'play' ? 'No rating data checked yet.' : 'Rating breakdown tracking is Google Play only.'}</p></div>`;
        const latest = rh[rh.length - 1];
        const prev = rh.length > 1 ? rh[rh.length - 2] : null;
        const toneColor = { good: 'up', mid: 'flat', bad: 'down', na: 'flat' }[latest.tone] || 'flat';
        const diff = prev ? Math.round((latest.negativeShare - prev.negativeShare) * 10) / 10 : null;
        const diffHtml = diff == null || diff === 0 ? '' : diff > 0
          ? ` <span class="delta down">▲ ${diff}pt</span>` : ` <span class="delta up">▼ ${-diff}pt</span>`;
        return `<div class="wn-card">${head}
          <button class="wn-linkline" data-goto-section="trends"><span class="wn-line-main"><span class="wn-line-title"><span class="delta ${toneColor}">${latest.negativeShare}%</span> of the last ${latest.total} reviews are 1-2★${diffHtml}</span><span class="wn-empty">Lower is healthier — watch for a rise ahead of a rank drop</span></span><span class="wn-viewcta">Trend →</span></button>
        </div>`;
      }

      // One plain-language sentence explaining WHY the visibility score
      // moved — reuses the same gainers/losers/newlyRanked/droppedOut data
      // moversHtml already computes, just collapsed into prose instead of a
      // list, so the headline number always comes with a reason attached
      // instead of a bare "+7" the reader has to go dig for elsewhere.
      function visibilityNarrative(app) {
        const trends = app.trends || [];
        const withDelta = trends.filter((t) => t.delta != null && t.delta !== 0);
        const topGain = withDelta.filter((t) => t.delta > 0).sort((a, b) => b.delta - a.delta)[0];
        const topDrop = withDelta.filter((t) => t.delta < 0).sort((a, b) => a.delta - b.delta)[0];
        const fresh = trends.find((t) => t.position != null && t.prevPosition == null);
        const parts = [];
        if (fresh) parts.push(`<b>${esc(fresh.keyword)}</b> entered the rankings at #${fresh.position}`);
        else if (topGain) parts.push(`<b>${esc(topGain.keyword)}</b> climbed from #${topGain.prevPosition} to #${topGain.position}`);
        if (topDrop) parts.push(`<b>${esc(topDrop.keyword)}</b> slipped from #${topDrop.prevPosition} to ${topDrop.position != null ? `#${topDrop.position}` : 'out of the rankings'}`);
        if (!parts.length) return 'No keyword moved position since the last check.';
        return parts.join(' — ') + '.';
      }

      // The two full-keyword-universe charts. Rendered on BOTH Overview (the
      // tab that actually gets opened every day) and All Keywords, built from
      // one function so the two copies can never drift apart. Returns '' when
      // the app has no coverage list, or has one that's never been checked —
      // an empty axis is worse than no chart.
      function coverageChartsHtml(app) {
        const cov = app.coverageOverview;
        if (!cov || !cov.total || !cov.days || !cov.days.length) return '';
        const legend = bucketLegend(cov.days);
        return `<div class="chartbox"><h4>Keyword universe size over time</h4>${universeSizeChart(cov.universeTrend)}</div>
          <div class="chartbox"><h4>Coverage distribution by check</h4>${stackChart(cov.days)}<div class="legend">${legend}</div></div>`;
      }

      function overviewHtml(app) {
        const ov = app.overview;
        if (!ov || !ov.days || !ov.days.length) {
          // A read-only guest has no Check button to hit — telling them to
          // press one is just a support message waiting to happen.
          return state.readOnly
            ? '<p class="hint">No check data yet — the first daily check hasn\'t run for this app.</p>'
            : '<p class="hint">No check data yet — hit <b>Check now</b> to record the first data point.</p>';
        }
        const c = ov.counts || {}, p = ov.prevCounts || null;
        const legend = bucketLegend(ov.days);
        const cur = ov.visibility, prev = ov.prevVisibility;
        const vDelta = (cur != null && prev != null) ? Math.round((cur - prev) * 10) / 10 : null;
        const vDeltaHtml = vDelta == null ? ''
          : vDelta > 0 ? `<span class="delta up">▲ ${vDelta}</span> since last check — `
          : vDelta < 0 ? `<span class="delta down">▼ ${-vDelta}</span> since last check — `
          : `<span class="delta flat">＝ unchanged</span> since last check — `;
        const covCharts = coverageChartsHtml(app);
        return `<div class="ov">
          <div class="headline">
            <div class="headline-eyebrow">Search visibility score</div>
            <div class="headline-num">${cur != null ? cur.toFixed(1) : '–'}</div>
            <div class="headline-sub">${vDeltaHtml}${visibilityNarrative(app)}</div>
            <div class="chartbox">${visChart(ov.days, app.annotations)}</div>
          </div>
          ${covCharts ? `<div class="ovcharts">${covCharts}</div>` : ''}
          <div class="tiles">
            ${tileHtml('Top 1 rankings', c.top1, p && p.top1)}
            ${tileHtml('Top 10 rankings', c.top10, p && p.top10)}
            ${tileHtml('Top 30 rankings', c.top30, p && p.top30)}
            ${tileHtml('Top 100 rankings', c.top100, p && p.top100)}
          </div>
          <div class="chartbox" style="margin-top:12px;"><h4>Keyword rank distribution by day</h4>${stackChart(ov.days)}<div class="legend">${legend}</div>${coverageNote(ov.days)}</div>
        </div>`;
      }

      // Keywords excluded from today's bars because their check failed or
      // they weren't searched at all. They used to be silently counted as
      // "Unranked", which both inflated that bar and dragged the visibility
      // score down — making a throttled store look identical to a real
      // ranking loss. Now they're excluded and stated explicitly instead.
      function coverageNote(days) {
        const today = days && days.length ? days[days.length - 1] : null;
        if (!today) return '';
        const bits = [];
        if (today.failed) bits.push(`<b>${today.failed}</b> keyword${today.failed === 1 ? '' : 's'} failed to check`);
        if (today.unchecked) bits.push(`<b>${today.unchecked}</b> not searched yet`);
        if (!bits.length) return '';
        return `<p class="hint" style="margin-top:6px;">${bits.join(' · ')} — excluded from the bars and the visibility score above rather than counted as "Unranked", since neither is a confirmed result. Retried on the next check.</p>`;
      }

      function trendChartsHtml(app) {
        // Category chart trend only makes sense once the app has actually
        // ranked in a top chart at least once — otherwise it's an empty line.
        const chartHist = (app.chart && app.chart.history) || [];
        const isChartRanking = chartHist.some((v) => v != null);
        const chartName = app.chart && app.chart.chart;
        // A Play app checked with no genreId falls back to the store's
        // OVERALL Top Free chart — every app on the store, not just this
        // app's own category — a far harder bar to clear, and easy to
        // mistake for "genuinely not ranked anywhere" if the chart name
        // isn't shown. Only flag it for Play — iOS's public chart feed has
        // no per-category option at all, so "overall" there isn't fixable
        // or unusual, just how that platform's data works.
        const isOverallFallback = app.store === 'play' && chartName === 'Top Free';
        const overallNote = isOverallFallback
          ? '<p class="hint" style="margin-top:4px;">Checked against the store\'s overall Top Free chart, not this app\'s own category — its category wasn\'t available yet and is retried automatically on the next check.</p>'
          : '';
        // topChart being empty has TWO very different causes that used to
        // look identical: genuinely checked and not in the chart, vs the
        // chart fetch itself has been silently failing (bad/rate-limited
        // request) every single day, in which case "not ranked" is not a
        // real result at all — see chartTrend's `error` field (track.ts).
        // Surfacing which one it is is exactly what turned "we are ranking
        // but showing not ranking" from a keyword-search bug into a fixed
        // one earlier — the same fix applies here.
        const chartErrHtml = app.chart && app.chart.error
          ? `<div class="alert info" style="display:block;">⚠︎ The category chart check has been failing (${esc(app.chart.error)}) — this is <b>not</b> a confirmed "not ranking", just a store fetch that keeps failing. Retried automatically on the next check.</div>`
          : '';
        // The store's chart endpoint often returns far fewer entries than the
        // 200 we ask for. "Not in the top of X" then overstates what was
        // actually verified — if only 50 rows came back, an app sitting at
        // #90 is reported as absent from a chart it's genuinely in. State
        // the real depth, and flag it when it's well short of the request.
        const depth = app.chart && app.chart.depth;
        const shortChart = depth != null && depth < 150;
        const depthNote = shortChart
          ? `<p class="hint" style="margin-top:4px;">⚠︎ The store only returned <b>${depth}</b> chart entries for this request (we ask for 200). An app ranked below #${depth} in this category can't be detected from that response — so this is "not in the top ${depth}", not "not in the category chart".</p>`
          : '';
        const notRankedText = chartName
          ? `Not in the top ${depth || '?'} of ${esc(chartName)}.`
          : 'Not ranked in a top chart yet.';
        const catChartBox = isChartRanking
          ? `<div class="chartbox"><h4>Category chart rank trend${chartName ? ` — ${esc(chartName)}` : ''}</h4>${chartPositionTrend(app.chart.dateKeys, chartHist)}${overallNote}${depthNote}</div>`
          : `<div class="chartbox"><h4>Category chart rank trend</h4>${chartErrHtml}<p class="hint">${chartErrHtml ? '' : notRankedText}</p>${overallNote}${depthNote}</div>`;
        return `<div class="charts">
          ${catChartBox}
          <div class="chartbox"><h4>1-2★ rating share trend</h4>${ratingTrendChart(app.ratingHistory)}</div>
        </div>`;
      }

      // A single, self-contained card meant to be screenshotted and shared
      // outside the tool (a WhatsApp/Slack report group) — everything a
      // stakeholder asks for in one glance: visibility, category rank,
      // rating health, keyword rankings. Pure re-presentation of data the
      // other tabs already compute; no new fetch, no new stored state.
      // Daily-tracked + coverage keywords, deduped (daily wins on overlap —
      // it's checked every day, so it's the fresher signal for a keyword
      // tracked in both lists; same precedence already used for `difficulty`
      // in statePayload). This is what makes the snapshot show the FULL
      // keyword universe (up to 2000 via coverage) instead of just the
      // plan-capped daily list — a client with 400-600+ tracked keywords
      // wants to see how much of that whole universe is ranking, not just
      // whatever fits in the daily-tracked subset.
      /**
       * Why the Report Card has no rows. "No keyword data yet" was the same
       * message whether the app had no keywords at all, had them but hadn't
       * been checked, or had been checked and genuinely ranked nowhere —
       * three completely different situations needing three different
       * actions. Say which one it is.
       */
      function snapshotEmptyReason(app, allTrends) {
        if (!allTrends.length) {
          return `No keywords added for <b>${esc(app.title)}</b> yet — add them under <b>Settings</b>, then they appear here after the next check.`;
        }
        const unchecked = allTrends.filter((t) => !t.checked).length;
        const failed = allTrends.filter((t) => t.error).length;
        if (unchecked === allTrends.length) {
          return `${allTrends.length} keywords tracked, none checked yet — the next scheduled check fills this in. Nothing is wrong with your rankings.`;
        }
        if (failed) {
          return `${failed} of ${allTrends.length} keyword checks failed (store rate-limit or a temporary block, not a real result) — they retry on the next check.`;
        }
        return `${allTrends.length} keywords checked, none currently ranking in the top 200.`;
      }

      function mergedKeywordTrends(app) {
        const map = new Map();
        for (const t of (app.coverageTrends || [])) map.set(t.keyword.toLowerCase(), t);
        for (const t of (app.trends || [])) map.set(t.keyword.toLowerCase(), t);
        return [...map.values()];
      }

      const INSIGHT_KIND_LABEL = {
        listing: 'Listing changes', reviews: 'Review health',
        competitor: 'Competitors', coverage: 'Data quality', chart: 'Category chart',
      };

      // Renders the server-computed insights (see lib/rank/insights.ts).
      // Grouped by kind so the "things you changed" vs "things you didn't"
      // split — the whole point of this view — is visible at a glance.
      function insightsHtml(app) {
        const items = app.insights || [];
        if (!items.length) return '<p class="hint">Not enough data yet — run a check and log a listing change to start building this.</p>';
        const order = ['listing', 'reviews', 'competitor', 'chart', 'coverage'];
        const groups = order
          .map((kind) => ({ kind, rows: items.filter((i) => i.kind === kind) }))
          .filter((g) => g.rows.length);
        return groups.map((g) => `
          <div class="chartbox" style="margin-bottom:12px;">
            <h4>${esc(INSIGHT_KIND_LABEL[g.kind] || g.kind)}</h4>
            ${g.rows.map((i) => `
              <div class="insight ${esc(i.tone)}">
                <div class="insight-t">${esc(i.title)}</div>
                <div class="insight-d">${esc(i.detail)}</div>
              </div>`).join('')}
          </div>`).join('');
      }

      function snapshotHtml(app) {
        const ov = app.overview || {};
        const cur = ov.visibility, prev = ov.prevVisibility;
        const vDelta = (cur != null && prev != null) ? Math.round((cur - prev) * 10) / 10 : null;
        const vDeltaHtml = vDelta == null ? '<span class="delta flat">–</span> vs last check'
          : vDelta > 0 ? `<span class="delta up">▲ ${vDelta}</span> vs last check`
          : vDelta < 0 ? `<span class="delta down">▼ ${-vDelta}</span> vs last check`
          : '<span class="delta flat">＝ unchanged</span> vs last check';

        const chartName = (app.chart && app.chart.chart) || 'category chart';
        const chartDelta = app.chart && app.chart.delta
          ? (app.chart.delta > 0 ? ` <span class="delta up">▲${app.chart.delta}</span>` : ` <span class="delta down">▼${-app.chart.delta}</span>`)
          : '';
        // Same distinction as the Trends tab: a missing chart position can
        // mean "checked, genuinely not in it" OR "the chart fetch has been
        // failing" — those used to look identical (see track.ts's chartTrend).
        const chartDepth = app.chart && app.chart.depth;
        const chartSub = app.chart && app.chart.position != null
          ? `in ${esc(chartName)}${chartDelta}`
          : app.chart && app.chart.error
            ? `chart check failing — not a confirmed miss, retrying`
            : `not in the top ${chartDepth || '?'} of ${esc(chartName)}`;

        const rh = app.ratingHistory || [];
        const latestRating = rh.length ? rh[rh.length - 1] : null;
        const lr = app.latestResult;
        const scoreTxt = lr && lr.score != null ? `${lr.score.toFixed(1)}★ average${lr.ratings != null ? ` · ${lr.ratings.toLocaleString()} ratings` : ''}` : '';
        const ratingSub = latestRating
          ? `of last ${latestRating.total} reviews are 1-2★${scoreTxt ? ` · ${scoreTxt}` : ''}`
          : (app.store === 'play' ? 'no rating data checked yet' : 'rating tracking is Google Play only');

        const volumes = app.keywordVolumes || {};
        const diffMap = app.difficulty || {};
        const allTrends = mergedKeywordTrends(app).map((t) => ({ ...t, volume: volumes[t.keyword] ?? null, difficulty: diffMap[t.keyword] || null }));
        const rankingNow = allTrends.filter((t) => t.position != null && !t.error).sort((a, b) => a.position - b.position);
        const newlyRanked = rankingNow.filter((t) => t.prevPosition == null).length;
        const coverageSub = allTrends.length
          ? `of ${allTrends.length.toLocaleString()} tracked keywords${newlyRanked ? ` · <span class="delta up">+${newlyRanked}</span> new` : ''}`
          : 'no keywords tracked yet';

        // Defaults to rank ascending (the sort already applied to rankingNow
        // above) until a column header is clicked — reuses the same
        // sortVal/sort-state pattern as the other keyword tables.
        const snapSort = snapSortState[app.key] || {};
        const sortedKw = rankingNow.slice();
        if (snapSort.col) {
          sortedKw.sort((a, b) => {
            const av = sortVal(a, snapSort.col), bv = sortVal(b, snapSort.col);
            if (av == null && bv == null) return 0;
            if (av == null) return 1;
            if (bv == null) return -1;
            return (av - bv) * snapSort.dir;
          });
        }
        const snapArrow = (col) => snapSort.col === col ? (snapSort.dir === 1 ? ' ▲' : ' ▼') : '';
        const snapTh = (col, label) => `<th class="sortable" data-sort="${col}">${label}${snapArrow(col)}</th>`;

        const kwRows = sortedKw
          .map((t) => `<tr><td class="kw">${esc(t.keyword)}</td><td class="pos">${posCell(t)}</td><td>${deltaCell(t)}</td><td class="pos">${t.volume != null ? t.volume.toLocaleString() : '<span class="un">–</span>'}</td><td>${diffCell(t.difficulty)}</td></tr>`)
          .join('');

        const dateStr = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
        const icon = app.icon
          ? `<img class="icon" src="${escAttr(app.icon)}" alt="" />`
          : `<div class="fallback-icon">${app.store === 'play' ? '🤖' : ''}</div>`;

        return `
        <div class="snap-frame">
          <div class="snap-top">
            ${icon}
            <div>
              <div class="t">${esc(app.title)}</div>
              <div class="d">Daily Snapshot · ${dateStr}</div>
            </div>
            <button class="ghost no-print" data-act="pdf-snapshot" style="margin-left:auto;">Export as PDF</button>
          </div>
          <p class="headline-sub" style="margin-bottom:16px;">${visibilityNarrative(app)}</p>
          <div class="tiles">
            <div class="tile">
              <div class="lbl">Keywords ranking</div>
              <div class="val">${rankingNow.length.toLocaleString()}</div>
              <div class="hint" style="margin:6px 0 0;">${coverageSub}</div>
            </div>
            <div class="tile">
              <div class="lbl">Visibility score</div>
              <div class="val">${cur != null ? cur.toFixed(1) : '–'}</div>
              <div class="hint" style="margin:6px 0 0;">${vDeltaHtml}</div>
            </div>
            <div class="tile">
              <div class="lbl">Category chart rank</div>
              <div class="val">${app.chart && app.chart.position != null ? '#' + app.chart.position : '–'}</div>
              <div class="hint" style="margin:6px 0 0;">${chartSub}</div>
            </div>
            <div class="tile">
              <div class="lbl">Rating health</div>
              <div class="val">${latestRating ? latestRating.negativeShare + '%' : '–'}</div>
              <div class="hint" style="margin:6px 0 0;">${ratingSub}</div>
            </div>
          </div>
          ${allTrends.length && allTrends.every((t) => !t.checked) ? `<div class="alert info" style="display:block;margin:14px 0 0;">Today's check hasn't reached this app yet, so the figures above are blank — this is not a ranking loss. They fill in automatically once its scheduled check runs.</div>` : ''}
          <h4 style="margin:18px 0 8px;font-size:11px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:0.03em;">Keyword rankings — ${rankingNow.length.toLocaleString()} of ${allTrends.length.toLocaleString()} tracked keywords ranking</h4>
          <div class="table-wrap snaptable"><table>
            <thead><tr><th>Keyword</th>${snapTh('pos', 'Rank')}${snapTh('delta', 'Δ vs last')}${snapTh('volume', 'Volume')}${snapTh('difficulty', 'Difficulty')}</tr></thead>
            <tbody>${kwRows || `<tr><td colspan="5" class="hint">${snapshotEmptyReason(app, allTrends)}</td></tr>`}</tbody>
          </table></div>
          <p class="hint no-print" style="margin-top:14px;">Short list? Screenshot the card above. Long list (400+ keywords)? Use <b>Export as PDF</b> — it paginates cleanly and shares as a file in WhatsApp/Slack.</p>
        </div>`;
      }

      // AI-extracted complaint themes from recent 1-3★ reviews — pairs with
      // the rating-share trend above: that chart says the score is sliding,
      // this says WHY. Only refreshed on an explicit click (each run is an
      // AI call), cached server-side like the ASO audit.
      function reviewThemesHtml(app) {
        if (app.store !== 'play') return '';
        const rt = app.reviewThemes;
        const btn = `<button class="ghost" data-act="review-themes">${rt ? 'Re-analyze now' : 'Analyze negative reviews'}</button>`;
        if (!rt) {
          return `<div class="chartbox no-print" style="margin-top:14px;"><h4>What negative reviews complain about</h4>
            <p class="hint" style="margin:0 0 10px;">Reads the recent 1-3★ reviews and groups them into the most common complaints — the "why" behind a sliding rating, and usually the fastest thing to fix before it drags rank down. Refreshes automatically every night once it's run for the first time.</p>
            ${btn}</div>`;
        }
        const themeRows = rt.themes.map((t) => `
          <div style="padding:9px 0;border-top:1px solid var(--bg);">
            <div style="display:flex;justify-content:space-between;gap:10px;align-items:baseline;">
              <b style="font-size:13.5px;">${esc(t.theme)}</b>
              <span class="hint" style="margin:0;white-space:nowrap;">${t.count} of ${rt.negativeAnalysed} reviews</span>
            </div>
            ${t.example ? `<div class="hint" style="margin:3px 0 0;font-style:italic;">“${esc(t.example)}”</div>` : ''}
          </div>`).join('');
        return `<div class="chartbox" style="margin-top:14px;"><h4>What negative reviews complain about</h4>
          <p class="hint" style="margin:0 0 4px;">From ${rt.negativeAnalysed} written 1-3★ reviews over the last ${rt.windowDays} days · last refreshed ${new Date(rt.checkedAt).toLocaleDateString()} · updates automatically every night</p>
          ${themeRows}
          <div class="row no-print" style="margin-top:10px;">${btn}</div>
        </div>`;
      }

      const ANN_TYPE_LABEL = { experiment: '🧪 Experiment', paid: '📢 Paid push' };

      function annotationsHtml(app) {
        const anns = app.annotations || [];
        if (!anns.length) return '';
        const rows = anns.slice().sort((a, b) => b.date.localeCompare(a.date)).map((a) => {
          const im = a.impact || {};
          const hasImpact = im.before && im.after && im.before.avgVisibility != null && im.after.avgVisibility != null;
          const deltaHtml = !hasImpact
            ? '<span class="ann-delta na">Not enough days before/after yet</span>'
            : `<span class="ann-delta ${im.delta > 0 ? 'up' : im.delta < 0 ? 'down' : 'flat'}">${im.delta > 0 ? '▲' : im.delta < 0 ? '▼' : '＝'} ${Math.abs(im.delta)} pt visibility</span>`;
          const detail = hasImpact
            ? `${im.before.avgVisibility} → ${im.after.avgVisibility} avg visibility (14d before → after)`
            : '';
          return `<div class="annrow">
            <span class="anntype ${a.type}">${ANN_TYPE_LABEL[a.type] || a.type}</span>
            <div class="anntext"><b>${esc(fmtDay(a.date))}</b> — ${esc(a.label)}<div class="annimpact">${deltaHtml}${detail ? `<span>${esc(detail)}</span>` : ''}</div></div>
            <button class="ghost danger small" data-act="remove-annotation" data-id="${escAttr(a.id)}" title="Remove annotation">×</button>
          </div>`;
        }).join('');
        return `<div class="annlist"><h4>Annotations &amp; ranking impact</h4>${rows}</div>`;
      }

      // Plain-language key for the Rank column, since "#N" / ">200" /
      // "not checked yet" / "err" otherwise have to be inferred.
      const RANK_LEGEND = `<p class="hint" style="margin:2px 0 10px;"><b>#N</b> = found at position N &nbsp;·&nbsp; <b>&gt;200</b> = checked, not in the top 200 &nbsp;·&nbsp; <b>not checked yet</b> = hasn't been searched yet (just added, or waiting on the next check) &nbsp;·&nbsp; <b>⚠︎ err</b> (hover for why) = the check itself failed, not a real rank</p>`;

      function coverageTableHtml(app, trends) {
        if (!trends.length) return '<p class="hint" style="margin-top:10px;">No keywords in this category.</p>';
        const volumes = app.keywordVolumes || {};
        const covDiff = app.difficulty || {};
        const rows = trends.map((t) => ({ ...t, volume: volumes[t.keyword] ?? null, difficulty: covDiff[t.keyword] || null }));
        // Default to highest-volume-first — the whole point of this table is
        // seeing where you rank on the keywords that matter most, not just
        // the plan-limited 60 that happen to be in the daily-tracked list.
        const sort = covSortState[app.key] || { col: 'volume', dir: -1 };
        if (sort.col) {
          rows.sort((a, b) => {
            const av = sortVal(a, sort.col), bv = sortVal(b, sort.col);
            if (av == null && bv == null) return 0;
            if (av == null) return 1;
            if (bv == null) return -1;
            return (av - bv) * sort.dir;
          });
        }
        const arrow = (col) => sort.col === col ? (sort.dir === 1 ? ' ▲' : ' ▼') : '';
        const th = (col, label) => `<th class="sortable" data-sort="${col}">${label}${arrow(col)}</th>`;
        const body = rows.map((t) => `
          <tr>
            <td class="kw"><button class="kwlink" data-kwhistory="${escAttr(t.keyword)}" data-list="coverage">${esc(t.keyword)}</button></td>
            <td class="pos">${t.volume != null ? t.volume.toLocaleString() : '<span class="un">–</span>'}</td>
            <td class="pos">${posCell(t)}</td>
            <td>${deltaCell(t)}</td>
            <td class="pos">${t.best != null ? `#${t.best}` : '<span class="un">–</span>'}</td>
            <td>${diffCell(t.difficulty)}</td>
            <td>${spark(t.history || [])}</td>
            <td class="who">${(t.top || []).length ? esc(t.top[0].title) : '–'}</td>
          </tr>`).join('');
        return `<p class="scrollhint no-print">↔ Swipe to see all columns</p><div class="table-wrap covtable"><table>
            <thead><tr><th>Keyword</th>${th('volume', 'Volume')}${th('pos', 'Rank')}${th('delta', 'Δ vs last')}${th('best', 'Best')}${th('difficulty', 'Difficulty')}<th>Trend</th><th>#1 for this keyword</th></tr></thead>
            <tbody>${body}</tbody>
          </table></div>`;
      }

      // Groups the coverage list using the app's own derived topics (see
      // buildKeywordGroups) and renders a sub-tab per group actually present,
      // so each topic can be read without scanning one long flat list.
      function categorizedCoverageHtml(app) {
        // A keyword can legitimately sit in BOTH the daily-tracked list and
        // the full coverage list — they're checked by two separate passes
        // (the daily automatic check vs the coverage batch, which can take
        // more than one run to get through a big list), so the same keyword
        // can show a different position in each tab simply because it was
        // last actually searched on a different day in each pipeline. That
        // reads as a bug even though both numbers were real at the time they
        // were captured. Fix: for any keyword also daily-tracked, show the
        // daily result here too — it's checked every day, so it's always the
        // freshest number regardless of where the coverage batch has reached.
        const dailyMap = {};
        for (const t of (app.trends || [])) dailyMap[t.keyword] = t;
        const trends = (app.coverageTrends || []).map((t) => dailyMap[t.keyword] || t);
        if (!trends.length) return '';
        const byCat = {};
        for (const t of trends) {
          const cat = categorizeKeyword(t.keyword, app);
          (byCat[cat] = byCat[cat] || []).push(t);
        }
        // A tab holding one keyword isn't a topic, it's clutter — fold those
        // back into Other so the tab bar stays readable.
        for (const cat of Object.keys(byCat)) {
          if (cat !== 'Brand + Comp' && cat !== 'Other' && byCat[cat].length < 2) {
            byCat.Other = [...(byCat.Other || []), ...byCat[cat]];
            delete byCat[cat];
          }
        }
        // Derived groups in the order buildKeywordGroups ranked them, brand
        // first and the leftovers last, so the tab bar is stable across
        // renders rather than reshuffling as ranks move.
        const order = ['Brand + Comp', ...groupsFor(app).groups.map((g) => g.label), 'Other'];
        const present = order.filter((c) => (byCat[c] || []).length);
        // Only one category present (usually "General") — a tab bar with a
        // single option is just noise, show the plain table instead.
        if (present.length <= 1) return coverageTableHtml(app, trends);
        const active = present.includes(catTabState[app.key]) ? catTabState[app.key] : present[0];
        const tabs = `<div class="kwtabs cattabs no-print">${present.map((c) =>
          `<button class="kwtab cattab ${c === active ? 'active' : ''}" data-cattab="${escAttr(c)}">${esc(c)} (${byCat[c].length})</button>`
        ).join('')}</div>`;
        return tabs + coverageTableHtml(app, byCat[active]);
      }

      function coverageHtml(app) {
        const cov = app.coverageOverview;
        if (!cov || !cov.total) return '';
        const c = cov.counts || {}, p = cov.prevCounts || null;
        if (!cov.days.length) {
          return `<div class="ov covov"><h4 class="covhead">Keyword coverage <span class="hint" style="display:inline;margin:0;">— ${cov.total} keywords saved, not checked yet</span></h4>
            <p class="hint">Click <b>Check all keyword rankings</b> above to run the first check. Each check adds one point to this trend — run it every few days to see coverage of your full list growing or dropping over time.</p></div>`;
        }
        const covErrCount = (app.coverageTrends || []).filter((t) => t.error).length;
        const covErrBanner = covErrCount
          ? `<div class="alert info" style="display:block;">⚠︎ ${covErrCount} of ${app.coverageTrends.length} keyword${app.coverageTrends.length === 1 ? '' : 's'} failed their last check (store rate-limit or a temporary block, not a real result) — not confirmed "not ranking"; retried automatically on the next check.</div>`
          : '';
        return `<div class="ov covov">
          <h4 class="covhead">Keyword coverage <span class="hint" style="display:inline;margin:0;">— ${cov.total} keywords, last checked ${cov.lastCheckedAt ? new Date(cov.lastCheckedAt).toLocaleString() : 'never'}</span></h4>
          ${covErrBanner}
          <div class="charts">${coverageChartsHtml(app)}</div>
          <div class="statblock">
            <div class="tiles">
              ${tileHtml('Top 1', c.top1, p && p.top1)}
              ${tileHtml('Top 10', c.top10, p && p.top10)}
              ${tileHtml('Top 30', c.top30, p && p.top30)}
              ${tileHtml('Top 100', c.top100, p && p.top100)}
            </div>
            ${categorizedCoverageHtml(app)}
          </div>
          <h4 class="covhead" style="margin-top:14px;">Every keyword you're monitoring here, ranking or not, sorted by volume</h4>
          <p class="hint" style="margin:0 0 6px;">This list can overlap with the "Daily Keyword Snapshot" tab, that's normal — a keyword on both is now always shown with its daily-checked position here too, so the two tabs never disagree. This list is checked by the nightly check, not the "Check now" button up top — click <b>Check all keyword rankings</b> above for a smaller list you want checked right away.</p>
          ${RANK_LEGEND}
        </div>`;
      }

      // Shared hover tooltip for both charts.
      const viztip = $('viztip');
      document.addEventListener('mousemove', (ev) => {
        const col = ev.target.closest && ev.target.closest('.hcol');
        if (!col) { viztip.style.display = 'none'; return; }
        viztip.innerHTML = TIPS[col.getAttribute('data-tip')] || '';
        viztip.style.display = 'block';
        const vw = window.innerWidth, rect = viztip.getBoundingClientRect();
        viztip.style.left = Math.min(ev.clientX + 14, vw - rect.width - 10) + 'px';
        viztip.style.top = Math.max(8, ev.clientY - rect.height - 12) + 'px';
      });

      function deltaCell(t) {
        // A failed check (see posCell's "err" case) has no real position to
        // compare — showing "out" here would read as a confirmed rank drop
        // when all that actually happened is the store search errored out.
        if (t.error) return '<span class="delta na">–</span>';
        if (t.position != null && t.prevPosition == null) return '<span class="delta up">new</span>';
        if (t.position == null && t.prevPosition != null) return '<span class="delta down">out</span>';
        if (t.delta == null) return '<span class="delta na">–</span>';
        if (t.delta > 0) return `<span class="delta up">▲ ${t.delta}</span>`;
        if (t.delta < 0) return `<span class="delta down">▼ ${-t.delta}</span>`;
        return '<span class="delta flat">＝ 0</span>';
      }

      function posCell(t) {
        if (t.error) return `<span class="un" title="${escAttr(t.error)}">⚠︎ err</span>`;
        if (t.position != null) return `#${t.position}`;
        // Distinguish "searched, ranked beyond depth" from "never actually
        // checked yet" (just added, or a large coverage list still waiting
        // on the nightly cron) — showing ">200" for the latter would wrongly
        // read as "confirmed not ranking".
        if (t.checked === false) return `<span class="un" title="Not checked yet — this keyword hasn't been searched in a check yet.">not checked yet</span>`;
        return `<span class="un">&gt;${t.depth || 200}</span>`;
      }

      // Clicking a keyword in either table opens this — the full position
      // history for just that keyword, reusing the same low-is-good line
      // chart as the category-rank trend, paired with that list's own date
      // keys (daily-tracked and coverage are checked on different
      // schedules, so their snapshot histories don't line up 1:1).
      function openKeywordHistory(appKey, listType, keyword) {
        const app = state.apps.find((a) => a.key === appKey);
        if (!app) return;
        let trends = listType === 'coverage' ? (app.coverageTrends || []) : (app.trends || []);
        let t = trends.find((x) => x.keyword === keyword);
        // Compare links pass 'daily' but the keyword may only be in coverage
        // (or vice versa) — fall back to the other list before giving up.
        if (!t) {
          listType = listType === 'coverage' ? 'daily' : 'coverage';
          trends = listType === 'coverage' ? (app.coverageTrends || []) : (app.trends || []);
          t = trends.find((x) => x.keyword === keyword);
        }
        if (!t) return;
        const dateKeys = (listType === 'coverage' ? (app.coverageOverview && app.coverageOverview.days) : (app.overview && app.overview.days)) || [];
        const dks = dateKeys.map((d) => d.dateKey);
        const volume = (app.keywordVolumes || {})[keyword];
        const chart = chartPositionTrend(dks, t.history || [], 'Rank', 'No history yet for this keyword — check back after the next check.');
        $('kwmodal').innerHTML = `
          <div class="kwmodal-head">
            <div class="kwmodal-title">${esc(keyword)}</div>
            <button class="kwmodal-close" data-act="close-kwmodal" aria-label="Close">×</button>
          </div>
          <div class="hint" style="margin:0 0 4px;">${listType === 'coverage' ? 'Coverage list' : 'Daily tracked'} · ${app.title ? esc(app.title) : ''}</div>
          <div class="kwmodal-stats">
            <div class="kwmodal-stat">Current<b>${t.position != null ? `#${t.position}` : (t.checked === false ? 'not checked yet' : `>${t.depth || 200}`)}</b></div>
            <div class="kwmodal-stat">Best ever<b>${t.best != null ? `#${t.best}` : '–'}</b></div>
            <div class="kwmodal-stat">Δ vs last check<b>${t.delta != null ? (t.delta > 0 ? `▲ ${t.delta}` : t.delta < 0 ? `▼ ${-t.delta}` : '＝ 0') : '–'}</b></div>
            <div class="kwmodal-stat">Volume<b>${volume != null ? volume.toLocaleString() : '–'}</b></div>
          </div>
          ${chart}
          ${(t.top || []).length ? `<p class="hint" style="margin-top:10px;">Currently #1 for this keyword: <b>${esc(t.top[0].title)}</b></p>` : ''}
        `;
        $('kwmodal-backdrop').classList.add('open');
      }
      function closeKeywordHistory() { $('kwmodal-backdrop').classList.remove('open'); }

      // --- side-by-side competitor comparison --------------------------------
      // Uses data already collected: every tracked app's own trends. A rival
      // only has a rank for a keyword if that keyword is in ITS daily or
      // coverage list — the "Track these on X" button closes that gap by
      // appending your keywords to the rival's (uncapped) coverage list.
      // Only apps EXPLICITLY linked to this one via competitorOf are
      // comparable — matching purely on store+country+developer used to
      // pull in every other app in the whole account (every client's own
      // apps and every client's competitors, all mixed into one picker),
      // which is unusable once an account is managing more than one client.
      // See set-competitor-of in api/rank.ts for linking an app added
      // before this existed, or one that was linked to the wrong app.
      function comparableApps(app) {
        return state.apps.filter((a) => a.key !== app.key && (a.competitorOf === app.key || app.competitorOf === a.key));
      }

      // An app counts as a valid "your own app" target for linking a NEW
      // competitor to it if it either has no competitorOf at all, OR its
      // competitorOf points at a key that no longer exists (the app it was
      // linked to got removed later) — a stale link like that shouldn't
      // make the app permanently un-selectable everywhere else. The sidebar
      // already treats an unresolved target the same way (renders the app
      // top-level, see renderSidebar's isNested) — this keeps every picker
      // agreeing with what the sidebar already shows.
      function isPrimaryLike(a) {
        return !a.competitorOf || !state.apps.some((x) => x.key === a.competitorOf);
      }

      function trendMap(a) {
        const m = {};
        for (const t of (a.coverageTrends || [])) m[t.keyword] = t;
        for (const t of (a.trends || [])) m[t.keyword] = t; // daily-tracked wins (fresher)
        return m;
      }

      // "You" always in --ink (the same neutral used for every other
      // "your data" line elsewhere); competitors get distinct saturated
      // hues far enough apart to stay distinguishable on the trend chart,
      // and different enough from the amber accent not to be mistaken for
      // an interactive element.
      const COMPARE_COLORS = ['var(--ink)', '#6ea8fe', '#34d399', '#c084fc'];

      // Icon + short name instead of the full store title in comparison
      // TABLE headers specifically — a real app title ("PhonePe: UPI,
      // Recharge, Bill Pay & Insurance") can be 40+ characters, which is
      // what was forcing the Compare table into permanent horizontal
      // scroll with 3 competitor columns. Full name is still on hover.
      function compLabel(a, isYou) {
        const short = a.title.length > 14 ? a.title.slice(0, 13) + '…' : a.title;
        const icon = a.icon ? `<img src="${escAttr(a.icon)}" alt="" class="cticon" />` : '';
        return `<span class="cthead" title="${escAttr(a.title)}">${icon}<span>${esc(short)}${isYou ? ' (you)' : ''}</span></span>`;
      }

      // 0-100 popularity-style score, same curve as the server-side
      // visibilityScore (track.ts) — reimplemented here since the trend
      // chart only has per-keyword position HISTORY on the client, not raw
      // snapshots to send back to the server for.
      function visScore(pos) {
        if (pos == null || pos > 200) return 0;
        return 100 * (1 - Math.log(pos) / Math.log(201));
      }

      // Visibility trend for `app` measured against `kws` (the PRIMARY app's
      // keyword list, not app's own) — every app's keyword-trend `history`
      // array is date-aligned to the same tenant-wide snapshot list (see
      // keywordTrends in track.ts), so this is a fair apples-to-apples read
      // of "how visible is this app on the keywords I actually care about,
      // over time" even for a rival that tracks a totally different list of
      // its own. A keyword the app doesn't track at all just contributes 0
      // (same as truly unranked) at every day.
      function compareTrendSeries(app, kws, days, dateKeys) {
        const map = trendMap(app);
        const histLen = Math.max(0, ...kws.map((kw) => (map[kw]?.history || []).length));
        const n = Math.min(days, histLen, dateKeys.length);
        if (!n) return [];
        // A competitor added partway through the window has no real data
        // for the days before it existed — history[] can't tell "not
        // tracked yet" apart from "tracked, ranked nowhere" (both are
        // null), so use the app's own addedAt date instead. Without this,
        // every pre-add day scored 0 (same as "ranked nowhere"), which
        // drew a flat line at zero followed by a vertical cliff the day
        // tracking actually started — reading as an overnight ranking
        // surge that never happened, when it was really "we only started
        // watching this app a few days ago."
        const addedDate = app.addedAt ? app.addedAt.slice(0, 10) : null;
        const alignedDates = dateKeys.slice(-n);
        const out = [];
        for (let i = 0; i < n; i++) {
          if (addedDate && alignedDates[i] < addedDate) { out.push(null); continue; }
          const idx = histLen - n + i; // align to the most recent `n` days
          const scores = kws.map((kw) => visScore((map[kw]?.history || [])[idx] ?? null));
          out.push(scores.reduce((a, b) => a + b, 0) / scores.length);
        }
        return out;
      }

      function compareTrendChart(app, comps, kws) {
        const dateKeys = (state.snapshotDays || []).slice(-30);
        const series = [{ titleHtml: compLabel(app, true), color: COMPARE_COLORS[0], vals: compareTrendSeries(app, kws, 30, dateKeys) },
          ...comps.map((c, i) => ({ titleHtml: compLabel(c, false), color: COMPARE_COLORS[i + 1], vals: compareTrendSeries(c, kws, 30, dateKeys) }))];
        const n = Math.max(...series.map((s) => s.vals.length));
        if (n < 2) return '';
        const dates = dateKeys.slice(-n);
        const W = 720, H = 200, padL = 32, padB = 20, padT = 10;
        const plotW = W - padL - 8, plotH = H - padT - padB;
        const x = (i) => padL + (n === 1 ? plotW / 2 : (i / (n - 1)) * plotW);
        const y = (v) => padT + plotH - (v / 100) * plotH;
        let out = '';
        for (const v of [100, 50, 0]) {
          out += `<line x1="${padL}" y1="${y(v).toFixed(1)}" x2="${W - 6}" y2="${y(v).toFixed(1)}" stroke="var(--line)" stroke-width="1"/>
            <text x="${padL - 5}" y="${(y(v) + 3.5).toFixed(1)}" text-anchor="end" font-size="9.5" fill="var(--muted)">${v}</text>`;
        }
        const labelEvery = Math.ceil(n / 6);
        for (let i = 0; i < n; i++) {
          if (i % labelEvery === 0) out += `<text x="${x(i).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="var(--muted)">${esc(fmtDay(dates[i] || ''))}</text>`;
        }
        for (const s of series) {
          const vals = s.vals.slice(-n);
          let d = '', started = false;
          // null = wasn't tracked yet (see compareTrendSeries) — break the
          // line instead of drawing through it, so a competitor added
          // partway through the window starts its line only from its own
          // first real day, not a flat zero leading up to a fake cliff.
          vals.forEach((v, i) => {
            if (v == null) { started = false; return; }
            d += `${started ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)} `;
            started = true;
          });
          out += `<path d="${d}" fill="none" stroke="${s.color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
        }
        const legend = series.map((s) => `<span class="li"><span class="sw" style="background:${s.color}"></span>${s.titleHtml}</span>`).join('');
        return `<div class="chartbox"><h4>Visibility trend on your keywords — you vs competitors</h4>
          <svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${out}</svg>
          <div class="legend">${legend}</div>
          <p class="hint" style="margin-top:6px;">0–100 score, same scale as the Overview visibility score — averaged across your keyword list for each app, using only that app's own tracked/coverage keywords (untracked keywords count as 0, same as "not ranking"). Trend direction matters more than the exact number on any single day.</p>
        </div>`;
      }

      // Which topics your keyword list actually falls into (derived per app,
      // see buildKeywordGroups) and how strong each app is in each — a single
      // overall visibility number hides that you might be dominant in one
      // category and invisible in another; this is where that shows up.
      function categoryStrengthHtml(app, comps, kws) {
        const byCat = {};
        for (const kw of kws) (byCat[categorizeKeyword(kw, app)] = byCat[categorizeKeyword(kw, app)] || []).push(kw);
        const cats = Object.keys(byCat);
        if (cats.length < 2) return ''; // one bucket (usually "General") — nothing to break out
        const apps = [app, ...comps];
        const maps = apps.map(trendMap);
        const rows = cats.map((cat) => {
          const catKws = byCat[cat];
          const scores = maps.map((m) => {
            const vals = catKws.map((kw) => visScore(m[kw]?.error ? null : m[kw]?.position ?? null));
            return Math.round((vals.reduce((a, b) => a + b, 0) / vals.length) * 10) / 10;
          });
          const best = Math.max(...scores);
          return { cat, count: catKws.length, scores, best };
        });
        const head = `<th>Category</th><th>${compLabel(app, true)}</th>${comps.map((c) => `<th>${compLabel(c, false)}</th>`).join('')}`;
        const body = rows.map((r) => `<tr>
            <td class="kw">${esc(r.cat)} <span class="hint" style="margin:0;">(${r.count})</span></td>
            ${r.scores.map((s) => `<td class="pos" ${s === r.best ? 'style="background:var(--ok-tint);"' : ''}>${s}</td>`).join('')}
          </tr>`).join('');
        return `<div class="chartbox" style="margin-bottom:12px;"><h4>Strength by category</h4>
          <p class="hint" style="margin:0 0 8px;">0–100 visibility score, averaged per category — shows where you're actually ahead or behind, not just overall.</p>
          <div class="table-wrap"><table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>
        </div>`;
      }

      function compareHtml(app) {
        const others = comparableApps(app);
        if (!others.length) {
          return `<p class="hint">To compare, track your competitors' apps too (<b>＋ Track an app</b> in the sidebar) — same store and country as this one. Their ranks will appear here next to yours, keyword by keyword.</p>`;
        }
        let sel = (compareState[app.key] || others.slice(0, 3).map((o) => o.key)).filter((k) => others.some((o) => o.key === k)).slice(0, 3);
        compareState[app.key] = sel;
        const picker = `<div class="row no-print" style="margin-bottom:12px;">
          <span class="hint" style="margin:0;">Compare against (max 3):</span>
          ${others.map((o) => `<label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;cursor:pointer;">
            <input type="checkbox" data-comp-toggle="${escAttr(o.key)}" ${sel.includes(o.key) ? 'checked' : ''} /> ${compLabel(o, false)}
          </label>`).join('')}
        </div>`;
        const comps = sel.map((k) => others.find((o) => o.key === k)).filter(Boolean);
        const kws = (app.keywords || []).length ? app.keywords : (app.coverageKeywords || []).slice(0, 60);
        if (!kws.length) return picker + '<p class="hint">Add keywords to this app first — the comparison uses your keyword list.</p>';
        if (!comps.length) return picker + '<p class="hint">Tick at least one competitor above.</p>';

        const volumes = app.keywordVolumes || {};
        const mine = trendMap(app);
        const maps = comps.map(trendMap);

        const posOf = (t) => (t && !t.error && t.position != null) ? t.position : null;
        let rows = kws.map((kw) => {
          const myT = mine[kw];
          const myPos = posOf(myT);
          const compCells = comps.map((c, i) => {
            let t = maps[i][kw];
            let pos = posOf(t);
            let fromTop3 = false;
            // Freebie: even if the rival doesn't track this keyword, our own
            // check stored the top-3 apps for it — if the rival is in there,
            // that IS their rank.
            if (!t && myT && (myT.top || []).length) {
              const idx = myT.top.findIndex((x) => x.appId === c.appId);
              if (idx !== -1) { pos = idx + 1; fromTop3 = true; }
            }
            return { pos, tracked: !!t || fromTop3, checked: t ? t.checked !== false : fromTop3, error: t ? t.error : null };
          });
          const all = [myPos, ...compCells.map((c) => c.pos)].filter((p) => p != null);
          const best = all.length ? Math.min(...all) : null;
          return { kw, volume: volumes[kw] ?? null, myPos, myChecked: myT ? myT.checked !== false : false, myError: myT ? myT.error : null, compCells, best };
        });

        const sort = compareSortState[app.key] || {};
        if (sort.col) {
          const valOf = (r) => {
            if (sort.col === 'kw') return r.kw;
            if (sort.col === 'volume') return r.volume;
            if (sort.col === 'mine') return r.myPos;
            if (sort.col === 'best') return r.best;
            if (sort.col.startsWith('comp:')) return r.compCells[Number(sort.col.slice(5))]?.pos;
            return null;
          };
          rows = rows.slice().sort((a, b) => {
            const av = valOf(a), bv = valOf(b);
            if (av == null && bv == null) return 0;
            if (av == null) return 1;
            if (bv == null) return -1;
            if (typeof av === 'string') return av.localeCompare(bv) * sort.dir;
            return (av - bv) * sort.dir;
          });
        }

        const cell = (pos, tracked, checked, best, error) => {
          // A failed check (see posCell's "err" case elsewhere) has no real
          // position — showing ">200" here would confidently claim "checked,
          // not ranking" when the store search actually just errored out.
          if (error) return `<td class="pos"><span class="un" title="${escAttr(error)}">⚠︎ err</span></td>`;
          if (pos != null) return `<td class="pos" ${pos === best ? 'style="background:var(--ok-tint);"' : ''}>#${pos}</td>`;
          if (!tracked) return '<td class="pos"><span class="un" title="This keyword isn\'t in this app\'s tracked or coverage list yet — use the button below to add it.">not tracked</span></td>';
          if (!checked) return '<td class="pos"><span class="un">not checked yet</span></td>';
          return '<td class="pos"><span class="un">&gt;200</span></td>';
        };
        const rowsHtml = rows.map((r) => `<tr>
            <td class="kw"><button class="kwlink" data-kwhistory="${escAttr(r.kw)}" data-list="daily">${esc(r.kw)}</button></td>
            <td class="pos">${r.volume != null ? r.volume.toLocaleString() : '<span class="un">–</span>'}</td>
            ${cell(r.myPos, true, r.myChecked, r.best, r.myError)}
            ${r.compCells.map((c) => cell(c.pos, c.tracked, c.checked, r.best, c.error)).join('')}
          </tr>`).join('');

        const syncBtns = comps.map((c, i) => {
          const missing = kws.filter((kw) => !maps[i][kw]);
          if (!missing.length) return '';
          return `<button class="ghost" data-act="sync-comp" data-comp="${escAttr(c.key)}">Track these ${missing.length} keyword${missing.length === 1 ? '' : 's'} on ${esc(c.title)}</button>`;
        }).filter(Boolean).join(' ');

        const arrow = (col) => sort.col === col ? (sort.dir === 1 ? ' ▲' : ' ▼') : '';
        const th = (col, label) => `<th class="sortable" data-sort="${col}">${label}${arrow(col)}</th>`;

        return `${picker}
          ${compareTrendChart(app, comps, kws)}
          ${categoryStrengthHtml(app, comps, kws)}
          <p class="scrollhint no-print">↔ Swipe to see all columns</p>
          <div class="table-wrap comparetable"><table>
            <thead><tr>${th('kw', 'Keyword')}${th('volume', 'Volume')}${th('mine', compLabel(app, true))}${comps.map((c, i) => th(`comp:${i}`, compLabel(c, false))).join('')}</tr></thead>
            <tbody>${rowsHtml}</tbody>
          </table></div>
          <p class="hint" style="margin-top:8px;">Green cell = best rank for that keyword. "Not tracked" means the competitor's own keyword lists don't include that term yet — their rank can't be known until it's checked on their side:</p>
          ${syncBtns ? `<div class="row no-print">${syncBtns}</div>` : ''}`;
      }

      function renderApp(app) {
        const storePill = app.store === 'play'
          ? '<span class="pill play">Google Play</span>'
          : '<span class="pill ios">App Store</span>';
        const chart = app.chart && app.chart.position != null
          ? `<span class="pill chart" title="${escAttr(app.chart.chart || '')}">📈 ${esc(app.chart.chart || 'Top Free')} · #${app.chart.position}${app.chart.delta ? (app.chart.delta > 0 ? ` (▲${app.chart.delta})` : ` (▼${-app.chart.delta})`) : ''}</span>`
          : (app.chart && app.chart.chart ? `<span class="pill cc" title="Not in the top of ${escAttr(app.chart.chart)}">chart: not ranked</span>` : '');
        const icon = app.icon
          ? `<img class="icon" src="${escAttr(app.icon)}" alt="" />`
          : `<div class="fallback-icon">${app.store === 'play' ? '🤖' : ''}</div>`;
        const sort = sortState[app.key] || {};
        const volumes = app.keywordVolumes || {};
        const diffMap = app.difficulty || {};
        const trends = (app.trends || []).map((t) => ({ ...t, volume: volumes[t.keyword] ?? null, difficulty: diffMap[t.keyword] || null }));
        if (sort.col) {
          trends.sort((a, b) => {
            const av = sortVal(a, sort.col), bv = sortVal(b, sort.col);
            if (av == null && bv == null) return 0;
            if (av == null) return 1;
            if (bv == null) return -1;
            return (av - bv) * sort.dir;
          });
        }
        const arrow = (col) => sort.col === col ? (sort.dir === 1 ? ' ▲' : ' ▼') : '';
        const th = (col, label) => `<th class="sortable" data-sort="${col}">${label}${arrow(col)}</th>`;
        const rows = trends.map((t) => `
          <tr>
            <td class="kw"><button class="kwlink" data-kwhistory="${escAttr(t.keyword)}" data-list="daily">${esc(t.keyword)}</button></td>
            <td class="pos">${t.volume != null ? t.volume.toLocaleString() : '<span class="un">–</span>'}</td>
            <td class="pos">${posCell(t)}</td>
            <td>${deltaCell(t)}</td>
            <td class="pos">${t.best != null ? `#${t.best}` : '<span class="un">–</span>'}</td>
            <td>${diffCell(t.difficulty)}</td>
            <td>${spark(t.history || [])}</td>
            <td class="who">${(t.top || []).length ? esc(t.top[0].title) : '–'}</td>
          </tr>`).join('');
        const errCount = trends.filter((t) => t.error).length;
        // A checked-but-failed row (store rate-limit/block) still reads as
        // "not ranking" in the table (no numeric position either way) — call
        // that out explicitly so it's never mistaken for a confirmed result.
        const errBanner = errCount
          ? `<div class="alert info" style="display:block;">⚠︎ ${errCount} of ${trends.length} keyword${trends.length === 1 ? '' : 's'} failed to check today (store rate-limit or a temporary block, not a real result) — hover the <b>⚠︎ err</b> tag in the table for details. These are <b>not</b> confirmed as "not ranking"; they're retried automatically on the next check.</div>`
          : '';
        const table = (app.keywords || []).length
          ? `<div class="chartbox" style="margin-bottom:14px;"><h4>Search visibility score (0–100)</h4>${visChart(app.overview.days, app.annotations)}</div>
            ${errBanner}
            <p class="scrollhint no-print">↔ Swipe to see all columns</p><div class="table-wrap"><table>
              <thead><tr><th>Keyword</th>${th('volume', 'Volume')}${th('pos', 'Rank')}${th('delta', 'Δ vs last')}${th('best', 'Best')}${th('difficulty', 'Difficulty')}<th>Trend</th><th>#1 for this keyword</th></tr></thead>
              <tbody>${rows}</tbody>
            </table></div>
            <h4 class="covhead" style="margin-top:14px;">Daily-tracked keywords <span class="hint" style="display:inline;margin:0;">— ${app.keywords.length} keyword${app.keywords.length === 1 ? '' : 's'}, checked automatically every day</span></h4>
            ${RANK_LEGEND}`
          : '<p class="hint" style="margin-top:10px;">No keywords yet — click <b>Edit keywords</b> to add some, then check rankings.</p>';
        const apphead = `
          <div class="apphead" style="margin-bottom:14px;">
            ${icon}
            <div class="names">
              <div class="t">${app.url ? `<a href="${escAttr(app.url)}" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">${esc(app.title)}</a>` : esc(app.title)}</div>
              <div class="d">${esc(app.developer || app.appId)} · ${storePill} <span class="pill cc">${esc((app.country || '').toUpperCase())}</span> ${chart}</div>
            </div>
            <div class="btns no-print">
              <button class="ghost" data-act="check-one">Check now</button>
              <button class="ghost" data-act="pdf">Export PDF</button>
            </div>
          </div>`;

        // Overview is the ONE screen a client should never need explaining —
        // just what's ranking, the trend, and what moved. Everything else
        // (the full movers list, competitor standing, rating health, the
        // ASO cross-sell) has its own home in a tab that's actually about
        // that thing, instead of all of it landing on the home screen at
        // once.
        const sectionOverview = `
          <div class="section-head"><h2>Overview</h2><p class="hint">Where you rank today, your trend, and what changed since your last check.</p></div>
          ${overviewHtml(app)}`;

        const sectionInsights = `
          <div class="section-head"><h2>Insights</h2><p class="hint">What's actually moving your rank — separating the listing changes you made from the things you didn't change (review health, competitor standing) that no copy rewrite will fix.</p></div>
          ${insightsHtml(app)}`;

        const sectionSnapshot = `
          <div class="section-head no-print"><h2>Report Card</h2><p class="hint">Visibility, category rank, rating health, and keyword rankings — screenshot the card, or export it as a PDF for a long keyword list.</p></div>
          ${snapshotHtml(app)}`;

        const moversCard = moversHtml(app);
        const promoCard = promotableHtml(app);
        const sectionKeywords = `
          <div class="section-head"><h2>Daily Keywords</h2>
            <div class="row no-print"><button class="ghost" data-act="discover">Discover keywords</button></div>
          </div>
          <p class="hint" style="margin:0 0 12px;">The keywords checked every single day — these drive your visibility score, movement and drop alerts. Your full list lives under <b>All Keywords</b>.</p>
          ${promoCard ? `<div style="max-width:520px;margin-bottom:14px;">${promoCard}</div>` : ''}
          ${moversCard ? `<div style="max-width:520px;margin-bottom:14px;">${moversCard}</div>` : ''}
          <div class="no-print">${discoverHtml(app)}</div>
          ${table}
          <div class="no-print" style="margin-top:14px;">${asoSummaryHtml(app)}</div>`;

        const sectionCoverage = `
          <div class="section-head"><h2>All Keywords</h2>
            <div class="row no-print"><button class="ghost" data-act="check-coverage">Check all keyword rankings</button></div>
          </div>
          ${(app.coverageKeywords || []).length
            ? coverageHtml(app)
            : '<p class="hint">No coverage list yet — paste your full keyword universe (up to ' + MAX_COVERAGE + ') under <b>Settings</b> to monitor every keyword you care about beyond the plan-capped daily list.</p>'}`;

        const compPulseCard = competitorPulseHtml(app);
        const sectionCompare = `
          <div class="section-head"><h2>Compare</h2><p class="hint">Your keywords, your rank vs your competitors' — side by side.</p></div>
          ${compPulseCard ? `<div style="max-width:520px;margin-bottom:14px;">${compPulseCard}</div>` : ''}
          ${compareHtml(app)}`;

        const ratingCard = ratingPulseHtml(app);
        const sectionTrends = `
          <div class="section-head"><h2>Trends</h2><p class="hint">Longer-horizon signals: category chart position, rating health, and your logged experiments.</p></div>
          ${ratingCard ? `<div style="max-width:520px;margin-bottom:14px;">${ratingCard}</div>` : ''}
          ${trendChartsHtml(app)}
          ${reviewThemesHtml(app)}
          <div class="annedit open no-print" data-role="annedit" style="margin-top:16px;">
            <h4 style="margin:0 0 6px;font-size:13.5px;">Log an annotation</h4>
            <p class="hint" style="margin:0 0 8px;">An ASO experiment (title/screenshot/keyword change) or a paid marketing push — we'll compare average visibility in the 14 days before vs after.</p>
            <div class="row">
              <div><label>Date</label><input type="date" data-role="ann-date" value="${new Date().toISOString().slice(0, 10)}" max="${new Date().toISOString().slice(0, 10)}" /></div>
              <div><label>Type</label><select data-role="ann-type"><option value="experiment">ASO experiment</option><option value="paid">Paid marketing push</option></select></div>
            </div>
            <label>What did you change / run?</label>
            <textarea data-role="ann-label" placeholder="e.g. Rewrote title to include &quot;photo editor&quot;, or Started a ₹50k UAC campaign" rows="2"></textarea>
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-annotation">Save annotation</button>
            </div>
          </div>
          ${annotationsHtml(app)}`;

        const sectionSettings = `
          <div class="section-head"><h2>Settings</h2><p class="hint">Everything you can edit for this app lives here.</p></div>
          <div class="settings-block no-print">
            <h4>Daily-tracked keywords</h4>
            <p class="hint" style="margin:0 0 8px;">One keyword per line (or comma-separated). Pasting straight from a spreadsheet with search volume in the next column works too — "keyword&nbsp;&nbsp;&nbsp;1234" or "keyword, 1234" per line. Saving re-checks this app's rankings right away. <b>This list is checked daily and capped by your plan</b> — bigger lists go in the All keywords list below.</p>
            <textarea data-role="kwtext">${esc((app.keywords || []).join('\n'))}</textarea>
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-kw">Save keywords &amp; check ranks</button>
            </div>
          </div>
          <div class="settings-block no-print">
            <h4>All keywords list <span class="hint" style="display:inline;">— your full keyword universe, up to ${MAX_COVERAGE}</span></h4>
            <p class="hint" style="margin:0 0 8px;">Separate from the daily list above and not capped by your plan. Checked automatically by the nightly check; "Check all keyword rankings" on the All Keywords Snapshot section runs it on demand.</p>
            <textarea data-role="covtext" placeholder="One keyword per line or comma-separated — up to ${MAX_COVERAGE}">${esc((app.coverageKeywords || []).join('\n'))}</textarea>
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-coverage">Save coverage list</button>
            </div>
          </div>
          <div class="settings-block no-print">
            <h4>Daily email report</h4>
            <p class="hint" style="margin:0 0 8px;">Comma-separated email addresses — everyone on this list gets a daily rank report for this app, right after each automatic check. Leave blank to turn it off.</p>
            <input type="text" data-role="report-emails" placeholder="you@company.com, teammate@company.com" value="${escAttr(app.reportEmails || '')}" style="width:100%;" />
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-report-emails">Save recipients</button>
            </div>
          </div>
          <div class="settings-block no-print">
            <h4>Rank-drop alerts</h4>
            <p class="hint" style="margin:0 0 8px;">Get an email the moment a daily-tracked keyword falls out of your chosen range — checked as part of every nightly run. Goes to the same recipients as the daily report above, so set that list first.</p>
            <select data-role="alert-select">
              <option value="" ${!app.alertTopN ? 'selected' : ''}>Off</option>
              <option value="10" ${app.alertTopN === 10 ? 'selected' : ''}>Alert when a keyword drops out of the top 10</option>
              <option value="30" ${app.alertTopN === 30 ? 'selected' : ''}>Alert when a keyword drops out of the top 30</option>
              <option value="100" ${app.alertTopN === 100 ? 'selected' : ''}>Alert when a keyword drops out of the top 100</option>
            </select>
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-alert">Save alert setting</button>
            </div>
          </div>
          <div class="settings-block no-print">
            <h4>Keyword volumes</h4>
            <p class="hint" style="margin:0 0 8px;">If you already have search volume data (e.g. from AppRadar or your own research), paste it in alongside your keywords and we'll use it as-is. This button estimates the <b>missing</b> ones for you on a 0–100 popularity scale. Click again if some keywords are still blank after the first pass.</p>
            <button class="ghost" data-act="estimate-volumes">Estimate missing volumes</button>
          </div>
          <div class="settings-block no-print">
            <h4>Daily check window <span class="hint" style="display:inline;">— IST</span></h4>
            <p class="hint" style="margin:0 0 8px;">Stagger your apps into separate slots so they don't all hit the stores at once — simultaneous bursts are the main cause of rate-limited checks that come back as "failed" or unchecked keywords. Weekends ignore this and use the whole day, so large keyword lists can catch up.</p>
            <select data-role="window-select">
              <option value="" ${!app.checkWindow ? 'selected' : ''}>Any time (no stagger)</option>
              ${WINDOW_CHOICES.map(([s, e]) => {
                const val = `${s}-${e}`;
                const sel = app.checkWindow && app.checkWindow.startHour === s && app.checkWindow.endHour === e;
                return `<option value="${val}" ${sel ? 'selected' : ''}>${hourLabel(s)} – ${hourLabel(e)}</option>`;
              }).join('')}
            </select>
            <label style="margin-top:10px;">Searches per hour for this app</label>
            <p class="hint" style="margin:0 0 6px;">Caps how many keywords are searched at the store each hour, so a big list is spread out instead of hammering it in one go. Cached results (a competitor sharing this app's keywords) don't count. Blank = no cap.</p>
            <input type="number" min="10" max="2000" step="10" data-role="hourly-cap" placeholder="no cap"
                   value="${app.hourlyRequestCap || ''}" style="max-width:150px;" />
            ${capPlanHint(app)}
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-window">Save check window</button>
            </div>
          </div>
          <div class="settings-block no-print">
            <h4>Competitors</h4>
            <p class="hint" style="margin:0 0 8px;">Rival apps tracked against this one — they show up in this app's Compare tab. Add one by pasting its Google Play / App Store URL or id; remove one to stop tracking it entirely.</p>
            ${(() => {
              const comps = state.apps.filter((a) => a.competitorOf === app.key);
              if (!comps.length) return '<p class="hint" style="margin:0 0 8px;">No competitors tracked yet.</p>';
              return `<div class="complist">${comps.map((c) => `
                <div class="complist-row" data-key="${escAttr(c.key)}">
                  <span>${esc(c.title)} <span class="hint">(${c.store === 'play' ? 'Google Play' : 'App Store'} · ${esc(c.country.toUpperCase())})</span></span>
                  <button class="ghost danger small" data-act="remove-competitor" data-key="${escAttr(c.key)}">Remove</button>
                </div>`).join('')}</div>`;
            })()}
            <div style="display:grid;grid-template-columns:2.2fr 110px;gap:10px;margin-top:10px;">
              <input type="text" data-role="add-competitor-input" placeholder="Play/App Store URL, package id, or id123456789" />
              <input type="text" data-role="add-competitor-country" placeholder="Country (${esc(app.country)})" maxlength="2" />
            </div>
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="add-competitor">Add competitor</button>
            </div>
          </div>
          <div class="settings-block no-print">
            <h4>Competitor relationship</h4>
            <p class="hint" style="margin:0 0 8px;">If this app is a rival you're tracking rather than your own, pick which of your apps it's a competitor for — that's what scopes it into that app's Compare tab instead of showing up everywhere.</p>
            <select data-role="competitor-of-select">
              <option value="">— none, this is my own app —</option>
              ${state.apps.filter((a) =>
                // Only YOUR OWN top-level apps are valid targets — offering
                // other competitors here is how chains (A→B→C) and loops
                // (A→B→A) got created, which used to make apps vanish from
                // the sidebar. Excluded: this app itself and anything that
                // is already someone's competitor. isPrimaryLike (not a bare
                // !a.competitorOf check) also accepts an app whose
                // competitorOf points at a since-removed app — otherwise a
                // stale link like that makes an app permanently impossible
                // to pick as a target anywhere, even though the sidebar
                // already renders it as a normal top-level app. The current
                // saved target always stays listed too (even if the data is
                // in a broken state), so the select shows what's saved,
                // never a blank.
                a.key !== app.key && (a.key === app.competitorOf || isPrimaryLike(a))
              ).map((a) =>
                `<option value="${escAttr(a.key)}" ${app.competitorOf === a.key ? 'selected' : ''}>${esc(a.title)} (${a.store === 'play' ? 'Google Play' : 'App Store'} · ${esc(a.country.toUpperCase())})</option>`).join('')}
            </select>
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-competitor-of">Save</button>
            </div>
          </div>
          <div class="dangerzone no-print">
            <h4>Danger zone</h4>
            <p class="hint" style="margin:0 0 8px;">Stops tracking this app. Its saved history stays on disk but will no longer be shown.</p>
            <button class="ghost danger" data-act="remove">Remove this app</button>
          </div>`;

        const bySection = {
          overview: sectionOverview, insights: sectionInsights, snapshot: sectionSnapshot, keywords: sectionKeywords, coverage: sectionCoverage,
          compare: sectionCompare, trends: sectionTrends, settings: sectionSettings,
        };
        const body = printAll
          ? [sectionOverview, sectionKeywords, sectionCoverage, sectionCompare, sectionTrends].join('<hr style="border:none;border-top:1px solid #ddd;margin:20px 0;">')
          : bySection[currentSection] || sectionOverview;

        return `
        <div class="card appcard" data-key="${escAttr(app.key)}">
          <div class="print-only">${esc(BRAND_NAME)} — Rank Report · generated ${new Date().toLocaleDateString()}</div>
          ${apphead}
          ${body}
        </div>`;
      }

      function tabIcon(app) {
        return app.icon
          ? `<img src="${escAttr(app.icon)}" alt="" />`
          : `<div class="fi">${app.store === 'play' ? '🤖' : '📱'}</div>`;
      }

      function sectionCount(app, id) {
        if (id === 'keywords') return (app.keywords || []).length || '';
        if (id === 'coverage') return (app.coverageKeywords || []).length || '';
        if (id === 'compare') return comparableApps(app).length || '';
        return '';
      }

      // Apps added via "this app is a competitor for X" carry competitorOf —
      // nested directly under that specific primary app in the sidebar
      // (indented), not lumped into one flat "Competitors" list across
      // every app in the account. With more than one primary app tracked
      // (e.g. managing several clients from one account), a flat list mixed
      // every client's competitors together with no indication of whose
      // they were — the whole point of the link is which app each
      // competitor belongs to. Clicking a nested entry jumps straight to
      // ITS primary app's Compare tab (pre-ticked) rather than opening its
      // own Overview — that's the view competitor tracking is actually for
      // — while its own Keywords/Coverage/Settings tabs stay one click away
      // under it if it needs managing directly.
      function sideAppBtn(app, isSub) {
        // The jump-to-Compare shortcut only applies to properly NESTED
        // entries (isSub). An app with a broken link (loop/chain) renders
        // top-level, and its click must open the app itself — otherwise
        // there's no way to reach its own Settings and fix the bad link:
        // the shortcut would bounce you to the other app every time.
        return `<button class="side-app ${isSub ? 'sub' : ''} ${app.key === selectedAppKey ? 'selected' : ''}" data-key="${escAttr(app.key)}" ${isSub && app.competitorOf ? `data-competitor-of="${escAttr(app.competitorOf)}"` : ''}>
            ${tabIcon(app)}
            <span class="tt">${esc(app.title)}</span>
            <span class="tick">${app.store === 'play' ? 'GP' : 'AS'}</span>
          </button>`;
      }

      function renderSidebar() {
        const sb = $('sidebar');
        if (!state.apps.length) { sb.style.display = 'none'; return; }
        sb.style.display = 'block';
        const byKey = new Map(state.apps.map((a) => [a.key, a]));
        // The sidebar draws exactly one level of nesting, so an app is only
        // ever indented under a target that is itself top-level. Every other
        // shape renders at the top level rather than being skipped:
        //  - competitorOf pointing at a deleted app (orphan)
        //  - competitorOf pointing at an app that is itself a competitor
        //    (chain: A→B→C), and two apps pointing at each other (loop:
        //    A→B→A — trivially creatable from the Settings dropdown).
        // An earlier version filtered "primaries = apps with no valid link"
        // and only drew children of primaries — a chain or loop made BOTH
        // sides fail that filter and entire apps silently vanished from the
        // sidebar (nothing deleted, just never drawn). Never drop an app.
        const isNested = (a) => {
          const target = a.competitorOf ? byKey.get(a.competitorOf) : null;
          return !!(target && !(target.competitorOf && byKey.has(target.competitorOf)));
        };
        const primaries = state.apps.filter((a) => !isNested(a));
        const byPrimary = {};
        for (const a of state.apps) {
          if (isNested(a)) (byPrimary[a.competitorOf] = byPrimary[a.competitorOf] || []).push(a);
        }
        $('side-apps').innerHTML = primaries.map((app) =>
          sideAppBtn(app, false) + (byPrimary[app.key] || []).map((c) => sideAppBtn(c, true)).join('')).join('');
        const app = state.apps.find((a) => a.key === selectedAppKey);
        // Settings is entirely owner-only controls — for a read-only guest
        // the whole tab would render empty once applyReadOnly() strips it.
        const sections = state.readOnly ? SECTIONS.filter((s) => s.id !== 'settings') : SECTIONS;
        if (state.readOnly && currentSection === 'settings') currentSection = 'overview';
        $('snav').innerHTML = sections.map((s) => {
          const cnt = app ? sectionCount(app, s.id) : '';
          return `<button class="${s.id === currentSection ? 'active' : ''}" data-section="${s.id}">${s.label}${cnt !== '' ? `<span class="cnt">${cnt}</span>` : ''}</button>`;
        }).join('');
      }

      function renderLikeAppOptions() {
        const sel = $('add-likeapp');
        const prev = sel.value;
        // Same rule as the Settings picker: a new competitor can only be
        // linked to one of YOUR top-level apps, never to another competitor
        // — that's what creates the chains/loops that broke the sidebar.
        const primaries = state.apps.filter(isPrimaryLike);
        sel.innerHTML = '<option value="">— none, this is my own app —</option>' + primaries.map((a) =>
          `<option value="${escAttr(a.key)}">${esc(a.title)} (${a.store === 'play' ? 'Google Play' : 'App Store'} · ${esc(a.country.toUpperCase())})</option>`).join('');
        if (primaries.some((a) => a.key === prev)) sel.value = prev;
      }

      // A read-only guest (an app shared with them by the account owner —
      // see lib/saas/grants.ts) can look at everything and change nothing.
      // The server rejects every write from them regardless; this only stops
      // the UI offering buttons that would come back 403. Rather than an
      // allowlist of "safe" controls sprinkled through the render functions,
      // sweep the DOM after each render and drop anything that acts —
      // a new mutating button added later is then read-only by default.
      const READONLY_SAFE_ACTS = new Set(['pdf', 'pdf-snapshot', 'close-addapp-modal', 'close-kwmodal', 'dismiss-discover']);
      function applyReadOnly() {
        if (!state.readOnly) return;
        document.querySelectorAll('[data-act]').forEach((el) => {
          if (!READONLY_SAFE_ACTS.has(el.getAttribute('data-act'))) el.remove();
        });
        // Editable fields would silently discard whatever was typed.
        document.querySelectorAll('#apps input, #apps textarea, #apps select').forEach((el) => {
          if (!el.closest('[data-role="sortable"]')) el.setAttribute('disabled', 'disabled');
        });
      }

      function render() {
        const box = $('apps');
        if (!state.apps.length) {
          $('sidebar').style.display = 'none';
          box.innerHTML = state.readOnly
            ? '<div class="card"><div class="empty">No apps have been shared with you yet.</div></div>'
            : '<div class="card"><div class="empty">No apps tracked yet.<div style="margin-top:10px;"><button class="primary" id="empty-add-app">＋ Track your first app</button></div></div></div>';
        } else {
          if (!selectedAppKey || !state.apps.some((a) => a.key === selectedAppKey)) selectedAppKey = state.apps[0].key;
          renderSidebar();
          const current = state.apps.find((a) => a.key === selectedAppKey);
          box.innerHTML = renderApp(current);
        }
        renderLikeAppOptions();
        const days = state.snapshotDays || [];
        $('lastcheck').textContent = state.lastCheckedAt
          ? `Last checked ${new Date(state.lastCheckedAt).toLocaleString()} · ${days.length} day${days.length === 1 ? '' : 's'} of history`
          : state.readOnly
            ? 'No checks recorded yet.'
            : 'Never checked — add apps and hit "Check all rankings now".';

        // Only accounts that have BOTH their own apps and apps shared with
        // them ever see this — for everyone else there's nothing to switch.
        const wsSwitch = $('ws-switch');
        if (state.canSwitch) {
          wsSwitch.style.display = '';
          wsSwitch.value = state.wsMode || 'own';
        } else {
          wsSwitch.style.display = 'none';
        }

        if (state.readOnly) {
          const banner = $('ro-banner');
          banner.textContent = state.sharedByEmail
            ? `Read-only view shared with you by ${state.sharedByEmail}. Rankings update automatically every day.`
            : 'Read-only view. Rankings update automatically every day.';
          banner.style.display = 'block';
          $('checkall-btn').style.display = 'none';
          const addBtn = $('toggle-add-app');
          if (addBtn) addBtn.style.display = 'none';
          applyReadOnly();
        }
      }

      async function api(body) {
        const res = await fetch('/api/rank', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Request failed.');
        return data;
      }

      async function refresh() {
        const res = await fetch('/api/rank');
        state = await res.json();
        render();
        // ASO results are cached server-side (see api/aso.ts) — load whatever
        // was last checked instead of calling /api/aso again. That call is a
        // paid Anthropic request, so viewing/reloading the dashboard must
        // never silently re-trigger it.
        for (const app of state.apps) loadAsoFromCache(app);
        render();
      }

      async function withBusy(btn, busyLabel, fn) {
        showErr('');
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>' + busyLabel;
        try {
          const data = await fn();
          if (data) { state = data; render(); if (data.note) showInfo(data.note); }
        } catch (e) {
          showErr(e && e.message ? e.message : String(e));
        } finally {
          btn.disabled = false;
          btn.innerHTML = orig;
        }
      }

      $('add-likeapp').addEventListener('change', () => {
        const key = $('add-likeapp').value;
        const hint = $('add-likeapp-hint');
        const kwBox = $('add-keywords');
        if (!key) {
          hint.style.display = 'none';
          kwBox.placeholder = 'Keywords to track — one per line or comma-separated, e.g.\nphoto editor\ncollage maker\nai photo enhancer';
          return;
        }
        const ref = state.apps.find((a) => a.key === key);
        if (ref) {
          if (!$('add-country').value.trim()) $('add-country').value = ref.country;
          if (!$('add-lang').value.trim()) $('add-lang').value = ref.lang;
        }
        hint.style.display = 'block';
        hint.textContent = `Leave keywords blank to auto-track the same keyword list as "${ref ? ref.title : 'that app'}" — we'll also look for this rival's own keywords in the background and add anything new we find.`;
        kwBox.placeholder = 'Leave blank to inherit keywords automatically, or paste your own to override.';
      });

      $('add-btn').addEventListener('click', () =>
        withBusy($('add-btn'), 'Adding…', async () => {
          const app = $('add-app').value.trim();
          if (!app) { showErr('Paste an app URL or id first.'); return null; }
          const data = await api({
            action: 'add-app', app,
            country: $('add-country').value.trim(),
            lang: $('add-lang').value.trim(),
            keywords: $('add-keywords').value,
            likeApp: $('add-likeapp').value,
          });
          const notes = [];
          if (data.metaError) notes.push('App added, but its listing could not be read right now: ' + data.metaError);
          if (data.keywordsTruncated) notes.push(truncationMsg(data.keywordsTruncated));
          if (!data.metaError && data.checkError) notes.push(data.checkError);
          if (data.discoveryQueued) notes.push('Also looking for more of this rival’s own keywords in the background — check the All Keywords Snapshot tab in a minute.');
          if (notes.length) showInfo(notes.join(' '));
          $('add-app').value = ''; $('add-keywords').value = ''; $('add-likeapp').value = '';
          $('add-likeapp-hint').style.display = 'none';
          closeAddAppModal();
          showToast('App added');
          if (data.apps && data.apps.length) {
            const newApp = data.apps[data.apps.length - 1];
            selectedAppKey = newApp.key;
            checkAsoFor(newApp);
          }
          return data;
        }));

      $('checkall-btn').addEventListener('click', () =>
        withBusy($('checkall-btn'), 'Checking rankings… this can take a minute', () => api({ action: 'check' })));

      $('sidebar').addEventListener('click', (ev) => {
        const appBtn = ev.target.closest('.side-app');
        if (appBtn) {
          const compOf = appBtn.getAttribute('data-competitor-of');
          const key = appBtn.getAttribute('data-key');
          // First click on a nested competitor jumps to its primary's
          // Compare tab, pre-ticked — that's the view competitor tracking
          // exists for. Clicking it AGAIN (already on that Compare view)
          // opens the competitor's own dashboard, so its Keywords/Settings
          // are reachable too — without this second-click path there was
          // literally no way to open a nested app's Settings and manage
          // (or unlink) it.
          const alreadyThere = compOf && selectedAppKey === compOf && currentSection === 'compare';
          if (compOf && !alreadyThere && state.apps.some((a) => a.key === compOf)) {
            selectedAppKey = compOf;
            currentSection = 'compare';
            const sel = compareState[compOf] || [];
            if (!sel.includes(key)) compareState[compOf] = [...sel, key].slice(-3);
          } else {
            selectedAppKey = key;
            if (currentSection === 'compare') currentSection = 'overview';
          }
          render();
          return;
        }
      });
      // The Sections bar (#snav) moved out of the sidebar into its own top
      // tab strip above the app content — it's a sibling of #sidebar and
      // #apps now, not a descendant of either, so it needs its own listener
      // rather than relying on the sidebar's (which is how the tabs went
      // dead after that move: the click handler was still bound to
      // #sidebar, which no longer contains these buttons at all).
      $('snav').addEventListener('click', (ev) => {
        const secBtn = ev.target.closest('[data-section]');
        if (secBtn) { currentSection = secBtn.getAttribute('data-section'); render(); }
      });
      // "Track an app" used to be an inline card at the top of the page —
      // permanently taking space above the toolbar and pushing the app
      // you're actually looking at further down, even when you weren't
      // adding anything. A modal only takes space when it's actually open.
      function openAddAppModal() { $('addapp-modal-backdrop').classList.add('open'); renderLikeAppOptions(); $('add-app').focus(); }
      function closeAddAppModal() { $('addapp-modal-backdrop').classList.remove('open'); }
      $('toggle-add-app').addEventListener('click', openAddAppModal);
      const addAppBackdrop = $('addapp-modal-backdrop');
      addAppBackdrop.addEventListener('click', (ev) => {
        if (ev.target === addAppBackdrop || ev.target.closest('[data-act="close-addapp-modal"]')) closeAddAppModal();
      });
      document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeAddAppModal(); });

      $('apps').addEventListener('click', (ev) => {
        if (ev.target.closest('#empty-add-app')) { openAddAppModal(); return; }
        const gotoCompare = ev.target.closest('[data-goto-compare]');
        if (gotoCompare) {
          const compKey = gotoCompare.getAttribute('data-goto-compare');
          currentSection = 'compare';
          const sel = compareState[selectedAppKey] || [];
          if (!sel.includes(compKey)) compareState[selectedAppKey] = [...sel, compKey].slice(-3);
          render();
          return;
        }
        const gotoSection = ev.target.closest('[data-goto-section]');
        if (gotoSection) { currentSection = gotoSection.getAttribute('data-goto-section'); render(); return; }
        // Stash the already-computed ASO result before the deep link opens
        // /aso (in a new, noopener tab — so sessionStorage isn't shared;
        // localStorage is, since it's scoped to the origin, not the opener
        // relationship), so that page can reuse it instead of re-running
        // the (paid) Anthropic audit for data we just checked seconds ago here.
        const asoLink = ev.target.closest('a[data-aso-key]');
        if (asoLink) {
          const k = asoLink.getAttribute('data-aso-key');
          const cached = ASO_CACHE[k];
          if (cached && cached.status === 'done') {
            try { localStorage.setItem('aso-cache:' + k, JSON.stringify({ data: cached.data, checkedAt: cached.checkedAt })); } catch { /* best-effort */ }
          }
          return;
        }
        const kwLink = ev.target.closest('.kwlink');
        if (kwLink) {
          const card = kwLink.closest('.appcard');
          openKeywordHistory(card.getAttribute('data-key'), kwLink.getAttribute('data-list'), kwLink.getAttribute('data-kwhistory'));
          return;
        }
        const catTab = ev.target.closest('.cattab');
        if (catTab) {
          const card = catTab.closest('.appcard');
          catTabState[card.getAttribute('data-key')] = catTab.getAttribute('data-cattab');
          render();
          return;
        }
        const sortTh = ev.target.closest('th.sortable');
        if (sortTh) {
          const card = sortTh.closest('.appcard');
          const key = card.getAttribute('data-key');
          const col = sortTh.getAttribute('data-sort');
          const store = sortTh.closest('.comparetable') ? compareSortState
            : sortTh.closest('.covtable') ? covSortState
            : sortTh.closest('.snaptable') ? snapSortState
            : sortState;
          const cur = store[key] || (store === covSortState ? { col: 'volume', dir: -1 } : {});
          store[key] = { col, dir: cur.col === col ? -cur.dir : 1 };
          render();
          return;
        }
        const btn = ev.target.closest('button[data-act]');
        if (!btn) return;
        const card = btn.closest('.appcard');
        const key = card.getAttribute('data-key');
        const act = btn.getAttribute('data-act');
        if (act === 'save-kw') {
          withBusy(btn, 'Saving & checking ranks…', async () => {
            const data = await api({ action: 'set-keywords', key, keywords: card.querySelector('[data-role="kwtext"]').value });
            const notes = [];
            if (data.keywordsTruncated) notes.push(truncationMsg(data.keywordsTruncated));
            if (data.checkError) notes.push(data.checkError);
            if (notes.length) showInfo(notes.join(' ')); else showToast('Keywords saved — fresh ranks below');
            const saved = data.apps.find((a) => a.key === key);
            if (saved) checkAsoFor(saved);
            return data;
          });
          return;
        }
        if (act === 'save-coverage') {
          withBusy(btn, 'Saving…', async () => {
            const data = await api({ action: 'set-coverage-keywords', key, keywords: card.querySelector('[data-role="covtext"]').value });
            showToast('Coverage list saved — click "Check all keyword rankings" to run the first check, or wait for the nightly automatic check');
            return data;
          });
          return;
        }
        if (act === 'check-coverage') {
          // Runs in safely-sized, time-bounded batches server-side (see
          // checkCoverageBatch) — this loop just keeps asking for the next
          // batch until the whole list is done, so a list in the hundreds
          // actually finishes instead of one giant request timing out.
          withBusy(btn, 'Checking coverage…', async () => {
            let data = await api({ action: 'check-coverage', key });
            let p = data.coverageProgress;
            let rounds = 0;
            while (p && !p.done && p.checkedNow > 0 && rounds < 100) {
              showToast(`Checked ${p.totalDone}/${p.total} keywords — continuing…`);
              data = await api({ action: 'check-coverage', key });
              p = data.coverageProgress;
              rounds++;
            }
            if (p) showToast(p.done ? `Coverage check complete — ${p.total} keywords` : `Checked ${p.totalDone}/${p.total} so far — click "Check all keyword rankings" again to continue`);
            else if (data.note) showInfo(data.note);
            return data;
          });
          return;
        }
        if (act === 'save-report-emails') {
          withBusy(btn, 'Saving…', async () => {
            const reportEmails = card.querySelector('[data-role="report-emails"]').value.trim();
            const data = await api({ action: 'set-report-emails', key, reportEmails });
            showToast(reportEmails ? 'Report recipients saved' : 'Report emails turned off for this app');
            return data;
          });
          return;
        }
        if (act === 'save-alert') {
          withBusy(btn, 'Saving…', async () => {
            const alertTopN = card.querySelector('[data-role="alert-select"]').value;
            const data = await api({ action: 'set-alert', key, alertTopN });
            showToast(alertTopN ? `Alerts on — you'll be emailed if a keyword drops out of the top ${alertTopN}` : 'Rank-drop alerts turned off');
            return data;
          });
          return;
        }
        if (act === 'review-themes') {
          withBusy(btn, 'Reading recent reviews… ~30s', async () => {
            const data = await api({ action: 'review-themes', key });
            showToast('Review analysis done');
            return data;
          });
          return;
        }
        if (act === 'save-window') {
          withBusy(btn, 'Saving…', async () => {
            const val = card.querySelector('[data-role="window-select"]').value;
            const cap = card.querySelector('[data-role="hourly-cap"]').value.trim();
            const data = await api({ action: 'set-check-window', key, window: val, hourlyCap: cap });
            showToast(val ? 'Check window saved' : 'Stagger removed — checks any time');
            return data;
          });
          return;
        }
        if (act === 'save-competitor-of') {
          withBusy(btn, 'Saving…', async () => {
            const competitorOf = card.querySelector('[data-role="competitor-of-select"]').value;
            const data = await api({ action: 'set-competitor-of', key, competitorOf });
            showToast(competitorOf ? 'Linked as a competitor' : 'Unlinked — now shown as your own app');
            return data;
          });
          return;
        }
        if (act === 'add-competitor') {
          const input = card.querySelector('[data-role="add-competitor-input"]');
          const countryInput = card.querySelector('[data-role="add-competitor-country"]');
          const value = input.value.trim();
          if (!value) { showErr('Paste an app URL or id first.'); return; }
          withBusy(btn, 'Adding…', async () => {
            const data = await api({
              action: 'add-app', app: value,
              country: countryInput.value.trim(),
              likeApp: key,
            });
            const notes = [];
            if (data.metaError) notes.push('App added, but its listing could not be read right now: ' + data.metaError);
            if (!data.metaError && data.checkError) notes.push(data.checkError);
            if (data.discoveryQueued) notes.push('Also looking for more of this rival’s own keywords in the background — check the All Keywords Snapshot tab in a minute.');
            if (notes.length) showInfo(notes.join(' '));
            else showToast('Competitor added');
            input.value = ''; countryInput.value = '';
            return data;
          });
          return;
        }
        if (act === 'remove-competitor') {
          const compKey = btn.getAttribute('data-key');
          const comp = state.apps.find((a) => a.key === compKey);
          if (!confirm(`Stop tracking "${comp ? comp.title : 'this competitor'}"? Its saved history stays on disk but will no longer be shown.`)) return;
          withBusy(btn, 'Removing…', () => api({ action: 'remove-app', key: compKey }));
          return;
        }
        if (act === 'save-annotation') {
          withBusy(btn, 'Saving…', async () => {
            const date = card.querySelector('[data-role="ann-date"]').value;
            const type = card.querySelector('[data-role="ann-type"]').value;
            const label = card.querySelector('[data-role="ann-label"]').value.trim();
            if (!date || !label) { showErr('Add a date and describe what you changed.'); return null; }
            const data = await api({ action: 'add-annotation', key, date, type, label });
            showToast('Annotation saved');
            return data;
          });
          return;
        }
        if (act === 'remove-annotation') {
          const id = btn.getAttribute('data-id');
          if (!confirm('Remove this annotation?')) return;
          withBusy(btn, '…', () => api({ action: 'remove-annotation', key, id }));
          return;
        }
        if (act === 'sync-comp') {
          const compKey = btn.getAttribute('data-comp');
          const me = state.apps.find((a) => a.key === key);
          const comp = state.apps.find((a) => a.key === compKey);
          if (!me || !comp) return;
          const kws = (me.keywords || []).length ? me.keywords : (me.coverageKeywords || []).slice(0, 60);
          const merged = [...new Set([...(comp.coverageKeywords || []), ...kws])];
          withBusy(btn, 'Adding…', async () => {
            const data = await api({ action: 'set-coverage-keywords', key: compKey, keywords: merged.join('\n') });
            showToast(`Keywords added to ${comp.title}'s coverage list — ranks appear after its next check (nightly, or "Check all keyword rankings" on that app).`);
            return data;
          });
          return;
        }
        if (act === 'estimate-volumes') {
          withBusy(btn, 'Estimating… up to ~1 min', () => api({ action: 'estimate-volumes', key }));
          return;
        }
        if (act === 'check-one') {
          // Rank check only re-checks keyword positions — the listing itself
          // hasn't changed, so this must NOT trigger a fresh (paid) ASO audit.
          withBusy(btn, 'Checking…', () => api({ action: 'check', key }));
          return;
        }
        if (act === 'recheck-aso') {
          const app = state.apps.find((a) => a.key === key);
          if (app) withBusy(btn, 'Checking…', async () => { await checkAsoFor(app); return null; });
          return;
        }
        if (act === 'pdf') {
          // Print every section stacked, not just the one currently open.
          printAll = true; render();
          setTimeout(() => { window.print(); printAll = false; render(); }, 60);
          return;
        }
        if (act === 'pdf-snapshot') {
          // currentSection is already 'snapshot' here (the button only exists
          // on that tab), so no printAll toggle is needed — just this card
          // prints. The print-snapshot-only class (see @media print CSS)
          // hides the marketing header and lets the card's break-inside
          // rule relax, so a long keyword list starts filling page 1
          // immediately instead of leaving it almost entirely blank while
          // the whole (page-height-exceeding) card gets pushed to page 2.
          document.body.classList.add('print-snapshot-only');
          window.print();
          document.body.classList.remove('print-snapshot-only');
          return;
        }
        if (act === 'discover') {
          withBusy(btn, 'Scanning stores… 1–2 min', async () => {
            const data = await api({ action: 'discover', key });
            DISCOVER[key] = data;
            render();
            return null;
          });
          return;
        }
        if (act === 'dismiss-discover') { delete DISCOVER[key]; render(); return; }
        if (act === 'promote-kw') {
          const selected = [...card.querySelectorAll('[data-role="promo-kw"]:checked')].map((el) => el.value);
          if (!selected.length) { showErr('Tick at least one keyword to track daily.'); return; }
          const beforeCount = (state.apps.find((a) => a.key === key) || {}).keywords?.length || 0;
          withBusy(btn, 'Adding to daily…', async () => {
            const data = await api({ action: 'add-keywords', key, keywords: selected.join('\n') });
            const afterCount = (data.apps.find((a) => a.key === key) || {}).keywords?.length || 0;
            const added = afterCount - beforeCount;
            if (added < selected.length) {
              showInfo(`Added ${added} of ${selected.length} — your plan's daily keyword limit is reached. Remove a low-value daily keyword to make room, or upgrade.`);
            } else {
              showInfo(`${added} keyword${added === 1 ? '' : 's'} now tracked daily — they'll get a position, movement and drop alerts from the next check.`);
            }
            return data;
          });
          return;
        }

        if (act === 'track-selected') {
          const selected = [...card.querySelectorAll('[data-role="disc-kw"]:checked')].map((el) => el.value);
          if (!selected.length) { showErr('Tick at least one keyword to track.'); return; }
          const beforeCount = (state.apps.find((a) => a.key === key) || {}).keywords?.length || 0;
          withBusy(btn, 'Adding & checking ranks…', async () => {
            const data = await api({ action: 'add-keywords', key, keywords: selected.join('\n') });
            delete DISCOVER[key];
            const afterCount = (data.apps.find((a) => a.key === key) || {}).keywords?.length || 0;
            const actuallyAdded = afterCount - beforeCount;
            if (data.checkError) showInfo(data.checkError);
            else if (actuallyAdded < selected.length) showInfo(`Added ${actuallyAdded} of ${selected.length} selected — your plan's keyword-per-app limit is reached. Remove some tracked keywords or upgrade to add the rest.`);
            else showToast(selected.length + ' keyword(s) now tracked');
            const tracked = data.apps.find((a) => a.key === key);
            if (tracked) checkAsoFor(tracked);
            return data;
          });
          return;
        }
        if (act === 'remove') {
          if (!confirm('Stop tracking this app? Its saved history stays on disk but will no longer be shown.')) return;
          withBusy(btn, 'Removing…', () => api({ action: 'remove-app', key }));
        }
      });

      // Compare-section competitor checkboxes (change, not click — checkboxes).
      $('apps').addEventListener('change', (ev) => {
        const toggle = ev.target.closest && ev.target.closest('[data-comp-toggle]');
        if (!toggle) return;
        const card = toggle.closest('.appcard');
        const key = card.getAttribute('data-key');
        const compKey = toggle.getAttribute('data-comp-toggle');
        let sel = compareState[key] || [];
        if (toggle.checked) {
          if (sel.length >= 3) { toggle.checked = false; showToast('Max 3 competitors at a time — untick one first.'); return; }
          sel = [...sel, compKey];
        } else {
          sel = sel.filter((k) => k !== compKey);
        }
        compareState[key] = sel;
        render();
      });

      // CSV export: one row per app × keyword with today's rank + delta + best.
      // The workspace is carried in a cookie so a plain page load lands in
      // the same one (see middleware) — reload rather than re-fetch, so the
      // server-rendered parts of the page agree with the data too.
      $('ws-switch').addEventListener('change', (e) => {
        const mode = e.target.value;
        document.cookie = `ws_mode=${mode}; path=/; max-age=${60 * 60 * 24 * 365}; samesite=lax`;
        location.reload();
      });

      $('csv-btn').addEventListener('click', () => {
        const rows = [['App', 'Store', 'Country', 'Keyword', 'Rank', 'Δ vs last check', 'Best', '#1 for keyword']];
        for (const app of state.apps) {
          for (const t of app.trends || []) {
            rows.push([
              app.title, app.store === 'play' ? 'Google Play' : 'App Store', (app.country || '').toUpperCase(),
              t.keyword, t.position != null ? t.position : '', t.delta != null ? t.delta : '',
              t.best != null ? t.best : '', (t.top && t.top[0] && t.top[0].title) || '',
            ]);
          }
        }
        if (rows.length === 1) { showToast('Nothing to export yet'); return; }
        const cell = (v) => { const s = String(v == null ? '' : v); return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
        const blob = new Blob(['﻿' + rows.map((r) => r.map(cell).join(',')).join('\r\n')], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `app-rankings-${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(a.href);
        showToast('CSV downloaded');
      });

      const logoutBtn = document.getElementById('logout');
      if (logoutBtn) logoutBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        await fetch('/api/auth/logout', { method: 'POST' });
        location.href = '/';
      });

      const userTrigger = document.getElementById('usertrigger');
      const userDropdown = document.getElementById('userdropdown');
      if (userTrigger && userDropdown) {
        userTrigger.addEventListener('click', (e) => { e.stopPropagation(); userDropdown.classList.toggle('open'); });
        document.addEventListener('click', (e) => { if (!userDropdown.contains(e.target) && e.target !== userTrigger) userDropdown.classList.remove('open'); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') userDropdown.classList.remove('open'); });
      }

      const kwmodalBackdrop = $('kwmodal-backdrop');
      kwmodalBackdrop.addEventListener('click', (ev) => {
        if (ev.target === kwmodalBackdrop || ev.target.closest('[data-act="close-kwmodal"]')) closeKeywordHistory();
      });
      document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeKeywordHistory(); });

      refresh().catch((e) => showErr('Could not load tracker state: ' + (e && e.message ? e.message : e)));
    </script>
  </body>
</html>
