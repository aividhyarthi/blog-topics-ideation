      .asorating.bad { background: var(--bad-tint); color: var(--bad); }
      .asorating.mid { background: var(--warn-tint); color: var(--warn); }
      .ghost-link { display: inline-block; margin-top: 8px; font-size: 12.5px; font-weight: 700; color: var(--accent); text-decoration: none; }
      .ghost-link:hover { text-decoration: underline; }
      .lastcheck { font-size: 12.5px; color: var(--muted); }
      .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 4px 0 16px; }
      .empty { text-align: center; color: var(--muted); padding: 26px 10px; font-size: 14px; }
      .app-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
      .app-tab { display: flex; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px 6px 7px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--ink); transition: border-color 0.15s; max-width: 220px; }
      .app-tab:hover { border-color: var(--line2); }
      .app-tab.selected { border-color: var(--accent); background: var(--tint); color: var(--accent); }
      .app-tab img, .app-tab .fi { width: 20px; height: 20px; border-radius: 5px; flex-shrink: 0; }
      .app-tab .fi { display: grid; place-items: center; background: var(--card2); font-size: 11px; }
      .app-tab .tt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .app-tab .tick { font-size: 11px; color: var(--muted); font-weight: 700; flex-shrink: 0; }
      .kwtabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line); margin: 16px 0 14px; }
      .kwtab { background: none; border: none; border-bottom: 2px solid transparent; padding: 8px 4px; margin-right: 18px; font-size: 13.5px; font-weight: 600; color: var(--muted); cursor: pointer; font-family: inherit; }
      .kwtab:hover { color: var(--ink); }
      .kwtab.active { color: var(--ink); border-bottom-color: var(--accent); }
      .cattabs { border-bottom-style: dashed; margin: 0 0 12px; }
      .cattabs .cattab { font-size: 12.5px; padding: 6px 3px; margin-right: 14px; }
      /* --- app-shell layout (sidebar + one-section-at-a-time content) --- */
      .shell { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 18px; align-items: start; }
      .sidebar { position: sticky; top: 16px; max-height: calc(100vh - 32px); overflow-y: auto; }
      .side-card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px; margin-bottom: 12px; }
      .side-label { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); padding: 4px 8px 8px; }
      .side-app { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 7px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--ink); border: none; background: none; width: 100%; text-align: left; font-family: inherit; }
      .side-app:hover { background: var(--card2); }
      .side-app.selected { background: var(--accent); color: var(--accent-ink); }
      .side-app img, .side-app .fi { width: 22px; height: 22px; border-radius: 5px; flex-shrink: 0; }
      .side-app .fi { display: grid; place-items: center; background: var(--card2); font-size: 11px; }
      .side-app .tt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
      .side-app .tick { font-size: 10px; font-weight: 700; opacity: 0.7; flex-shrink: 0; }
      .side-app.sub { padding-left: 22px; font-size: 12px; font-weight: 500; color: var(--muted); }
      .side-app.sub img, .side-app.sub .fi { width: 18px; height: 18px; }
      .side-app.sub.selected { color: var(--accent-ink); }
      .side-add { display: block; width: 100%; margin-top: 6px; }
      .main-col { min-width: 0; }
      .toptabs { display: flex; gap: 4px; border-bottom: 2px solid var(--line); margin-bottom: 18px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .toptabs button { display: flex; align-items: center; gap: 7px; padding: 11px 15px; border: none; background: none; font-size: 13.5px; font-weight: 700; color: var(--muted); cursor: pointer; font-family: inherit; white-space: nowrap; border-bottom: 2px solid transparent; margin-bottom: -2px; transition: color 0.12s, border-color 0.12s; }
      .toptabs button:hover { color: var(--ink); }
      .toptabs button.active { color: var(--accent); border-bottom-color: var(--accent); }
      .toptabs .cnt { font-size: 10.5px; font-weight: 700; background: var(--card2); color: var(--muted); padding: 1px 6px; border-radius: 999px; }
      .toptabs button.active .cnt { background: var(--tint); color: var(--accent); }
      .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 2px 0 12px; }
      .section-head h2 { margin: 0; font-size: 17px; letter-spacing: -0.01em; }
      .section-head .hint { margin: 0; }
      .dangerzone { border: 1px solid rgba(242,84,91,0.35); border-radius: 10px; padding: 14px 16px; margin-top: 18px; }
      .dangerzone h4 { margin: 0 0 6px; font-size: 13px; color: var(--bad); }
      .settings-block { border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px; background: var(--card); }
      .settings-block h4 { margin: 0 0 4px; font-size: 13.5px; }
      .complist { border: 1px solid var(--line); border-radius: 8px; margin-bottom: 10px; overflow: hidden; }
      .complist-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px; font-size: 13px; }
      .complist-row + .complist-row { border-top: 1px solid var(--line); }
      @media (max-width: 900px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar { position: static; max-height: none; }
        .side-card .side-apps { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; }
        .side-card .side-app { width: auto; flex-shrink: 0; max-width: 180px; }
      }
      svg.spark { display: block; }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 24px; }
      .toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); background: var(--ink); color: var(--bg); padding: 10px 18px; border-radius: 8px; font-size: 13.5px; font-weight: 600; opacity: 0; transition: opacity 0.2s; pointer-events: none; z-index: 50; }
      .toast.show { opacity: 1; }
      .print-only { display: none; }
      @media print {
        .no-print, header nav.top, footer, .toast, .sidebar { display: none !important; }
        .shell { display: block; }
        header { background: none !important; padding: 0 0 14px; }
        header .aipill, header .by { display: none !important; }
        .card { box-shadow: none; border: 1px solid #ddd; break-inside: avoid; }
        .table-wrap { border: 1px solid #ddd; }
        .print-only { display: block; font-size: 12px; color: var(--muted); margin: -6px 0 14px; }
      }
      /* A Daily Snapshot card with a long (400-600+) keyword list is always
         taller than one printed page — break-inside: avoid on .card above
         is exactly right for a short card, but forces a TALLER-than-a-page
         one entirely onto the next page, leaving the previous one almost
         completely blank under just the marketing header. Hiding that
         header and letting the card break normally fixes both: page 1
         starts filling immediately, and the table paginates like any other
         long content instead of jumping as one indivisible block. */
      @media print {
        body.print-snapshot-only header { display: none !important; }
        body.print-snapshot-only .card { break-inside: auto; border: none; margin: 0; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        {product ? (
          <>
            <a href="/" class="brandbar" style="text-decoration:none;color:inherit;">
