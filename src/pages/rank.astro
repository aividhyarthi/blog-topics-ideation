---
// Rank Tracker — App Radar-style keyword rank tracking for Google Play + App Store.
// Serves two audiences from one page: the internal (Nykaa) toolset, and the
// AppRankr product dashboard (product mode: branded header, trial banner,
// plan-based limits).
import { BRAND, planOf, checkAccess, ADSENSE_SLOTS } from '../lib/saas/plans';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import AdSenseMeta from '../components/AdSenseMeta.astro';
import AdSenseScript from '../components/AdSenseScript.astro';
import AdSlot from '../components/AdSlot.astro';
const product = Boolean(Astro.locals.productMode);
const user = Astro.locals.user || null;
const plan = user ? planOf(user.plan) : null;
const access = user ? checkAccess(user.status, user.trialEndsAt) : null;
const limitsText = product && plan
  ? `Your ${plan.name} plan tracks up to ${plan.maxApps} apps, ${plan.maxKeywordsPerApp} keywords each.`
  : 'Up to 15 apps, 60 keywords each.';
---

<!doctype html>
<html lang="en">
  <head>
    {product && <GoogleAnalytics />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {product && <AdSenseMeta />}
    {product && <AdSenseScript />}
    <title>{product ? `${BRAND} — Rank Tracker` : 'CiteRank — Rank Tracker'}</title>
    <meta name="description" content="Track where your apps rank in Google Play and App Store search for your keywords, with daily history and trends." />
    <style is:global>
      :root {
        --pink: #4338ca; --pink-dark: #372aa8; --ink: #16181d; --muted: #6b7280;
        --line: #e5e7eb; --bg: #f8f9fb; --card: #ffffff; --ok: #0a8a5f; --warn: #b8790a; --bad: #c0392b;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.5; font-size: 14px; }
      header { background: #fff; color: var(--ink); border-bottom: 1px solid var(--line); padding: 14px 20px; }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
      header h1 { margin: 0 0 4px; font-size: 19px; font-weight: 700; letter-spacing: -0.01em; }
      header p { margin: 0; color: var(--muted); font-size: 13px; max-width: 780px; }
      nav.top { margin-top: 12px; display: flex; gap: 2px; flex-wrap: wrap; align-items: center; }
      nav.top a { color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 600; background: none; border: 1px solid transparent; padding: 6px 11px; border-radius: 7px; }
      nav.top a:hover { color: var(--ink); background: var(--bg); }
      nav.top a.active { color: var(--pink); background: #eef0fd; }
      .usermenu { position: relative; margin-left: auto; }
      .usertrigger { color: var(--muted); font-size: 13px; font-weight: 600; background: none; border: 1px solid var(--line); padding: 6px 11px; border-radius: 7px; cursor: pointer; font-family: inherit; max-width: 46vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .usertrigger:hover { border-color: #cbd0da; color: var(--ink); }
      .usertrigger .caret { opacity: 0.7; }
      .userdropdown { display: none; position: absolute; right: 0; top: calc(100% + 6px); background: #fff; border: 1px solid var(--line); border-radius: 9px; box-shadow: 0 8px 24px rgba(15,20,30,0.1); min-width: 190px; overflow: hidden; z-index: 50; }
      .userdropdown.open { display: block; }
      .usermenu .userdropdown a { display: block; padding: 9px 13px; font-size: 13px; font-weight: 600; color: var(--ink); text-decoration: none; background: none; border: none; border-radius: 0; }
      .usermenu .userdropdown a:hover { background: var(--bg); }
      .usermenu .userdropdown a + a { border-top: 1px solid var(--line); }
      @media (max-width: 480px) { .usertrigger { max-width: 60vw; } }
      .brandbar { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; flex-wrap: wrap; }
      .brandbar .logo { width: 22px; height: 22px; border-radius: 6px; background: var(--pink); color: #fff; display: grid; place-items: center; font-size: 11px; }
      .brandbar .wordmark { font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
      .brandbar .betatag { font-size: 10px; font-weight: 700; color: var(--muted); background: var(--bg); border: 1px solid var(--line); padding: 2px 6px; border-radius: 4px; letter-spacing: 0.02em; }
      .brandbar .by { font-size: 11.5px; font-weight: 600; color: var(--muted); }
      main { padding: 22px 0 60px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin-bottom: 14px; }
      .card h3 { margin: 0 0 4px; font-size: 14px; }
      .card .hint { margin: 0 0 10px; font-size: 12.5px; color: var(--muted); }
      input[type="text"], textarea, select {
        border: 1px solid var(--line); border-radius: 7px; padding: 8px 10px; font-size: 13.5px;
        color: var(--ink); background: #fff; outline: none; font-family: inherit;
      }
      input:focus, textarea:focus { border-color: var(--pink); box-shadow: 0 0 0 3px rgba(67,56,202,0.1); }
      textarea { width: 100%; min-height: 74px; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      .addrow { display: grid; grid-template-columns: 2.2fr 110px 110px; gap: 10px; margin-bottom: 10px; }
      @media (max-width: 760px) { .addrow { grid-template-columns: 1fr; } }
      .row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      button.primary { background: var(--pink); color: #fff; border: 1px solid var(--pink); border-radius: 7px; padding: 9px 16px; font-size: 13.5px; font-weight: 600; cursor: pointer; }
      button.primary:hover { background: var(--pink-dark); border-color: var(--pink-dark); }
      button.primary:disabled { opacity: 0.5; cursor: not-allowed; }
      button.ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 7px; padding: 7px 12px; font-size: 13px; font-weight: 600; cursor: pointer; }
      button.ghost:hover { border-color: #cbd0da; background: var(--bg); }
      button.ghost.danger:hover { border-color: var(--bad); color: var(--bad); background: #fff; }
      .spinner { width: 14px; height: 14px; border: 2px solid rgba(0,0,0,0.15); border-top-color: currentColor; border-radius: 50%; display: inline-block; vertical-align: -3px; margin-right: 7px; animation: spin 0.7s linear infinite; }
      button.primary .spinner { border-color: rgba(255,255,255,0.35); }
      @keyframes spin { to { transform: rotate(360deg); } }
      .alert { margin: 0 0 14px; padding: 12px 14px; border-radius: 10px; font-size: 13.5px; display: none; }
      .alert.err { background: #fdecec; color: #b3261e; border: 1px solid #f6c9c6; }
      .alert.info { background: #eef3ff; color: #2f4b9e; border: 1px solid #ccd9f6; }
      .appcard { margin-bottom: 16px; }
      .apphead { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .apphead img.icon { width: 40px; height: 40px; border-radius: 8px; border: 1px solid var(--line); }
      .apphead .fallback-icon { width: 40px; height: 40px; border-radius: 8px; border: 1px solid var(--line); display: grid; place-items: center; font-size: 18px; background: var(--bg); }
      .apphead .names { flex: 1; min-width: 200px; }
      .apphead .t { font-weight: 700; font-size: 14.5px; }
      .apphead .d { font-size: 12.5px; color: var(--muted); }
      .apphead .btns { display: flex; gap: 6px; flex-wrap: wrap; }
      .pill { display: inline-block; padding: 2px 8px; border-radius: 5px; font-size: 11px; font-weight: 700; white-space: nowrap; }
      .pill.play { background: #e6f6ee; color: #0a7a4e; }
      .pill.ios { background: #eaeeff; color: #364fc7; }
      .pill.chart { background: #eef0fd; color: var(--pink); }
      .pill.cc { background: var(--bg); color: var(--muted); }
      .pill.vol { background: #eaeeff; color: #364fc7; cursor: help; }
      /* --- overview (tiles + charts) --- */
      .ov { margin-top: 14px; }
      .tiles { display: flex; gap: 10px; flex-wrap: wrap; }
      .tile { flex: 1; min-width: 128px; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
      .tile .lbl { font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); font-weight: 700; }
      .tile .val { font-size: 20px; font-weight: 700; line-height: 1.2; display: flex; align-items: baseline; gap: 7px; }
      .tile .val .d { font-size: 12px; font-weight: 700; }
      .tile .val .d.up { color: var(--ok); }
      .tile .val .d.down { color: var(--bad); }
      .tile .val .d.flat { color: var(--muted); }
      .charts { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; margin-top: 12px; }
      @media (max-width: 880px) { .charts { grid-template-columns: 1fr; } }
      .chartbox { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 12px 12px 8px; }
      .chartbox h4 { margin: 0 0 8px; font-size: 11px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
      .legend { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; font-size: 11px; color: var(--muted); }
      .legend .li { display: flex; align-items: center; gap: 5px; }
      .legend .sw { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
      .viztip { position: fixed; z-index: 60; pointer-events: none; background: #fff; border: 1px solid var(--line); border-radius: 7px; box-shadow: 0 6px 20px rgba(15,20,30,0.12); padding: 8px 11px; font-size: 12px; display: none; min-width: 130px; }
      .kwmodal-backdrop { display: none; position: fixed; inset: 0; z-index: 70; background: rgba(15,20,30,0.4); align-items: center; justify-content: center; padding: 20px; }
      .kwmodal-backdrop.open { display: flex; }
      .kwmodal { background: #fff; border-radius: 12px; padding: 20px; max-width: 520px; width: 100%; max-height: 86vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(15,20,30,0.25); }
      .kwmodal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 4px; }
      .kwmodal-title { font-size: 16px; font-weight: 700; font-family: ui-monospace, monospace; }
      .kwmodal-close { background: none; border: none; font-size: 20px; line-height: 1; color: var(--muted); cursor: pointer; padding: 2px 4px; }
      .kwmodal-close:hover { color: var(--ink); }
      .kwmodal-stats { display: flex; gap: 20px; margin: 12px 0 16px; flex-wrap: wrap; }
      .kwmodal-stat { font-size: 12px; color: var(--muted); }
      .kwmodal-stat b { display: block; font-size: 17px; color: var(--ink); font-weight: 800; }
      .viztip .tt-d { font-weight: 700; margin-bottom: 4px; }
      .viztip .tt-r { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); }
      .viztip .tt-r b { color: var(--ink); font-variant-numeric: tabular-nums; }
      .scrollhint { display: none; font-size: 11px; color: var(--muted); margin: 10px 0 4px; font-weight: 600; }
      @media (max-width: 760px) { .scrollhint { display: block; } }
      .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: #fff; margin-top: 12px; -webkit-overflow-scrolling: touch; }
      table { border-collapse: collapse; width: 100%; min-width: 780px; font-size: 13px; }
      th, td { text-align: left; padding: 8px 12px; vertical-align: middle; border-bottom: 1px solid var(--line); }
      th { background: var(--bg); font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); font-weight: 700; }
      th.sortable { cursor: pointer; user-select: none; white-space: nowrap; }
      th.sortable:hover { color: var(--pink); }
      tr:last-child td { border-bottom: none; }
      td.kw { font-family: ui-monospace, monospace; font-size: 12.5px; color: var(--pink); }
      .kwlink { background: none; border: none; padding: 0; font: inherit; font-family: ui-monospace, monospace; font-size: 12.5px; color: var(--pink); cursor: pointer; text-align: left; text-decoration: underline; text-decoration-color: transparent; }
      .kwlink:hover { text-decoration-color: var(--pink); }
      td.pos { font-variant-numeric: tabular-nums; font-weight: 800; font-size: 15px; width: 64px; }
      td.pos .un { color: var(--muted); font-weight: 600; font-size: 12.5px; }
      .delta { font-weight: 700; font-size: 12.5px; white-space: nowrap; }
      .delta.up { color: var(--ok); }
      .delta.down { color: var(--bad); }
      .delta.flat, .delta.na { color: var(--muted); font-weight: 600; }
      .who { font-size: 12.5px; color: var(--muted); }
      .kwedit { margin-top: 12px; display: none; }
      .kwedit.open { display: block; }
      .annedit { margin-top: 12px; display: none; }
      .annedit.open { display: block; }
      .annedit .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 8px; }
      .annedit label { font-size: 11.5px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 3px; }
      .annedit input[type="date"], .annedit select { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; font-size: 13px; font-family: inherit; }
      .annlist { margin-top: 16px; }
      .annlist h4 { margin: 0 0 4px; font-size: 13px; }
      .annrow { display: flex; align-items: flex-start; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); }
      .annrow:last-child { border-bottom: none; }
      .anntype { font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 5px; white-space: nowrap; flex-shrink: 0; }
      .anntype.experiment { background: #eef0fd; color: var(--pink); }
      .anntype.paid { background: #fdf3dd; color: var(--warn); }
      .anntext { flex: 1; font-size: 13px; }
      .annimpact { margin-top: 4px; font-size: 12.5px; color: var(--muted); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
      .ann-delta { font-weight: 800; font-size: 12.5px; }
      .ann-delta.up { color: var(--ok); }
      .ann-delta.down { color: var(--bad); }
      .ann-delta.na, .ann-delta.flat { color: var(--muted); }
      button.small { padding: 4px 9px; font-size: 12px; flex-shrink: 0; }
      .covov { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }
      .covhead { margin: 0 0 12px; font-size: 13.5px; font-weight: 700; color: var(--ink); }
      .discover { margin-top: 12px; border: 1px solid var(--line); background: var(--bg); border-radius: 8px; padding: 12px 14px; }
      .discover h4 { margin: 0 0 8px; font-size: 13px; }
      .disc-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 4px 14px; max-height: 300px; overflow-y: auto; }
      .disc-row { display: flex; align-items: center; gap: 8px; font-size: 13px; padding: 4px 6px; border-radius: 6px; cursor: pointer; }
      .disc-row:hover { background: #eef0fd; }
      .disc-row .kw { flex: 1; font-family: ui-monospace, monospace; font-size: 12.5px; color: var(--pink); }
      .disc-row b { font-variant-numeric: tabular-nums; }
      .asobox { margin-top: 12px; border: 1px solid var(--line); background: var(--bg); border-radius: 8px; padding: 12px 14px; font-size: 13px; color: var(--ink); }
      .asobox.err { background: #fdecec; border-color: #f6c9c6; color: #b3261e; }
      .asobox.na { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: var(--muted); font-size: 13px; }
      .asometa { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px; font-size: 12px; color: var(--muted); }
      .asorow { display: flex; gap: 12px; align-items: center; }
      .asoscore { font-size: 20px; font-weight: 700; flex-shrink: 0; }
      .asoscore small { font-size: 12px; font-weight: 600; color: var(--muted); }
      .asotext p { margin: 2px 0 0; color: var(--muted); font-size: 12.5px; }
      .asorating { margin-top: 10px; padding: 8px 11px; border-radius: 7px; font-size: 12.5px; font-weight: 600; }
      .asorating.bad { background: #fdecec; color: #b3261e; }
      .asorating.mid { background: #fdf3dd; color: #8a5d00; }
      .ghost-link { display: inline-block; margin-top: 8px; font-size: 12.5px; font-weight: 700; color: var(--pink); text-decoration: none; }
      .ghost-link:hover { text-decoration: underline; }
      .lastcheck { font-size: 12.5px; color: var(--muted); }
      .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 4px 0 16px; }
      .empty { text-align: center; color: var(--muted); padding: 26px 10px; font-size: 14px; }
      .app-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
      .app-tab { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px 6px 7px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--ink); transition: border-color 0.15s; max-width: 220px; }
      .app-tab:hover { border-color: #cbd0da; }
      .app-tab.selected { border-color: var(--pink); background: #eef0fd; color: var(--pink); }
      .app-tab img, .app-tab .fi { width: 20px; height: 20px; border-radius: 5px; flex-shrink: 0; }
      .app-tab .fi { display: grid; place-items: center; background: var(--bg); font-size: 11px; }
      .app-tab .tt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .app-tab .tick { font-size: 11px; color: var(--muted); font-weight: 700; flex-shrink: 0; }
      .kwtabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line); margin: 16px 0 14px; }
      .kwtab { background: none; border: none; border-bottom: 2px solid transparent; padding: 8px 4px; margin-right: 18px; font-size: 13.5px; font-weight: 600; color: var(--muted); cursor: pointer; font-family: inherit; }
      .kwtab:hover { color: var(--ink); }
      .kwtab.active { color: var(--pink); border-bottom-color: var(--pink); }
      .cattabs { border-bottom-style: dashed; margin: 0 0 12px; }
      .cattabs .cattab { font-size: 12.5px; padding: 6px 3px; margin-right: 14px; }
      svg.spark { display: block; }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 24px; }
      .toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 10px 18px; border-radius: 8px; font-size: 13.5px; opacity: 0; transition: opacity 0.2s; pointer-events: none; z-index: 50; }
      .toast.show { opacity: 1; }
      .print-only { display: none; }
      @media print {
        .no-print, header nav.top, footer, .toast { display: none !important; }
        header { background: none !important; color: var(--ink) !important; padding: 0 0 14px; }
        header .aipill, header .by { display: none !important; }
        body { background: #fff; }
        .card { box-shadow: none; border: 1px solid #ddd; break-inside: avoid; }
        .table-wrap { border: 1px solid #ddd; }
        .print-only { display: block; font-size: 12px; color: var(--muted); margin: -6px 0 14px; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        {product ? (
          <>
            <a href="/" class="brandbar" style="text-decoration:none;color:inherit;">
              <span class="logo">▲</span>
              <span class="wordmark">{BRAND}</span>
              <span class="betatag">Beta 1.0</span>
            </a>
            <h1>Your rank dashboard</h1>
            <p>
              Where your apps rank in <b>Google Play</b> and <b>App Store</b> search — position history,
              movement vs the last check, keyword discovery, and top-chart positions. Checked daily.
            </p>
            <nav class="top">
              <a href="/rank" class="active">Rank Tracker</a>
              <a href="/aso">ASO Inspector</a>
              <div class="usermenu">
                <button type="button" class="usertrigger" id="usertrigger">{user?.email} <span class="caret">▾</span></button>
                <div class="userdropdown" id="userdropdown">
                  <a href="/account">Account &amp; billing</a>
                  <a href="/about">About</a>
                  <a href="#" id="logout">Log out</a>
                </div>
              </div>
            </nav>
          </>
        ) : (
          <>
            <div class="brandbar">
              <span class="logo">◆</span>
              <span class="wordmark">CiteRank</span>
              <span class="by">By Rudra Kasturi Inc</span>
            </div>
            <h1>Rank Tracker</h1>
            <p>
              Track where your apps rank in <b>Google Play</b> and <b>App Store</b> search for the keywords
              you care about — checked on demand or daily, with position history, movement vs the last
              check, and the top-chart position. Add competitors' apps too to watch them on the same keywords.
            </p>
            <nav class="top">
              <a href="/aso">ASO Inspector</a>
              <a href="/rank" class="active">Rank Tracker</a>
            </nav>
          </>
        )}
      </div>
    </header>

    {product && access?.trialDaysLeft && (
      <div class="no-print" style="background:#fff6e6;border-bottom:1px solid #f3e0b0;color:#8a5d00;font-size:13.5px;padding:9px 20px;text-align:center;">
        ⏳ <b>{access.trialDaysLeft} day{access.trialDaysLeft === 1 ? '' : 's'}</b> left in your free trial —
        <a href="/account" style="color:#8a5d00;font-weight:700;">choose a plan</a> to keep your rank history running.
      </div>
    )}

    <main>
      <div class="wrap">
        <div class="alert err no-print" id="err"></div>
        <div class="alert info no-print" id="info"></div>

        <div class="card no-print" id="add-app-card">
          <h3>➕ Track an app</h3>
          <p class="hint">
            Paste a <b>Google Play URL / package id</b> (e.g. <code>com.whatsapp</code>) or an
            <b>App Store URL / id</b> (e.g. <code>https://apps.apple.com/in/app/…/id310633997</code>).
            Add the same app twice with different countries to track multiple markets.
          </p>
          <div class="addrow">
            <input type="text" id="add-app" placeholder="Play/App Store URL, package id, or id123456789" />
            <input type="text" id="add-country" placeholder="Country (us)" maxlength="2" />
            <input type="text" id="add-lang" placeholder="Lang (en)" maxlength="2" />
          </div>
          <textarea id="add-keywords" placeholder="Keywords to track — one per line or comma-separated, e.g.
photo editor
collage maker
ai photo enhancer"></textarea>
          <div class="row" style="margin-top:10px;">
            <button class="primary" id="add-btn">Add app</button>
            <span class="hint" style="margin:0;">{limitsText} No keywords yet? Add the app, then hit <b>Discover keywords</b>.</span>
          </div>
        </div>

        <div class="toolbar no-print">
          <span class="lastcheck" id="lastcheck"></span>
          <div class="row">
            <button class="ghost" id="csv-btn">⬇️ Export CSV</button>
            <button class="primary" id="checkall-btn">Check all rankings now</button>
          </div>
        </div>

        <div id="app-tabs-wrap" class="no-print" style="display:none;">
          <div class="row" style="margin-bottom:10px;">
            <input type="text" id="app-filter" placeholder="Filter your tracked apps…" style="flex:1;min-width:200px;" />
          </div>
          <div id="app-tabs" class="app-tabs"></div>
        </div>
        <div id="apps"></div>
        {product && <div class="no-print"><AdSlot slot={ADSENSE_SLOTS.rank} /></div>}
      </div>
    </main>

    <footer>{product ? <><b>{BRAND}</b> · App keyword rank tracking</> : <><b>CiteRank</b> · By Rudra Kasturi Inc · App keyword rank tracking</>}</footer>
    <div class="toast" id="toast"></div>
    <div class="viztip" id="viztip"></div>
    <div class="kwmodal-backdrop no-print" id="kwmodal-backdrop">
      <div class="kwmodal" id="kwmodal"></div>
    </div>

    <script define:vars={{ BRAND_NAME: product ? BRAND : 'CiteRank' }}>
      const $ = (id) => document.getElementById(id);
      let state = { apps: [], lastCheckedAt: null, snapshotDays: [] };
      let selectedAppKey = null;
      let tabFilter = '';
      const sortState = {};
      const covSortState = {};
      // Which sub-tab is showing per app: 'daily' (tracked list + its charts)
      // or 'coverage' (full keyword universe) — so you only ever see one
      // table at a time instead of scrolling past one to reach the other.
      const kwTabState = {};
      // Which category sub-tab is active within the coverage view, per app.
      const catTabState = {};

      // Hardcoded category rules (not user-editable) — grouping a long
      // coverage list by topic instead of one flat list. "Brand + Comp" is
      // always the app's own name (+ any competitor titles already cached
      // from an ASO Inspector run); the rest are simple word-match rules
      // aimed at the finance vertical this was built for first. A pattern
      // that doesn't match anything just never produces a tab, so this
      // doesn't do anything odd for apps outside that vertical — they just
      // end up with a "Brand + Comp" tab (if applicable) and "General".
      const CATEGORY_RULES = [
        { name: 'SIP', patterns: ['sip', 'systematic investment'] },
        { name: 'Mutual Funds', patterns: ['mutual fund', 'mf', 'nav', 'scheme'] },
        { name: 'Tax Saving', patterns: ['tax sav', '80c', 'elss'] },
        { name: 'Fixed Deposit', patterns: ['fixed deposit', 'fd'] },
        { name: 'Retirement / NPS', patterns: ['nps', 'retirement', 'pension'] },
        { name: 'Insurance', patterns: ['insurance', 'term plan', 'ulip'] },
        { name: 'Gold', patterns: ['gold bond', 'sgb', 'digital gold'] },
      ];
      function wordMatch(text, pattern) {
        const esc = pattern.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return new RegExp(`\\b${esc}\\b`, 'i').test(text);
      }
      // App Store titles are almost always "BrandName: keyword-stuffed
      // tagline" (e.g. "Groww: Mutual Fund, SIP, Stocks") — that tagline
      // exists specifically to rank for generic terms, so treating every
      // word in a title as a "brand" signal (the original bug here)
      // mis-tags nearly every generic keyword as Brand + Comp. Only the
      // part before the first separator is a real brand signal, and even
      // that is filtered against a generic-word list as a second guard.
      const GENERIC_TITLE_WORDS = new Set([
        'app', 'apps', 'application', 'free', 'best', 'online', 'india', 'new',
        'investment', 'invest', 'investing', 'fund', 'funds', 'mutual', 'sip',
        'money', 'finance', 'financial', 'save', 'saving', 'savings', 'tax',
        'tracker', 'manager', 'management', 'wallet', 'pay', 'payment', 'bank',
        'banking', 'loan', 'loans', 'insurance', 'stock', 'stocks', 'trading',
        'trade', 'gold', 'plan', 'plans', 'calculator', 'and', 'the', 'for',
      ]);
      function brandTokensFromTitle(title) {
        if (!title) return [];
        const brandPart = title.split(/[:\-–|,]/)[0];
        return brandPart.toLowerCase().split(/\s+/).filter((w) => w.length > 2 && !GENERIC_TITLE_WORDS.has(w));
      }
      function categorizeKeyword(keyword, app) {
        const kw = keyword.toLowerCase();
        const ownTokens = brandTokensFromTitle(app.title);
        const compTitles = ((app.asoCache && app.asoCache.data && app.asoCache.data.competitors) || []).map((c) => c.title || '');
        const compTokens = compTitles.flatMap(brandTokensFromTitle);
        if ([...ownTokens, ...compTokens].some((t) => wordMatch(kw, t))) return 'Brand + Comp';
        for (const rule of CATEGORY_RULES) {
          if (rule.patterns.some((p) => wordMatch(kw, p))) return rule.name;
        }
        return 'General';
      }
      const MAX_COVERAGE = 2000;
      function sortVal(t, col) {
        if (col === 'pos') return t.position;
        if (col === 'best') return t.best;
        if (col === 'delta') return t.delta;
        if (col === 'volume') return t.volume;
        return null;
      }
      // key -> { status: 'loading'|'done'|'error', data?, error? } — best-effort
      // ASO Inspector summary fetched automatically once an app has keywords.
      const ASO_CACHE = {};

      const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const escAttr = (s) => esc(s).replace(/"/g, '&quot;');

      function showToast(msg) {
        const t = $('toast'); t.textContent = msg; t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2000);
      }
      function showErr(msg) { const e = $('err'); e.textContent = msg; e.style.display = msg ? 'block' : 'none'; }
      function showInfo(msg) { const e = $('info'); e.textContent = msg; e.style.display = msg ? 'block' : 'none'; }

      // A paste bigger than the daily-tracked cap used to just silently lose
      // everything past the cap with no indication anything was dropped.
      function truncationMsg(t) {
        return `Saved ${t.saved} of ${t.total} keywords here — this list is checked daily and capped at ${t.saved} for your plan. Paste the rest into the "Coverage list" below instead (up to ${MAX_COVERAGE}, checked automatically by the nightly check) to still monitor them.`;
      }

      // Sparkline of positions (lower = better, so the y-axis is inverted).
      function spark(history) {
        const pts = history.map((p, i) => ({ p, i })).filter((x) => x.p != null);
        if (pts.length < 2) return '<span class="who">—</span>';
        const w = 110, h = 26, pad = 3;
        const min = Math.min(...pts.map((x) => x.p));
        const max = Math.max(...pts.map((x) => x.p));
        const span = Math.max(1, max - min);
        const x = (i) => pad + (i / Math.max(1, history.length - 1)) * (w - 2 * pad);
        const y = (p) => pad + ((p - min) / span) * (h - 2 * pad); // top = best rank
        const d = pts.map((pt, j) => `${j ? 'L' : 'M'}${x(pt.i).toFixed(1)},${y(pt.p).toFixed(1)}`).join(' ');
        const last = pts[pts.length - 1];
        return `<svg class="spark" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">
          <path d="${d}" fill="none" stroke="#4338ca" stroke-width="1.8" stroke-linecap="round"/>
          <circle cx="${x(last.i).toFixed(1)}" cy="${y(last.p).toFixed(1)}" r="2.6" fill="#4338ca"/>
        </svg>`;
      }

      // --- overview charts (App Radar-style) ---------------------------------
      // Ordered rank buckets share one indigo ramp (darkest = best); "Unranked"
      // is neutral gray because it means absence, not a rank. Ramp validated
      // for lightness monotony + surface contrast.
      const BUCKET_COLORS = ['#2c2a75', '#4038c4', '#5655e6', '#7472f0', '#9091f5', '#a9aaf8', '#cbccd6'];
      const BUCKET_LABELS = () => [...(state.buckets || ['Top 1', 'Top 2–3', 'Top 4–10', 'Top 11–30', 'Top 31–100', 'Top 101–200']), 'Unranked'];
      const TIPS = {}; let tipSeq = 0;
      const fmtDay = (dk) => { const d = new Date(dk + 'T00:00:00Z'); return d.getUTCDate() + ' ' + d.toLocaleString('en', { month: 'short', timeZone: 'UTC' }); };

      function tipId(html) { const id = 't' + (++tipSeq); TIPS[id] = html; return id; }

      function tileHtml(label, val, prev, decimals) {
        let d = '<span class="d flat">–</span>';
        if (val != null && prev != null) {
          const diff = Math.round((val - prev) * 10) / 10;
          if (diff > 0) d = `<span class="d up">▲ ${diff}</span>`;
          else if (diff < 0) d = `<span class="d down">▼ ${-diff}</span>`;
          else d = '<span class="d flat">＝</span>';
        }
        const shown = val == null ? '–' : (decimals ? val.toFixed(1) : val);
        return `<div class="tile"><div class="lbl">${esc(label)}</div><div class="val">${shown} ${d}</div></div>`;
      }

      // Stacked bars: one bar per checked day, best bucket at the bottom,
      // 2px surface gaps between segments/bars, rounded cap on the top segment.
      function stackChart(days) {
        const W = 560, H = 170, padL = 26, padB = 18, padT = 6;
        const plotW = W - padL - 6, plotH = H - padT - padB;
        const maxY = Math.max(1, ...days.map((d) => d.tracked));
        const n = days.length;
        const slot = plotW / n, bw = Math.min(46, Math.max(8, slot * 0.62));
        let out = '';
        // recessive grid: baseline + one midline + top
        const gy = (v) => padT + plotH - (v / maxY) * plotH;
        for (const v of [maxY, Math.round(maxY / 2)]) {
          if (v > 0) out += `<line x1="${padL}" y1="${gy(v)}" x2="${W - 4}" y2="${gy(v)}" stroke="#e7e8ef" stroke-width="1"/>
            <text x="${padL - 5}" y="${gy(v) + 3.5}" text-anchor="end" font-size="9.5" fill="#898781">${v}</text>`;
        }
        out += `<line x1="${padL}" y1="${padT + plotH}" x2="${W - 4}" y2="${padT + plotH}" stroke="#c3c2b7" stroke-width="1"/>`;
        const labelEvery = Math.ceil(n / 8);
        days.forEach((d, i) => {
          const x = padL + slot * i + (slot - bw) / 2;
          let y = padT + plotH;
          let segs = '';
          let topSegY = null, topBi = null;
          d.buckets.forEach((v, bi) => {
            if (!v) return;
            const h = (v / maxY) * plotH;
            y -= h;
            segs += `<rect x="${x.toFixed(1)}" y="${(y + 1).toFixed(1)}" width="${bw.toFixed(1)}" height="${Math.max(1, h - 2).toFixed(1)}" fill="${BUCKET_COLORS[bi]}"/>`;
            topSegY = y; topBi = bi;
          });
          // rounded cap on the top of the stack
          if (topSegY != null) segs += `<rect x="${x.toFixed(1)}" y="${(topSegY + 1).toFixed(1)}" width="${bw.toFixed(1)}" height="6" rx="3" fill="${BUCKET_COLORS[topBi]}"/>`;
          const rows = d.buckets.map((v, bi) => v ? `<div class="tt-r"><span><span class="sw" style="background:${BUCKET_COLORS[bi]};display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:4px;"></span>${esc(BUCKET_LABELS()[bi])}</span><b>${v}</b></div>` : '').join('');
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(d.dateKey))} · ${d.tracked} keywords</div>${rows}<div class="tt-r"><span>Visibility</span><b>${d.visibility.toFixed(1)}</b></div>`);
          out += segs;
          out += `<rect class="hcol" data-tip="${tid}" x="${(padL + slot * i).toFixed(1)}" y="${padT}" width="${slot.toFixed(1)}" height="${plotH + padB}" fill="transparent"/>`;
          if (i % labelEvery === 0) out += `<text x="${(x + bw / 2).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="#898781">${esc(fmtDay(d.dateKey))}</text>`;
        });
        return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${out}</svg>`;
      }

      // Visibility score: single indigo line on a 0-based scale.
      function visChart(days, annotations) {
        const W = 400, H = 170, padL = 30, padB = 18, padT = 8;
        const plotW = W - padL - 8, plotH = H - padT - padB;
        const vals = days.map((d) => d.visibility);
        const maxY = Math.max(10, Math.ceil(Math.max(...vals) / 10) * 10);
        const x = (i) => padL + (days.length === 1 ? plotW / 2 : (i / (days.length - 1)) * plotW);
        const y = (v) => padT + plotH - (v / maxY) * plotH;
        let out = '';
        for (const v of [maxY, maxY / 2]) {
          out += `<line x1="${padL}" y1="${y(v)}" x2="${W - 6}" y2="${y(v)}" stroke="#e7e8ef" stroke-width="1"/>
            <text x="${padL - 5}" y="${y(v) + 3.5}" text-anchor="end" font-size="9.5" fill="#898781">${v}</text>`;
        }
        out += `<line x1="${padL}" y1="${padT + plotH}" x2="${W - 6}" y2="${padT + plotH}" stroke="#c3c2b7" stroke-width="1"/>`;
        const d = vals.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
        out += `<path d="${d}" fill="none" stroke="#4338ca" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
        const labelEvery = Math.ceil(days.length / 6);
        days.forEach((day, i) => {
          out += `<circle cx="${x(i).toFixed(1)}" cy="${y(vals[i]).toFixed(1)}" r="3" fill="#4338ca" stroke="#fff" stroke-width="2"/>`;
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(day.dateKey))}</div><div class="tt-r"><span>Visibility score</span><b>${vals[i].toFixed(1)}</b></div>`);
          const cw = days.length === 1 ? plotW : plotW / (days.length - 1);
          out += `<rect class="hcol" data-tip="${tid}" x="${(x(i) - cw / 2).toFixed(1)}" y="${padT}" width="${cw.toFixed(1)}" height="${plotH + padB}" fill="transparent"/>`;
          if (i % labelEvery === 0) out += `<text x="${x(i).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="#898781">${esc(fmtDay(day.dateKey))}</text>`;
        });
        (annotations || []).forEach((a) => {
          const idx = days.findIndex((d) => d.dateKey === a.date);
          if (idx === -1) return;
          const ax = x(idx);
          const color = a.type === 'paid' ? '#b8790a' : '#4338ca';
          out += `<line x1="${ax.toFixed(1)}" y1="${padT}" x2="${ax.toFixed(1)}" y2="${(padT + plotH).toFixed(1)}" stroke="${color}" stroke-width="1.5" stroke-dasharray="3,2"/>`;
          out += `<circle cx="${ax.toFixed(1)}" cy="${(padT - 2).toFixed(1)}" r="3.5" fill="${color}" stroke="#fff" stroke-width="1"/>`;
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(a.date))} · ${esc(ANN_TYPE_LABEL[a.type] || a.type)}</div><div class="tt-r"><span>${esc(a.label)}</span></div>`);
          out += `<rect class="hcol" data-tip="${tid}" x="${(ax - 4).toFixed(1)}" y="${(padT - 8).toFixed(1)}" width="8" height="${(plotH + padB + 8).toFixed(1)}" fill="transparent"/>`;
        });
        return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${out}</svg>`;
      }

      // Category (top-chart) position trend — top = best rank, same
      // low-is-good inversion as the per-keyword sparkline.
      function chartPositionTrend(dateKeys, history, label = 'Category rank', emptyMsg = 'No category chart data yet.') {
        const known = history.filter((v) => v != null);
        if (!known.length) return `<p class="hint">${esc(emptyMsg)}</p>`;
        const W = 400, H = 170, padL = 34, padB = 18, padT = 8;
        const plotW = W - padL - 8, plotH = H - padT - padB;
        const minV = Math.min(...known), maxV = Math.max(...known);
        const span = Math.max(1, maxV - minV);
        const x = (i) => padL + (history.length === 1 ? plotW / 2 : (i / (history.length - 1)) * plotW);
        const y = (v) => padT + ((v - minV) / span) * plotH;
        let out = '';
        [minV, maxV].forEach((v) => {
          out += `<line x1="${padL}" y1="${y(v).toFixed(1)}" x2="${W - 6}" y2="${y(v).toFixed(1)}" stroke="#e7e8ef" stroke-width="1"/>
            <text x="${padL - 5}" y="${(y(v) + 3.5).toFixed(1)}" text-anchor="end" font-size="9.5" fill="#898781">#${v}</text>`;
        });
        let d = '', started = false;
        history.forEach((v, i) => {
          if (v == null) { started = false; return; }
          d += `${started ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)} `;
          started = true;
        });
        out += `<path d="${d}" fill="none" stroke="#4338ca" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
        const labelEvery = Math.ceil(history.length / 6);
        history.forEach((v, i) => {
          if (v == null) return;
          out += `<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="3" fill="#4338ca" stroke="#fff" stroke-width="2"/>`;
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(dateKeys[i]))}</div><div class="tt-r"><span>${esc(label)}</span><b>#${v}</b></div>`);
          const cw = history.length === 1 ? plotW : plotW / (history.length - 1);
          out += `<rect class="hcol" data-tip="${tid}" x="${(x(i) - cw / 2).toFixed(1)}" y="${padT}" width="${cw.toFixed(1)}" height="${plotH + padB}" fill="transparent"/>`;
          if (i % labelEvery === 0) out += `<text x="${x(i).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="#898781">${esc(fmtDay(dateKeys[i]))}</text>`;
        });
        return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${out}</svg>`;
      }

      // 1-2★ share trend — one cheap (no-AI) point per nightly check, shows
      // the ranking-impact risk building over time even between full ASO audits.
      function ratingTrendChart(history) {
        const pts = (history || []).map((h) => ({ dateKey: h.dateKey, v: h.tone === 'na' ? null : h.negativeShare, windowDays: h.windowDays }));
        const known = pts.filter((p) => p.v != null);
        if (!known.length) return '<p class="hint">Not enough rating history yet — check back after a few nightly checks.</p>';
        const W = 400, H = 170, padL = 30, padB = 18, padT = 8;
        const plotW = W - padL - 8, plotH = H - padT - padB;
        const maxY = Math.max(20, Math.ceil(Math.max(...known.map((p) => p.v)) / 10) * 10);
        const x = (i) => padL + (pts.length === 1 ? plotW / 2 : (i / (pts.length - 1)) * plotW);
        const y = (v) => padT + plotH - (v / maxY) * plotH;
        let out = '';
        for (const v of [maxY, maxY / 2]) {
          out += `<line x1="${padL}" y1="${y(v).toFixed(1)}" x2="${W - 6}" y2="${y(v).toFixed(1)}" stroke="#e7e8ef" stroke-width="1"/>
            <text x="${padL - 5}" y="${(y(v) + 3.5).toFixed(1)}" text-anchor="end" font-size="9.5" fill="#898781">${v}%</text>`;
        }
        out += `<line x1="${padL}" y1="${(padT + plotH).toFixed(1)}" x2="${W - 6}" y2="${(padT + plotH).toFixed(1)}" stroke="#c3c2b7" stroke-width="1"/>`;
        let d = '', started = false;
        pts.forEach((p, i) => {
          if (p.v == null) { started = false; return; }
          d += `${started ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.v).toFixed(1)} `;
          started = true;
        });
        out += `<path d="${d}" fill="none" stroke="#c0392b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
        const labelEvery = Math.ceil(pts.length / 6);
        pts.forEach((p, i) => {
          if (p.v == null) return;
          out += `<circle cx="${x(i).toFixed(1)}" cy="${y(p.v).toFixed(1)}" r="3" fill="#c0392b" stroke="#fff" stroke-width="2"/>`;
          const tid = tipId(`<div class="tt-d">${esc(fmtDay(p.dateKey))}</div><div class="tt-r"><span>1-2★ share${p.windowDays ? ` (last ${p.windowDays}d)` : ''}</span><b>${p.v}%</b></div>`);
          const cw = pts.length === 1 ? plotW : plotW / (pts.length - 1);
          out += `<rect class="hcol" data-tip="${tid}" x="${(x(i) - cw / 2).toFixed(1)}" y="${padT}" width="${cw.toFixed(1)}" height="${plotH + padB}" fill="transparent"/>`;
          if (i % labelEvery === 0) out += `<text x="${x(i).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9.5" fill="#898781">${esc(fmtDay(p.dateKey))}</text>`;
        });
        return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;display:block;">${out}</svg>`;
      }

      // --- keyword discovery panel -------------------------------------------
      const DISCOVER = {}; // key -> discovery result, shown until tracked/dismissed

      function discoverHtml(app) {
        const d = DISCOVER[app.key];
        if (!d) return '';
        const items = d.discovery.discovered;
        const ranking = items.filter((k) => k.position != null);
        const opportunities = items.filter((k) => k.position == null);
        const srcPill = { listing: 'from listing', autocomplete: 'autocomplete', ai: 'AI idea' };
        const volPill = (v) => v == null ? '' : `<span class="pill vol" title="Google Trends popularity proxy, 0-100 — unofficial data source, best-effort only">📊 ${v}</span>`;
        const row = (k) => `
          <label class="disc-row">
            <input type="checkbox" data-role="disc-kw" value="${escAttr(k.keyword)}" ${k.position != null && k.position <= 100 ? 'checked' : ''} />
            <span class="kw">${esc(k.keyword)}</span>
            <b>${k.position != null ? '#' + k.position : '<span class="un">not yet ranking</span>'}</b>
            ${volPill(k.volume)}
            <span class="pill cc">${srcPill[k.source] || esc(k.source)}</span>
          </label>`;
        const errNote = d.discovery.errors && d.discovery.errors.length
          ? `<p class="hint" style="margin:8px 0 0;">⚠︎ ${esc(d.discovery.errors[0])}${d.discovery.errors.length > 1 ? ` (+${d.discovery.errors.length - 1} more)` : ''}</p>` : '';
        return `<div class="discover" data-role="discover">
          <h4>Keyword universe: ${items.length} relevant keywords scanned — ${ranking.length} already ranking, ${opportunities.length} opportunities not yet ranking</h4>
          <p class="hint" style="margin:0 0 10px;">Tick any to start tracking them daily — you don't need to already rank for a keyword to track it. Your plan caps how many you can track at once, not how many you can see here. 📊 shows a 0–100 popularity proxy (Google Trends) for the top ${Math.min(25, items.length)} — best-effort, may be blank if unavailable.</p>
          ${ranking.length ? `<p class="hint" style="margin:0 0 4px;font-weight:700;color:var(--ink);">✅ Already ranking (${ranking.length})</p><div class="disc-list">${ranking.map(row).join('')}</div>` : ''}
          ${opportunities.length ? `<p class="hint" style="margin:12px 0 4px;font-weight:700;color:var(--ink);">💡 Opportunities — relevant, not yet ranking (${opportunities.length})</p><div class="disc-list">${opportunities.map(row).join('')}</div>` : ''}
          ${items.length ? '' : '<p class="hint">No new keyword ideas found beyond the ones already tracked.</p>'}
          <div class="row" style="margin-top:10px;">
            ${items.length ? '<button class="primary" data-act="track-selected" style="padding:9px 16px;font-size:13.5px;">Track selected keywords</button>' : ''}
            <button class="ghost" data-act="dismiss-discover">Dismiss</button>
          </div>
          ${errNote}
        </div>`;
      }

      // --- ASO Inspector integration -----------------------------------------
      // ASO Inspector is Play-only. Fires in the background after keywords are
      // saved so a recommendation is waiting without slowing down the save.
      function asoLinkParams(app, focusList) {
        const p = new URLSearchParams({ app: app.url || app.appId, country: app.country || 'us', lang: app.lang || 'en', key: app.key });
        if (focusList.length) p.set('focus', focusList.join(', '));
        return p.toString();
      }

      // Loads whatever was cached server-side (see api/aso.ts + api/rank.ts's
      // statePayload) — no network call, so viewing/reloading the dashboard
      // never silently re-triggers a (paid, Anthropic-backed) ASO audit.
      function loadAsoFromCache(app) {
        if (app.store !== 'play') return;
        if (app.asoCache) ASO_CACHE[app.key] = { status: 'done', data: app.asoCache.data, focusList: app.asoCache.focusList, checkedAt: app.asoCache.checkedAt };
      }

      // The REAL check — hits /api/aso (and its Anthropic call). Only call
      // this from an actual change (new app, edited keywords) or an explicit
      // "Re-check ASO" click, never automatically on page load/reload.
      async function checkAsoFor(app) {
        if (app.store !== 'play' || !app.keywords || !app.keywords.length) return;
        ASO_CACHE[app.key] = { status: 'loading' };
        if (app.key === selectedAppKey) render();
        const focusList = app.keywords.slice(0, 3);
        try {
          const res = await fetch('/api/aso', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: app.url || app.appId, focusKeyword: focusList.join(', '), country: app.country, lang: app.lang, key: app.key }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'ASO check failed.');
          ASO_CACHE[app.key] = { status: 'done', data, focusList, checkedAt: data.checkedAt };
        } catch (e) {
          ASO_CACHE[app.key] = { status: 'error', error: e && e.message ? e.message : String(e) };
        }
        if (app.key === selectedAppKey) render();
      }

      function asoSummaryHtml(app) {
        if (app.store !== 'play') return '';
        const cached = ASO_CACHE[app.key];
        if (!cached) {
          return `<div class="asobox na">No ASO check yet for this app. <button class="ghost small" data-act="recheck-aso">Run ASO check</button></div>`;
        }
        if (cached.status === 'loading') {
          return `<div class="asobox"><span class="spinner" style="border-color:rgba(99,102,241,0.3);border-top-color:var(--pink);"></span>Getting ASO recommendations for your tracked keywords…</div>`;
        }
        if (cached.status === 'error') {
          return `<div class="asobox err">⚠︎ Couldn't fetch ASO recommendations: ${esc(cached.error)}</div>`;
        }
        const r = cached.data.report, ai = cached.data.ai || {};
        const link = `/aso?${asoLinkParams(app, cached.focusList)}`;
        const rb = r.ratingBreakdown;
        const ratingPill = (rb && (rb.tone === 'bad' || rb.tone === 'mid'))
          ? `<div class="asorating ${rb.tone}">⚠️ ${rb.negativeShare}% of ratings in the last ${rb.windowDays} days are 1-2★ — likely hurting your ranking, not just conversions</div>`
          : '';
        const lastChecked = cached.checkedAt ? new Date(cached.checkedAt).toLocaleString() : null;
        return `<div class="asobox">
          <div class="asorow">
            <span class="asoscore" style="color:${r.overall >= 80 ? '#0e7a4e' : r.overall >= 60 ? '#c98a00' : '#c0392b'}">${r.overall}<small>/100</small></span>
            <div class="asotext">
              <b>ASO score for "${esc(cached.focusList[0] || '')}"${cached.focusList.length > 1 ? ` +${cached.focusList.length - 1} more` : ''}</b>
              <p>${esc(ai.summary || 'Deterministic listing score computed — open the full report for keyword-by-keyword recommendations.')}</p>
            </div>
          </div>
          ${ratingPill}
          <div class="asometa">
            ${lastChecked ? `<span>Last checked ${esc(lastChecked)}</span>` : ''}
            <button class="ghost small" data-act="recheck-aso">Re-check ASO</button>
          </div>
          <a class="ghost-link" href="${escAttr(link)}" target="_blank" rel="noopener" data-aso-key="${escAttr(app.key)}">Open full ASO Inspector report →</a>
        </div>`;
      }

      function overviewHtml(app) {
        const ov = app.overview;
        if (!ov || !ov.days || !ov.days.length) return '';
        const c = ov.counts || {}, p = ov.prevCounts || null;
        const legend = BUCKET_LABELS().map((l, i) => `<span class="li"><span class="sw" style="background:${BUCKET_COLORS[i]}"></span>${esc(l)}</span>`).join('');
        // Category chart trend only makes sense once the app has actually
        // ranked in a top chart at least once — otherwise it's an empty line.
        const chartHist = (app.chart && app.chart.history) || [];
        const isChartRanking = chartHist.some((v) => v != null);
        const catChartBox = isChartRanking
          ? `<div class="chartbox"><h4>Category chart rank trend${app.chart.chart ? ` — ${esc(app.chart.chart)}` : ''}</h4>${chartPositionTrend(app.chart.dateKeys, chartHist)}</div>`
          : '';
        return `<div class="ov">
          <div class="tiles">
            ${tileHtml('Top 1 rankings', c.top1, p && p.top1)}
            ${tileHtml('Top 10 rankings', c.top10, p && p.top10)}
            ${tileHtml('Top 30 rankings', c.top30, p && p.top30)}
            ${tileHtml('Top 100 rankings', c.top100, p && p.top100)}
            ${tileHtml('Visibility score', ov.visibility, ov.prevVisibility, true)}
          </div>
          <div class="charts">
            <div class="chartbox"><h4>Keyword rank distribution by day</h4>${stackChart(ov.days)}<div class="legend">${legend}</div></div>
            <div class="chartbox"><h4>Search visibility score (0–100)</h4>${visChart(ov.days, app.annotations)}</div>
            ${catChartBox}
            <div class="chartbox"><h4>1-2★ rating share trend</h4>${ratingTrendChart(app.ratingHistory)}</div>
          </div>
        </div>`;
      }

      const ANN_TYPE_LABEL = { experiment: '🧪 Experiment', paid: '📢 Paid push' };

      function annotationsHtml(app) {
        const anns = app.annotations || [];
        if (!anns.length) return '';
        const rows = anns.slice().sort((a, b) => b.date.localeCompare(a.date)).map((a) => {
          const im = a.impact || {};
          const hasImpact = im.before && im.after && im.before.avgVisibility != null && im.after.avgVisibility != null;
          const deltaHtml = !hasImpact
            ? '<span class="ann-delta na">Not enough days before/after yet</span>'
            : `<span class="ann-delta ${im.delta > 0 ? 'up' : im.delta < 0 ? 'down' : 'flat'}">${im.delta > 0 ? '▲' : im.delta < 0 ? '▼' : '＝'} ${Math.abs(im.delta)} pt visibility</span>`;
          const detail = hasImpact
            ? `${im.before.avgVisibility} → ${im.after.avgVisibility} avg visibility (14d before → after)`
            : '';
          return `<div class="annrow">
            <span class="anntype ${a.type}">${ANN_TYPE_LABEL[a.type] || a.type}</span>
            <div class="anntext"><b>${esc(fmtDay(a.date))}</b> — ${esc(a.label)}<div class="annimpact">${deltaHtml}${detail ? `<span>${esc(detail)}</span>` : ''}</div></div>
            <button class="ghost danger small" data-act="remove-annotation" data-id="${escAttr(a.id)}" title="Remove annotation">×</button>
          </div>`;
        }).join('');
        return `<div class="annlist"><h4>Annotations &amp; ranking impact</h4>${rows}</div>`;
      }

      // Plain-language key for the Rank column, since "#N" / ">200" /
      // "not checked yet" / "err" otherwise have to be inferred.
      const RANK_LEGEND = `<p class="hint" style="margin:2px 0 10px;"><b>#N</b> = found at position N &nbsp;·&nbsp; <b>&gt;200</b> = checked, not in the top 200 &nbsp;·&nbsp; <b>not checked yet</b> = hasn't been searched yet (just added, or waiting on the next check) &nbsp;·&nbsp; <b>⚠︎ err</b> (hover for why) = the check itself failed, not a real rank</p>`;

      function coverageTableHtml(app, trends) {
        if (!trends.length) return '<p class="hint" style="margin-top:10px;">No keywords in this category.</p>';
        const volumes = app.keywordVolumes || {};
        const rows = trends.map((t) => ({ ...t, volume: volumes[t.keyword] ?? null }));
        // Default to highest-volume-first — the whole point of this table is
        // seeing where you rank on the keywords that matter most, not just
        // the plan-limited 60 that happen to be in the daily-tracked list.
        const sort = covSortState[app.key] || { col: 'volume', dir: -1 };
        if (sort.col) {
          rows.sort((a, b) => {
            const av = sortVal(a, sort.col), bv = sortVal(b, sort.col);
            if (av == null && bv == null) return 0;
            if (av == null) return 1;
            if (bv == null) return -1;
            return (av - bv) * sort.dir;
          });
        }
        const arrow = (col) => sort.col === col ? (sort.dir === 1 ? ' ▲' : ' ▼') : '';
        const th = (col, label) => `<th class="sortable" data-sort="${col}">${label}${arrow(col)}</th>`;
        const body = rows.map((t) => `
          <tr>
            <td class="kw"><button class="kwlink" data-kwhistory="${escAttr(t.keyword)}" data-list="coverage">${esc(t.keyword)}</button></td>
            <td class="pos">${t.volume != null ? t.volume.toLocaleString() : '<span class="un">–</span>'}</td>
            <td class="pos">${posCell(t)}</td>
            <td>${deltaCell(t)}</td>
            <td class="pos">${t.best != null ? `#${t.best}` : '<span class="un">–</span>'}</td>
            <td>${spark(t.history || [])}</td>
            <td class="who">${(t.top || []).length ? esc(t.top[0].title) : '–'}</td>
          </tr>`).join('');
        return `<p class="scrollhint no-print">↔ Swipe to see all columns</p><div class="table-wrap covtable"><table>
            <thead><tr><th>Keyword</th>${th('volume', 'Volume')}${th('pos', 'Rank')}${th('delta', 'Δ vs last')}${th('best', 'Best')}<th>Trend</th><th>#1 for this keyword</th></tr></thead>
            <tbody>${body}</tbody>
          </table></div>`;
      }

      // Groups the coverage list by category (see CATEGORY_RULES above) and
      // renders a sub-tab per category actually present, so "Brand + Comp",
      // "SIP", "MF" etc. can each be checked without scanning one long list.
      function categorizedCoverageHtml(app) {
        const trends = app.coverageTrends || [];
        if (!trends.length) return '';
        const byCat = {};
        for (const t of trends) {
          const cat = categorizeKeyword(t.keyword, app);
          (byCat[cat] = byCat[cat] || []).push(t);
        }
        const order = ['Brand + Comp', ...CATEGORY_RULES.map((r) => r.name), 'General'];
        const present = order.filter((c) => (byCat[c] || []).length);
        // Only one category present (usually "General") — a tab bar with a
        // single option is just noise, show the plain table instead.
        if (present.length <= 1) return coverageTableHtml(app, trends);
        const active = present.includes(catTabState[app.key]) ? catTabState[app.key] : present[0];
        const tabs = `<div class="kwtabs cattabs no-print">${present.map((c) =>
          `<button class="kwtab cattab ${c === active ? 'active' : ''}" data-cattab="${escAttr(c)}">${esc(c)} (${byCat[c].length})</button>`
        ).join('')}</div>`;
        return tabs + coverageTableHtml(app, byCat[active]);
      }

      function coverageHtml(app) {
        const cov = app.coverageOverview;
        if (!cov || !cov.total) return '';
        const c = cov.counts || {}, p = cov.prevCounts || null;
        if (!cov.days.length) {
          return `<div class="ov covov"><h4 class="covhead">Keyword coverage <span class="hint" style="display:inline;margin:0;">— ${cov.total} keywords saved, not checked yet</span></h4>
            <p class="hint">Click <b>Check coverage now</b> above to run the first check. Each check adds one point to this trend — run it every few days to see coverage of your full list growing or dropping over time.</p></div>`;
        }
        const legend = BUCKET_LABELS().map((l, i) => `<span class="li"><span class="sw" style="background:${BUCKET_COLORS[i]}"></span>${esc(l)}</span>`).join('');
        return `<div class="ov covov">
          <h4 class="covhead">Keyword coverage <span class="hint" style="display:inline;margin:0;">— ${cov.total} keywords, last checked ${cov.lastCheckedAt ? new Date(cov.lastCheckedAt).toLocaleString() : 'never'}</span></h4>
          <div class="tiles">
            ${tileHtml('Top 1', c.top1, p && p.top1)}
            ${tileHtml('Top 10', c.top10, p && p.top10)}
            ${tileHtml('Top 30', c.top30, p && p.top30)}
            ${tileHtml('Top 100', c.top100, p && p.top100)}
          </div>
          <div class="charts">
            <div class="chartbox" style="grid-column:1/-1;"><h4>Coverage distribution by check</h4>${stackChart(cov.days)}<div class="legend">${legend}</div></div>
          </div>
          <h4 class="covhead" style="margin-top:16px;">Every keyword you're monitoring here, ranking or not, sorted by volume</h4>
          <p class="hint" style="margin:0 0 6px;">This list can overlap with the "Daily tracked" tab, that's normal. It's checked by the nightly check, not the "Check now" button up top — click <b>Check coverage now</b> below for a smaller list you want checked right away.</p>
          ${RANK_LEGEND}
          ${categorizedCoverageHtml(app)}
        </div>`;
      }

      // Shared hover tooltip for both charts.
      const viztip = $('viztip');
      document.addEventListener('mousemove', (ev) => {
        const col = ev.target.closest && ev.target.closest('.hcol');
        if (!col) { viztip.style.display = 'none'; return; }
        viztip.innerHTML = TIPS[col.getAttribute('data-tip')] || '';
        viztip.style.display = 'block';
        const vw = window.innerWidth, rect = viztip.getBoundingClientRect();
        viztip.style.left = Math.min(ev.clientX + 14, vw - rect.width - 10) + 'px';
        viztip.style.top = Math.max(8, ev.clientY - rect.height - 12) + 'px';
      });

      function deltaCell(t) {
        if (t.position != null && t.prevPosition == null) return '<span class="delta up">new</span>';
        if (t.position == null && t.prevPosition != null) return '<span class="delta down">out</span>';
        if (t.delta == null) return '<span class="delta na">–</span>';
        if (t.delta > 0) return `<span class="delta up">▲ ${t.delta}</span>`;
        if (t.delta < 0) return `<span class="delta down">▼ ${-t.delta}</span>`;
        return '<span class="delta flat">＝ 0</span>';
      }

      function posCell(t) {
        if (t.error) return `<span class="un" title="${escAttr(t.error)}">⚠︎ err</span>`;
        if (t.position != null) return `#${t.position}`;
        // Distinguish "searched, ranked beyond depth" from "never actually
        // checked yet" (just added, or a large coverage list still waiting
        // on the nightly cron) — showing ">200" for the latter would wrongly
        // read as "confirmed not ranking".
        if (t.checked === false) return `<span class="un" title="Not checked yet — this keyword hasn't been searched in a check yet.">not checked yet</span>`;
        return `<span class="un">&gt;${t.depth || 200}</span>`;
      }

      // Clicking a keyword in either table opens this — the full position
      // history for just that keyword, reusing the same low-is-good line
      // chart as the category-rank trend, paired with that list's own date
      // keys (daily-tracked and coverage are checked on different
      // schedules, so their snapshot histories don't line up 1:1).
      function openKeywordHistory(appKey, listType, keyword) {
        const app = state.apps.find((a) => a.key === appKey);
        if (!app) return;
        const trends = listType === 'coverage' ? (app.coverageTrends || []) : (app.trends || []);
        const t = trends.find((x) => x.keyword === keyword);
        if (!t) return;
        const dateKeys = (listType === 'coverage' ? (app.coverageOverview && app.coverageOverview.days) : (app.overview && app.overview.days)) || [];
        const dks = dateKeys.map((d) => d.dateKey);
        const volume = (app.keywordVolumes || {})[keyword];
        const chart = chartPositionTrend(dks, t.history || [], 'Rank', 'No history yet for this keyword — check back after the next check.');
        $('kwmodal').innerHTML = `
          <div class="kwmodal-head">
            <div class="kwmodal-title">${esc(keyword)}</div>
            <button class="kwmodal-close" data-act="close-kwmodal" aria-label="Close">×</button>
          </div>
          <div class="hint" style="margin:0 0 4px;">${listType === 'coverage' ? 'Coverage list' : 'Daily tracked'} · ${app.title ? esc(app.title) : ''}</div>
          <div class="kwmodal-stats">
            <div class="kwmodal-stat">Current<b>${t.position != null ? `#${t.position}` : (t.checked === false ? 'not checked yet' : `>${t.depth || 200}`)}</b></div>
            <div class="kwmodal-stat">Best ever<b>${t.best != null ? `#${t.best}` : '–'}</b></div>
            <div class="kwmodal-stat">Δ vs last check<b>${t.delta != null ? (t.delta > 0 ? `▲ ${t.delta}` : t.delta < 0 ? `▼ ${-t.delta}` : '＝ 0') : '–'}</b></div>
            <div class="kwmodal-stat">Volume<b>${volume != null ? volume.toLocaleString() : '–'}</b></div>
          </div>
          ${chart}
          ${(t.top || []).length ? `<p class="hint" style="margin-top:10px;">Currently #1 for this keyword: <b>${esc(t.top[0].title)}</b></p>` : ''}
        `;
        $('kwmodal-backdrop').classList.add('open');
      }
      function closeKeywordHistory() { $('kwmodal-backdrop').classList.remove('open'); }

      function renderApp(app) {
        const storePill = app.store === 'play'
          ? '<span class="pill play">Google Play</span>'
          : '<span class="pill ios">App Store</span>';
        const chart = app.chart && app.chart.position != null
          ? `<span class="pill chart" title="${escAttr(app.chart.chart || '')}">📈 ${esc(app.chart.chart || 'Top Free')} · #${app.chart.position}${app.chart.delta ? (app.chart.delta > 0 ? ` (▲${app.chart.delta})` : ` (▼${-app.chart.delta})`) : ''}</span>`
          : (app.chart && app.chart.chart ? `<span class="pill cc" title="Not in the top of ${escAttr(app.chart.chart)}">chart: not ranked</span>` : '');
        const icon = app.icon
          ? `<img class="icon" src="${escAttr(app.icon)}" alt="" />`
          : `<div class="fallback-icon">${app.store === 'play' ? '🤖' : ''}</div>`;
        const sort = sortState[app.key] || {};
        const volumes = app.keywordVolumes || {};
        const trends = (app.trends || []).map((t) => ({ ...t, volume: volumes[t.keyword] ?? null }));
        if (sort.col) {
          trends.sort((a, b) => {
            const av = sortVal(a, sort.col), bv = sortVal(b, sort.col);
            if (av == null && bv == null) return 0;
            if (av == null) return 1;
            if (bv == null) return -1;
            return (av - bv) * sort.dir;
          });
        }
        const arrow = (col) => sort.col === col ? (sort.dir === 1 ? ' ▲' : ' ▼') : '';
        const th = (col, label) => `<th class="sortable" data-sort="${col}">${label}${arrow(col)}</th>`;
        const rows = trends.map((t) => `
          <tr>
            <td class="kw"><button class="kwlink" data-kwhistory="${escAttr(t.keyword)}" data-list="daily">${esc(t.keyword)}</button></td>
            <td class="pos">${t.volume != null ? t.volume.toLocaleString() : '<span class="un">–</span>'}</td>
            <td class="pos">${posCell(t)}</td>
            <td>${deltaCell(t)}</td>
            <td class="pos">${t.best != null ? `#${t.best}` : '<span class="un">–</span>'}</td>
            <td>${spark(t.history || [])}</td>
            <td class="who">${(t.top || []).length ? esc(t.top[0].title) : '–'}</td>
          </tr>`).join('');
        const table = (app.keywords || []).length
          ? `<h4 class="covhead">Daily-tracked keywords <span class="hint" style="display:inline;margin:0;">— ${app.keywords.length} keyword${app.keywords.length === 1 ? '' : 's'}, checked automatically every day</span></h4>
            ${RANK_LEGEND}
            <p class="scrollhint no-print">↔ Swipe to see all columns</p><div class="table-wrap"><table>
              <thead><tr><th>Keyword</th>${th('volume', 'Volume')}${th('pos', 'Rank')}${th('delta', 'Δ vs last')}${th('best', 'Best')}<th>Trend</th><th>#1 for this keyword</th></tr></thead>
              <tbody>${rows}</tbody>
            </table></div>`
          : '<p class="hint" style="margin-top:10px;">No keywords yet — click <b>Edit keywords</b> to add some, then check rankings.</p>';
        return `
        <div class="card appcard" data-key="${escAttr(app.key)}">
          <div class="print-only">${esc(BRAND_NAME)} — Rank Report · generated ${new Date().toLocaleDateString()}</div>
          <div class="apphead">
            ${icon}
            <div class="names">
              <div class="t">${app.url ? `<a href="${escAttr(app.url)}" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;">${esc(app.title)}</a>` : esc(app.title)}</div>
              <div class="d">${esc(app.developer || app.appId)} · ${storePill} <span class="pill cc">${esc((app.country || '').toUpperCase())}</span> ${chart}</div>
            </div>
            <div class="btns no-print">
              <button class="ghost" data-act="check-one">Check now</button>
              <button class="ghost" data-act="discover">Discover keywords</button>
              <button class="ghost" data-act="edit-kw">Add / edit keywords</button>
              <button class="ghost" data-act="edit-coverage">Coverage list</button>
              <button class="ghost" data-act="add-annotation">Add annotation</button>
              <button class="ghost" data-act="pdf">Export PDF</button>
              <button class="ghost danger" data-act="remove">Remove</button>
            </div>
          </div>
          <div class="kwedit no-print" data-role="kwedit">
            <p class="hint" style="margin:10px 0 6px;">One keyword per line (or comma-separated). Pasting straight from a spreadsheet with search volume in the next column works too — "keyword&nbsp;&nbsp;&nbsp;1234" or "keyword, 1234" per line — the volume shows up in the Volume column below. Saving re-checks this app's rankings right away. <b>This is the daily-checked list, capped by your plan</b> — if you have a bigger list, paste the rest into the "Coverage list" further down instead; it isn't capped and covers the same volume/rank tracking, just checked less often.</p>
            <textarea data-role="kwtext">${esc((app.keywords || []).join('\n'))}</textarea>
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-kw">Save keywords &amp; check ranks</button>
            </div>
          </div>
          <div class="annedit no-print" data-role="annedit">
            <p class="hint" style="margin:10px 0 6px;">Log an ASO experiment (title/screenshot/keyword change) or a paid marketing push, and we'll compare average visibility score in the 14 days before vs after.</p>
            <div class="row">
              <div><label>Date</label><input type="date" data-role="ann-date" value="${new Date().toISOString().slice(0, 10)}" max="${new Date().toISOString().slice(0, 10)}" /></div>
              <div><label>Type</label><select data-role="ann-type"><option value="experiment">🧪 ASO experiment</option><option value="paid">📢 Paid marketing push</option></select></div>
            </div>
            <label>What did you change / run?</label>
            <textarea data-role="ann-label" placeholder="e.g. Rewrote title to include &quot;photo editor&quot;, or Started a ₹50k UAC campaign" rows="2"></textarea>
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-annotation">Save annotation</button>
            </div>
          </div>
          <div class="kwedit no-print" data-role="covedit">
            <p class="hint" style="margin:10px 0 6px;">Paste your FULL keyword universe here — up to ${MAX_COVERAGE} — separate from the keywords list above (which is checked daily and capped by your plan). Straight from a spreadsheet with a volume column works too, same format as above. "Check coverage now" works for any size list — it checks in safe batches and picks up where it left off, so for a very large list it may take a few clicks (or a bit of waiting) to fully finish. It's also picked up automatically by the nightly check either way.</p>
            <textarea data-role="covtext" placeholder="One keyword per line or comma-separated — up to ${MAX_COVERAGE}">${esc((app.coverageKeywords || []).join('\n'))}</textarea>
            <div class="row" style="margin-top:8px;">
              <button class="ghost" data-act="save-coverage">Save coverage list</button>
              <button class="ghost" data-act="check-coverage">Check coverage now</button>
            </div>
          </div>
          <div class="no-print">${asoSummaryHtml(app)}</div>
          <div class="no-print">${discoverHtml(app)}</div>
          ${kwTabsHtml(app, table)}
        </div>`;
      }

      // Two sub-tabs so the daily-tracked table and the (potentially much
      // longer) coverage table are never both on screen / scrolled-past at
      // once — click between them instead of scrolling past a 2000-row list
      // to reach the 60-row one, or vice versa.
      function kwTabsHtml(app, dailyTable) {
        const tab = kwTabState[app.key] || 'daily';
        const dailyCount = (app.keywords || []).length;
        const covCount = (app.coverageKeywords || []).length;
        const tabs = `<div class="kwtabs no-print">
          <button class="kwtab ${tab === 'daily' ? 'active' : ''}" data-kwtab="daily">Daily tracked (${dailyCount})</button>
          <button class="kwtab ${tab === 'coverage' ? 'active' : ''}" data-kwtab="coverage">All keywords (${covCount})</button>
        </div>`;
        const body = tab === 'coverage'
          ? `<div class="no-print">${coverageHtml(app)}</div>`
          : `${overviewHtml(app)}<div class="no-print">${annotationsHtml(app)}</div>${dailyTable}`;
        return tabs + body;
      }

      function tabIcon(app) {
        return app.icon
          ? `<img src="${escAttr(app.icon)}" alt="" />`
          : `<div class="fi">${app.store === 'play' ? '🤖' : '📱'}</div>`;
      }

      function renderTabs() {
        const wrap = $('app-tabs-wrap');
        if (!state.apps.length) { wrap.style.display = 'none'; return; }
        wrap.style.display = 'block';
        const q = tabFilter.trim().toLowerCase();
        const visible = q ? state.apps.filter((a) => (a.title || '').toLowerCase().includes(q) || (a.appId || '').toLowerCase().includes(q)) : state.apps;
        $('app-tabs').innerHTML = visible.map((app) => `
          <div class="app-tab ${app.key === selectedAppKey ? 'selected' : ''}" data-key="${escAttr(app.key)}">
            ${tabIcon(app)}
            <span class="tt">${esc(app.title)}</span>
            <span class="tick">${app.store === 'play' ? 'GP' : 'AS'}</span>
          </div>`).join('') || '<p class="hint" style="margin:0;">No apps match that filter.</p>';
      }

      function render() {
        const box = $('apps');
        if (!state.apps.length) {
          $('app-tabs-wrap').style.display = 'none';
          box.innerHTML = '<div class="card"><div class="empty">No apps tracked yet. Add your app (and your competitors’ apps) above to start tracking rankings.</div></div>';
        } else {
          if (!selectedAppKey || !state.apps.some((a) => a.key === selectedAppKey)) selectedAppKey = state.apps[0].key;
          renderTabs();
          const current = state.apps.find((a) => a.key === selectedAppKey);
          box.innerHTML = renderApp(current);
        }
        const days = state.snapshotDays || [];
        $('lastcheck').textContent = state.lastCheckedAt
          ? `Last checked ${new Date(state.lastCheckedAt).toLocaleString()} · ${days.length} day${days.length === 1 ? '' : 's'} of history`
          : 'Never checked — add apps and hit "Check all rankings now".';
      }

      async function api(body) {
        const res = await fetch('/api/rank', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Request failed.');
        return data;
      }

      async function refresh() {
        const res = await fetch('/api/rank');
        state = await res.json();
        render();
        // ASO results are cached server-side (see api/aso.ts) — load whatever
        // was last checked instead of calling /api/aso again. That call is a
        // paid Anthropic request, so viewing/reloading the dashboard must
        // never silently re-trigger it.
        for (const app of state.apps) loadAsoFromCache(app);
        render();
      }

      async function withBusy(btn, busyLabel, fn) {
        showErr('');
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>' + busyLabel;
        try {
          const data = await fn();
          if (data) { state = data; render(); if (data.note) showInfo(data.note); }
        } catch (e) {
          showErr(e && e.message ? e.message : String(e));
        } finally {
          btn.disabled = false;
          btn.innerHTML = orig;
        }
      }

      $('add-btn').addEventListener('click', () =>
        withBusy($('add-btn'), 'Adding…', async () => {
          const app = $('add-app').value.trim();
          if (!app) { showErr('Paste an app URL or id first.'); return null; }
          const data = await api({
            action: 'add-app', app,
            country: $('add-country').value.trim(),
            lang: $('add-lang').value.trim(),
            keywords: $('add-keywords').value,
          });
          const notes = [];
          if (data.metaError) notes.push('App added, but its listing could not be read right now: ' + data.metaError);
          if (data.keywordsTruncated) notes.push(truncationMsg(data.keywordsTruncated));
          if (!data.metaError && data.checkError) notes.push(data.checkError);
          if (notes.length) showInfo(notes.join(' '));
          $('add-app').value = ''; $('add-keywords').value = '';
          showToast('App added');
          if (data.apps && data.apps.length) {
            const newApp = data.apps[data.apps.length - 1];
            selectedAppKey = newApp.key;
            checkAsoFor(newApp);
          }
          return data;
        }));

      $('checkall-btn').addEventListener('click', () =>
        withBusy($('checkall-btn'), 'Checking rankings… this can take a minute', () => api({ action: 'check' })));

      $('app-tabs').addEventListener('click', (ev) => {
        const tab = ev.target.closest('.app-tab');
        if (!tab) return;
        selectedAppKey = tab.getAttribute('data-key');
        render();
      });
      $('app-filter').addEventListener('input', (ev) => { tabFilter = ev.target.value; renderTabs(); });

      $('apps').addEventListener('click', (ev) => {
        // Stash the already-computed ASO result before the deep link opens
        // /aso (in a new, noopener tab — so sessionStorage isn't shared;
        // localStorage is, since it's scoped to the origin, not the opener
        // relationship), so that page can reuse it instead of re-running
        // the (paid) Anthropic audit for data we just checked seconds ago here.
        const asoLink = ev.target.closest('a[data-aso-key]');
        if (asoLink) {
          const k = asoLink.getAttribute('data-aso-key');
          const cached = ASO_CACHE[k];
          if (cached && cached.status === 'done') {
            try { localStorage.setItem('aso-cache:' + k, JSON.stringify({ data: cached.data, checkedAt: cached.checkedAt })); } catch { /* best-effort */ }
          }
          return;
        }
        const kwLink = ev.target.closest('.kwlink');
        if (kwLink) {
          const card = kwLink.closest('.appcard');
          openKeywordHistory(card.getAttribute('data-key'), kwLink.getAttribute('data-list'), kwLink.getAttribute('data-kwhistory'));
          return;
        }
        const catTab = ev.target.closest('.cattab');
        if (catTab) {
          const card = catTab.closest('.appcard');
          catTabState[card.getAttribute('data-key')] = catTab.getAttribute('data-cattab');
          render();
          return;
        }
        const kwTab = ev.target.closest('.kwtab');
        if (kwTab) {
          const card = kwTab.closest('.appcard');
          kwTabState[card.getAttribute('data-key')] = kwTab.getAttribute('data-kwtab');
          render();
          return;
        }
        const sortTh = ev.target.closest('th.sortable');
        if (sortTh) {
          const card = sortTh.closest('.appcard');
          const key = card.getAttribute('data-key');
          const col = sortTh.getAttribute('data-sort');
          const store = sortTh.closest('.covtable') ? covSortState : sortState;
          const cur = store[key] || (store === covSortState ? { col: 'volume', dir: -1 } : {});
          store[key] = { col, dir: cur.col === col ? -cur.dir : 1 };
          render();
          return;
        }
        const btn = ev.target.closest('button[data-act]');
        if (!btn) return;
        const card = btn.closest('.appcard');
        const key = card.getAttribute('data-key');
        const act = btn.getAttribute('data-act');
        if (act === 'edit-kw') { card.querySelector('[data-role="kwedit"]').classList.toggle('open'); return; }
        if (act === 'save-kw') {
          withBusy(btn, 'Saving & checking ranks…', async () => {
            const data = await api({ action: 'set-keywords', key, keywords: card.querySelector('[data-role="kwtext"]').value });
            const notes = [];
            if (data.keywordsTruncated) notes.push(truncationMsg(data.keywordsTruncated));
            if (data.checkError) notes.push(data.checkError);
            if (notes.length) showInfo(notes.join(' ')); else showToast('Keywords saved — fresh ranks below');
            const saved = data.apps.find((a) => a.key === key);
            if (saved) checkAsoFor(saved);
            return data;
          });
          return;
        }
        if (act === 'edit-coverage') { card.querySelector('[data-role="covedit"]').classList.toggle('open'); return; }
        if (act === 'save-coverage') {
          withBusy(btn, 'Saving…', async () => {
            const data = await api({ action: 'set-coverage-keywords', key, keywords: card.querySelector('[data-role="covtext"]').value });
            showToast('Coverage list saved — click "Check coverage now" to run the first check, or wait for the nightly automatic check');
            return data;
          });
          return;
        }
        if (act === 'check-coverage') {
          // Runs in safely-sized, time-bounded batches server-side (see
          // checkCoverageBatch) — this loop just keeps asking for the next
          // batch until the whole list is done, so a list in the hundreds
          // actually finishes instead of one giant request timing out.
          withBusy(btn, 'Checking coverage…', async () => {
            let data = await api({ action: 'check-coverage', key });
            let p = data.coverageProgress;
            let rounds = 0;
            while (p && !p.done && p.checkedNow > 0 && rounds < 100) {
              showToast(`Checked ${p.totalDone}/${p.total} keywords — continuing…`);
              data = await api({ action: 'check-coverage', key });
              p = data.coverageProgress;
              rounds++;
            }
            if (p) showToast(p.done ? `Coverage check complete — ${p.total} keywords` : `Checked ${p.totalDone}/${p.total} so far — click "Check coverage now" again to continue`);
            else if (data.note) showInfo(data.note);
            return data;
          });
          return;
        }
        if (act === 'add-annotation') { card.querySelector('[data-role="annedit"]').classList.toggle('open'); return; }
        if (act === 'save-annotation') {
          withBusy(btn, 'Saving…', async () => {
            const date = card.querySelector('[data-role="ann-date"]').value;
            const type = card.querySelector('[data-role="ann-type"]').value;
            const label = card.querySelector('[data-role="ann-label"]').value.trim();
            if (!date || !label) { showErr('Add a date and describe what you changed.'); return null; }
            const data = await api({ action: 'add-annotation', key, date, type, label });
            showToast('Annotation saved');
            return data;
          });
          return;
        }
        if (act === 'remove-annotation') {
          const id = btn.getAttribute('data-id');
          if (!confirm('Remove this annotation?')) return;
          withBusy(btn, '…', () => api({ action: 'remove-annotation', key, id }));
          return;
        }
        if (act === 'check-one') {
          // Rank check only re-checks keyword positions — the listing itself
          // hasn't changed, so this must NOT trigger a fresh (paid) ASO audit.
          withBusy(btn, 'Checking…', () => api({ action: 'check', key }));
          return;
        }
        if (act === 'recheck-aso') {
          const app = state.apps.find((a) => a.key === key);
          if (app) withBusy(btn, 'Checking…', async () => { await checkAsoFor(app); return null; });
          return;
        }
        if (act === 'pdf') { window.print(); return; }
        if (act === 'discover') {
          withBusy(btn, 'Scanning stores… 1–2 min', async () => {
            const data = await api({ action: 'discover', key });
            DISCOVER[key] = data;
            render();
            return null;
          });
          return;
        }
        if (act === 'dismiss-discover') { delete DISCOVER[key]; render(); return; }
        if (act === 'track-selected') {
          const selected = [...card.querySelectorAll('[data-role="disc-kw"]:checked')].map((el) => el.value);
          if (!selected.length) { showErr('Tick at least one keyword to track.'); return; }
          const beforeCount = (state.apps.find((a) => a.key === key) || {}).keywords?.length || 0;
          withBusy(btn, 'Adding & checking ranks…', async () => {
            const data = await api({ action: 'add-keywords', key, keywords: selected.join('\n') });
            delete DISCOVER[key];
            const afterCount = (data.apps.find((a) => a.key === key) || {}).keywords?.length || 0;
            const actuallyAdded = afterCount - beforeCount;
            if (data.checkError) showInfo(data.checkError);
            else if (actuallyAdded < selected.length) showInfo(`Added ${actuallyAdded} of ${selected.length} selected — your plan's keyword-per-app limit is reached. Remove some tracked keywords or upgrade to add the rest.`);
            else showToast(selected.length + ' keyword(s) now tracked');
            const tracked = data.apps.find((a) => a.key === key);
            if (tracked) checkAsoFor(tracked);
            return data;
          });
          return;
        }
        if (act === 'remove') {
          if (!confirm('Stop tracking this app? Its saved history stays on disk but will no longer be shown.')) return;
          withBusy(btn, 'Removing…', () => api({ action: 'remove-app', key }));
        }
      });

      // CSV export: one row per app × keyword with today's rank + delta + best.
      $('csv-btn').addEventListener('click', () => {
        const rows = [['App', 'Store', 'Country', 'Keyword', 'Rank', 'Δ vs last check', 'Best', '#1 for keyword']];
        for (const app of state.apps) {
          for (const t of app.trends || []) {
            rows.push([
              app.title, app.store === 'play' ? 'Google Play' : 'App Store', (app.country || '').toUpperCase(),
              t.keyword, t.position != null ? t.position : '', t.delta != null ? t.delta : '',
              t.best != null ? t.best : '', (t.top && t.top[0] && t.top[0].title) || '',
            ]);
          }
        }
        if (rows.length === 1) { showToast('Nothing to export yet'); return; }
        const cell = (v) => { const s = String(v == null ? '' : v); return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
        const blob = new Blob(['﻿' + rows.map((r) => r.map(cell).join(',')).join('\r\n')], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `app-rankings-${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(a.href);
        showToast('CSV downloaded');
      });

      const logoutBtn = document.getElementById('logout');
      if (logoutBtn) logoutBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        await fetch('/api/auth/logout', { method: 'POST' });
        location.href = '/';
      });

      const userTrigger = document.getElementById('usertrigger');
      const userDropdown = document.getElementById('userdropdown');
      if (userTrigger && userDropdown) {
        userTrigger.addEventListener('click', (e) => { e.stopPropagation(); userDropdown.classList.toggle('open'); });
        document.addEventListener('click', (e) => { if (!userDropdown.contains(e.target) && e.target !== userTrigger) userDropdown.classList.remove('open'); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') userDropdown.classList.remove('open'); });
      }

      const kwmodalBackdrop = $('kwmodal-backdrop');
      kwmodalBackdrop.addEventListener('click', (ev) => {
        if (ev.target === kwmodalBackdrop || ev.target.closest('[data-act="close-kwmodal"]')) closeKeywordHistory();
      });
      document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeKeywordHistory(); });

      refresh().catch((e) => showErr('Could not load tracker state: ' + (e && e.message ? e.message : e)));
    </script>
  </body>
</html>
