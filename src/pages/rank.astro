---
// Keyword Rank Tracker — Google Play (Android).
// Given your app + competitor apps + a keyword list, checks each keyword's live
// Play Store search results and reports the position of every app (or "not found").
// Optionally also checks a category's Top Free chart as a separate, non-keyword signal.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>CiteRank — Keyword Rank Tracker for Google Play</title>
    <meta name="description" content="Check where your Google Play app ranks vs competitors for a list of keywords, plus category Top Chart position." />
    <style is:global>
      :root {
        --pink: #6366f1; --pink-dark: #4f46e5; --ink: #1d1f2b; --muted: #6b6f80;
        --line: #e7e8ef; --bg: #f4f5fb; --card: #ffffff;
        --ok: #15a06a; --ok-bg: #e7f6ef; --warn: #c98a00; --warn-bg: #fdf3dd;
        --bad: #d63a3a; --bad-bg: #fdecec; --na: #9aa0ad; --indigo: #5b46c9;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.5; }
      header { background: linear-gradient(125deg, #6366f1 0%, #8b5cf6 60%, #a78bfa 100%); color: #fff; padding: 30px 20px 34px; }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
      header h1 { margin: 0 0 8px; font-size: 27px; font-weight: 800; letter-spacing: -0.02em; }
      header p { margin: 0; opacity: 0.96; font-size: 15px; max-width: 780px; }
      .brandbar { display: flex; align-items: center; gap: 9px; margin-bottom: 14px; flex-wrap: wrap; }
      .brandbar .logo { width: 26px; height: 26px; border-radius: 8px; background: rgba(255,255,255,0.22); border: 1px solid rgba(255,255,255,0.4); display: grid; place-items: center; font-size: 13px; }
      .brandbar .wordmark { font-size: 19px; font-weight: 800; letter-spacing: -0.02em; }
      .brandbar .by { font-size: 11.5px; font-weight: 600; opacity: 0.9; }
      nav.top { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; }
      nav.top a { color: #fff; text-decoration: none; font-size: 13px; font-weight: 600; background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.3); padding: 7px 13px; border-radius: 9px; }
      nav.top a.active { background: #fff; color: var(--pink-dark); }
      main { padding: 26px 0 64px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 18px; box-shadow: 0 2px 8px rgba(20,20,40,0.05); }
      label.fld { display: block; font-size: 12.5px; color: var(--muted); font-weight: 600; margin: 12px 0 5px; }
      input[type=text], textarea { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: 13.5px; color: var(--ink); background: #fcfcfe; outline: none; font-family: inherit; }
      textarea { min-height: 90px; resize: vertical; font-size: 13px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      input:focus, textarea:focus { border-color: var(--pink); box-shadow: 0 0 0 3px rgba(99,102,241,0.12); }
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .three { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 12px; }
      @media (max-width: 720px) { .two, .three { grid-template-columns: 1fr; } }
      .hint { font-size: 11.5px; color: var(--muted); margin-top: 5px; }
      .row { display: flex; align-items: center; gap: 14px; margin-top: 18px; flex-wrap: wrap; }
      button.primary { background: var(--pink); color: #fff; border: none; border-radius: 11px; padding: 13px 24px; font-size: 15px; font-weight: 700; cursor: pointer; box-shadow: 0 2px 10px rgba(99,102,241,0.35); }
      button.primary:hover { background: var(--pink-dark); }
      button.primary:disabled { opacity: 0.6; cursor: not-allowed; box-shadow: none; }
      .ghostbtn { background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 9px; padding: 9px 14px; font-size: 13px; font-weight: 700; cursor: pointer; }
      .ghostbtn:hover { border-color: var(--pink); color: var(--pink); }
      .spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.5); border-top-color: #fff; border-radius: 50%; display: inline-block; vertical-align: -3px; margin-right: 8px; animation: spin 0.7s linear infinite; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .alert { margin-top: 16px; padding: 12px 14px; border-radius: 10px; font-size: 13.5px; display: none; }
      .alert.err { background: var(--bad-bg); color: #b3261e; border: 1px solid #f6c9c6; }
      .alert.info { background: var(--warn-bg); color: #8a5d00; border: 1px solid #f3e0b0; }
      #results { margin-top: 26px; display: none; }
      .sectitle { font-size: 15px; font-weight: 800; margin: 26px 0 12px; display: flex; align-items: center; gap: 8px; }
      .sectitle .sub { font-weight: 500; color: var(--muted); font-size: 12.5px; }
      .legend { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; font-size: 12px; color: var(--muted); }
      .legend b { color: var(--ink); }
      .tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: #fff; }
      table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 640px; }
      th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
      th { background: #f6f7fb; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); position: sticky; top: 0; }
      tr:last-child td { border-bottom: none; }
      td.kwcell { white-space: normal; font-weight: 600; min-width: 160px; }
      td.rankcell { text-align: center; font-weight: 800; }
      .rankpill { display: inline-block; min-width: 30px; padding: 3px 9px; border-radius: 999px; font-size: 12.5px; font-weight: 800; }
      .rankpill.top { background: var(--ok-bg); color: var(--ok); }
      .rankpill.mid { background: var(--warn-bg); color: var(--warn); }
      .rankpill.low { background: #eef0f5; color: var(--muted); }
      .rankpill.none { background: var(--bad-bg); color: var(--bad); }
      .rankpill.err { background: #eef0f5; color: var(--na); font-weight: 600; font-size: 11px; }
      .apphead { display: flex; gap: 6px; align-items: baseline; font-size: 12px; font-weight: 700; color: var(--muted); flex-direction: column; }
      .apphead .atitle { font-size: 13px; color: var(--ink); }
      .apphead a { color: var(--pink-dark); text-decoration: none; font-size: 10.5px; font-weight: 600; }
      .me-col { background: #f3f1ff; }
      .caveat { margin-top: 20px; font-size: 12px; color: var(--muted); background: #eef0f7; border-radius: 12px; padding: 12px 14px; }
      .caveat b { color: var(--ink); }
      footer { text-align: center; color: var(--muted); font-size: 12.5px; padding: 26px; }

      .modetabs { display: flex; gap: 8px; margin-bottom: 4px; }
      .modetab { padding: 8px 14px; border-radius: 9px; border: 1px solid var(--line); background: #fff; cursor: pointer; font-size: 13px; font-weight: 700; color: var(--muted); }
      .modetab.active { border-color: var(--pink); color: var(--pink); background: #f0f1fe; }
      .sheetstatus { font-size: 11.5px; font-weight: 700; padding: 3px 10px; border-radius: 999px; margin-left: auto; }
      .sheetstatus.on { background: var(--ok-bg); color: var(--ok); }
      .sheetstatus.off { background: var(--warn-bg); color: var(--warn); }
      .modehead { display: flex; align-items: center; gap: 10px; }
      .writeback { margin-top: 16px; padding: 12px 14px; border-radius: 10px; font-size: 13.5px; background: var(--ok-bg); color: #0d6b48; border: 1px solid #bfe8d5; display: none; }
      .writeback a { color: #0d6b48; font-weight: 700; }

      .pagetabs { display: flex; gap: 10px; margin-bottom: 18px; }
      .pagetab { padding: 10px 18px; border-radius: 10px; border: 1px solid var(--line); background: #fff; cursor: pointer; font-size: 14px; font-weight: 700; color: var(--muted); }
      .pagetab.active { border-color: var(--pink); color: var(--pink); background: #f0f1fe; }
      .trackerlist { display: grid; gap: 10px; margin-top: 10px; }
      .trackerrow { display: flex; align-items: center; gap: 14px; border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; background: #fff; cursor: pointer; }
      .trackerrow:hover { border-color: var(--pink); }
      .trackerrow .tname { font-weight: 800; font-size: 14.5px; }
      .trackerrow .tmeta { font-size: 12px; color: var(--muted); }
      .trackerrow .tlast { margin-left: auto; font-size: 12px; color: var(--muted); text-align: right; white-space: nowrap; }
      .empty { text-align: center; color: var(--muted); font-size: 13.5px; padding: 30px 10px; }
      .cardhead { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .cardhead h3 { margin: 0; font-size: 16px; }
      .backlink { color: var(--pink-dark); font-weight: 700; font-size: 13px; cursor: pointer; }
      .detailhead { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
      .detailhead h2 { margin: 0; font-size: 19px; }
      .detailactions { margin-left: auto; display: flex; gap: 8px; }
      .dangerbtn { background: #fff; color: var(--bad); border: 1px solid #f6c9c6; border-radius: 9px; padding: 9px 14px; font-size: 13px; font-weight: 700; cursor: pointer; }
      .dangerbtn:hover { background: var(--bad-bg); }
      .histcell { text-align: center; }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <div class="brandbar">
          <span class="logo">◆</span>
          <span class="wordmark">CiteRank</span>
          <span class="by">By Rudra Kasturi Inc</span>
        </div>
        <h1>Keyword Rank Tracker — Google Play</h1>
        <p>Save your app, its competitors, and a list of keywords once — the tool checks Play's live search results automatically every day and keeps the history, so you can just come back and see where you rank.</p>
        <nav class="top">
          <a href="/">✍️ Topic Engine</a>
          <a href="/audit">🔎 AEO Auditor</a>
          <a href="/aso">📱 ASO Inspector</a>
          <a href="/rank" class="active">📶 Rank Tracker</a>
          <a href="/wbr">📊 WBR Builder</a>
          <a href="/snapshot">🎯 Snapshot</a>
          <a href="/measure">📡 Live AEO</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <div class="pagetabs">
          <div class="pagetab active" id="pagetab-trackers" data-page="trackers">📌 Saved Trackers</div>
          <div class="pagetab" id="pagetab-oneoff" data-page="oneoff">🔍 One-off Check</div>
        </div>

        <div id="page-trackers">
          <div class="card" id="tracker-list-card">
            <div class="cardhead">
              <h3>Your trackers</h3>
              <button class="primary" id="new-tracker-btn" style="padding:9px 16px;font-size:13.5px">+ New tracker</button>
            </div>
            <p class="hint" style="margin-top:6px">Each tracker is checked automatically once a day. No setup beyond saving it here — no Sheets, no service account.</p>
            <div class="trackerlist" id="tracker-list"><div class="empty">Loading…</div></div>
          </div>

          <div class="card" id="tracker-form-card" style="display:none;margin-top:16px">
            <div class="cardhead">
              <h3>New tracker</h3>
              <span class="backlink" id="cancel-tracker-form">Cancel</span>
            </div>
            <label class="fld" for="t-name">Name <span style="font-weight:400">(just a label for you)</span></label>
            <input id="t-name" type="text" placeholder="e.g. CRED" />

            <label class="fld" for="t-primary">Your app — Play Store URL or package id</label>
            <input id="t-primary" type="text" placeholder="https://play.google.com/store/apps/details?id=com.dreamplug.androidapp" />

            <label class="fld" for="t-competitors">Competitor apps <span style="font-weight:400">(one URL or package id per line, up to 5)</span></label>
            <textarea id="t-competitors" placeholder="https://play.google.com/store/apps/details?id=com.competitor.app"></textarea>

            <label class="fld" for="t-keywords">Keywords <span style="font-weight:400">(one per line, up to 50)</span></label>
            <textarea id="t-keywords" placeholder="instant loan online app
credit score free check
emi calculator"></textarea>

            <div class="three" style="margin-top:4px">
              <div>
                <label class="fld" for="t-category">Category <span style="font-weight:400">(optional)</span></label>
                <input id="t-category" type="text" placeholder="FINANCE" />
              </div>
              <div>
                <label class="fld" for="t-country">Country</label>
                <input id="t-country" type="text" value="in" />
              </div>
              <div>
                <label class="fld" for="t-lang">Language</label>
                <input id="t-lang" type="text" value="en" />
              </div>
            </div>

            <div class="row">
              <button class="primary" id="save-tracker-btn">Save & check now</button>
            </div>
            <div class="alert err" id="t-err"></div>
            <div class="alert info" id="t-info"></div>
          </div>

          <div id="tracker-detail" style="display:none;margin-top:16px">
            <div class="detailhead">
              <span class="backlink" id="detail-back">← All trackers</span>
              <h2 id="detail-name"></h2>
              <div class="detailactions">
                <button class="ghostbtn" id="detail-recheck">🔄 Recheck now</button>
                <button class="dangerbtn" id="detail-delete">Delete</button>
              </div>
            </div>
            <p class="hint" id="detail-meta"></p>
            <div class="alert err" id="detail-err"></div>

            <div class="sectitle">🔎 Latest rankings <span class="sub" id="detail-lastchecked"></span></div>
            <p class="hint" style="margin:-4px 0 10px">Checks up to position <b>250</b> in Play's live search results per keyword. "Not found" means the app isn't in the top 250 for that exact term.</p>
            <div class="tablewrap"><table id="detail-kw-table">
              <thead><tr id="detail-kw-thead"></tr></thead>
              <tbody id="detail-kw-tbody"></tbody>
            </table></div>

            <div class="sectitle">🏁 Top competing apps <span class="sub">— apps you didn't add, that keep showing up near the top of your keywords</span></div>
            <div class="tablewrap"><table id="detail-comp-table">
              <thead><tr><th>App</th><th class="rankcell">Appears in</th><th class="rankcell">Avg. position</th><th class="rankcell">Best position</th></tr></thead>
              <tbody id="detail-comp-tbody"></tbody>
            </table></div>

            <div class="sectitle">📈 History <span class="sub">— your app's rank per keyword, one column per day checked</span></div>
            <div class="tablewrap"><table id="detail-hist-table">
              <thead><tr id="detail-hist-thead"></tr></thead>
              <tbody id="detail-hist-tbody"></tbody>
            </table></div>
          </div>
        </div>

        <div id="page-oneoff" style="display:none">
        <div class="card" id="inputcard">
          <div class="modehead">
            <div class="modetabs">
              <div class="modetab active" id="tab-manual" data-mode="manual">✍️ Paste keywords</div>
              <div class="modetab" id="tab-sheet" data-mode="sheet">📄 From Google Sheet</div>
            </div>
            <span class="sheetstatus off" id="sheet-status" style="display:none">Checking…</span>
          </div>

          <label class="fld" for="primary">Your app — Play Store URL or package id</label>
          <input id="primary" type="text" placeholder="https://play.google.com/store/apps/details?id=com.dreamplug.androidapp" />

          <label class="fld" for="competitors">Competitor apps <span style="font-weight:400">(one URL or package id per line, up to 5)</span></label>
          <textarea id="competitors" placeholder="https://play.google.com/store/apps/details?id=com.competitor.app
com.another.competitor"></textarea>

          <div id="mode-manual">
            <label class="fld" for="keywords">Keywords <span style="font-weight:400">(one per line, up to 50)</span></label>
            <textarea id="keywords" placeholder="instant loan online app
credit score free check
emi calculator"></textarea>
            <div class="hint" id="kw-count">0 keywords</div>
          </div>

          <div id="mode-sheet" style="display:none">
            <label class="fld" for="sheetUrl">Google Sheet URL</label>
            <input id="sheetUrl" type="text" placeholder="https://docs.google.com/spreadsheets/d/.../edit#gid=..." />
            <div class="two" style="margin-top:4px">
              <div>
                <label class="fld" for="keywordHeader">Keyword column header</label>
                <input id="keywordHeader" type="text" value="Focused Keyword" />
              </div>
            </div>
            <div class="hint" id="sheet-hint">Reads every non-empty cell under that column header, checks each keyword, then writes a new dated rank column per app back into this same sheet. The sheet must be shared (Editor access) with the service account below.</div>
          </div>

          <div class="three" style="margin-top:4px">
            <div>
              <label class="fld" for="category">Category <span style="font-weight:400">(optional — for Top Chart check)</span></label>
              <input id="category" type="text" placeholder="https://play.google.com/store/apps/category/FINANCE  —or—  FINANCE" />
            </div>
            <div>
              <label class="fld" for="country">Country</label>
              <input id="country" type="text" value="in" />
            </div>
            <div>
              <label class="fld" for="lang">Language</label>
              <input id="lang" type="text" value="en" />
            </div>
          </div>

          <div class="row">
            <button class="primary" id="go">Check rankings</button>
          </div>
          <div class="alert err" id="err"></div>
          <div class="alert info" id="info"></div>
        </div>

        <section id="results">
          <div class="writeback" id="writeback"></div>
          <div class="sectitle">🔎 Keyword search rank <span class="sub">— position in Play's live search results for each keyword</span></div>
          <div class="legend">
            <span class="rankpill top">1–10</span>
            <span class="rankpill mid">11–30</span>
            <span class="rankpill low">31–250</span>
            <span class="rankpill none">Not found</span>
          </div>
          <p class="hint" style="margin:-4px 0 10px">Checks up to position <b>250</b> in Play's live search results for each keyword (Play's own scraping ceiling — it doesn't expose deeper results). "Not found" means the app isn't in the top 250 for that exact term, in the chosen country/language.</p>
          <div class="tablewrap"><table id="kw-table">
            <thead><tr id="kw-thead"></tr></thead>
            <tbody id="kw-tbody"></tbody>
          </table></div>

          <div id="cat-section" style="display:none">
            <div class="sectitle">🏆 Category Top Chart <span class="sub" id="cat-sub"></span></div>
            <p class="hint" style="margin:-4px 0 10px">This is <b>not</b> keyword-specific — it's Play's Top Free chart position for the whole category.</p>
            <div class="tablewrap"><table id="cat-table">
              <thead><tr><th>App</th><th class="rankcell">Chart position</th></tr></thead>
              <tbody id="cat-tbody"></tbody>
            </table></div>
          </div>

          <div id="comp-section" style="display:none">
            <div class="sectitle">🏁 Top competing apps <span class="sub">— apps you didn't add, that keep showing up near the top of your keywords</span></div>
            <div class="tablewrap"><table id="comp-table">
              <thead><tr><th>App</th><th class="rankcell">Appears in</th><th class="rankcell">Avg. position</th><th class="rankcell">Best position</th></tr></thead>
              <tbody id="comp-tbody"></tbody>
            </table></div>
          </div>

          <div class="caveat" id="caveat"></div>
        </section>
        </div>
      </div>
    </main>

    <footer><b>CiteRank</b> · By Rudra Kasturi Inc · Google Play keyword rank tracking</footer>

    <script>
      const $ = (id) => document.getElementById(id);
      let mode = 'manual';
      let sheetsConnected = false;

      function esc(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function countLines(blob) {
        return blob.split(/\n+/).map((s) => s.trim()).filter(Boolean).length;
      }
      $('keywords').addEventListener('input', () => {
        $('kw-count').textContent = countLines($('keywords').value) + ' keywords';
      });

      function hideAlerts() { $('err').style.display = 'none'; $('info').style.display = 'none'; }
      function showErr(msg) { const e = $('err'); e.textContent = msg; e.style.display = 'block'; }

      function setMode(next) {
        mode = next;
        $('tab-manual').classList.toggle('active', mode === 'manual');
        $('tab-sheet').classList.toggle('active', mode === 'sheet');
        $('mode-manual').style.display = mode === 'manual' ? 'block' : 'none';
        $('mode-sheet').style.display = mode === 'sheet' ? 'block' : 'none';
        $('go').textContent = mode === 'sheet' ? 'Check rankings & write to sheet' : 'Check rankings';
        $('writeback').style.display = 'none';
      }
      $('tab-manual').addEventListener('click', () => setMode('manual'));
      $('tab-sheet').addEventListener('click', () => setMode('sheet'));

      async function checkSheetStatus() {
        const badge = $('sheet-status');
        badge.style.display = 'inline-block';
        try {
          const res = await fetch('/api/rank-sheet');
          const data = await res.json();
          sheetsConnected = Boolean(data.connected);
          if (sheetsConnected) {
            badge.textContent = '✓ Sheets connected';
            badge.className = 'sheetstatus on';
            $('sheet-hint').textContent = `Reads every non-empty cell under that column header, checks each keyword, then writes a new dated rank column per app back into this same sheet. Share the sheet (Editor access) with: ${data.serviceAccountEmail || 'the service account'}.`;
          } else {
            badge.textContent = '⚠ Sheets not connected';
            badge.className = 'sheetstatus off';
            $('sheet-hint').textContent = data.reason || 'Google Sheets isn\'t connected on this server yet — see DEPLOY.md.';
          }
        } catch {
          badge.style.display = 'none';
        }
      }
      checkSheetStatus();

      function rankClass(pos) {
        if (pos == null) return 'none';
        if (pos <= 10) return 'top';
        if (pos <= 30) return 'mid';
        return 'low';
      }
      function rankLabel(pos) { return pos == null ? 'Not found' : '#' + pos; }

      function renderTopCompetitors(tbodyId, sectionId, list) {
        const section = sectionId ? $(sectionId) : null;
        if (!list || !list.length) {
          if (section) { section.style.display = 'none'; $(tbodyId).innerHTML = ''; }
          else { $(tbodyId).innerHTML = '<tr><td colspan="4">No other apps showed up in the top 10 across these keywords.</td></tr>'; }
          return;
        }
        if (section) section.style.display = 'block';
        $(tbodyId).innerHTML = list.map((c) => `
          <tr>
            <td><a href="https://play.google.com/store/apps/details?id=${esc(c.appId)}" target="_blank" rel="noopener">${esc(c.title)}</a></td>
            <td class="rankcell">${c.appearances}/${c.outOf}</td>
            <td class="rankcell">${c.avgPosition}</td>
            <td class="rankcell">#${c.bestPosition}</td>
          </tr>`).join('');
      }

      function render(data) {
        const apps = [data.primary, ...data.competitors];

        const wb = $('writeback');
        if (data.sheetUrl) {
          wb.style.display = 'block';
          wb.innerHTML = `✅ Wrote ${esc((data.writtenColumns || []).join(', '))} into <a href="${esc(data.sheetUrl)}" target="_blank" rel="noopener">${esc(data.sheetTitle || 'the sheet')}</a>.`;
        } else {
          wb.style.display = 'none';
        }

        // Keyword table header
        const thead = $('kw-thead');
        thead.innerHTML = '<th>Keyword</th>' + apps.map((a, i) => `
          <th class="${i === 0 ? 'me-col' : ''}">
            <div class="apphead">
              <span class="atitle">${esc(a.title)}${i === 0 ? ' (you)' : ''}</span>
              <a href="${esc(a.url)}" target="_blank" rel="noopener">${esc(a.appId)}</a>
            </div>
          </th>`).join('');

        const tbody = $('kw-tbody');
        tbody.innerHTML = data.keywords.map((k) => {
          const cells = apps.map((a, i) => {
            if (k.error) return `<td class="rankcell ${i === 0 ? 'me-col' : ''}"><span class="rankpill err" title="${esc(k.error)}">error</span></td>`;
            const pos = k.ranks[a.appId];
            return `<td class="rankcell ${i === 0 ? 'me-col' : ''}"><span class="rankpill ${rankClass(pos)}">${rankLabel(pos)}</span></td>`;
          }).join('');
          return `<tr><td class="kwcell">${esc(k.keyword)}</td>${cells}</tr>`;
        }).join('');

        // Category table
        const catSection = $('cat-section');
        if (data.category) {
          catSection.style.display = 'block';
          $('cat-sub').textContent = `— ${data.category.category} · ${data.category.collection}`;
          const catBody = $('cat-tbody');
          if (data.category.error) {
            catBody.innerHTML = `<tr><td colspan="2">Couldn't load the category chart: ${esc(data.category.error)}</td></tr>`;
          } else {
            catBody.innerHTML = apps.map((a) => {
              const pos = data.category.ranks[a.appId];
              return `<tr><td>${esc(a.title)}</td><td class="rankcell"><span class="rankpill ${rankClass(pos)}">${rankLabel(pos)}</span></td></tr>`;
            }).join('');
          }
        } else {
          catSection.style.display = 'none';
        }

        renderTopCompetitors('comp-tbody', 'comp-section', data.topCompetitors);

        // Caveats
        const notes = [];
        if (data.meta.truncated) notes.push(`Only the first ${data.meta.keywordsRun} of ${data.meta.keywordCount} keywords were checked (limit ${data.meta.keywordsRun}/run).`);
        if (data.meta.keywordErrors) notes.push(`${data.meta.keywordErrors} keyword(s) failed to load from Play Store search (shown as "error" above) — usually a temporary block/throttle; try again in a bit.`);
        if (data.meta.skippedDuplicateHeader) notes.push(`Skipped ${data.meta.skippedDuplicateHeader} row(s) in the sheet where the keyword cell just repeated the column header text ("${esc($('keywordHeader').value.trim() || 'Focused Keyword')}") instead of a real keyword — check that column for accidentally duplicated/copy-pasted header cells.`);
        notes.push('<b>Keyword search rank</b> = each app\'s position in Play\'s own search results for that exact term, in the chosen country/language. <b>Category Top Chart</b> is a separate, non-keyword signal (installs/engagement based) — Play does not expose "rank within a category, for this keyword" as a single lookup.');
        $('caveat').innerHTML = notes.map((n) => `<div>${n}</div>`).join('');

        $('results').style.display = 'block';
        $('results').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      async function run() {
        hideAlerts();
        const primary = $('primary').value.trim();
        const competitors = $('competitors').value;
        const category = $('category').value.trim();
        const country = $('country').value.trim() || 'in';
        const lang = $('lang').value.trim() || 'en';

        if (!primary) { showErr('Enter your app\'s Play Store URL or package id.'); return; }

        let endpoint = '/api/rank';
        let payload = {};
        if (mode === 'sheet') {
          const sheetUrl = $('sheetUrl').value.trim();
          const keywordHeader = $('keywordHeader').value.trim() || 'Focused Keyword';
          if (!sheetUrl) { showErr('Paste the Google Sheet URL.'); return; }
          if (!sheetsConnected) { showErr('Google Sheets isn\'t connected on this server yet — see the hint below the tabs.'); return; }
          endpoint = '/api/rank-sheet';
          payload = { primary, competitors, sheetUrl, keywordHeader, category, country, lang };
        } else {
          const keywords = $('keywords').value;
          if (!countLines(keywords)) { showErr('Add at least one keyword (one per line).'); return; }
          payload = { primary, competitors, keywords, category, country, lang };
        }

        const btn = $('go');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>' + (mode === 'sheet' ? 'Reading sheet & checking rankings…' : 'Checking Play Store search results…');
        $('info').textContent = mode === 'sheet'
          ? 'Reading keywords from the sheet, querying Play Store one keyword at a time, then writing the results back — this can take a while for many keywords.'
          : 'Querying Play Store for each keyword — this runs one at a time and can take a while for many keywords.';
        $('info').style.display = 'block';

        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) {
            showErr(data.error || 'Something went wrong. Please try again.');
            if (data.keywords) render(data);
          } else {
            hideAlerts();
            render(data);
          }
        } catch (e) {
          showErr('Network error: ' + (e && e.message ? e.message : e));
        } finally {
          btn.disabled = false;
          btn.textContent = mode === 'sheet' ? 'Check rankings & write to sheet' : 'Check rankings';
        }
      }

      $('go').addEventListener('click', run);

      // ---- page-level tabs (Saved Trackers vs One-off Check) ----
      function setPage(page) {
        $('pagetab-trackers').classList.toggle('active', page === 'trackers');
        $('pagetab-oneoff').classList.toggle('active', page === 'oneoff');
        $('page-trackers').style.display = page === 'trackers' ? 'block' : 'none';
        $('page-oneoff').style.display = page === 'oneoff' ? 'block' : 'none';
      }
      $('pagetab-trackers').addEventListener('click', () => setPage('trackers'));
      $('pagetab-oneoff').addEventListener('click', () => setPage('oneoff'));

      // ---- saved trackers list ----
      let trackers = [];

      async function loadTrackers() {
        const list = $('tracker-list');
        try {
          const res = await fetch('/api/trackers');
          const data = await res.json();
          trackers = data.trackers || [];
          if (!trackers.length) {
            list.innerHTML = '<div class="empty">No trackers yet — click "+ New tracker" to add your first app.</div>';
            return;
          }
          list.innerHTML = trackers.map((t) => `
            <div class="trackerrow" data-id="${esc(t.id)}">
              <div>
                <div class="tname">${esc(t.name)}</div>
                <div class="tmeta">${esc(t.primary)} · ${t.keywordCount} keyword${t.keywordCount === 1 ? '' : 's'}${t.competitorCount ? ' · ' + t.competitorCount + ' competitor' + (t.competitorCount === 1 ? '' : 's') : ''}</div>
              </div>
              <div class="tlast">${t.lastRun ? 'Last checked ' + esc(t.lastRun.date) : 'Not checked yet'}</div>
            </div>`).join('');
          list.querySelectorAll('.trackerrow').forEach((row) => {
            row.addEventListener('click', () => openTracker(row.getAttribute('data-id')));
          });
        } catch (e) {
          list.innerHTML = '<div class="empty">Couldn\'t load trackers: ' + esc(e && e.message ? e.message : e) + '</div>';
        }
      }
      loadTrackers();

      // ---- new tracker form ----
      function showTrackerForm(show) {
        $('tracker-form-card').style.display = show ? 'block' : 'none';
        $('tracker-list-card').style.display = show ? 'none' : 'block';
        if (show) {
          ['t-name', 't-primary', 't-competitors', 't-keywords', 't-category'].forEach((id) => { $(id).value = ''; });
          $('t-country').value = 'in';
          $('t-lang').value = 'en';
          $('t-err').style.display = 'none';
          $('t-info').style.display = 'none';
        }
      }
      $('new-tracker-btn').addEventListener('click', () => showTrackerForm(true));
      $('cancel-tracker-form').addEventListener('click', () => showTrackerForm(false));

      $('save-tracker-btn').addEventListener('click', async () => {
        $('t-err').style.display = 'none';
        const name = $('t-name').value.trim();
        const primary = $('t-primary').value.trim();
        const competitors = $('t-competitors').value;
        const keywords = $('t-keywords').value;
        const category = $('t-category').value.trim();
        const country = $('t-country').value.trim() || 'in';
        const lang = $('t-lang').value.trim() || 'en';

        if (!primary) { $('t-err').textContent = 'Enter your app\'s Play Store URL or package id.'; $('t-err').style.display = 'block'; return; }
        if (!countLines(keywords)) { $('t-err').textContent = 'Add at least one keyword (one per line).'; $('t-err').style.display = 'block'; return; }

        const btn = $('save-tracker-btn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>Saving & checking…';
        $('t-info').textContent = 'Saving the tracker and running the first check now — this can take a bit for many keywords.';
        $('t-info').style.display = 'block';

        try {
          const res = await fetch('/api/trackers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, primary, competitors, keywords, category, country, lang }),
          });
          const data = await res.json();
          if (!res.ok) {
            $('t-err').textContent = data.error || 'Something went wrong.';
            $('t-err').style.display = 'block';
            $('t-info').style.display = 'none';
            return;
          }
          showTrackerForm(false);
          await loadTrackers();
          openTracker(data.tracker.id);
        } catch (e) {
          $('t-err').textContent = 'Network error: ' + (e && e.message ? e.message : e);
          $('t-err').style.display = 'block';
        } finally {
          btn.disabled = false;
          btn.textContent = 'Save & check now';
          $('t-info').style.display = 'none';
        }
      });

      // ---- tracker detail ----
      let currentTrackerId = null;

      async function openTracker(id) {
        currentTrackerId = id;
        $('tracker-list-card').style.display = 'none';
        $('tracker-form-card').style.display = 'none';
        $('tracker-detail').style.display = 'block';
        $('detail-err').style.display = 'none';
        $('detail-name').textContent = 'Loading…';
        $('detail-kw-tbody').innerHTML = '';
        $('detail-hist-tbody').innerHTML = '';
        try {
          const res = await fetch('/api/trackers/' + id);
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to load tracker.');
          renderTrackerDetail(data);
        } catch (e) {
          $('detail-err').textContent = e && e.message ? e.message : String(e);
          $('detail-err').style.display = 'block';
        }
      }

      function renderTrackerDetail(data) {
        const t = data.tracker;
        $('detail-name').textContent = t.name;
        $('detail-meta').textContent = `${t.primary} · ${t.keywords.length} keyword(s)${t.competitors.length ? ' · vs ' + t.competitors.length + ' competitor(s)' : ''}${t.category ? ' · category ' + t.category : ''} · ${t.country.toUpperCase()}/${t.lang}`;

        const run = data.run;
        if (!run) {
          $('detail-lastchecked').textContent = '— not checked yet';
          $('detail-kw-thead').innerHTML = '';
          $('detail-kw-tbody').innerHTML = '<tr><td>No data yet — click Recheck now.</td></tr>';
        } else {
          $('detail-lastchecked').textContent = '— as of ' + run.date;
          const apps = [run.primary, ...run.competitors];
          $('detail-kw-thead').innerHTML = '<th>Keyword</th>' + apps.map((a, i) => `
            <th class="${i === 0 ? 'me-col' : ''}">
              <div class="apphead">
                <span class="atitle">${esc(a.title)}${i === 0 ? ' (you)' : ''}</span>
                <a href="${esc(a.url)}" target="_blank" rel="noopener">${esc(a.appId)}</a>
              </div>
            </th>`).join('');
          $('detail-kw-tbody').innerHTML = run.keywords.map((k) => {
            const cells = apps.map((a, i) => {
              if (k.error) return `<td class="rankcell ${i === 0 ? 'me-col' : ''}"><span class="rankpill err" title="${esc(k.error)}">error</span></td>`;
              const pos = k.ranks[a.appId];
              return `<td class="rankcell ${i === 0 ? 'me-col' : ''}"><span class="rankpill ${rankClass(pos)}">${rankLabel(pos)}</span></td>`;
            }).join('');
            return `<tr><td class="kwcell">${esc(k.keyword)}</td>${cells}</tr>`;
          }).join('');
        }

        renderTopCompetitors('detail-comp-tbody', null, run ? run.topCompetitors : []);

        // History: rows = keywords, columns = dates (oldest -> newest), cell = primary app's rank that day.
        const history = data.history || [];
        if (!history.length) {
          $('detail-hist-thead').innerHTML = '';
          $('detail-hist-tbody').innerHTML = '<tr><td>No history yet — check back after the first automatic run.</td></tr>';
        } else {
          $('detail-hist-thead').innerHTML = '<th>Keyword</th>' + history.map((h) => `<th class="histcell">${esc(h.date)}</th>`).join('');
          $('detail-hist-tbody').innerHTML = t.keywords.map((kw) => {
            const cells = history.map((h) => {
              const pos = Object.prototype.hasOwnProperty.call(h.ranks, kw) ? h.ranks[kw] : undefined;
              return `<td class="histcell">${pos === undefined ? '–' : `<span class="rankpill ${rankClass(pos)}">${rankLabel(pos)}</span>`}</td>`;
            }).join('');
            return `<tr><td class="kwcell">${esc(kw)}</td>${cells}</tr>`;
          }).join('');
        }
      }

      $('detail-back').addEventListener('click', () => {
        $('tracker-detail').style.display = 'none';
        $('tracker-list-card').style.display = 'block';
        loadTrackers();
      });

      $('detail-recheck').addEventListener('click', async () => {
        if (!currentTrackerId) return;
        const btn = $('detail-recheck');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>Checking…';
        try {
          const res = await fetch('/api/trackers/' + currentTrackerId, { method: 'POST' });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Recheck failed.');
          await openTracker(currentTrackerId);
        } catch (e) {
          $('detail-err').textContent = e && e.message ? e.message : String(e);
          $('detail-err').style.display = 'block';
        } finally {
          btn.disabled = false;
          btn.textContent = '🔄 Recheck now';
        }
      });

      $('detail-delete').addEventListener('click', async () => {
        if (!currentTrackerId) return;
        if (!confirm('Delete this tracker and all its history?')) return;
        try {
          await fetch('/api/trackers/' + currentTrackerId, { method: 'DELETE' });
        } catch {}
        $('tracker-detail').style.display = 'none';
        $('tracker-list-card').style.display = 'block';
        loadTrackers();
      });
    </script>
  </body>
</html>
