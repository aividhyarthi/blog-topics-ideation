---
// Rank Tracker — App Radar-style keyword rank tracking for Google Play + App Store.
// Serves two audiences from one page: the internal (Nykaa) toolset, and the
// AppRankr product dashboard (product mode: branded header, trial banner,
// plan-based limits).
import { BRAND, planOf, checkAccess, INITIATIVE_NAME, SITE_URL } from '../lib/saas/plans';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { isGuest } from '../lib/saas/grants';
const product = Boolean(Astro.locals.productMode);
const user = Astro.locals.user || null;
// Read-only guest viewing an app someone shared with them (see grants.ts).
const guest = product && user ? isGuest(user, Astro.locals.wsMode) : false;
const plan = user ? planOf(user.plan) : null;
const access = user ? checkAccess(user.status, user.trialEndsAt) : null;
const limitsText = product && plan
  ? `Your ${plan.name} plan tracks up to ${plan.maxApps} of your own apps (${plan.maxCompetitorsPerApp} competitors each, which don't count towards the limit), ${plan.maxKeywordsPerApp} keywords each.`
  : 'Up to 15 apps, 60 keywords each.';
---

<!doctype html>
<html lang="en">
  <head>
    {product && <GoogleAnalytics />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{product ? `${BRAND} — Rank Tracker` : 'CiteRank — Rank Tracker'}</title>
    <meta name="description" content="Track where your apps rank in Google Play and App Store search for your keywords, with daily history and trends." />
    {product && <meta name="robots" content="noindex, nofollow" />}
    {product && <link rel="canonical" href={`${SITE_URL}/rank`} />}
    <style is:global>
      /* Console layout (card-based, KPI chips, dense tables) on a light
         ground — every surface/border/text color is a token, so this is
         the only place a future theme change needs to touch. */
      :root {
        --bg: #f7f8fa; --card: #ffffff; --card2: #f3f4f6;
        --line: #e5e7eb; --line2: #cbd0da;
        --ink: #16181d; --muted: #6b7280;
        --accent: #16181d; --accent-dark: #000000; --accent-ink: #ffffff;
        --tint: #eceef1;
        --ok: #0a8a5f; --ok-tint: #e6f5ef;
        --bad: #c0392b; --bad-tint: #fdecec;
        --blue: #364fc7; --blue-tint: #eaeeff;
        --warn: #b8790a; --warn-tint: #fdf3e0;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.5; font-size: 14px; }
      header { background: var(--card); color: var(--ink); border-bottom: 1px solid var(--line); padding: 14px 20px; }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
      header h1 { margin: 0 0 4px; font-size: 19px; font-weight: 700; letter-spacing: -0.01em; }
      header p { margin: 0; color: var(--muted); font-size: 13px; max-width: 780px; }
      nav.top { margin-top: 12px; display: flex; gap: 2px; flex-wrap: wrap; align-items: center; }
      nav.top a { color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 600; background: none; border: 1px solid transparent; padding: 6px 11px; border-radius: 7px; }
      nav.top a:hover { color: var(--ink); background: var(--card2); }
      nav.top a.active { color: var(--accent); background: var(--tint); }
      .usermenu { position: relative; margin-left: auto; }
      .usertrigger { color: var(--muted); font-size: 13px; font-weight: 600; background: none; border: 1px solid var(--line); padding: 6px 11px; border-radius: 7px; cursor: pointer; font-family: inherit; max-width: 46vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .usertrigger:hover { border-color: var(--line2); color: var(--ink); }
      .usertrigger .caret { opacity: 0.7; }
      .userdropdown { display: none; position: absolute; right: 0; top: calc(100% + 6px); background: var(--card2); border: 1px solid var(--line); border-radius: 9px; box-shadow: 0 8px 24px rgba(0,0,0,0.45); min-width: 190px; overflow: hidden; z-index: 50; }
      .userdropdown.open { display: block; }
      .usermenu .userdropdown a { display: block; padding: 9px 13px; font-size: 13px; font-weight: 600; color: var(--ink); text-decoration: none; background: none; border: none; border-radius: 0; }
      .usermenu .userdropdown a:hover { background: var(--card); }
      .usermenu .userdropdown a + a { border-top: 1px solid var(--line); }
      @media (max-width: 480px) { .usertrigger { max-width: 60vw; } }
      .brandbar { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; flex-wrap: wrap; }
      .brandbar .logo { width: 22px; height: 22px; border-radius: 6px; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; font-size: 9.5px; font-weight: 800; letter-spacing: -0.03em; }
      .brandbar .wordmark { font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
      .brandbar .betatag { font-size: 10px; font-weight: 700; color: var(--muted); background: var(--card2); border: 1px solid var(--line); padding: 2px 6px; border-radius: 4px; letter-spacing: 0.02em; }
      .brandbar .by { font-size: 11.5px; font-weight: 600; color: var(--muted); }
      main { padding: 22px 0 60px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin-bottom: 14px; }
      .card h3 { margin: 0 0 4px; font-size: 14px; }
      .card .hint { margin: 0 0 10px; font-size: 12.5px; color: var(--muted); }
      input[type="text"], textarea, select {
        border: 1px solid var(--line); border-radius: 7px; padding: 8px 10px; font-size: 13.5px;
        color: var(--ink); background: var(--card2); outline: none; font-family: inherit;
      }
      input:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(242,169,59,0.18); }
      textarea { width: 100%; min-height: 74px; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      .addrow { display: grid; grid-template-columns: 2.2fr 110px 110px; gap: 10px; margin-bottom: 10px; }
      @media (max-width: 760px) { .addrow { grid-template-columns: 1fr; } }
      .row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      button.primary { background: var(--accent); color: var(--accent-ink); border: 1px solid var(--accent); border-radius: 7px; padding: 9px 16px; font-size: 13.5px; font-weight: 700; cursor: pointer; }
      button.primary:hover { background: var(--accent-dark); border-color: var(--accent-dark); }
      button.primary:disabled { opacity: 0.5; cursor: not-allowed; }
      button.ghost { background: var(--card2); color: var(--ink); border: 1px solid var(--line); border-radius: 7px; padding: 7px 12px; font-size: 13px; font-weight: 600; cursor: pointer; }
      button.ghost:hover { border-color: var(--line2); background: var(--card); }
      button.ghost.danger:hover { border-color: var(--bad); color: var(--bad); background: var(--card2); }
      .spinner { width: 14px; height: 14px; border: 2px solid rgba(0,0,0,0.15); border-top-color: currentColor; border-radius: 50%; display: inline-block; vertical-align: -3px; margin-right: 7px; animation: spin 0.7s linear infinite; }
      button.primary .spinner { border-color: rgba(255,255,255,0.35); }
      @keyframes spin { to { transform: rotate(360deg); } }
      .alert { margin: 0 0 14px; padding: 12px 14px; border-radius: 10px; font-size: 13.5px; display: none; }
      .alert.err { background: var(--bad-tint); color: var(--bad); border: 1px solid rgba(242,84,91,0.35); }
      .alert.info { background: var(--blue-tint); color: var(--blue); border: 1px solid rgba(110,168,254,0.32); }
      .appcard { margin-bottom: 16px; }
      .apphead { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .apphead img.icon { width: 40px; height: 40px; border-radius: 8px; border: 1px solid var(--line); }
      .apphead .fallback-icon { width: 40px; height: 40px; border-radius: 8px; border: 1px solid var(--line); display: grid; place-items: center; font-size: 18px; background: var(--card2); }
      .apphead .names { flex: 1; min-width: 200px; }
      .apphead .t { font-weight: 700; font-size: 14.5px; }
      .apphead .d { font-size: 12.5px; color: var(--muted); }
      .apphead .btns { display: flex; gap: 6px; flex-wrap: wrap; }
      .pill { display: inline-block; padding: 2px 8px; border-radius: 5px; font-size: 11px; font-weight: 700; white-space: nowrap; }
      .pill.play { background: var(--ok-tint); color: var(--ok); }
      .pill.ios { background: var(--blue-tint); color: var(--blue); }
      .pill.chart { background: var(--tint); color: var(--accent); }
      .pill.cc { background: var(--card2); color: var(--muted); }
      .pill.vol { background: var(--blue-tint); color: var(--blue); cursor: help; }
      .diffpill { display: inline-block; padding: 2px 8px; border-radius: 5px; font-size: 11px; font-weight: 700; white-space: nowrap; cursor: help; }
      .diffpill.easy { background: var(--ok-tint); color: var(--ok); }
      .diffpill.med { background: var(--warn-tint); color: var(--accent); }
      .diffpill.hard { background: var(--bad-tint); color: var(--bad); }
      /* --- overview headline (Digest-style: one number + why it moved) --- */
      .headline { margin-bottom: 18px; }
      .headline-eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 700; margin-bottom: 6px; }
      .headline-num { font-size: 46px; font-weight: 800; font-family: ui-monospace, "SF Mono", Menlo, monospace; letter-spacing: -0.01em; line-height: 1; margin-bottom: 9px; font-variant-numeric: tabular-nums; }
      .headline-sub { font-size: 14px; color: var(--muted); line-height: 1.6; max-width: 70ch; margin-bottom: 16px; }
      .headline-sub b { color: var(--ink); font-weight: 600; }
      /* --- overview (KPI cards + charts) --- */
      .ov { margin-top: 14px; }
      /* Console-style KPI cards: each stat is its own small elevated card
         with a tinted delta chip, not plain colored text — the chip's
         background carries the same up/down meaning even at a glance. */
      .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); gap: 10px; }
      .tile { background: var(--card2); border: 1px solid var(--line); border-radius: 10px; padding: 13px 15px; }
      .tile .lbl { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); font-weight: 700; margin-bottom: 7px; }
      .tile .val { font-size: 23px; font-weight: 700; line-height: 1.2; display: flex; align-items: baseline; gap: 8px; font-variant-numeric: tabular-nums; font-family: ui-monospace, "SF Mono", Menlo, monospace; }
      .tile .val .d { font-size: 10.5px; font-weight: 700; font-family: -apple-system, sans-serif; padding: 2px 7px; border-radius: 999px; }
      .tile .val .d.up { color: var(--ok); background: var(--ok-tint); }
      .tile .val .d.down { color: var(--bad); background: var(--bad-tint); }
      .tile .val .d.flat { color: var(--muted); background: var(--card); }
      /* Tiles + the category tabs + the table below them are one
         continuous story ("here's your coverage, broken down by
         category") — one shared surface makes that explicit; the tiles
         still read as distinct cards one layer up (--card2 on --card). */
      .statblock { border: 1px solid var(--line); border-radius: 10px; background: var(--card); overflow: hidden; padding: 14px; }
      .statblock .tiles { margin-bottom: 4px; }
      .statblock .kwtabs.cattabs { margin: 12px 0 0; padding: 0; }
      .statblock .table-wrap { border: none; border-radius: 0; border-top: 1px solid var(--line); margin-top: 10px; background: transparent; }
      .wn-card { background: var(--card2); border: 1px solid var(--line); border-radius: 10px; padding: 15px 16px; }
      .wn-card-head { display: flex; align-items: center; gap: 8px; margin-bottom: 11px; }
      .promo-row { display: flex; align-items: center; gap: 9px; padding: 6px 0; border-top: 1px solid var(--bg); font-size: 13.5px; cursor: pointer; }
      .promo-row:first-of-type { border-top: none; }
      .promo-row .kw { flex: 1; }
      .promo-row .pos { color: var(--ok); font-variant-numeric: tabular-nums; }
      .wn-card-ico { width: 26px; height: 26px; border-radius: 7px; display: grid; place-items: center; flex-shrink: 0; background: var(--tint); color: var(--accent); }
      .wn-card h4 { margin: 0; font-size: 11.5px; color: var(--ink); font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; }
      .wn-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 13px; padding: 5px 0; border-top: 1px solid var(--line); }
      .wn-row:first-of-type { border-top: none; }
      .wn-row .wn-kw { color: var(--ink); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .wn-empty { color: var(--muted); font-size: 12.5px; }
      .wn-line { font-size: 13px; padding: 6px 0; border-top: 1px solid var(--line); }
      .wn-line:first-of-type { border-top: none; padding-top: 0; }
      .wn-linkline { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; text-align: left; background: none; border: none; padding: 8px 0; border-top: 1px solid var(--line); cursor: pointer; font-family: inherit; color: inherit; }
      .wn-linkline:first-of-type { border-top: none; padding-top: 0; }
      .wn-linkline:hover .wn-line-title { color: var(--accent); }
      .wn-linkline:hover .wn-viewcta { background: var(--accent); color: var(--accent-ink); }
      .wn-line-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
      .wn-viewcta { flex-shrink: 0; font-size: 11px; font-weight: 700; color: var(--accent); background: var(--tint); padding: 4px 9px; border-radius: 999px; white-space: nowrap; transition: background 0.12s, color 0.12s; }
      .wn-line-title { font-size: 13px; color: var(--ink); }
      .charts { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; margin-top: 12px; }
      @media (max-width: 880px) { .charts { grid-template-columns: 1fr; } }
      /* Same two charts on Overview, stacked full-width instead of side by
         side — they sit directly under the visibility trend, where the
         universe size is read against it rather than beside another chart. */
      .ovcharts { display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 18px; }
      .chartbox { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 12px 8px; }
      .chartbox h4 { margin: 0 0 8px; font-size: 11px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
      .legend { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; font-size: 11px; color: var(--muted); }
      .legend .li { display: flex; align-items: center; gap: 5px; }
      .legend .sw { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
      /* --- Daily Snapshot: a framed, screenshot-sized card for sharing
         outside the tool (WhatsApp/Slack report groups) --- */
      .insight { padding: 10px 0 10px 12px; border-left: 3px solid var(--line); border-top: 1px solid var(--bg); }
      .insight:first-of-type { border-top: none; }
      .insight.good { border-left-color: var(--ok); }
      .insight.bad { border-left-color: var(--bad); }
      .insight.watch { border-left-color: var(--warn); }
      .insight.neutral { border-left-color: var(--line2); }
      .insight-t { font-size: 13.5px; font-weight: 700; margin-bottom: 3px; }
      .insight-d { font-size: 13px; color: var(--muted); line-height: 1.55; }
      .snap-frame { border: 1px solid var(--line); border-radius: 14px; background: var(--card); padding: 20px 22px; max-width: 760px; }
      .snap-top { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
      .snap-top img.icon { width: 40px; height: 40px; border-radius: 8px; border: 1px solid var(--line); }
      .snap-top .fallback-icon { width: 40px; height: 40px; border-radius: 8px; border: 1px solid var(--line); display: grid; place-items: center; font-size: 18px; background: var(--card2); }
      .snap-top .t { font-weight: 700; font-size: 15px; }
      .snap-top .d { font-size: 12px; color: var(--muted); margin-top: 1px; }
      .viztip { position: fixed; z-index: 60; pointer-events: none; background: var(--card2); border: 1px solid var(--line); border-radius: 7px; box-shadow: 0 6px 20px rgba(0,0,0,0.5); padding: 8px 11px; font-size: 12px; display: none; min-width: 130px; }
      .kwmodal-backdrop { display: none; position: fixed; inset: 0; z-index: 70; background: rgba(0,0,0,0.6); align-items: center; justify-content: center; padding: 20px; }
      .kwmodal-backdrop.open { display: flex; }
      .kwmodal { background: var(--card2); border: 1px solid var(--line); border-radius: 12px; padding: 20px; max-width: 520px; width: 100%; max-height: 86vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.55); }
      .kwmodal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 4px; }
      .kwmodal-title { font-size: 16px; font-weight: 700; font-family: ui-monospace, monospace; }
      .kwmodal-close { background: none; border: none; font-size: 20px; line-height: 1; color: var(--muted); cursor: pointer; padding: 2px 4px; }
      .kwmodal-close:hover { color: var(--ink); }
      .kwmodal-stats { display: flex; gap: 20px; margin: 12px 0 16px; flex-wrap: wrap; }
      .kwmodal-stat { font-size: 12px; color: var(--muted); }
      .kwmodal-stat b { display: block; font-size: 17px; color: var(--ink); font-weight: 800; }
      .viztip .tt-d { font-weight: 700; margin-bottom: 4px; }
      .viztip .tt-r { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); }
      .viztip .tt-r b { color: var(--ink); font-variant-numeric: tabular-nums; }
      .scrollhint { display: none; font-size: 11px; color: var(--muted); margin: 10px 0 4px; font-weight: 600; }
      @media (max-width: 760px) { .scrollhint { display: block; } }
      /* overflow-y: hidden + touch-action: pan-x make the scroll axis
         unambiguous — without this, a horizontally-scrollable table nested
         inside a vertically-scrollable page can swallow vertical swipes on
         touch devices, making the page feel stuck while a finger is over
         a table (only the table's own content ever appears to move). */
      .table-wrap { overflow-x: auto; overflow-y: hidden; touch-action: pan-x; border: 1px solid var(--line); border-radius: 10px; background: var(--card); margin-top: 12px; -webkit-overflow-scrolling: touch; }
      .cthead { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; max-width: 140px; overflow: hidden; text-overflow: ellipsis; }
      .cthead b { overflow: hidden; text-overflow: ellipsis; }
      .cticon { width: 16px; height: 16px; border-radius: 4px; flex-shrink: 0; }
      table { border-collapse: collapse; width: 100%; min-width: 780px; font-size: 13px; }
      th, td { text-align: left; padding: 8px 12px; vertical-align: middle; border-bottom: 1px solid var(--line); }
      th { background: var(--card2); font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); font-weight: 700; }
      th.sortable { cursor: pointer; user-select: none; white-space: nowrap; }
      th.sortable:hover { color: var(--accent); }
      tr:hover td { background: var(--card2); }
      tr:last-child td { border-bottom: none; }
      td.kw { font-family: ui-monospace, monospace; font-size: 12.5px; color: var(--accent); }
      .kwlink { background: none; border: none; padding: 0; font: inherit; font-family: ui-monospace, monospace; font-size: 12.5px; color: var(--accent); cursor: pointer; text-align: left; text-decoration: underline; text-decoration-color: transparent; }
      .kwlink:hover { text-decoration-color: var(--accent); }
      td.pos { font-variant-numeric: tabular-nums; font-weight: 800; font-size: 15px; width: 64px; font-family: ui-monospace, "SF Mono", Menlo, monospace; }
      td.pos .un { color: var(--muted); font-weight: 600; font-size: 12.5px; font-family: -apple-system, sans-serif; }
      .delta { font-weight: 700; font-size: 12.5px; white-space: nowrap; font-family: ui-monospace, "SF Mono", Menlo, monospace; }
      .delta.up { color: var(--ok); }
      .delta.down { color: var(--bad); }
      .delta.flat, .delta.na { color: var(--muted); font-weight: 600; }
      .who { font-size: 12.5px; color: var(--muted); }
      .kwedit { margin-top: 12px; display: none; }
      .kwedit.open { display: block; }
      .annedit { margin-top: 12px; display: none; }
      .annedit.open { display: block; }
      .annedit .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 8px; }
      .annedit label { font-size: 11.5px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 3px; }
      .annedit input[type="date"], .annedit select { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; font-size: 13px; font-family: inherit; background: var(--card2); color: var(--ink); }
      .annedit input[type="date"] { color-scheme: light; }
      .annlist { margin-top: 16px; }
      .annlist h4 { margin: 0 0 4px; font-size: 13px; }
      .annrow { display: flex; align-items: flex-start; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); }
      .annrow:last-child { border-bottom: none; }
      .anntype { font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 5px; white-space: nowrap; flex-shrink: 0; }
      .anntype.experiment { background: var(--tint); color: var(--accent); }
      .anntype.paid { background: var(--blue-tint); color: var(--blue); }
      .anntext { flex: 1; font-size: 13px; }
      .annimpact { margin-top: 4px; font-size: 12.5px; color: var(--muted); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
      .ann-delta { font-weight: 800; font-size: 12.5px; }
      .ann-delta.up { color: var(--ok); }
      .ann-delta.down { color: var(--bad); }
      .ann-delta.na, .ann-delta.flat { color: var(--muted); }
      button.small { padding: 4px 9px; font-size: 12px; flex-shrink: 0; }
      .covov { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }
      .covhead { margin: 0 0 12px; font-size: 13.5px; font-weight: 700; color: var(--ink); }
      .discover { margin-top: 12px; border: 1px solid var(--line); background: var(--card2); border-radius: 8px; padding: 12px 14px; }
      .discover h4 { margin: 0 0 8px; font-size: 13px; }
